local function makeBtn(yPos, label, tag, tagColor, url)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -24, 0, 44)
    btn.Position = UDim2.new(0, 12, 0, yPos)
    btn.BackgroundColor3 = BTN_BG
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Parent = main

    local bCr = Instance.new("UICorner")
    bCr.CornerRadius = UDim.new(0, 8)
    bCr.Parent = btn

    local bSt = Instance.new("UIStroke")
    bSt.Color = BORDER
    bSt.Thickness = 1
    bSt.Parent = btn

    local txt = Instance.new("TextLabel")
    txt.Size = UDim2.new(1, -85, 1, 0)
    txt.Position = UDim2.new(0, 14, 0, 0)
    txt.BackgroundTransparency = 1
    txt.Text = label
    txt.TextColor3 = TEXT
    txt.TextSize = 13
    txt.Font = FONT
    txt.TextXAlignment = Enum.TextXAlignment.Left
    txt.Parent = btn

    local pill = Instance.new("TextLabel")
    pill.Size = UDim2.new(0, 56, 0, 20)
    pill.Position = UDim2.new(1, -68, 0.5, -10)
    pill.BackgroundColor3 = tagColor
    pill.BackgroundTransparency = 0.85
    pill.Text = tag
    pill.TextColor3 = tagColor
    pill.TextSize = 10
    pill.Font = FONT
    pill.Parent = btn

    local pCr = Instance.new("UICorner")
    pCr.CornerRadius = UDim.new(0, 5)
    pCr.Parent = pill

    btn.MouseEnter:Connect(function()
        if closing then return end
        sfx("72243701593463", 0.08, 1.5)
        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = Color3.fromRGB(38, 43, 56)}):Play()
        TweenService:Create(bSt, TweenInfo.new(0.12), {Color = tagColor}):Play()
    end)

    btn.MouseLeave:Connect(function()
        if closing then return end
        TweenService:Create(btn, TweenInfo.new(0.12), {BackgroundColor3 = BTN_BG}):Play()
        TweenService:Create(bSt, TweenInfo.new(0.12), {Color = BORDER}):Play()
    end)

    btn.MouseButton1Click:Connect(function()
        if closing then return end
        sfx("89862007435778", 0.25, 1.1)
        txt.Text = "Loading..."
        task.spawn(function()
            destroyUI()
            loadstring(game:HttpGet(url))()
        end)
    end)
end

