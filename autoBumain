            pcall(function()
                if v.IsTwoPart and v.SecondaryWorldCF then
                    placeRF:InvokeServer(
                        v.Name, getBlockID(v.Name), v.Relative,
                        v.Relative.CFrame:ToObjectSpace(v.skyWorldCF),
                        true,
                        v.SecondaryWorldCF,
                        v.skyWorldCF
                    )
                else
                    placeRF:InvokeServer(
                        v.Name, getBlockID(v.Name), v.Relative,
                        v.Relative.CFrame:ToObjectSpace(v.skyWorldCF),
