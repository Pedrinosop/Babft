    local function fastRescale(b, cf, sz)
        if not b or not b:FindFirstChild("PPart") then return false end
        pcall(function()
            b.PPart.Size = sz
            b.PPart.CFrame = cf
        end)
        if scaleRF then
            fireScale(b, sz, cf)
            return true
        end
        return false
