function resolveIconAsset(name)
    if not name then return nil end
    if name == "mascot" then
        return resolveMascotAsset()
    end
    if name == "profile" then
        local lp = Players and Players.LocalPlayer
        local uid = lp and lp.UserId or 1
        return "rbxthumb://type=AvatarHeadShot&id=" .. tostring(uid) .. "&w=150&h=150"
    end
    if _sprb_icon_cache[name] then return _sprb_icon_cache[name] end
    local getAssetFn = (typeof(getcustomasset) == "function" and getcustomasset)
        or (typeof(getsynasset) == "function" and getsynasset)
    if getAssetFn then
        local candidates = {
            "icons/" .. name .. ".png",
            name .. ".png",
            FOLDER_PREFIX .. "icons/" .. name .. ".png",
            FOLDER_PREFIX .. "sprb_icon_" .. name .. ".png",
            FOLDER_PATH .. "/" .. name .. ".png"
        }
        for _, p in ipairs(candidates) do
            local exists = (typeof(isfile) == "function" and isfile(p)) or (not isfile)
            if exists then
                local ok, asset = pcall(getAssetFn, p)
                if ok and asset and asset ~= "" then
                    _sprb_icon_cache[name] = asset
                    return asset
                end
            end
        end
    end

    if name == "transform" then return resolveIconAsset("replace") or resolveIconAsset("refresh") end
    if name == "troll" then return resolveIconAsset("star") or resolveIconAsset("warn") end
    if name == "misc" then return resolveIconAsset("boat") or resolveIconAsset("stage") end
    return nil
end

