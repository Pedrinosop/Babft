function fmtTime(s)
    s = math.floor(s)
    local h = math.floor(s / 3600) local m = math.floor((s % 3600) / 60)
    if h > 0 then return string.format("%d:%02d:%02d", h, m, s % 60) end
    return string.format("%d:%02d", m, s % 60)
end
function getFarmStats()
