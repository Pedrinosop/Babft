    local activeContentFrame = nil
    local tabFrameOrder = {}
    local setDockActiveGlobal = nil
    local function switchTab(frame)
        local previousFrame = activeContentFrame
        if previousFrame == frame then return end
        activeContentFrame = frame

        local prevIdx = 0
        local newIdx = 0
        for i, t in ipairs(tabFrameOrder) do
            if t == previousFrame then prevIdx = i end
            if t == frame then
                newIdx = i
                _lastActiveTabIdx = i
            end
        end
        local goingDown = newIdx > prevIdx
        if previousFrame and previousFrame.Parent then
            local exitY = goingDown and -10 or 18
            tween(previousFrame, TweenInfo.new(0.12, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = UDim2.new(0, 7, 0, exitY)
            }):Play()
            task.delay(0.12, function()
                if previousFrame ~= activeContentFrame and previousFrame and previousFrame.Parent then
                    previousFrame.Visible = false
                    previousFrame.Position = UDim2.new(0, 7, 0, 6)
                end
            end)
        end
        for _, f in pairs(ContentArea:GetChildren()) do
            if f:IsA("ScrollingFrame") and f ~= frame and f ~= previousFrame then
                f.Visible = false
                f.Position = UDim2.new(0, 7, 0, 6)
            end
        end
        for _, b in pairs(TabsBar:GetChildren()) do
            if b:IsA("TextButton") then
                b.Text = ""
                local oldTG = b:FindFirstChild("SPRB_TabGrad")
                if oldTG then oldTG:Destroy() end
                tween(b, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = Colors.PanelSoft,
                    BackgroundTransparency = Settings.btnTransparency or 0.1,
                }):Play()
                local lbl = b:FindFirstChild("TabLabel")
                if lbl then tween(lbl, TweenInfo.new(0.12), {TextColor3 = Colors.Muted}):Play() end
                local ic = b:FindFirstChild("TabIcon")
                if ic then tween(ic, TweenInfo.new(0.12), {ImageColor3 = Colors.Muted}):Play() end
                local s = b:FindFirstChildOfClass("UIStroke")
                if s then
                    s.Color = Colors.Border
                    s.Transparency = 0.8
                end
            end
        end
        frame.Visible = true
        frame.CanvasPosition = Vector2.new(0, 0)
        local enterY = goingDown and 18 or -10
        frame.Position = UDim2.new(0, 7, 0, enterY)
        tween(frame, TweenInfo.new(0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(0, 7, 0, 6)
        }):Play()
        local tb = TabsBar:FindFirstChild(frame.Name:gsub("Frame", "Tab"))
        if tb then
            local oldTG = tb:FindFirstChild("SPRB_TabGrad")
            if oldTG then oldTG:Destroy() end

            tween(tb, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = Colors.PanelElevated,
                BackgroundTransparency = 0,
            }):Play()
            local lbl = tb:FindFirstChild("TabLabel")
            if lbl then tween(lbl, TweenInfo.new(0.12), {TextColor3 = Colors.ActiveText}):Play() end
            local ic = tb:FindFirstChild("TabIcon")
            if ic then tween(ic, TweenInfo.new(0.12), {ImageColor3 = Colors.ActiveText}):Play() end
            local s = tb:FindFirstChildOfClass("UIStroke")
            if s then
                s.Color = Colors.Accent
                s.Transparency = 0.45
            end
        end
        if setDockActiveGlobal then
            local map = {
                BuildFrame = "Build",
                BlocksFrame = "Blocks",
                ConvertFrame = "Convert",
                TrollFrame = "Troll",
                MiscFrame = "Misc",
                SettingsFrame = "Settings"
            }
            if map[frame.Name] then
                setDockActiveGlobal(map[frame.Name])
            end
        end
    end

