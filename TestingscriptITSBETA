function getRealBlockCount(blockName)
    local count = nil
    pcall(function()
        local dataFolder = LocalPlayer:FindFirstChild("Data")
        if dataFolder then
            local dItem = dataFolder:FindFirstChild(blockName)
            if dItem and (dItem:IsA("ValueBase") or dItem:IsA("NumberValue") or dItem:IsA("IntValue")) then
                local used = dItem:FindFirstChild("Used")
                local usedVal = (used and tonumber(used.Value)) or 0
                local totalVal = tonumber(dItem.Value) or 0
                count = math.max(0, math.floor(totalVal - usedVal))
                return
            end
        end

        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local bg = pg and pg:FindFirstChild("BuildGui")
        if not bg then return end

        local inv = bg:FindFirstChild("InventoryFrame") or bg:FindFirstChild("Inventory")
        local sf = inv and (inv:FindFirstChild("ScrollingFrame") or inv)
        local bf = sf and (sf:FindFirstChild("BlocksFrame") or sf)

        if bf then
            local item = bf:FindFirstChild(blockName)
            if item then
                local at = item:FindFirstChild("AmountText") or item:FindFirstChild("Amount") or item:FindFirstChild("Count")
                if at and at:IsA("TextLabel") and at.Text then
                    local digits = at.Text:gsub("[^%d]", "")
                    if digits ~= "" then
                        local n = tonumber(digits)
                        if n ~= nil then
                            count = n
                            return
                        end
                    end
                end
                count = 1
                return
            end
        end

        if bf then
            local targetLower = string.lower(blockName)
            for _, child in ipairs(bf:GetChildren()) do
                if string.lower(child.Name) == targetLower then
                    local at = child:FindFirstChild("AmountText") or child:FindFirstChild("Amount") or child:FindFirstChild("Count")
                    if at and at:IsA("TextLabel") and at.Text then
                        local digits = at.Text:gsub("[^%d]", "")
                        if digits ~= "" then
                            local n = tonumber(digits)
                            if n ~= nil then
                                count = n
                                return
                            end
                        end
                    end
                    count = 1
                    return
                end
            end
        end

        if sf then
            for _, desc in ipairs(sf:GetDescendants()) do
                if desc.Name == blockName and desc:IsA("GuiObject") then
                    local at = desc:FindFirstChild("AmountText") or desc:FindFirstChild("Amount") or desc:FindFirstChild("Count")
                    if at and at:IsA("TextLabel") and at.Text then
                        local digits = at.Text:gsub("[^%d]", "")
                        if digits ~= "" then
                            local n = tonumber(digits)
                            if n ~= nil then
                                count = n
                                return
                            end
                        end
                    end
                    count = 1
                    return
                end
            end
        end
    end)

    if count ~= nil then
        return math.floor(count)
    end

    return 0
end

