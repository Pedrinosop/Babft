            local TRACKS_Z = 5
            local COLS_PER_FLOOR = COLS_X * TRACKS_Z 

            for i, st in ipairs(steps) do
                local globalCol = math.floor((i - 1) / STEPS_PER_COL)
                local rowInCol = (i - 1) % STEPS_PER_COL
                local floorIdx = math.floor(globalCol / COLS_PER_FLOOR)
                local colOnFloor = globalCol % COLS_PER_FLOOR

