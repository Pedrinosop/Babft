function getContrastTextColor(bgColor)
    if not bgColor then return Color3.fromRGB(255, 255, 255) end
    local lum = 0.299 * bgColor.R + 0.587 * bgColor.G + 0.114 * bgColor.B
    if lum < 0.55 then
        return Color3.fromRGB(255, 255, 255)
    else
        return Color3.fromRGB(15, 17, 21)
    end
end

function getReadableAccentColor(accentColor, bgColor)
    accentColor = accentColor or (Colors and Colors.Secondary) or Color3.fromRGB(59, 130, 246)
    bgColor = bgColor or (Colors and Colors.PanelElevated) or Color3.fromRGB(30, 34, 44)
    local aLum = 0.299 * accentColor.R + 0.587 * accentColor.G + 0.114 * accentColor.B
    local bLum = 0.299 * bgColor.R + 0.587 * bgColor.G + 0.114 * bgColor.B
    if math.abs(aLum - bLum) < 0.35 then
        if bLum < 0.55 then
            return accentColor:Lerp(Color3.fromRGB(255, 255, 255), 0.55)
        else
            return accentColor:Lerp(Color3.fromRGB(0, 0, 0), 0.55)
        end
    end
    return accentColor
end

function syncColors()
    local pc = Settings.primaryColor or Color3.fromRGB(15, 17, 21)
    local sc = Settings.secondaryColor or Color3.fromRGB(59, 130, 246)

    local pLum = 0.299 * pc.R + 0.587 * pc.G + 0.114 * pc.B
    local sLum = 0.299 * sc.R + 0.587 * sc.G + 0.114 * sc.B
    local isDarkBg = pLum < 0.55

    Colors.Primary = pc
    Colors.Secondary = sc
    Colors.Accent = sc
    Colors.SecondaryText = sc

    Colors.BG = pc
    if isDarkBg then
        Colors.Panel = pc:Lerp(sc, 0.06)
        Colors.PanelSoft = pc:Lerp(sc, 0.03)
        Colors.PanelElevated = pc:Lerp(sc, 0.12)
        Colors.Text = sc:Lerp(Color3.fromRGB(245, 245, 245), 0.15)
        Colors.Muted = sc:Lerp(pc, 0.45)
        Colors.Border = pc:Lerp(sc, 0.28)
    else
        Colors.Panel = pc:Lerp(sc, 0.06)
        Colors.PanelSoft = pc:Lerp(sc, 0.03)
        Colors.PanelElevated = pc:Lerp(sc, 0.12)
        Colors.Text = Color3.fromRGB(20, 22, 26)
        Colors.Muted = sc:Lerp(Color3.fromRGB(20, 22, 26), 0.45)
        Colors.Border = pc:Lerp(sc, 0.28)
    end

    Colors.ActiveBG = sc
    Colors.ActiveText = (sLum < 0.55) and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(20, 20, 20)
    Colors.AccentSoft = sc:Lerp(pc, 0.35)
    Colors.AccentGlow = sc:Lerp(Color3.fromRGB(255, 255, 255), 0.25)
    Colors.IconIdle = sc:Lerp(pc, 0.38)
    Colors.IconActive = sc

    if updateDockColorsGlobal then pcall(updateDockColorsGlobal) end
end

_bgAnimConns = {}
_registeredBgWindows = {}

function registerWindowForBg(w)
    if not w then return end
    for _, existing in ipairs(_registeredBgWindows) do
        if existing == w then return end
    end
    table.insert(_registeredBgWindows, w)
    applyWindowBackground(w, true)
end

function applyAllWindowBackgrounds()
    if MainFrame and MainFrame.Parent then
        applyWindowBackground(MainFrame, true)
    end
    local clean = {}
    for _, w in ipairs(_registeredBgWindows) do
        if w and w.Parent and w ~= MainFrame then
            table.insert(clean, w)
            applyWindowBackground(w, true)
        end
    end
    _registeredBgWindows = clean
end

function applyWindowBackground(MainFrame_ref, isBatch)
    if GlobalBuildOverlayRef and GlobalBuildOverlayRef.Parent then
        GlobalBuildOverlayRef.BackgroundTransparency = Settings.guiTransparency or 0.15
    end
    if not MainFrame_ref then
        applyAllWindowBackgrounds()
        return
    end

    if not isBatch and MainFrame and MainFrame_ref == MainFrame then
        applyAllWindowBackgrounds()
        return
    end

    if not MainFrame_ref.Visible then
        return
    end

    for _, c in pairs(MainFrame_ref:GetChildren()) do
        if c.Name == "SPRB_BgAnim" or c.Name:find("^SPRB_Grid_") or c.Name:find("^SPRB_Ball_") or c.Name:find("^SPRB_Wave_") or c.Name:find("^SPRB_SmokeP_") or c.Name:find("^SPRB_Const") then
            c:Destroy()
        end
    end
    if not _bgAnimConns[MainFrame_ref] then _bgAnimConns[MainFrame_ref] = {} end
    for _, conn in ipairs(_bgAnimConns[MainFrame_ref]) do
        pcall(function() conn:Disconnect() end)
    end
    _bgAnimConns[MainFrame_ref] = {}
    local _bgConns = _bgAnimConns[MainFrame_ref]

    local mode = Settings.bgMode or "default"
    local gt = Settings.guiTransparency or 0.18

    local function applySolidBg(col)
        TweenService:Create(MainFrame_ref, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
            BackgroundTransparency = gt,
            BackgroundColor3 = col
        }):Play()
        pcall(function()
            local h = MainFrame_ref:FindFirstChild("Frame")
            if h then
                h.BackgroundTransparency = math.clamp(gt * 0.9, 0, 0.95)
                local hbc = h:FindFirstChild("HeaderBottomCover")
                if hbc then hbc.BackgroundTransparency = h.BackgroundTransparency end
            end
            local tb = MainFrame_ref:FindFirstChild("TabsBar")
            if tb then
                tb.BackgroundTransparency = math.clamp(gt * 0.95, 0, 0.95)
            end
        end)
    end

    if mode == "color" then
        applySolidBg(Settings.bgCustomColor)
    else
        applySolidBg(Colors.BG)
    end

    if Settings.bgAnimEnabled then
        local anim = Settings.bgAnim or "lava"
        local animColor = Settings.bgAnimColor or Color3.fromRGB(15, 17, 21)
        local count = math.floor(Settings.bgAnimCount or 8)
        local speed = Settings.bgAnimSpeed or 1.0
        local container = Instance.new("Frame")
        container.Name = "SPRB_BgAnim"
        container.Size = UDim2.new(1, 0, 1, 0)
        container.BackgroundTransparency = 1
        container.ClipsDescendants = true
        container.ZIndex = 0
        container.Parent = MainFrame_ref
        local cCorner = Instance.new("UICorner")
        cCorner.CornerRadius = UDim.new(0, 16)
        cCorner.Parent = container

        if anim == "grid" then
            local animSize = Settings.bgAnimSize or 1.0
            local cellSize = math.clamp(math.floor(20 * animSize), 6, 80)
            local gap = 1
            local stride = cellSize + gap
            local cells = {}
            local randomCenter = {x = 0.5, y = 0.5, vx = 0.12, vy = 0.09}
            local autoColor = Settings.bgAnimAutoColor
            local h, s, v0 = Color3.toHSV(animColor)

            local colIdx = 0
            local maxCellsX = math.clamp(math.floor(math.min(container.AbsoluteSize.X > 0 and container.AbsoluteSize.X or 760, 800) / stride), 4, 16)
            local maxCellsY = math.clamp(math.floor(math.min(container.AbsoluteSize.Y > 0 and container.AbsoluteSize.Y or 460, 500) / stride), 4, 12)
            for r = 0, maxCellsY do
                local gy = r * stride
                for c = 0, maxCellsX do
                    local gx = c * stride
                    local sq = Instance.new("Frame")
                    sq.Name = "SPRB_Grid_" .. r .. "_" .. c
                    sq.Size = UDim2.new(0, cellSize, 0, cellSize)
                    sq.Position = UDim2.new(0, gx, 0, gy)
                    sq.BackgroundColor3 = animColor
                    sq.BackgroundTransparency = 0.6
                    sq.BorderSizePixel = 0
                    sq.ZIndex = 0
                    sq.Parent = container
                    cells[#cells + 1] = {frame = sq, gx = gx, gy = gy}
                end
            end

            local conn
            local _gridDtAccum = 0
            conn = RunService.RenderStepped:Connect(function(dt)
                if not container or not container.Parent or not MainFrame_ref.Visible then
                    if not container or not container.Parent then
                        pcall(function() conn:Disconnect() end)
                    end
                    return
                end
                _gridDtAccum = _gridDtAccum + dt
                if _gridDtAccum < 0.033 then return end
                _gridDtAccum = 0
                local absW = container.AbsoluteSize.X
                local absH = container.AbsoluteSize.Y
                if absW < 1 or absH < 1 then return end

                randomCenter.x = randomCenter.x + randomCenter.vx * dt * speed
                randomCenter.y = randomCenter.y + randomCenter.vy * dt * speed
                if randomCenter.x < 0.1 or randomCenter.x > 0.9 then randomCenter.vx = -randomCenter.vx end
                if randomCenter.y < 0.1 or randomCenter.y > 0.9 then randomCenter.vy = -randomCenter.vy end
                local cx = randomCenter.x * absW
                local cy = randomCenter.y * absH

                local t = os.clock()

                local curH = h
                if autoColor then

                    local phase = (t * 0.04) % 1

                    local shift = math.sin(phase * math.pi * 2) * 0.08
                    local compShift = math.sin(phase * math.pi * 2 + math.pi) * 0.04
                    curH = (h + shift + compShift) % 1
                end
                for _, sq in ipairs(cells) do
                    local px = sq.gx + cellSize * 0.5
                    local py = sq.gy + cellSize * 0.5
                    local dx = px - cx
                    local dy = py - cy
                    local dist = math.sqrt(dx * dx + dy * dy)

                    local wave = (math.sin(dist * 0.02 - t * speed * 2.0) + 1) / 2

                    local hueShift = wave * 0.06

                    local lightness = 0.08 + wave * 0.18
                    local sat = s * (0.3 + wave * 0.5)
                    sq.frame.BackgroundColor3 = Color3.fromHSV((curH + hueShift) % 1, sat, lightness)

                    sq.frame.BackgroundTransparency = 0.25 + (1 - wave) * 0.45
                end
            end)
            table.insert(_bgConns, conn)

        elseif anim == "constellation" then
            local particles = {}
            local pCount = math.clamp(count * 4, 12, 60)
            local linkDist = 0.18
            local autoColor = Settings.bgAnimAutoColor
            local h, s, v0 = Color3.toHSV(animColor)
            for i = 1, pCount do
                local p = Instance.new("Frame")
                p.Name = "SPRB_ConstP_" .. i
                p.Size = UDim2.new(0, 4, 0, 4)
                p.Position = UDim2.new(math.random(), 0, math.random(), 0)
                p.BackgroundColor3 = animColor
                p.BackgroundTransparency = 0.1
                p.BorderSizePixel = 0
                p.ZIndex = 0
                p.Parent = container
                local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(1, 0); cr.Parent = p
                particles[i] = {
                    frame = p,
                    vx = (math.random() - 0.5) * 0.06 * speed,
                    vy = (math.random() - 0.5) * 0.06 * speed,
                }
            end

            local linePool = {}
            local maxLines = pCount * 3
            for i = 1, maxLines do
                local ln = Instance.new("Frame")
                ln.Name = "SPRB_ConstL_" .. i
                ln.Size = UDim2.new(0, 1, 0, 1)
                ln.BackgroundColor3 = animColor
                ln.BackgroundTransparency = 1
                ln.BorderSizePixel = 0
                ln.ZIndex = 0
                ln.Parent = container
                linePool[i] = {frame = ln, active = false}
            end

            local conn
            local _gridDtAccum = 0
            conn = RunService.RenderStepped:Connect(function(dt)
                if not container or not container.Parent or not MainFrame_ref.Visible then
                    if not container or not container.Parent then
                        pcall(function() conn:Disconnect() end)
                    end
                    return
                end
                _gridDtAccum = _gridDtAccum + dt
                if _gridDtAccum < 0.033 then return end
                _gridDtAccum = 0
                local absW = container.AbsoluteSize.X
                local absH = container.AbsoluteSize.Y
                if absW < 1 or absH < 1 then return end

                local curH = h
                if autoColor then
                    local phase = (os.clock() * 0.04) % 1
                    local shift = math.sin(phase * math.pi * 2) * 0.08
                    local compShift = math.sin(phase * math.pi * 2 + math.pi) * 0.04
                    curH = (h + shift + compShift) % 1
                end

                local curColor = Color3.fromHSV(curH, s, v0)
                for _, pt in ipairs(particles) do
                    local f = pt.frame
                    local px = f.Position.X.Scale + pt.vx * dt
                    local py = f.Position.Y.Scale + pt.vy * dt
                    if px < 0 or px > 1 then pt.vx = -pt.vx; px = math.clamp(px, 0, 1) end
                    if py < 0 or py > 1 then pt.vy = -pt.vy; py = math.clamp(py, 0, 1) end
                    f.Position = UDim2.new(px, 0, py, 0)
                    if autoColor then
                        f.BackgroundColor3 = curColor
                    end
                end

                local linkPx = linkDist * absW
                local lineIdx = 1
                for i = 1, #particles do
                    local a = particles[i].frame
                    local ax, ay = a.Position.X.Scale * absW, a.Position.Y.Scale * absH
                    for j = i + 1, #particles do
                        local b = particles[j].frame
                        local bx, by = b.Position.X.Scale * absW, b.Position.Y.Scale * absH
                        local dx = ax - bx
                        local dy = ay - by
                        local dist = math.sqrt(dx * dx + dy * dy)
                        if dist < linkPx and lineIdx <= maxLines then
                            local ln = linePool[lineIdx]
                            ln.active = true
                            local midX = (ax + bx) / 2
                            local midY = (ay + by) / 2
                            local len = math.sqrt(dx * dx + dy * dy)
                            local angle = math.atan2(dy, dx)
                            local alpha = 1 - dist / linkPx
                            ln.frame.Size = UDim2.new(0, len, 0, 1.5)
                            ln.frame.Position = UDim2.new(0, midX - len / 2, 0, midY - 0.75)
                            ln.frame.Rotation = math.deg(angle)
                            ln.frame.BackgroundTransparency = 1 - alpha * 0.5
                            if autoColor then
                                ln.frame.BackgroundColor3 = curColor
                            end
                            lineIdx = lineIdx + 1
                        end
                    end
                end
                for i = lineIdx, maxLines do
                    if linePool[i].active then
                        linePool[i].frame.BackgroundTransparency = 1
                        linePool[i].active = false
                    end
                end
            end)
            table.insert(_bgConns, conn)

        elseif anim == "waves" then
            local layers = math.clamp(count, 3, 8)
            local autoColor = Settings.bgAnimAutoColor
            local waveDots = {}
            local dotsPerLayer = 30
            local h, s, v0 = Color3.toHSV(animColor)
