    local ASYNC_CAP = 16
    local asyncQueue, asyncInflight = {}, 0
    local function asyncPump()
        while asyncInflight < ASYNC_CAP and not stopBuild do
            local fn = table.remove(asyncQueue, 1)
            if not fn then break end
            asyncInflight = asyncInflight + 1
            task.spawn(function()
                pcall(fn)
                asyncInflight = asyncInflight - 1
                if not stopBuild then asyncPump() end
            end)
        end
    end
    local function asyncCall(fn)
        asyncQueue[#asyncQueue + 1] = fn
        if not stopBuild then asyncPump() end
    end
    local function asyncPending()
        return asyncInflight + #asyncQueue
    end
    local function asyncDrain(maxWait)
        local t0 = os.clock()
        local limit = maxWait or 120
        while asyncPending() > 0 and os.clock() - t0 < limit and not stopBuild do
            task.wait(0.05)
        end
    end

