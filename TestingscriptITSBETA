        local function updateCameraPose()
            if not cam then return end
            if autoRotate then
                local camHeight = modelDist * 0.5
                local orbitDist = modelDist * 0.99
                local cx = math.cos(curAngle) * orbitDist
                local cz = math.sin(curAngle) * orbitDist
                cam.CFrame = CFrame.new(Vector3.new(cx, camHeight, cz), Vector3.new(0, 0, 0))
            else
                cam.CFrame = CFrame.new(Vector3.new(modelDist * 0.7, modelDist * 0.5, modelDist * 0.7), Vector3.new(0, 0, 0))
            end
        end

        local hbConn = RunService.Heartbeat:Connect(function(dt)
            if not previewCard or not previewCard.Parent then return end
            if not previewCard.Visible then return end
            if autoRotate then
                curAngle = (curAngle + dt * 0.9) % (math.pi * 2)
                updateCameraPose()
            end
        end)

        local function updateModel(buildData)
            for _, child in ipairs(worldModel:GetChildren()) do
                child:Destroy()
            end
            if not buildData or not next(buildData) then
                countLbl.Text = "3D PREVIEW: EMPTY"
                countLbl.TextColor3 = Colors.Muted
                modelDist = 12
                updateCameraPose()
                return
            end

            local allParts = {}
            local minP = Vector3.new(math.huge, math.huge, math.huge)
            local maxP = Vector3.new(-math.huge, -math.huge, -math.huge)
            local totalCount = 0

            for _, blist in pairs(buildData) do
                if type(blist) == "table" then
                    for _, bitem in pairs(blist) do
                        if type(bitem) == "table" then
                            local bcf = getBlockCF(bitem)
                            if bcf then
                                totalCount = totalCount + 1
                                local p = bcf.Position
                                local sz = (bitem.Size and bitem.Size ~= "") and strV3(bitem.Size) or Vector3.new(2, 2, 2)
                                local hs = sz * 0.5
                                minP = Vector3.new(math.min(minP.X, p.X - hs.X), math.min(minP.Y, p.Y - hs.Y), math.min(minP.Z, p.Z - hs.Z))
                                maxP = Vector3.new(math.max(maxP.X, p.X + hs.X), math.max(maxP.Y, p.Y + hs.Y), math.max(maxP.Z, p.Z + hs.Z))
                                allParts[#allParts + 1] = {
                                    cf = bcf,
                                    sz = sz,
                                    col = bitem.Color or bitem.Col or bitem.col or bitem.cl or bitem.color,
                                    trans = bitem.Transparency or bitem.transparency or bitem.t
                                }
                            end
                        end
                    end
                end
            end

            if totalCount > 0 and minP.X < math.huge then
                local bCenter = (minP + maxP) * 0.5
                local bSize = maxP - minP
                local maxDim = math.max(bSize.X, bSize.Y, bSize.Z, 2)

                local MAX_PARTS = 1200
                local step = 1
                if #allParts > MAX_PARTS then
                    step = math.ceil(#allParts / MAX_PARTS)
                end

                local renderedCount = 0
                for i = 1, #allParts, step do
                    local it = allParts[i]
                    renderedCount = renderedCount + 1
                    local ppart = Instance.new("Part")
                    ppart.Size = it.sz
                    ppart.CFrame = CFrame.new(-bCenter) * it.cf
                    ppart.Anchored = true
                    ppart.CanCollide = false
                    ppart.CastShadow = false
                    ppart.Material = Enum.Material.SmoothPlastic
                    if it.col and it.col ~= "" then
                        pcall(function() ppart.Color = strCol(it.col) end)
                    else
                        ppart.Color = Color3.fromRGB(175, 185, 200)
                    end
                    if it.trans then
                        ppart.Transparency = tonumber(it.trans) or 0
                    end
                    ppart.Parent = worldModel
                end

                local fov = (cam.FieldOfView and cam.FieldOfView > 0) and cam.FieldOfView or 70
                local fovRad = math.rad(fov / 2)
                local aspect = 4.0
                if vpf.AbsoluteSize.Y > 0 and vpf.AbsoluteSize.X > 0 then
                    aspect = math.max(1.0, vpf.AbsoluteSize.X / vpf.AbsoluteSize.Y)
                end
                local distV = (bSize.Y / (2 * math.tan(fovRad))) * 1.3
                local distH = (math.max(bSize.X, bSize.Z) / (2 * math.tan(fovRad) * aspect)) * 1.3
                local dist = math.max(distV, distH, (maxDim / (2 * math.tan(fovRad))) * 0.75)
                modelDist = math.clamp(dist, 5, 2500)
                countLbl.Text = "3D PREVIEW: " .. renderedCount .. " / " .. totalCount .. " BLOCKS"
                countLbl.TextColor3 = Colors.Text
            else
                countLbl.Text = "3D PREVIEW: EMPTY"
                countLbl.TextColor3 = Colors.Muted
                modelDist = 12
            end
            updateCameraPose()
        end

        local function destroy()
            if hbConn then pcall(function() hbConn:Disconnect() end); hbConn = nil end
            if previewCard then pcall(function() previewCard:Destroy() end) end
        end

        return {
