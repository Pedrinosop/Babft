    local function sfFill(blockName, bsz, layers)
        local needN = sfGetVertCount()
        if #sfVerts < needN then showNotification("Pick " .. needN .. " corners first! (button above)", "warn", 3) return end
        if isBuilding then showNotification("Build already running, wait!", "warn", 3) return end
        bsz, layers = sfGetParams()
        local myZone = getPlayerZone(LocalPlayer)
        if not myZone then showNotification("No zone!", "error", 3) return end
        equipAllTools()
        local ch = Character or LocalPlayer.Character
        local pTool = ch and ch:FindFirstChild("BuildingTool")
        if not pTool or not pTool:FindFirstChild("RF") then showNotification("Need BuildingTool!", "error", 3) return end

        local strips = sfComputeStrips(bsz, layers)
        local total = #strips
        if total == 0 then showNotification("Degenerate selection!", "warn", 3) return end
        if total > 2000 then showNotification("Too many strips (" .. total .. ")! Increase block size.", "error", 4) return end

        local blockType = tostring(blockName or "WoodBlock")
        if Settings.excludedBlocks and Settings.excludedBlocks[blockType] then
            showNotification(blockType .. " is excluded in settings!", "warn", 4)
            return
        end

        local sc = tonumber(Settings.buildScale) or 1
        if math.abs(sc) < 1e-6 then sc = 1 end
        local off = Vector3.new(tonumber(Settings.buildOffsetX) or 0, tonumber(Settings.buildOffsetY) or 0, tonumber(Settings.buildOffsetZ) or 0)
        local zoneInv = myZone.CFrame:Inverse()
        local entries = {}
        for i, st in ipairs(strips) do
            local rel = zoneInv * st.cf
            local rp = rel.Position
            local compPos = Vector3.new((rp.X - off.X) / sc, (rp.Y - off.Y) / sc, (rp.Z - off.Z) / sc)
            local compCF = CFrame.new(compPos) * (rel - rel.Position)
            entries[#entries + 1] = cfToAsuBlock(compCF, Vector3.new(st.size.X / sc, st.size.Y / sc, st.size.Z / sc), nil, i, 0)
        end

        showNotification("Polygon fill: " .. total .. " strips, placing...", "stage", 4)
        local fillOk, fillErr = pcall(function()
            pasteBuild({ [blockType] = entries }, function(msg, pct)
                setStatus("  SF " .. tostring(pct) .. "%: " .. tostring(msg))
            end)
        end)
        if not fillOk then
            showNotification("Polygon fill error: " .. tostring(fillErr), "error", 4)
        elseif not stopBuild then
            showNotification("Polygon fill done! " .. total .. " strips", "success", 3)
        end
    end

