    BuildStatusOverlay.Size = UDim2.new(0, 240, 0, 34)
    local initOverlayX = tonumber(Settings.buildOverlayPosX)
    local initOverlayY = tonumber(Settings.buildOverlayPosY)
    if initOverlayX and initOverlayY then
        BuildStatusOverlay.Position = UDim2.new(0, initOverlayX, 0, initOverlayY)
    else
        BuildStatusOverlay.Position = UDim2.new(0.5, -120, 1, -56)
    end
    BuildStatusOverlay.BackgroundColor3 = Colors.Primary
    BuildStatusOverlay.BackgroundTransparency = Settings.guiTransparency or 0.15
    BuildStatusOverlay.BorderSizePixel = 0
    BuildStatusOverlay.ZIndex = 500
    BuildStatusOverlay.Visible = false
    BuildStatusOverlay.Parent = ScreenGui
    local bsoCorner = Instance.new("UICorner"); bsoCorner.CornerRadius = UDim.new(0, 8); bsoCorner.Parent = BuildStatusOverlay
    local bsoStroke = Instance.new("UIStroke"); bsoStroke.Color = Colors.Border; bsoStroke.Thickness = 1; bsoStroke.Transparency = 0.75; bsoStroke.Parent = BuildStatusOverlay

    do
        local dragging = false
        local dragStart, startPos = nil, nil
        BuildStatusOverlay.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = BuildStatusOverlay.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
                local curX = startPos.X.Scale * vp.X + startPos.X.Offset + delta.X
                local curY = startPos.Y.Scale * vp.Y + startPos.Y.Offset + delta.Y
                local newX = math.clamp(curX, 0, vp.X - 245)
                local newY = math.clamp(curY, 20, vp.Y - 40)
                BuildStatusOverlay.Position = UDim2.new(0, newX, 0, newY)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if dragging then
                    dragging = false
                    Settings.buildOverlayPosX = BuildStatusOverlay.Position.X.Offset
                    Settings.buildOverlayPosY = BuildStatusOverlay.Position.Y.Offset
                    if saveSettings then pcall(saveSettings) end
                end
            end
        end)
