            local curW = MainFrame.Size.X.Offset
            local curH = MainFrame.Size.Y.Offset
            if curW > 50 and curH > 50 then
                mfPos = Vector2.new(curX, curY)
                mfSize = Vector2.new(curW, curH)
            end
        end
        local dockW = 50
        local dockH = 46
        local dockTotalW = 402
        local vpH = mfSize.Y

        DockContainer.AnchorPoint = Vector2.new(0, 0)

        if isVertical then
            DockContainer.AutomaticSize = Enum.AutomaticSize.None

            local dockOffsetY = 62
            local targetPosX = (dockMode == "attached_left") and (mfPos.X - dockW - 8) or (mfPos.X + mfSize.X + 8)
            local railH = math.max(vpH, 396)
            local railY = (vpH < 396) and (mfPos.Y + (vpH - railH) * 0.5) or (mfPos.Y + dockOffsetY)
            local targetPos = UDim2.new(0, targetPosX, 0, railY)
            local targetSize = UDim2.new(0, dockW, 0, railH)

            dockLayout.FillDirection = Enum.FillDirection.Vertical
            dockLayout.Padding = UDim.new(0, 4)
            dockLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            dockLayout.VerticalAlignment = Enum.VerticalAlignment.Center

            c1Layout.FillDirection = Enum.FillDirection.Vertical
            c2Layout.FillDirection = Enum.FillDirection.Vertical

            capsule1.AutomaticSize = Enum.AutomaticSize.None
            capsule2.AutomaticSize = Enum.AutomaticSize.None

            c1Grip.Text = "•••"
            c2Grip.Visible = false

            capsuleDivider.Visible = true

            local pc = Colors.Primary or Color3.fromRGB(20, 24, 31)
            local sc = Colors.Secondary or Color3.fromRGB(59, 130, 246)
            local border = Colors.Border or Color3.fromRGB(44, 50, 64)
            local panelSoft = Colors.PanelSoft or Color3.fromRGB(20, 22, 28)
            local themedBorder = border:Lerp(sc, 0.3)
            local railBg = panelSoft:Lerp(pc, 0.4)

            if morph then
                TweenService:Create(DockContainer, tweenInfo, {
                    Position = targetPos,
                    Size = targetSize,
                    BackgroundTransparency = 0.08,
                    BackgroundColor3 = railBg
                }):Play()
                TweenService:Create(dockStroke, tweenInfo, {
                    Transparency = 0.5,
                    Color = themedBorder
                }):Play()

                TweenService:Create(capsule1, tweenInfo, {
                    Size = UDim2.new(1, 0, 0, 184),
                    BackgroundTransparency = 1
                }):Play()
                TweenService:Create(capsule2, tweenInfo, {
                    Size = UDim2.new(1, 0, 0, 168),
                    BackgroundTransparency = 1
                }):Play()
                TweenService:Create(c1Corner, tweenInfo, {CornerRadius = UDim.new(0, 14)}):Play()
                TweenService:Create(c2Corner, tweenInfo, {CornerRadius = UDim.new(0, 14)}):Play()
                TweenService:Create(dockCorner, tweenInfo, {CornerRadius = UDim.new(0, 16)}):Play()
                TweenService:Create(c1Stroke, tweenInfo, {Transparency = 1}):Play()
                TweenService:Create(c2Stroke, tweenInfo, {Transparency = 1}):Play()
                TweenService:Create(c1Grip, tweenInfo, {Size = UDim2.new(0, 36, 0, 10)}):Play()
                TweenService:Create(capsuleDivider, tweenInfo, {BackgroundTransparency = 0.4, BackgroundColor3 = themedBorder}):Play()
            else
                if animate then
                    TweenService:Create(DockContainer, tweenInfo, {Position = targetPos, Size = targetSize}):Play()
                else
                    DockContainer.Position = targetPos
                    DockContainer.Size = targetSize
                end
                DockContainer.BackgroundColor3 = railBg
                DockContainer.BackgroundTransparency = (MainFrame and MainFrame.BackgroundTransparency) or Settings.guiTransparency or 0.15
                dockStroke.Transparency = 0.5
                dockStroke.Color = themedBorder

                capsule1.Size = UDim2.new(1, 0, 0, 184)
                capsule2.Size = UDim2.new(1, 0, 0, 168)
                c1Corner.CornerRadius = UDim.new(0, 14)
                c2Corner.CornerRadius = UDim.new(0, 14)
                dockCorner.CornerRadius = UDim.new(0, 16)
                capsule1.BackgroundTransparency = 1
                capsule2.BackgroundTransparency = 1
                c1Stroke.Transparency = 1
                c2Stroke.Transparency = 1
                c1Grip.Size = UDim2.new(0, 36, 0, 10)
                capsuleDivider.BackgroundTransparency = 0.4
                capsuleDivider.BackgroundColor3 = themedBorder
            end
        else
            local targetPos = UDim2.new(0.5, -dockTotalW * 0.5, 1, -dockH - 22)
            local targetSize = UDim2.new(0, dockTotalW, 0, dockH)

            local dockOffsetY = 62
            if dockMode == "attached_top" then
                targetPos = UDim2.new(0, mfPos.X + (mfSize.X - dockTotalW) * 0.5, 0, mfPos.Y - dockH - 8 + dockOffsetY)
            elseif dockMode == "attached_bottom" then
                targetPos = UDim2.new(0, mfPos.X + (mfSize.X - dockTotalW) * 0.5, 0, mfPos.Y + mfSize.Y + 8 + dockOffsetY)
            elseif dockMode == "detached_top" then
                targetPos = UDim2.new(0.5, -dockTotalW * 0.5, 0, 20)
            elseif dockMode == "detached_bottom" then
                targetPos = UDim2.new(0.5, -dockTotalW * 0.5, 1, -dockH - 22)
            elseif dockMode == "detached_free" and customPos then
                targetPos = UDim2.new(0, customPos.X.Offset - dockTotalW * 0.5, 0, customPos.Y.Offset - dockH * 0.5)
            end

            dockLayout.FillDirection = Enum.FillDirection.Horizontal
            dockLayout.Padding = UDim.new(0, 10)
            dockLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
            dockLayout.VerticalAlignment = Enum.VerticalAlignment.Center

            c1Layout.FillDirection = Enum.FillDirection.Horizontal
            c2Layout.FillDirection = Enum.FillDirection.Horizontal

            c1Grip.Text = ":::"
            c2Grip.Visible = true

            local pc = Colors.Primary or Color3.fromRGB(20, 24, 31)
            local sc = Colors.Secondary or Color3.fromRGB(59, 130, 246)
            local border = Colors.Border or Color3.fromRGB(44, 50, 64)
            local panelSoft = Colors.PanelSoft or Color3.fromRGB(20, 22, 28)
            local themedBorder = border:Lerp(sc, 0.3)
            local capBg = panelSoft:Lerp(pc, 0.35)

            if morph then
                TweenService:Create(DockContainer, tweenInfo, {
                    Position = targetPos,
                    Size = targetSize,
                    BackgroundTransparency = 1
                }):Play()
                TweenService:Create(dockStroke, tweenInfo, {Transparency = 1}):Play()

                capsule1.BackgroundColor3 = capBg
                capsule2.BackgroundColor3 = capBg
                c1Stroke.Color = themedBorder
                c2Stroke.Color = themedBorder

                TweenService:Create(capsule1, tweenInfo, {
                    Size = UDim2.new(0, 196, 0, 46),
                    BackgroundTransparency = 0.08
                }):Play()
                TweenService:Create(capsule2, tweenInfo, {
                    Size = UDim2.new(0, 196, 0, 46),
                    BackgroundTransparency = 0.08
                }):Play()
                TweenService:Create(c1Corner, tweenInfo, {CornerRadius = UDim.new(0, 22)}):Play()
                TweenService:Create(c2Corner, tweenInfo, {CornerRadius = UDim.new(0, 22)}):Play()
                TweenService:Create(c1Stroke, tweenInfo, {Transparency = 0.5, Color = themedBorder}):Play()
                TweenService:Create(c2Stroke, tweenInfo, {Transparency = 0.5, Color = themedBorder}):Play()
                TweenService:Create(c1Grip, tweenInfo, {Size = UDim2.new(0, 16, 0, 36)}):Play()
                TweenService:Create(c2Grip, tweenInfo, {Size = UDim2.new(0, 16, 0, 36)}):Play()
                TweenService:Create(capsuleDivider, tweenInfo, {BackgroundTransparency = 1}):Play()

                task.delay(animTime, function()
                    if not (dockMode == "attached_left" or dockMode == "attached_right") then
                        capsuleDivider.Visible = false
                    end
                end)
            else
                if animate then
                    TweenService:Create(DockContainer, tweenInfo, {Position = targetPos, Size = targetSize}):Play()
                else
                    DockContainer.Position = targetPos
                    DockContainer.Size = targetSize
                end
                DockContainer.BackgroundTransparency = 1
                dockStroke.Transparency = 1
                capsuleDivider.Visible = false

                capsule1.BackgroundColor3 = capBg
                capsule2.BackgroundColor3 = capBg
                local curTransp = (MainFrame and MainFrame.BackgroundTransparency) or Settings.guiTransparency or 0.15
                capsule1.BackgroundTransparency = curTransp
                capsule2.BackgroundTransparency = curTransp
                c1Stroke.Color = themedBorder
                c2Stroke.Color = themedBorder
                c1Stroke.Transparency = 0.5
                c2Stroke.Transparency = 0.5

                c1Corner.CornerRadius = UDim.new(0, 22)
                c2Corner.CornerRadius = UDim.new(0, 22)
                c1Grip.Size = UDim2.new(0, 16, 0, 36)
                c2Grip.Size = UDim2.new(0, 16, 0, 36)

                capsule1.Size = UDim2.new(0, 196, 0, 46)
                capsule2.Size = UDim2.new(0, 196, 0, 46)
            end
        end
    end

    applyDockLayout(dockMode)

    MainFrame:GetPropertyChangedSignal("Visible"):Connect(function()
        local dock = DockContainer or (ScreenGui and ScreenGui:FindFirstChild("SPRB_DockContainer"))
        if dock then
            dock.Visible = MainFrame.Visible
            if MainFrame.Visible and updateAttachedPosition then
                task.defer(updateAttachedPosition)
            end
        end
    end)

    MainFrame:GetPropertyChangedSignal("Position"):Connect(function()
        if isDockAttached() and MainFrame.Visible then
            updateAttachedPosition()
        end
    end)
    MainFrame:GetPropertyChangedSignal("Size"):Connect(function()
        if isDockAttached() and MainFrame.Visible then
            updateAttachedPosition()
        end
    end)
    MainFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
        if isDockAttached() and MainFrame.Visible then
            updateAttachedPosition()
        end
    end)
    MainFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if isDockAttached() and MainFrame.Visible then
            updateAttachedPosition()
        end
    end)

    do
        local dockDragging = false
        local dockDragStart = Vector2.new()
        local dockStartPos = UDim2.new()
        local inputStartPos = Vector2.new()
        local hasMovedEnough = false

        local currentActiveSnap = nil

        local function getCursorSnapZone(pos)
            if not MainFrame.Visible then return nil end
            local mfPos = MainFrame.AbsolutePosition
            local mfSize = MainFrame.AbsoluteSize
            local curX, curY = pos.X, pos.Y

            local dockOffsetY = 62

            if curX >= mfPos.X - 120 and curX <= mfPos.X + 80 and curY >= mfPos.Y + dockOffsetY - 40 and curY <= mfPos.Y + mfSize.Y + dockOffsetY + 40 then
                return "left"

            elseif curX >= mfPos.X + mfSize.X - 80 and curX <= mfPos.X + mfSize.X + 140 and curY >= mfPos.Y + dockOffsetY - 40 and curY <= mfPos.Y + mfSize.Y + dockOffsetY + 40 then
                return "right"

            elseif curY >= mfPos.Y + dockOffsetY - 100 and curY <= mfPos.Y + dockOffsetY + 60 and curX >= mfPos.X - 60 and curX <= mfPos.X + mfSize.X + 60 then
                return "top"

            elseif curY >= mfPos.Y + mfSize.Y + dockOffsetY - 60 and curY <= mfPos.Y + mfSize.Y + dockOffsetY + 110 and curX >= mfPos.X - 60 and curX <= mfPos.X + mfSize.X + 60 then
                return "bottom"
            end
            return nil
        end

        local function handleDockInput(inp)
            if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
            dockDragging = false
            hasMovedEnough = false
            currentActiveSnap = nil
            inputStartPos = Vector2.new(inp.Position.X, inp.Position.Y)
            local curAbs = DockContainer.AbsolutePosition
            dockStartPos = UDim2.new(0, curAbs.X, 0, curAbs.Y)
            dockDragStart = inputStartPos
        end

        capsule1.InputBegan:Connect(handleDockInput)
        capsule2.InputBegan:Connect(handleDockInput)
        c1Grip.InputBegan:Connect(handleDockInput)
        c2Grip.InputBegan:Connect(handleDockInput)

        local function toggleDockModeClick()
            if dockMode == "attached_left" or dockMode == "attached_right" then
                applyDockLayout("attached_bottom", nil, true)
            else
                applyDockLayout("attached_left", nil, true)
            end
        end

        UserInputService.InputChanged:Connect(function(inp)
            if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
            if not inputStartPos or inputStartPos.Magnitude == 0 then return end
            local curPos = Vector2.new(inp.Position.X, inp.Position.Y)
            if not hasMovedEnough then
                if (curPos - inputStartPos).Magnitude > 6 then
                    hasMovedEnough = true
                    dockDragging = true
                    if isDockAttached() then
                        local curAbs = DockContainer.AbsolutePosition
                        local curCenter = curAbs + DockContainer.AbsoluteSize * 0.5
                        applyDockLayout("detached_free", UDim2.new(0, curCenter.X, 0, curCenter.Y), false)
                    end
                    local curAbs = DockContainer.AbsolutePosition
                    dockStartPos = UDim2.new(0, curAbs.X, 0, curAbs.Y)
                    DockContainer.Position = dockStartPos
                    dockDragStart = curPos
                    setSnapZonesVisible(true)
                end
            end
            if dockDragging then
                local dx = curPos.X - dockDragStart.X
                local dy = curPos.Y - dockDragStart.Y
                DockContainer.Position = UDim2.new(0, dockStartPos.X.Offset + dx, 0, dockStartPos.Y.Offset + dy)

                currentActiveSnap = getCursorSnapZone(curPos)
                if not currentActiveSnap then
                    local dockCenter = DockContainer.AbsolutePosition + DockContainer.AbsoluteSize * 0.5
                    currentActiveSnap = getClosestSnapZone(dockCenter)
                end
                highlightSnapZone(currentActiveSnap)
            end
        end)

        local function handleInputEnd(inp)
            if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and inp.UserInputType ~= Enum.UserInputType.Touch then return end
            if not inputStartPos or inputStartPos.Magnitude == 0 then return end
            local wasDragging = dockDragging
            dockDragging = false
            inputStartPos = Vector2.new()
            setSnapZonesVisible(false)

            if not wasDragging then
                return
            end

            local curPos = Vector2.new(inp.Position.X, inp.Position.Y)
            local targetSnap = currentActiveSnap or getCursorSnapZone(curPos)
            if not targetSnap then
                local dockCenter = DockContainer.AbsolutePosition + DockContainer.AbsoluteSize * 0.5
                targetSnap = getClosestSnapZone(dockCenter)
            end
            currentActiveSnap = nil
            local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)

            if targetSnap == "left" then
                applyDockLayout("attached_left", nil, true)
            elseif targetSnap == "right" then
                applyDockLayout("attached_right", nil, true)
            elseif targetSnap == "top" then
                applyDockLayout("attached_top", nil, true)
            elseif targetSnap == "bottom" then
                applyDockLayout("attached_bottom", nil, true)
            elseif curPos.Y < vp.Y * 0.20 then
                applyDockLayout("detached_top", nil, true)
            elseif curPos.Y > vp.Y * 0.80 then
                applyDockLayout("detached_bottom", nil, true)
            else
                local dockCenter = DockContainer.AbsolutePosition + DockContainer.AbsoluteSize * 0.5
                applyDockLayout("detached_free", UDim2.new(0, dockCenter.X, 0, dockCenter.Y), true)
            end
        end

        UserInputService.InputEnded:Connect(handleInputEnd)
        c1Grip.MouseButton1Click:Connect(function()
            if not hasMovedEnough then toggleDockModeClick() end
        end)
        c2Grip.MouseButton1Click:Connect(function()
            if not hasMovedEnough then toggleDockModeClick() end
        end)
    end
    end

function createUI()
    _langUpdateCallbacks = {}

    tween = nil; bump = nil; stylizeCard = nil; makeTab = nil
    makeBtn = nil; makeInput = nil; makeLabel = nil; makeSlider = nil; makeRangeSlider = nil
    makeColorPicker = nil; makeNumInput = nil; makeDropdown = nil
    makeExSub = nil; makeBuildSub = nil

    local ScreenGui = Instance.new("ScreenGui")
    DockContainer = nil
    updateAttachedPosition = nil
    applyDockLayout = nil
    _G.SPRB_ScreenGui = ScreenGui
    ScreenGui.Name = "SPRBBuilder"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    ScreenGui.IgnoreGuiInset = true

    local function stylizeScrollbar(sf)
        if not sf or not sf:IsA("ScrollingFrame") then return end
        sf.BorderSizePixel = 0
        sf.ScrollBarThickness = 0
        sf.VerticalScrollBarInset = Enum.ScrollBarInset.None
    end

    ScreenGui.DescendantAdded:Connect(function(desc)
        if desc:IsA("ScrollingFrame") then
            stylizeScrollbar(desc)
            desc:GetPropertyChangedSignal("ScrollBarThickness"):Connect(function()
                if desc.ScrollBarThickness > 0 then
                    desc.ScrollBarThickness = 0
                end
            end)
        end
    end)

    initNotifications(ScreenGui)

    local DropdownLayer = Instance.new("Frame")
    DropdownLayer.Name = "DropdownLayer"
    DropdownLayer.Size = UDim2.new(1, 0, 1, 0)
    DropdownLayer.BackgroundTransparency = 1
    DropdownLayer.BorderSizePixel = 0
    DropdownLayer.ZIndex = 500
    DropdownLayer.Parent = ScreenGui
    local activeDropdownClose = nil

    local baseW = 460
    local baseH = 440

    local isMobileMode = Settings.mobileMode
    if isMobileMode then Settings.uiScale = math.min(Settings.uiScale, 0.78) end
    syncColors()

    function tween(obj, a, b, c, d)
        if typeof(a) == "TweenInfo" then
            return TweenService:Create(obj, a, b)
        elseif type(a) == "table" then
            local dur = (type(b) == "number" and b) or 0.3
            local ti = TweenInfo.new(dur, c or Enum.EasingStyle.Quint, d or Enum.EasingDirection.Out)
            local tw = TweenService:Create(obj, ti, a)
            tw:Play()
            return tw
        end
        return TweenService:Create(obj, a, b)
    end

    function bump(btn, scale)
        local uiScale = btn:FindFirstChild("HoverScale")
        if not uiScale then
            uiScale = Instance.new("UIScale")
            uiScale.Name = "HoverScale"
            uiScale.Scale = 1
            uiScale.Parent = btn
        end
        tween(uiScale, TweenInfo.new(0.14, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = scale}):Play()
    end

    function stylizeCard(obj, bgColor, strokeColor, corner)
        local isBtn = obj:IsA("GuiButton")
        obj.BackgroundColor3 = bgColor or (isBtn and Colors.PanelElevated or Colors.Panel)
        obj.BackgroundTransparency = isBtn and (Settings.btnTransparency or 0) or (Settings.guiTransparency or 0.15)
        obj.BorderSizePixel = 0
        local c = obj:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, corner or 12)
        c.Parent = obj
        local s = obj:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
        s.Name = "SPRB_ThemedStroke"
        s.Color = strokeColor or Colors.Border
        s.Transparency = 0.78
        s.Thickness = 1.0
        s.Parent = obj

        if isBtn and not obj:FindFirstChild("SPRB_HoverAdded") and not obj:GetAttribute("SkipDefaultHover") then
            local tag = Instance.new("BoolValue")
            tag.Name = "SPRB_HoverAdded"
            tag.Parent = obj

            obj.MouseEnter:Connect(function()
                bump(obj, 1.02)
                if obj.BackgroundColor3 == Colors.Panel then
                    tween(obj, TweenInfo.new(0.12), {BackgroundColor3 = Colors.PanelElevated})
                end
                tween(s, TweenInfo.new(0.12), {Transparency = 0.45, Color = Colors.Border})
            end)
            obj.MouseLeave:Connect(function()
                bump(obj, 1.0)
                if obj.BackgroundColor3 == Colors.PanelElevated then
                    tween(obj, TweenInfo.new(0.12), {BackgroundColor3 = Colors.Panel})
                end
                tween(s, TweenInfo.new(0.12), {Transparency = 0.78, Color = Colors.Border})
            end)
        end
        return c, s
    end

    local OpenBtn = nil
    local MinBtn = nil
