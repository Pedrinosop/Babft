        local function getRect(obj)
            if not obj or not obj.Parent then return nil end
            local p = obj.AbsolutePosition
            local s = obj.AbsoluteSize
            if s.X <= 0 or s.Y <= 0 then return nil end
            return {x1 = p.X, y1 = p.Y, x2 = p.X + s.X, y2 = p.Y + s.Y}
        end

        local function isOverlapping(r1, r2)
            if not r1 or not r2 then return false end
            return not (r1.x2 < r2.x1 or r1.x1 > r2.x2 or r1.y2 < r2.y1 or r1.y1 > r2.y2)
        end

        local function calcDodgePosition(targetObj, origPos, mfRect, viewport)
            local pRect = getRect(targetObj)
            if not pRect or not isOverlapping(mfRect, pRect) then
                return origPos
            end

            local pSize = targetObj.AbsoluteSize
            local parentAbs = (targetObj.Parent and targetObj.Parent:IsA("GuiObject")) and targetObj.Parent.AbsolutePosition or Vector2.zero
            local vw = viewport.X
            local vh = viewport.Y
            local tw = pSize.X
            local th = pSize.Y

            local destAbsX = pRect.x1
            local destAbsY = pRect.y1

            if (mfRect.y2 + 12 + th) <= (vh - 10) then
                destAbsY = mfRect.y2 + 12
                destAbsX = math.clamp(pRect.x1, 10, vw - tw - 10)
            else

                local leftSpace = mfRect.x1 - 12
                local rightSpace = vw - (mfRect.x2 + 12)
                if leftSpace >= (tw + 10) then
                    destAbsX = mfRect.x1 - 12 - tw
                    destAbsY = math.clamp(pRect.y1, 10, vh - th - 10)
                elseif rightSpace >= (tw + 10) then
                    destAbsX = mfRect.x2 + 12
                    destAbsY = math.clamp(pRect.y1, 10, vh - th - 10)
                elseif (mfRect.y1 - 12 - th) >= 10 then

                    destAbsY = mfRect.y1 - 12 - th
                    destAbsX = math.clamp(pRect.x1, 10, vw - tw - 10)
                else

                    destAbsX = (leftSpace >= rightSpace) and 10 or (vw - tw - 10)
                    destAbsY = 10
                end
            end

            destAbsX = math.clamp(destAbsX, 10, vw - tw - 10)
            destAbsY = math.clamp(destAbsY, 10, vh - th - 10)

            local localX = destAbsX - parentAbs.X
            local localY = destAbsY - parentAbs.Y
            return UDim2.new(0, localX, 0, localY)
        end

