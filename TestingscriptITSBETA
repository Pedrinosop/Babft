local _SPRB_EMBEDDED_MASCOT_B64 = ""

function spBase64Decode(data)
    local b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local t = {}
    for i = 1, #b do t[b:byte(i)] = i - 1 end
    local out = {}
    local len = #data
    local i = 1
    while i <= len do
        local c1, c2, c3, c4 = data:byte(i, i + 3)
        if not c1 then break end
        local v1 = t[c1] or 0
        local v2 = t[c2] or 0
        local v3 = t[c3] or 0
        local v4 = t[c4] or 0
        local b1 = bit32.bor(bit32.lshift(v1, 2), bit32.rshift(v2, 4))
        out[#out + 1] = string.char(b1)
        if c3 and c3 ~= 61 then
            local b2 = bit32.bor(bit32.lshift(bit32.band(v2, 15), 4), bit32.rshift(v3, 2))
            out[#out + 1] = string.char(b2)
            if c4 and c4 ~= 61 then
                local b3 = bit32.bor(bit32.lshift(bit32.band(v3, 3), 6), v4)
                out[#out + 1] = string.char(b3)
            end
        end
        i = i + 4
    end
    return table.concat(out)
end

