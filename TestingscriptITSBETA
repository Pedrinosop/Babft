            b.BorderSizePixel = 0
            b.Text = txt
            b.TextColor3 = Settings.secondaryColor or Color3.fromRGB(59, 130, 246)
            b.TextSize = 15
        b.Font = SPRB_FONT
            b.ZIndex = 5
            b.Parent = cont
            local _, bs = stylizeCard(b, Colors.PanelElevated, Settings.secondaryColor or Color3.fromRGB(59, 130, 246), 3)
            if bs then bs.Name = "SPRB_ThemedStroke"; bs.Transparency = 0.4 end
            b.MouseButton1Click:Connect(function()
                applyVal(currentVal + delta, true)
                playUISound(UISoundConfig.click)
            end)
            return b
        end

        stepBtn("-", 0.74, -step)
        stepBtn("+", 0.86, step)
        valLbl.FocusLost:Connect(function()

            local raw = valLbl.Text:gsub("[^%d%.%-]", "")
            local n = tonumber(raw)
            if n then
                applyVal(n, true)
            else
                valLbl.Text = fmtFn and fmtFn(currentVal) or tostring(currentVal)
            end
        end)

        local function setVal(v)
            applyVal(v, false)
        end

        return cont, setVal, function() return currentVal end
    end

