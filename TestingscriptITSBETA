    local _convRefreshCb = nil
    local _convForceStatusPending = false
    local function convCountReal(opts)
        local count = 0
        if type(opts) == "table" then
            for _, o in ipairs(opts) do
                if type(o) == "table" and o.name and o.name ~= "" then count = count + 1 end
            end
        end
        return count
    end
    local function getConverterFileOptions(force)
        if not force and _convFilesCache and _convFilesLoaded and (os.clock() - _convFilesCacheTime) < 300 then
            return _convFilesCache
        end
        if _convFilesLoading then
            return _convFilesCache or {{display = "Loading files..."}}
        end
        if force then
            _convFilesCache = nil
            _convFilesLoaded = false
        end
        _convFilesLoading = true
        task.spawn(function()

            local okScan, scanErr = pcall(function()
                ensureFolder()
                local files = {}
                local seenFiles = {}
                local function scanDir(dir, depth)
                    if depth > 3 then return end
                    local okF, items

                    for attempt = 1, 3 do
                        okF, items = pcall(listfiles, dir)
                        if okF and type(items) == "table" then break end
                        if attempt < 3 then task.wait(0.07) end
                    end
                    if okF and type(items) == "table" then
                        for _, fp in ipairs(items) do
                            local fps = tostring(fp)
                            if isfolder(fps) then
                                scanDir(fps, depth + 1)
                            else
                                local low = fps:lower()
                                if low:match("%.json$") or low:match("%.obj$") or low:match("%.schem$") or low:match("%.schematic$") or low:match("%.mid$") or low:match("%.midi$") then
                                    if not seenFiles[fps] then
                                        seenFiles[fps] = true
                                        local name = fps:match("([^/\\]+)$") or fps
                                        local parent = getParentDir(fp) or dir
                                        local display = (parent == "." or parent == FOLDER_PATH) and name or (name .. "  [" .. parent:gsub(FOLDER_PATH .. "/", "") .. "]")
                                        files[#files + 1] = {name = fp, display = display}
                                    end
                                end
                            end
                        end
                        task.wait()
                    end
                end
                scanDir(FOLDER_PATH, 0)
                table.sort(files, function(a, b) return tostring(a.display):lower() < tostring(b.display):lower() end)
                local objList, jsonList, schemList, midiList, otherList = {}, {}, {}, {}, {}
                for _, f in ipairs(files) do
                    local low = tostring(f.name):lower()
                    if low:match("%.obj$") then
                        table.insert(objList, f)
                    elseif low:match("%.json$") then
                        table.insert(jsonList, f)
                    elseif low:match("%.schem") then
                        table.insert(schemList, f)
                    elseif low:match("%.mid") then
                        table.insert(midiList, f)
                    else
                        table.insert(otherList, f)
                    end
                end
                local organized = {}
                if #objList > 0 then
                    table.insert(organized, {display = "--- 3D MESHES (.obj) ---", isSection = true, name = ""})
                    for _, it in ipairs(objList) do table.insert(organized, it) end
                end
                if #jsonList > 0 then
                    table.insert(organized, {display = "--- IMAGE BUILDS (.json) ---", isSection = true, name = ""})
                    for _, it in ipairs(jsonList) do table.insert(organized, it) end
                end
                if #schemList > 0 then
                    table.insert(organized, {display = "--- SCHEMATICS (.schem) ---", isSection = true, name = ""})
                    for _, it in ipairs(schemList) do table.insert(organized, it) end
                end
                if #midiList > 0 then
                    table.insert(organized, {display = "--- MIDI FILES (.mid) ---", isSection = true, name = ""})
                    for _, it in ipairs(midiList) do table.insert(organized, it) end
                end
                if #otherList > 0 then
                    table.insert(organized, {display = "--- OTHER FILES ---", isSection = true, name = ""})
                    for _, it in ipairs(otherList) do table.insert(organized, it) end
                end
                if #organized > 0 then
                    files = organized
                end
                if #files == 0 then
                    files = {{name = "", display = "No converter files found"}}
                end
                _convFilesCache = files
                _convFilesCacheTime = os.clock()
            end)
            if okScan then
                _convFilesLoaded = true
            else

                _convFilesLoaded = _convFilesCache ~= nil
            end
            _convFilesLoading = false
            if _convForceStatusPending then
                _convForceStatusPending = false
                setStatus("  Converter file list refreshed: " .. convCountReal(_convFilesCache))
            end
            if _convRefreshCb then _convRefreshCb() end
        end)
        return (_convFilesLoaded and _convFilesCache) and _convFilesCache or {{display = "Loading files..."}}
    end
    local function setConvRefreshCb(cb) _convRefreshCb = cb end
