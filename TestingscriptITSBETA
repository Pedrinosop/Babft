local function runLoader()
    local loader = makeLoadingGui()
    dbg("Loader started")

    loader.setProgress(0.05, "Preparing...", "Initial delay")
    task.wait(0.5)

    loader.setProgress(0.20, "Loading settings...", "Reading config")
    dbg("Stage 1: settings")
    pcall(ensureFolder)
    pcall(loadSettings)
    pcall(syncColors)
    pcall(saveSettings)
    task.wait(0.5)

    loader.setProgress(0.45, "Building interface...", "Creating UI elements")
    dbg("Stage 2: createUI start")
    task.wait(0.4)

    local uiOk, uiErr = xpcall(function()
        UI = createUI()
    end, function(err)
        local tb = debug.traceback(tostring(err), 2)
        return tb
    end)
    if not uiOk then
        dbg("createUI ERROR:\n" .. tostring(uiErr))
        loader.setError(uiErr)
        task.wait(5)
        loader.fadeOut()
        return
    end
    dbg("Stage 2: createUI done")

    if _G._afterCreateUI then
        for _, cb in ipairs(_G._afterCreateUI) do
            cb()
        end
        _G._afterCreateUI = nil
    end
    loader.setProgress(0.85, "Finalizing...", "Starting services")
    task.wait(0.6)

    loader.setProgress(1.0, "Ready!", "SPRB loaded successfully")
    dbg("Loader complete")
    task.wait(1.0)
    loader.fadeOut()
    task.wait(0.25)
    if _SPRB_ShowGUI then
        _SPRB_ShowGUI()
    end

end

runLoader()
end

