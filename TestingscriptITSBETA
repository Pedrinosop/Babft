            local balls = {}
            local bCount = math.clamp(count, 4, 30)
            local animSize = Settings.bgAnimSize or 1.0
            local autoColor = Settings.bgAnimAutoColor
            local h, s, v0 = Color3.toHSV(animColor)
            for i = 1, bCount do
                local sz = math.clamp(math.random(10, 30) * animSize, 6, 120)
                local b = Instance.new("Frame")
                b.Name = "SPRB_Ball_" .. i
                b.Size = UDim2.new(0, sz, 0, sz)
                b.Position = UDim2.new(math.random() * 0.8 + 0.1, 0, math.random() * 0.8 + 0.1, 0)
                b.BackgroundColor3 = animColor
                b.BackgroundTransparency = 0.82
                b.BorderSizePixel = 0
                b.ZIndex = 0
                b.Parent = container
                local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(1, 0); cr.Parent = b

                local ballHueOff = (i / bCount) * 0.15
                balls[i] = {
                    frame = b,
                    vx = (math.random() - 0.5) * 0.3 * speed,
                    vy = (math.random() - 0.5) * 0.3 * speed,
                    size = sz,
                    hueOff = ballHueOff,
                }
            end

            local conn
            local _gridDtAccum = 0
            conn = RunService.RenderStepped:Connect(function(dt)
                if not container or not container.Parent or not MainFrame_ref.Visible then
                    if not container or not container.Parent then
                        pcall(function() conn:Disconnect() end)
                    end
                    return
                end
                _gridDtAccum = _gridDtAccum + dt
                if _gridDtAccum < 0.033 then return end
                _gridDtAccum = 0
                local absW = container.AbsoluteSize.X
                local absH = container.AbsoluteSize.Y
                if absW < 1 or absH < 1 then return end

                local curH = h
                if autoColor then
                    local phase = (os.clock() * 0.04) % 1
                    local shift = math.sin(phase * math.pi * 2) * 0.08
                    local compShift = math.sin(phase * math.pi * 2 + math.pi) * 0.04
                    curH = (h + shift + compShift) % 1
                end

                for _, bl in ipairs(balls) do
                    local f = bl.frame
                    local px = f.Position.X.Scale + bl.vx * dt
                    local py = f.Position.Y.Scale + bl.vy * dt
                    local szX = bl.size / absW
                    local szY = bl.size / absH
                    if px - szX / 2 < 0 then bl.vx = math.abs(bl.vx); px = szX / 2
                    elseif px + szX / 2 > 1 then bl.vx = -math.abs(bl.vx); px = 1 - szX / 2 end
                    if py - szY / 2 < 0 then bl.vy = math.abs(bl.vy); py = szY / 2
                    elseif py + szY / 2 > 1 then bl.vy = -math.abs(bl.vy); py = 1 - szY / 2 end
                    f.Position = UDim2.new(px, 0, py, 0)

                    if autoColor then
                        f.BackgroundColor3 = Color3.fromHSV((curH + bl.hueOff) % 1, s, v0)
                    end
                end
            end)
            table.insert(_bgConns, conn)
        end
    end

    for _, c in pairs(MainFrame_ref:GetChildren()) do
        if c:IsA("GuiObject") and c.ZIndex < 1 and not c.Name:find("^SPRB_") then
            c.ZIndex = 1
        end
    end
end

function playUISound(soundId, customPitch, customVol)
    if not soundId or soundId == "" then return end
    task.spawn(function()
        local s = Instance.new("Sound")
        s.SoundId = soundId
        local baseVol = UISoundConfig.volume or 0.25
        local finalVol = customVol or baseVol
        local finalPitch = customPitch or 1.0

        if soundId == UISoundConfig.hover then
            finalVol = (customVol or baseVol) * 0.2
            finalPitch = customPitch or 1.5
        elseif soundId == UISoundConfig.click then
            finalVol = (customVol or baseVol) * 0.7
            finalPitch = customPitch or 1.1
        elseif soundId == UISoundConfig.open then
            finalVol = (customVol or baseVol) * 0.8
            finalPitch = customPitch or 1.15
        elseif soundId == UISoundConfig.close then
            finalVol = (customVol or baseVol) * 0.6
            finalPitch = customPitch or 0.9
        elseif soundId == UISoundConfig.success then
            finalVol = (customVol or baseVol) * 0.9
            finalPitch = customPitch or 1.2
        elseif soundId == UISoundConfig.error then
            finalVol = (customVol or baseVol) * 0.65
            finalPitch = customPitch or 0.8
        end

        s.Volume = finalVol
        s.PlaybackSpeed = finalPitch
        s.Parent = game:GetService("SoundService")
        s.Ended:Connect(function()
            pcall(function() s:Destroy() end)
        end)
        pcall(function() s:Play() end)
        task.delay(1.5, function()
            if s and s.Parent then pcall(function() s:Destroy() end) end
        end)
    end)
end

_cachedSearchPaths = nil

function scanAllFolders(maxDepth)
    local paths, seen = {}, {}
    local function scanRecursive(basePath, depth)
        if depth <= 0 then return end
        local ok, items = pcall(listfiles, basePath)
        if not ok or type(items) ~= "table" then return end
        for _, fp in ipairs(items) do
            if type(fp) == "string" and isfolder(fp) and not seen[fp] then
                seen[fp] = true
                paths[#paths + 1] = fp
                scanRecursive(fp, depth - 1)
            end
        end
    end
    scanRecursive(".", maxDepth or 2)
    return paths
end

function getBuildSearchPaths()
    if _cachedSearchPaths then return _cachedSearchPaths end
    local paths, seen = {}, {}
    for _, path in ipairs(BUILD_SEARCH_PATHS) do
        if not seen[path] then
            paths[#paths + 1] = path
            seen[path] = true
        end
    end
    if not seen[FOLDER_PREFIX] then
        paths[#paths + 1] = FOLDER_PREFIX
    end

    local allFolders = scanAllFolders(2)
    for _, fp in ipairs(allFolders) do
        if not seen[fp] then
            paths[#paths + 1] = fp
            seen[fp] = true
        end
    end
    _cachedSearchPaths = paths
    return paths
end

function invalidateSearchCache()
    _cachedSearchPaths = nil
end

function loadSettings()
    local raw = ""
    local paths = {
        FOLDER_PREFIX .. SETTINGS_PATH,
        SETTINGS_PATH,
        FOLDER_PREFIX .. "SPRB_Settings.json",
        "SPRB_Settings.json"
    }
    for _, p in ipairs(paths) do
        local ok, res = pcall(function() return readfile(p) end)
        if ok and type(res) == "string" and #res > 0 then
            local testData
            local okTest = pcall(function() testData = HttpService:JSONDecode(res) end)
            if okTest and type(testData) == "table" then
                raw = res
                break
            end
        end
    end
    if type(raw) ~= "string" or #raw == 0 then
        return
    end
    local data
    local ok2, err2 = pcall(function() data = HttpService:JSONDecode(raw) end)
    if not ok2 or type(data) ~= "table" then
        return
    end

    for k, v in pairs(data) do
        pcall(function()
            if Settings[k] == nil then return end
            if typeof(Settings[k]) == "Color3" or (Settings_DEFAULTS[k] and typeof(Settings_DEFAULTS[k]) == "Color3") then
                if type(v) == "table" then
                    local r = tonumber(v.R or v.r or v[1]) or 0
                    local g = tonumber(v.G or v.g or v[2]) or 0
                    local b = tonumber(v.B or v.b or v[3]) or 0
                    if r > 1 or g > 1 or b > 1 then
                        r = r / 255; g = g / 255; b = b / 255
                    end
                    r = math.clamp(r, 0, 1)
                    g = math.clamp(g, 0, 1)
                    b = math.clamp(b, 0, 1)
                    Settings[k] = Color3.new(r, g, b)
                end
            elseif type(v) ~= "table" then
                local tv = type(v)
                local sk = type(Settings[k])
                if (sk == "number" and tv == "number") or (sk == "string" and tv == "string") or (sk == "boolean" and tv == "boolean") then
                    Settings[k] = v
                end
            elseif type(Settings[k]) == "table" then
                Settings[k] = v
            end
        end)
    end
    Settings.blockReplacements = {}

    for k, v in pairs(Settings) do
        pcall(function()
            if Settings_DEFAULTS[k] and typeof(Settings_DEFAULTS[k]) == "Color3" and typeof(v) ~= "Color3" then
                Settings[k] = Settings_DEFAULTS[k]
            end
        end)
    end

    if Settings.secondaryColor then
        Settings.accentColor = Settings.secondaryColor
    end

    if Settings.font and Enum.Font[Settings.font] then
        SPRB_FONT = Enum.Font[Settings.font]
        _G.SPRB_FONT = SPRB_FONT
    end
    if Settings.bgMode == "image" then Settings.bgMode = "default" end
    if type(Settings.guiTransparency) == "number" then
        Settings.guiTransparency = math.clamp(Settings.guiTransparency, 0, 0.95)
    end
    if type(Settings.btnTransparency) == "number" then
        Settings.btnTransparency = math.clamp(Settings.btnTransparency, 0, 0.95)
    end
    if type(Settings.uiScale) == "number" then
        Settings.uiScale = math.clamp(Settings.uiScale, 0.35, 2.0)
    end
    if type(Settings.buildScale) == "number" then
        Settings.buildScale = math.clamp(Settings.buildScale, 0.1, 10)
    end
end

local _saveSettingsThread = nil

function saveSettings(immediate)
    local function doSave()
        Settings.accentColor = Settings.secondaryColor
        local d = {}
        for k, v in pairs(Settings) do
            if k == "blockReplacements" then continue end
            if typeof(v) == "Color3" then
                local r = math.clamp(v.R, 0, 1)
                local g = math.clamp(v.G, 0, 1)
                local b = math.clamp(v.B, 0, 1)
                d[k] = {r, g, b}
            elseif type(v) == "table" then
                local safe = true
                local clean = {}
                for tk, tv in pairs(v) do
                    local tvt = type(tv)
                    if tvt == "string" or tvt == "number" or tvt == "boolean" then
                        clean[tk] = tv
                    else
                        safe = false; break
                    end
                end
                if safe then d[k] = clean end
            elseif type(v) == "string" or type(v) == "number" or type(v) == "boolean" then
                d[k] = v
            end
        end
        local ok, json = pcall(function() return HttpService:JSONEncode(d) end)
        if ok and type(json) == "string" and #json > 0 then
            pcall(ensureFolder)
            pcall(function()
                if writefile then
                    pcall(function() writefile(FOLDER_PREFIX .. SETTINGS_PATH, json) end)
                    pcall(function() writefile(SETTINGS_PATH, json) end)
                    pcall(function() writefile(FOLDER_PREFIX .. "SPRB_Settings.json", json) end)
                    pcall(function() writefile("SPRB_Settings.json", json) end)
                end
            end)
        end
    end

    if immediate then
        if _saveSettingsThread then
            task.cancel(_saveSettingsThread)
            _saveSettingsThread = nil
        end
        doSave()
    else
        if not _saveSettingsThread then
            _saveSettingsThread = task.delay(0.25, function()
                _saveSettingsThread = nil
                doSave()
            end)
        end
    end
end

