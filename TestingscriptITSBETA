    local function nukeAuraDetectTurret()
        local candidates = {"CannonTurret", "Cannon", "CannonEgg", "SnowballTurret"}
        local bestName = nil
        local bestCount = 0

        for _, name in ipairs(candidates) do
            local cnt = 0
            pcall(function() cnt = getRealBlockCount(name) end)
            if not cnt or cnt <= 0 then
                pcall(function()
                    local dataFolder = LocalPlayer:FindFirstChild("Data")
                    local invVal = dataFolder and dataFolder:FindFirstChild(name)
                    if invVal then
                        local okV, vV = pcall(function() return invVal.Value end)
                        if okV and type(vV) == "number" and vV > 0 then
                            cnt = vV
                        elseif type(invVal) == "number" and invVal > 0 then
                            cnt = invVal
                        end
                    end
                end)
            end
            if cnt and cnt > 0 then
                bestName = name
                bestCount = cnt
                break
            end
        end

        if not bestName then
            bestName = "CannonTurret"
            bestCount = 1
        end
        return bestName, bestCount
    end

