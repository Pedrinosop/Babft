function L(key)
    local t = Lang[Settings.lang] or Lang.en
    return t[key] or Lang.en[key] or key
end
function switchLanguage(newLang)
    Settings.lang = newLang
    saveSettings()
    notifyLanguageChange()
    if rebuildUI then
        task.defer(rebuildUI)
    end
end
_langUpdateCallbacks = {}
function onLanguageChange(cb)
    _langUpdateCallbacks[#_langUpdateCallbacks + 1] = cb
end
function notifyLanguageChange()
    for _, cb in ipairs(_langUpdateCallbacks) do
        pcall(function() cb() end)
    end
end

