        pcall(function()
            if v.IsTwoPart and v.SecondaryWorldCF and v.worldCF then

                local secAtPlace = v.SecondaryWorldCF
                if v.skyWorldCF and (v.skyWorldCF.Position - v.worldCF.Position).Magnitude > 0.001 then
                    secAtPlace = v.skyWorldCF * (v.worldCF:Inverse() * v.SecondaryWorldCF)
                end

                placeRF:InvokeServer(
                    v.Name, getBlockID(v.Name), v.Relative,
                    nil,
                    true,
                    v.skyWorldCF,
                    secAtPlace
                )
            else
                placeRF:InvokeServer(
                    v.Name, getBlockID(v.Name), v.Relative,
                    v.Relative.CFrame:ToObjectSpace(v.skyWorldCF),
                    true,
                    true
                )
            end
        end)
    end

