function ensureIconPngs()
    if isfile and writefile then
        pcall(ensureFolder)
        local iconDir = FOLDER_PREFIX .. "icons/"
        if makefolder and not isfolder(iconDir) then
            pcall(makefolder, iconDir)
        end
        if makefolder and typeof(isfolder) == "function" and not isfolder("icons") then
            pcall(makefolder, "icons")
        end
        for name, b64 in pairs(_SPRB_EMBEDDED_ICONS_B64) do
            local p1 = iconDir .. name .. ".png"
            local p2 = FOLDER_PREFIX .. "sprb_icon_" .. name .. ".png"
            local p3 = "icons/" .. name .. ".png"
            local p4 = name .. ".png"
            pcall(function()
                local raw = spBase64Decode(b64)
                if raw and #raw > 0 then
                    pcall(writefile, p1, raw)
                    pcall(writefile, p2, raw)
                    pcall(writefile, p3, raw)
                    pcall(writefile, p4, raw)
                end
            end)
        end
    end
end
