        local hxCr2 = Instance.new("UICorner"); hxCr2.CornerRadius = UDim.new(0, 4); hxCr2.Parent = hexInp
        local function parseHex(raw)
            if not raw then return nil end
            local s = tostring(raw):gsub("%s+", ""):gsub("^#", "")
            if #s == 3 then
                local r = s:sub(1, 1); local g = s:sub(2, 2); local b = s:sub(3, 3)
                s = r .. r .. g .. g .. b .. b
            end
            if #s == 6 then
                local hr = tonumber(s:sub(1, 2), 16)
                local hg = tonumber(s:sub(3, 4), 16)
                local hb = tonumber(s:sub(5, 6), 16)
                if hr and hg and hb then
                    return hr, hg, hb
                end
            end
            return nil
        end

        local function applyHex(triggerOnChange)
            local hr, hg, hb = parseHex(hexInp.Text)
            if hr and hg and hb then
                curR = math.clamp(hr, 0, 255)
                curG = math.clamp(hg, 0, 255)
                curB = math.clamp(hb, 0, 255)
                for ch, val in pairs({R = curR, G = curG, B = curB}) do
                    local sr = sliderRefs[ch]
                    if sr then
                        local rel = val / 255
                        sr.fill.Size = UDim2.new(rel, 0, 1, 0)
                        sr.thumb.Position = UDim2.new(rel, -7, 0.5, -7)
                        sr.valLbl.Text = tostring(val)
                    end
                end
                local c = Color3.fromRGB(curR, curG, curB)
                TweenService:Create(previewBtn, TweenInfo.new(0.15), {BackgroundColor3 = c}):Play()
                local inv = Color3.new(1 - c.R, 1 - c.G, 1 - c.B)
                pvSt.Color = inv
                pvSt.Transparency = 0.35
                TweenService:Create(pvSt, TweenInfo.new(0.15), {Color = inv, Transparency = 0.35}):Play()
                if triggerOnChange and onChange then pcall(onChange, c) end
                return true
            end
            return false
        end

        hexInp.FocusLost:Connect(function()
            applyHex(true)
            updateHexDisp()
        end)
        hexInp:GetPropertyChangedSignal("Text"):Connect(function()
            local s = tostring(hexInp.Text):gsub("%s+", ""):gsub("^#", "")
            if #s == 6 then
                applyHex(true)
            end
        end)

        local isOpen = false
        local function toggleOpen()
            isOpen = not isOpen
            expandPanel.Visible = isOpen
            if isOpen then
                TweenService:Create(cont, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 108)}):Play()
                editBtn.Text = "^"
                updateHexDisp()
            else
                TweenService:Create(cont, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(1, 0, 0, 24)}):Play()
                editBtn.Text = "v"
            end
        end
        editBtn.MouseButton1Click:Connect(toggleOpen)
        previewBtn.MouseButton1Click:Connect(toggleOpen)

        return {
            getColor = function()
                if hexInp then
                    local hr, hg, hb = parseHex(hexInp.Text)
                    if hr and hg and hb then
                        curR = hr; curG = hg; curB = hb
                    end
                end
                return Color3.fromRGB(curR, curG, curB)
            end,
            setColor = function(c)
                curR = math.floor(c.R * 255 + 0.5); curG = math.floor(c.G * 255 + 0.5); curB = math.floor(c.B * 255 + 0.5)
                local newC = Color3.fromRGB(curR, curG, curB)
                previewBtn.BackgroundColor3 = newC
                TweenService:Create(previewBtn, TweenInfo.new(0.15), {BackgroundColor3 = newC}):Play()
                local inv = Color3.new(1 - newC.R, 1 - newC.G, 1 - newC.B)
                pvSt.Color = inv
                pvSt.Transparency = 0.35
                TweenService:Create(pvSt, TweenInfo.new(0.15), {Color = inv, Transparency = 0.35}):Play()
                for ch, val in pairs({R=curR, G=curG, B=curB}) do
                    local sr = sliderRefs[ch]
                    if sr then local rel = val/255; sr.fill.Size = UDim2.new(rel,0,1,0); sr.thumb.Position = UDim2.new(rel,-7,0.5,-7); sr.valLbl.Text = tostring(val) end
                end
                updateHexDisp()
            end,
            preview = previewBtn,
