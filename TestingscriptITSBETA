    local function snapshotReplaceBlocks()
        R.savedBlocks = {}
        if not R.repBlock then return end

        local wantMat = (R.toggleMat == true)
        local wantCol = (R.toggleCol == true)

        if not wantMat and not wantCol then
            if R.repBlock and R.repBlock.Parent and R.repBlock:FindFirstChild("PPart") then
                R.savedBlocks[1] = R.repBlock
            end
            return
        end

        local folders = {}
        local seenFolders = {}
        local function addF(f)
            if f and not seenFolders[f] then
                seenFolders[f] = true
                folders[#folders + 1] = f
            end
        end

        addF(getPlotFolder())
        addF(getFolder())
        if R.repBlock and R.repBlock.Parent then
            addF(R.repBlock.Parent)
        end
        if BlocksFolder then
            local myName = LocalPlayer.Name
            local direct = BlocksFolder:FindFirstChild(myName)
            if direct then addF(direct) end
            for _, ch in ipairs(BlocksFolder:GetChildren()) do
                if (ch:IsA("Folder") or ch:IsA("Model")) and ch.Name:lower():find(myName:lower()) then
                    addF(ch)
                end
            end
        end

        local seen = {}
        for _, f in ipairs(folders) do
            for _, item in ipairs(f:GetDescendants()) do
                if (item:IsA("Model") or item:IsA("Folder")) and item:FindFirstChild("PPart") then
                    if not seen[item] and blockMatchesCriteria(item, wantMat, wantCol) then
                        seen[item] = true
                        R.savedBlocks[#R.savedBlocks + 1] = item
                    end
                end
            end
            for _, item in ipairs(f:GetChildren()) do
                if not seen[item] and item:FindFirstChild("PPart") then
                    if blockMatchesCriteria(item, wantMat, wantCol) then
                        seen[item] = true
                        R.savedBlocks[#R.savedBlocks + 1] = item
                    end
                end
            end
        end

        if #R.savedBlocks == 0 and R.repBlock and R.repBlock:FindFirstChild("PPart") then
            R.savedBlocks[1] = R.repBlock
        end
    end

