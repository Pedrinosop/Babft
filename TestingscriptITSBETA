                end)
                helperPiston = waitForBlockByName("Piston", beforePiston, 1.0)
                pistonPart = helperPiston and (helperPiston:FindFirstChild("PPart") or helperPiston:FindFirstChild("Base") or helperPiston.PrimaryPart or helperPiston:FindFirstChildWhichIsA("BasePart"))

                if not helperPiston or not pistonPart then
                    return false
                end

                if hrp and pistonPart then
                    pcall(function()
                        if not standPlatform or not standPlatform.Parent then
                            standPlatform = Instance.new("Part")
                            standPlatform.Name = "SPRB_DupePlatform"
                            standPlatform.Size = Vector3.new(14, 1, 14)
                            standPlatform.Anchored = true
                            standPlatform.Transparency = 0.5
                            standPlatform.Color = Color3.fromRGB(0, 170, 255)
                            standPlatform.Material = Enum.Material.SmoothPlastic
                            standPlatform.CanCollide = true
                            standPlatform.Parent = Workspace
                        end
                        standPlatform.CFrame = CFrame.new(pistonPart.Position + Vector3.new(0, -1, 4))
                        hrp.Anchored = false
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        hrp.CFrame = CFrame.new(pistonPart.Position + Vector3.new(0, 2.5, 4))
                    end)
                    startPlatformKeeper()
                    logNonBlockRemote("TELEPORT PLAYER", "HumanoidRootPart.CFrame", "pistonPart", "Teleported to Machine #" .. machineIndex .. " platform (Anchored=false, Keeper Active)")
                end
                if cam and pistonPart then
                    pcall(function()
                        cam.CameraType = Enum.CameraType.Custom
                        cam.CameraSubject = pistonPart
                        local pp = pistonPart.Position
                        cam.CFrame = CFrame.new(pp + Vector3.new(18, 10, 18), pp)
                    end)
                end

                local propToolCur = (Character and Character:FindFirstChild("PropertiesTool")) or (LocalPlayer.Backpack:FindFirstChild("PropertiesTool"))
                if propToolCur then
                    if propToolCur.Parent ~= Character then
                        propToolCur.Parent = Character
                        task.wait(0.02)
                    end
                    local propRF = propToolCur:FindFirstChild("SetPropertieRF") or propToolCur:FindFirstChild("RF")
                    if propRF then
                        pcall(function() propRF:InvokeServer("Piston length", {helperPiston}, 10.5) end)
                        pcall(function() propRF:InvokeServer("Piston speed", {helperPiston}, 600) end)
                    end
                end

                local topPart = helperPiston:FindFirstChild("TopPart") or helperPiston:FindFirstChild("TopPart", true) or pistonPart
                if topPart and topPart ~= pistonPart then
                    pcall(function()
                        topPart.Anchored = false
                        topPart.CanCollide = false
                    end)
                    if propToolCur then
                        local propRF2 = propToolCur:FindFirstChild("SetPropertieRF") or propToolCur:FindFirstChild("RF")
                        if propRF2 then
                            pcall(function() propRF2:InvokeServer("Anchored", {topPart}, false) end)
                            pcall(function() propRF2:InvokeServer("Collision", {topPart}, false) end)
                        end
                    end
                end

                retractHelperPiston()
                task.wait(0.04)

                local topSizeX = (topPart and topPart.Size and topPart.Size.X) or 2
                local offsetDistance = (topSizeX / 2) + 1

                repickBuildingTool()

                local woodRelCF = CFrame.new(-offsetDistance, 0, 0)
                logNonBlockRemote("SPAWN WOODBASE #" .. machineIndex, "BuildingTool.RF:InvokeServer", "TopPart", "woodRelCF=" .. tostring(woodRelCF) .. " (Anchored=false)")
                local beforeWood = {}
                for _, b in ipairs(folder:GetChildren()) do beforeWood[b] = true end
                pcall(function()
                    placeRF:InvokeServer(
                        "WoodBlock",
                        getBlockID("WoodBlock"),
                        topPart,
                        woodRelCF,
                        false,
                        true
                    )
                end)
                helperBase = waitForBlockByName("WoodBlock", beforeWood, 1.0)

                local addHeight = 6
                stackUpVector = Vector3.new(0, 1, 0)
                woodPart = helperBase and (helperBase:FindFirstChild("PPart") or helperBase.PrimaryPart) or topPart
                if helperBase and woodPart then
                    local scaleToolCur = (Character and Character:FindFirstChild("ScalingTool")) or (LocalPlayer.Backpack:FindFirstChild("ScalingTool"))
                    if scaleToolCur then
                        if scaleToolCur.Parent ~= Character then
                            scaleToolCur.Parent = Character
                            task.wait(0.06)
                        end
                        local curScaleRF = scaleToolCur:FindFirstChild("RF") or scaleRF

                        local woodCF = woodPart.CFrame
                        local upInWood = woodCF:VectorToObjectSpace(Vector3.new(0, 1, 0))
                        local absX, absY, absZ = math.abs(upInWood.X), math.abs(upInWood.Y), math.abs(upInWood.Z)
                        local scaledWoodSize, scaledWoodCF

                        if absY >= absX and absY >= absZ then
                            local signY = (upInWood.Y >= 0) and 1 or -1
                            scaledWoodSize = Vector3.new(2, 2 + addHeight, 2)
                            scaledWoodCF = woodCF * CFrame.new(0, signY * (addHeight / 2), 0)
                            stackUpVector = Vector3.new(0, signY, 0)
                        elseif absZ >= absX and absZ >= absY then
                            local signZ = (upInWood.Z >= 0) and 1 or -1
                            scaledWoodSize = Vector3.new(2, 2, 2 + addHeight)
                            scaledWoodCF = woodCF * CFrame.new(0, 0, signZ * (addHeight / 2))
                            stackUpVector = Vector3.new(0, 0, signZ)
                        else
                            local signX = (upInWood.X >= 0) and 1 or -1
                            scaledWoodSize = Vector3.new(2 + addHeight, 2, 2)
                            scaledWoodCF = woodCF * CFrame.new(signX * (addHeight / 2), 0, 0)
                            stackUpVector = Vector3.new(signX, 0, 0)
                        end

                        if curScaleRF then
                            logNonBlockRemote("SCALE WOODBASE #" .. machineIndex, "ScalingTool.RF:InvokeServer", helperBase.Name, "Size=" .. tostring(scaledWoodSize))
                            pcall(function()
                                curScaleRF:InvokeServer(helperBase, scaledWoodSize, scaledWoodCF)
                            end)
                        end
                    end

                    repickBuildingTool()
                end

                currentTowerTop = (2 + addHeight) / 2
                machinePlacedCount = 0
                currentMachineBlocks = {}
                return true
            end

            local function finalizeCurrentMachine()
                if #currentMachineBlocks == 0 and not helperPiston then return end

                extendHelperPiston()
                task.wait(0.06)
                repickBuildingTool()
                task.wait(0.04)

                if #currentMachineBlocks > 0 then
                    forceAnchorBlocks(currentMachineBlocks)
                    task.wait(0.06)
                end

                local dt = (Character and (Character:FindFirstChild("DeleteTool") or Character:FindFirstChild("DeletingTool")))
                    or (LocalPlayer.Backpack:FindFirstChild("DeleteTool") or LocalPlayer.Backpack:FindFirstChild("DeletingTool"))
                if dt and dt.Parent ~= Character then
                    dt.Parent = Character
                    task.wait(0.02)
                end
                local dRF = dt and (dt:FindFirstChild("RF") or dt:FindFirstChildWhichIsA("RemoteFunction")) or deleteRF
                if dRF then
                    if helperBase then pcall(function() dRF:InvokeServer(helperBase) end); helperBase = nil end
                    if helperPiston then pcall(function() dRF:InvokeServer(helperPiston) end); helperPiston = nil end
                end

                local tRefund = os.clock()
                while (os.clock() - tRefund) < 1.0 do
                    if getRealBlockCount("Piston") >= 1 and getRealBlockCount("WoodBlock") >= 1 then
                        break
                    end
                    task.wait(0.03)
                end

                currentElevationY = (currentElevationY or dupeHeightY) + (currentTowerTop or 4.0) + 12
                machinePlacedCount = 0
                currentMachineBlocks = {}
            end

            for _, miss in ipairs(missingNonRegular) do
                if stopBuild then break end
                local targetEntries = {}
                for _, v in ipairs(flat) do
                    if v.Name == miss.Name and not v._preplacedBlock then
                        targetEntries[#targetEntries + 1] = v
                    end
                end
                if #targetEntries == 0 then continue end

                finalizeCurrentMachine()
                local spawnOk = false
                for retry = 1, 3 do
                    spawnOk = spawnDupeMachine()
                    if spawnOk then break end
                    task.wait(0.1)
                end
                if not spawnOk then
                    break
                end

                local thisTypeBlocks = {}
                local cycleIndex = 0
                local consecutiveFailures = 0

                while #thisTypeBlocks < #targetEntries and not stopBuild do
                    cycleIndex = cycleIndex + 1

                    if machinePlacedCount >= MAX_BLOCKS_PER_MACHINE or not helperPiston then
                        finalizeCurrentMachine()
                        local nextMachineOk = false
                        for retry = 1, 3 do
                            nextMachineOk = spawnDupeMachine()
                            if nextMachineOk then break end
                            task.wait(0.08)
                        end
                        if not nextMachineOk then
                            break
                        end
                    end

                    local currentHave = getRealBlockCount(miss.Name)
                    if currentHave < 1 then
                        local waitCountT0 = os.clock()
                        while (os.clock() - waitCountT0) < 2.5 do
                            currentHave = getRealBlockCount(miss.Name)
                            if currentHave >= 1 then break end
                            task.wait()
                        end
                        if currentHave < 1 then
                            break
                        end
                    end

                    local remainingForType = #targetEntries - #thisTypeBlocks
                    local remainingForMachine = MAX_BLOCKS_PER_MACHINE - machinePlacedCount
                    local batchSize = math.min(currentHave, remainingForType, remainingForMachine)

                    local bBefore = {}
                    for _, b in ipairs(folder:GetChildren()) do bBefore[b] = true end

                    local blkHeight = tonumber(getBlockHeight(miss.Name)) or 2.0
                    local batchTowerTop = tonumber(currentTowerTop) or 4.0

                    for k = 1, batchSize do
                        if stopBuild then break end
                        local globalIdx = (totalBlocksPlaced or 0) + k
                        local centerOffset = batchTowerTop + (blkHeight / 2) - 0.05
                        batchTowerTop = batchTowerTop + blkHeight - 0.05
                        local blockRelCF = CFrame.new(stackUpVector * centerOffset)

                        logNonBlockRemote("TOWER PLACE", "BuildingTool.RF:InvokeServer", miss.Name, string.format("Global #%d (%s #%d/%d, Center=%.2f, H=%.2f)", globalIdx, miss.Name, #thisTypeBlocks + k, #targetEntries, centerOffset, blkHeight))
                        task.spawn(function()
                            pcall(function()
                                placeRF:InvokeServer(
                                    miss.Name,
                                    getBlockID(miss.Name),
                                    woodPart,
                                    blockRelCF,
                                    false,
                                    true
                                )
                            end)
                        end)
                    end

                    local batchPlaced = {}
                    local waitSpawnT0 = os.clock()
                    while (os.clock() - waitSpawnT0) < 1.5 do
                        for _, b in ipairs(folder:GetChildren()) do
                            if b.Name == miss.Name and not bBefore[b] then
                                local bp = b:FindFirstChild("PPart") or b.PrimaryPart or b:FindFirstChildWhichIsA("BasePart")
                                if bp then
                                    batchPlaced[#batchPlaced + 1] = b
                                    bBefore[b] = true
                                end
                            end
                        end
                        if #batchPlaced >= batchSize then break end
                        task.wait()
                    end

                    if #batchPlaced > 0 then
                        consecutiveFailures = 0
                        for _, b in ipairs(batchPlaced) do
                            thisTypeBlocks[#thisTypeBlocks + 1] = b
                            allDupedBlocks[#allDupedBlocks + 1] = b
                            currentMachineBlocks[#currentMachineBlocks + 1] = b
                            machinePlacedCount = (machinePlacedCount or 0) + 1
                            totalBlocksPlaced = (totalBlocksPlaced or 0) + 1
                            currentTowerTop = (currentTowerTop or 4.0) + blkHeight - 0.05
                            local targetEntry = targetEntries[#thisTypeBlocks]
                            if targetEntry then
                                targetEntry._preplacedBlock = b
                                allStackPairs[#allStackPairs + 1] = { block = b, entry = targetEntry, name = miss.Name }
                            end
                        end

                        extendHelperPiston()
                        task.wait(0.1) 
                        repickBuildingTool()
                        task.wait(0.08) 

                        if machinePlacedCount < MAX_BLOCKS_PER_MACHINE and #thisTypeBlocks < #targetEntries then
                            retractHelperPiston()
                            task.wait(0.1) 
                        end

                        updProg(string.format("INF Dupe %s: %d/%d (M#%d: %d/%d)", miss.Name, #thisTypeBlocks, #targetEntries, machineIndex, machinePlacedCount, MAX_BLOCKS_PER_MACHINE), 35)
                    else
                        consecutiveFailures = consecutiveFailures + 1
                        task.wait(0.4)
                        local retryCount = getRealBlockCount(miss.Name)
                        if retryCount == 0 or consecutiveFailures >= 2 then
                            if consecutiveFailures >= 2 and retryCount > 0 then
                                finalizeCurrentMachine()
                                local reOk = false
                                for r = 1, 3 do
                                    reOk = spawnDupeMachine()
                                    if reOk then break end
                                    task.wait(0.1)
                                end
                                if not reOk or consecutiveFailures >= 4 then
                                    break
                                end
                            else
                                break
                            end
                        end
                    end
                end
                finalizeCurrentMachine()
            end

                updProg("INF Non-Blocks: freezing all blocks...", 35)
                local allToFreeze = {}
                if folder then
                    for _, b in ipairs(folder:GetChildren()) do
                        if b and b:FindFirstChild("PPart") then
                            allToFreeze[#allToFreeze + 1] = b
                        end
                    end
                end
                for _, b in ipairs(allDupedBlocks or {}) do
                    if b and b.Parent and not table.find(allToFreeze, b) then
                        allToFreeze[#allToFreeze + 1] = b
                    end
                end
                forceAnchorBlocks(allToFreeze)

                local trowelTool = (Character and Character:FindFirstChild("TrowelTool")) or (LocalPlayer.Backpack:FindFirstChild("TrowelTool"))
                local trowelRF = trowelTool and (trowelTool:FindFirstChild("OperationRF") or trowelTool:FindFirstChild("RF"))
                if not trowelRF then
                    trowelRF = resolveRemote("TrowelTool", "OperationRF")
                end
                if trowelTool and trowelTool.Parent ~= Character then
                    trowelTool.Parent = Character
                    task.wait(0.06)
                end

                local movedPairs = {}
                for j = 1, #allStackPairs do
                    if stopBuild then break end
                    local pair = allStackPairs[j]
                    local blk = pair.block
                    local entry = pair.entry
                    if entry and blk and blk.Parent then
                        local targetCF = entry.worldCF
                        local currentCF = (blk.GetPivot and blk:GetPivot()) or (blk:FindFirstChild("PPart") and blk.PPart.CFrame)
                        entry._preplacedBlock = blk
                        if trowelRF and currentCF then
                            local dist = (currentCF.Position - targetCF.Position).Magnitude
                            local angDiff = (currentCF.LookVector - targetCF.LookVector).Magnitude
                            if dist > 0.05 or angDiff > 0.02 then
                                movedPairs[#movedPairs + 1] = blk
                                task.spawn(function()
                                    pcall(function()
                                        trowelRF:InvokeServer({blk}, currentCF, targetCF, "Move")
                                    end)
                                end)
                                task.wait(0.015)
                            end
                        end
                    end
                    if j % 50 == 0 or j == #allStackPairs then
                        updProg(string.format("Trowel Move: %d/%d blocks", j, #allStackPairs), 35)
                    end
                end

                if #movedPairs > 0 and trowelRF then
                    task.wait(0.35)
                    local batchSize = 25
                    for i = 1, #movedPairs, batchSize do
                        local batch = {}
                        for j = i, math.min(i + batchSize - 1, #movedPairs) do
                            batch[#batch + 1] = movedPairs[j]
                        end
                        if #batch > 0 then
                            local pivotCF = batch[1]:GetPivot()
                            task.spawn(function()
                                pcall(function()
                                    trowelRF:InvokeServer(batch, pivotCF, pivotCF, "Rotate")
                                end)
                            end)
                            task.wait(0.03)
                        end
                    end
                end

                forceAnchorBlocks(allToFreeze)

            restoreInfCamera()

        end

        pcall(function()
            local char = LocalPlayer.Character or Character
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if char and backpack then
                local bt = char:FindFirstChild("BuildingTool")
                if bt then
                    bt.Parent = backpack
                    task.wait(0.08)
                    bt.Parent = char
                    task.wait(0.08)
                end
            end
        end)
        local needed = {}
        if Settings.infBlockEnabled then
            for _, v in ipairs(flat) do
                if v.isRegular and isRegularBlock(v.Name) then
                    needed[v.Name] = (needed[v.Name] or 0) + (v.slotCount or 1)
                end
            end
        end

        local missingList = {}
        for name, need in pairs(needed) do
            local have = getRealBlockCount(name)
            if have < need then
                local missing = need - have
                missingList[#missingList+1] = {
                    Name = name,
                    Need = need,
                    Missing = missing,
                    ScaleCalls = math.max(1, math.ceil(missing / 4) + 1)
                }
            end
        end
        local totalInfCalls = 0
        for _, miss in ipairs(missingList) do
            totalInfCalls = totalInfCalls + (miss.ScaleCalls or 0)
        end
        local doneInfCalls = 0

        local function waitForBlockByName(name, beforeMap, maxWait)
            local t0 = os.clock()
            maxWait = maxWait or 3.5
            while (os.clock() - t0) < maxWait do
                for _, b in ipairs(folder:GetChildren()) do
                    if b.Name == name and not beforeMap[b] and b:FindFirstChild("PPart") then
                        return b
                    end
                end
                task.wait()
            end
            for _, b in ipairs(folder:GetChildren()) do
                if b.Name == name and not beforeMap[b] then
                    return b
                end
            end
            return nil
        end

        local myZone = getPlayerZone(LocalPlayer)
        local dupeSize = Vector3.new(251.79899597168, 1.1754999560161e-38, 298.99996948242)
        if myZone and math.abs(myZone.CFrame.LookVector.X) > 0.5 then
            dupeSize = Vector3.new(298.99996948242, 1.1754999560161e-38, 251.79899597168)
        end
        local dupeCFrame = myZone and CFrame.new(myZone.Position.X, -3.0000000054978e38, myZone.Position.Z, 1, 0, 0, 0, 1, 0, 0, 0, 1)
        for mi, miss in ipairs(missingList) do
            if stopBuild then break end
            if myZone and placeRF and scaleRF then
                local p0 = math.floor((mi - 1) / math.max(#missingList, 1) * 34)
                updProg("INF filling " .. miss.Name .. " +" .. miss.Missing, p0)

                local beforeMap = {}
                for _, b in ipairs(folder:GetChildren()) do beforeMap[b] = true end

                pcall(function()
                    placeRF:InvokeServer(
                        miss.Name,
                        getBlockID(miss.Name),
                        myZone,
                        CFrame.new(0, 2, 0),
                        true,
                        true
                    )
                end)

                local dupBlock = waitForBlockByName(miss.Name, beforeMap, 4)
                if dupBlock then
                    local scaleCalls = miss.ScaleCalls or math.max(1, math.ceil(miss.Missing / 4) + 1)
                    for n = 1, scaleCalls do
                        if stopBuild then break end
                        task.spawn(function()
                            pcall(function()
                                scaleRF:InvokeServer(dupBlock, dupeSize, dupeCFrame)
                            end)
                        end)
                    end
                    doneInfCalls = doneInfCalls + scaleCalls
                    local infPct = totalInfCalls > 0 and math.floor(doneInfCalls / totalInfCalls * 35) or 35
                    updProg("INF filling " .. miss.Name .. " " .. doneInfCalls .. "/" .. totalInfCalls, infPct)
                end
            end
        end

        updProg("INF ready, freezing all blocks...", 35)
        local allToFreeze = {}
        if folder then
            for _, b in ipairs(folder:GetChildren()) do
                if b and b:FindFirstChild("PPart") then
                    allToFreeze[#allToFreeze + 1] = b
                end
            end
        end
        forceAnchorBlocks(allToFreeze)
        updProg("INF ready, building", 35)
    end

    equipAllTools()
    placeTool = Character and Character:FindFirstChild("BuildingTool")
    scaleTool = Character and Character:FindFirstChild("ScalingTool")
    paintTool = Character and Character:FindFirstChild("PaintingTool")
    deleteTool = (Character and Character:FindFirstChild("DeleteTool")) or (Character and Character:FindFirstChild("DeletingTool"))
    propertiesTool = Character and Character:FindFirstChild("PropertiesTool")
    bindTool = Character and Character:FindFirstChild("BindTool")
    placeRF = placeTool and placeTool:FindFirstChild("RF")
    scaleRF = scaleTool and scaleTool:FindFirstChild("RF")
    paintRF = (paintTool and paintTool:FindFirstChild("RF"))
        or (LocalPlayer.Backpack:FindFirstChild("PaintingTool") and LocalPlayer.Backpack.PaintingTool:FindFirstChild("RF"))
    deleteRF = deleteTool and deleteTool:FindFirstChild("RF")
    propertiesRF = propertiesTool and propertiesTool:FindFirstChild("SetPropertieRF")
    bindRF = bindTool and bindTool:FindFirstChild("RF")
    local pistonFlat, restFlat = {}, {}
    local hasActivePistons = false
    for _, v in ipairs(flat) do
        if v.Name and v.Name:find("Piston") then
            pistonFlat[#pistonFlat + 1] = v
            if getPistonLD(v) == 1 then
                hasActivePistons = true
            end
        else
            restFlat[#restFlat + 1] = v
        end
    end

    local needPistonElevator = hasActivePistons
    local allStyled, styledPistons = {}, {}
    local pistonsToActivate = {}
    local pistonUpList = {}

    if not needPistonElevator then

        updProg("Placing " .. #flat .. " blocks...", 0)
        runPlacePhase(flat, "Placing ", 0, 30)
        if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end
        updProg("Waiting for blocks...", 30)
        logBuild(string.format("Waiting for %d blocks to replicate...", #flat), "BUILD", "WAIT")
        waitForN(#flat, math.max(6, math.min(90, #flat * 0.015)))

        do
            local allNew = folder:GetChildren()
            local toAnchor = {}
            for _, b in ipairs(allNew) do
                if not preExistingBlocks[b] and b:FindFirstChild("PPart") and not b.PPart.Anchored then
                    toAnchor[#toAnchor+1] = b
                end
            end
            if #toAnchor > 0 then
                forceAnchorBlocks(toAnchor)
            end
        end

        allStyled = runStylePhase(flat, folder:GetChildren(), {}, 35, 65)
        if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end

        updProg("Moving " .. #allStyled .. " blocks...", 65)
        runMovePhase(allStyled, 65, 80)
        if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end

        applyPropertiesPhase(allStyled, 80, 95)
    else

        if #pistonFlat > 0 and not stopBuild then
            updProg("Placing " .. #pistonFlat .. " pistons...", 0)
            runPlacePhase(pistonFlat, "Pistons ", 0, 10)
            if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end
            updProg("Waiting for pistons...", 11)
            logBuild(string.format("Waiting for %d pistons to replicate...", #pistonFlat), "PISTON", "WAIT")
            waitForN(math.max(1, math.floor(#pistonFlat * 0.95)), math.max(4, math.min(30, #pistonFlat * 0.04)))

            do
                local pChildren = folder:GetChildren()
                local toAnchor = {}
                for _, b in ipairs(pChildren) do
                    if not preExistingBlocks[b] and b:FindFirstChild("PPart") and not b.PPart.Anchored then
                        toAnchor[#toAnchor+1] = b
                    end
                end
                if #toAnchor > 0 then
                    updProg("Anchoring " .. #toAnchor .. " pistons...", 12)
                    forceAnchorBlocks(toAnchor)
                end
            end
            styledPistons = runStylePhase(pistonFlat, folder:GetChildren(), {}, 13, 20)
            if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end

            updProg("Moving " .. #styledPistons .. " pistons...", 20)
            runMovePhase(styledPistons, 20, 25)
            if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end

            pistonsToActivate = {}
            for _, entry in ipairs(styledPistons) do
                local ld = getPistonLD(entry.v)
                if entry.block and entry.block:FindFirstChild("PPart") and ld == 1 then
                    pistonsToActivate[#pistonsToActivate + 1] = {block = entry.block, worldCF = entry.worldCF, v = entry.v}
                end
            end

            pistonUpList = {}
            do
                local upItems = {}
                for _, entry in ipairs(styledPistons) do
                    if entry.block and entry.block.Parent and entry.block:FindFirstChild("PPart") then
                        upItems[#upItems + 1] = {block = entry.block, worldCF = entry.worldCF, v = entry.v}
                    end
                end
                if #upItems > 0 and not stopBuild then
                    updProg("Moving " .. #upItems .. " pistons UP (500 studs)...", 25)
                    local trowelTool = (Character and Character:FindFirstChild("TrowelTool")) or LocalPlayer.Backpack:FindFirstChild("TrowelTool")
                    if trowelTool then
                        if trowelTool.Parent ~= Character then trowelTool.Parent = Character ; task.wait(0.05) end
                        local moveOpRF = trowelTool:FindFirstChild("OperationRF")
                        if moveOpRF then

                            local upBoxes = {}
                            for _, it in ipairs(upItems) do
                                local b = it.block
                                local okPivot, piv = pcall(function() return b:GetPivot() end)
                                if okPivot and piv then
                                    local half = b.PPart.Size / 2
                                    local basePos = piv.Position + Vector3.new(0, 500, 0)
                                    local off = Vector3.new(0, 0, 0)
                                    local step = math.max(half.X * 2, 1) + 0.5
                                    for _ = 1, 400 do
                                        local clash = false
                                        for _, bx in ipairs(upBoxes) do
                                            local d = (basePos + off) - bx.pos
                                            if math.abs(d.X) < half.X + bx.half.X + 0.4
                                                and math.abs(d.Y) < half.Y + bx.half.Y + 0.4
                                                and math.abs(d.Z) < half.Z + bx.half.Z + 0.4 then
                                                clash = true ; break
                                            end
                                        end
                                        if not clash then break end
                                        off = off + Vector3.new(step, 0, 0)
                                    end
                                    upBoxes[#upBoxes + 1] = {pos = basePos + off, half = half}
                                    it.upDelta = Vector3.new(0, 500, 0) + off
                                end
                            end

                            local deltaGroups, deltaOrder = {}, {}
                            for _, it in ipairs(upItems) do
                                if it.upDelta then
                                    local key = string.format("%.3f_%.3f_%.3f", it.upDelta.X, it.upDelta.Y, it.upDelta.Z)
                                    local grp = deltaGroups[key]
                                    if not grp then
                                        grp = {items = {}, delta = it.upDelta}
                                        deltaGroups[key] = grp
                                        deltaOrder[#deltaOrder + 1] = key
                                    end
                                    grp.items[#grp.items + 1] = it
                                end
                            end
                            local moveOK = 0
                            local UP_CHUNK = 10
                            for _, key in ipairs(deltaOrder) do
                                local grp = deltaGroups[key]
                                for i = 1, #grp.items, UP_CHUNK do
                                    if stopBuild then break end
                                    local parts = {}
                                    for j = i, math.min(i + UP_CHUNK - 1, #grp.items) do
                                        parts[#parts + 1] = grp.items[j].block
                                    end
                                    local anchor
                                    pcall(function() anchor = parts[1]:GetPivot().Position end)

                                    if anchor then
                                        pcall(function()
                                            moveOpRF:InvokeServer(parts, CFrame.new(anchor), CFrame.new(anchor + grp.delta), "Move")
                                        end)
                                        moveOK = moveOK + #parts
                                    end
                                    task.wait()
                                end
                            end
                            task.wait(0.35)

                            local function verifyRaised()
                                local missed = {}
                                for _, it in ipairs(upItems) do
                                    if it.upDelta and it.block and it.block.Parent and it.block:FindFirstChild("PPart") then
                                        local okC, cur = pcall(function() return it.block:GetPivot().Position end)
                                        local target = it.worldCF.Position + it.upDelta
                                        if not okC or not cur or (cur - target).Magnitude > 2 then
                                            missed[#missed + 1] = it
                                        end
                                    end
                                end
                                return missed
                            end
                            for raisePass = 1, 3 do
                                local missed = verifyRaised()
                                if #missed == 0 then break end
                                updProg("Pistons UP: retrying " .. #missed .. " stuck...", 27)

                                local retryBlocks = {}
                                for _, it in ipairs(missed) do
                                    retryBlocks[#retryBlocks + 1] = it.block
                                end
                                forceAnchorBlocks(retryBlocks)
                                task.wait(0.15)
                                for _, it in ipairs(missed) do
                                    if stopBuild then break end
                                    local okA, anchor = pcall(function() return it.block:GetPivot().Position end)
                                    if okA and anchor then

                                        local target = it.worldCF.Position + it.upDelta
                                        local delta = target - anchor
                                        pcall(function()
                                            moveOpRF:InvokeServer({it.block}, CFrame.new(anchor), CFrame.new(anchor + delta), "Move")
                                        end)
                                    end
                                    task.wait(0.05)
                                end
                                task.wait(0.5)
                            end
                            do
                                local finalMissed = verifyRaised()
                                if #finalMissed > 0 then
                                    updProg("Pistons UP: " .. #finalMissed .. " could not rise (client synced)", 28)
                                end
                            end
                            for _, it in ipairs(upItems) do
                                if it.upDelta then pistonUpList[#pistonUpList + 1] = it end
                            end
                            updProg("Pistons moved UP: " .. moveOK .. "/" .. #upItems .. " OK", 28)
                            logBuild(string.format("Pistons moved UP: %d/%d (500 studs)", moveOK, #upItems), "PISTON", "ELEVATOR_UP")
                        else
                            updProg("No OperationRF for piston Move UP", 28)
                        end
                    else
                        updProg("No TrowelTool for piston Move UP", 28)
                    end
                end
            end

            updProg("Piston properties (no collision, no transparency)...", 28)
            applyPropertiesPhase(styledPistons, 28, 33, true, true)

            if propertiesRF and #styledPistons > 0 then
                local pbList = {}
                local lenGroups = {}
                for _, entry in ipairs(styledPistons) do
                    if entry.block and entry.block:FindFirstChild("PPart") then
                        pbList[#pbList + 1] = entry.block
                        local extLen = 10
                        if entry.v and entry.v.NumberValues and entry.v.NumberValues.ExtendLength then
                            extLen = tonumber(entry.v.NumberValues.ExtendLength) or 10
                        end
                        if not lenGroups[extLen] then lenGroups[extLen] = {} end
                        lenGroups[extLen][#lenGroups[extLen] + 1] = entry.block
                    end
                end
                if #pbList > 0 then
                    pcall(function() propertiesRF:InvokeServer("Piston speed", pbList, 600) end)
                    for extLen, pblks in pairs(lenGroups) do
                        pcall(function() propertiesRF:InvokeServer("Piston length", pblks, extLen) end)
                    end
                end
            end

            for _, entry in ipairs(styledPistons) do allStyled[#allStyled + 1] = entry end
            task.wait(0.2)
        end

        local restP0 = #pistonFlat > 0 and 40 or 0
        if #restFlat > 0 and not stopBuild then
            updProg("Placing " .. #restFlat .. " blocks...", restP0)
            runPlacePhase(restFlat, "Placing ", restP0, restP0 + 15)
            if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end
            updProg("Waiting for blocks...", restP0 + 16)
            logBuild(string.format("Waiting for %d remaining blocks to replicate...", #restFlat), "BUILD", "WAIT")
            waitForN(math.floor((#pistonFlat + #restFlat) * 0.95), math.max(6, math.min(90, (#pistonFlat + #restFlat) * 0.015)))

            do
                local allNew = folder:GetChildren()
                local toAnchor = {}
                for _, b in ipairs(allNew) do
                    if not preExistingBlocks[b] and b:FindFirstChild("PPart") and not b.PPart.Anchored then
                        toAnchor[#toAnchor+1] = b
                    end
                end
                if #toAnchor > 0 then
                    updProg("Anchoring " .. #toAnchor .. " blocks...", restP0 + 17)
                    forceAnchorBlocks(toAnchor)
                end
            end
            local rUsed = {}
            for _, entry in ipairs(allStyled) do if entry.block then rUsed[entry.block] = true end end
            local styledRest = runStylePhase(restFlat, folder:GetChildren(), rUsed, restP0 + 18, restP0 + 40)
            if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end
            updProg("Moving " .. #styledRest .. " blocks...", restP0 + 40)
            runMovePhase(styledRest, restP0 + 40, restP0 + 45)
            if stopBuild then isBuilding = false ; setStatus("Stopped") ; return false end
            applyPropertiesPhase(styledRest, restP0 + 45, restP0 + 50)
            for _, entry in ipairs(styledRest) do allStyled[#allStyled + 1] = entry end
        end
    end

    local legacyCount = applyLegacySwitches(allStyled, propertiesRF)
    if legacyCount > 0 then
        updProg("Legacy switches: " .. legacyCount, 90)
        task.wait(0.1)
    end

    if needPistonElevator and #styledPistons > 0 and #pistonsToActivate > 0 and not stopBuild then

        local actBlocks = {}
        for _, item in ipairs(pistonsToActivate) do
            if item.block and item.block.Parent and item.block:FindFirstChild("PPart") then
                actBlocks[#actBlocks + 1] = item.block
            end
        end

        updProg("Pistons: placing service Switch at plot center...", 94)
        local serviceSwitch = nil
        local actZone = getPlayerZone(LocalPlayer)
        if placeRF and actZone then
            local beforeMap = {}
            for _, b in ipairs(folder:GetChildren()) do beforeMap[b] = true end
            pcall(function()
                placeRF:InvokeServer(
                    "Switch", getBlockID("Switch"), actZone,
                    CFrame.new(0, 1.5, 0),
                    true,
                    true
                )
            end)
            for _ = 1, 40 do
                task.wait(0.1)
                for _, b in ipairs(folder:GetChildren()) do
                    if not beforeMap[b] and b.Name == "Switch" and not serviceSwitch then
                        serviceSwitch = b
                    end
                end
                if serviceSwitch then break end
            end
            if serviceSwitch and serviceSwitch:FindFirstChild("PPart") and not serviceSwitch.PPart.Anchored then
                forceAnchorBlocks({serviceSwitch})
            end
        end

        if serviceSwitch then
            if not bindTool or not bindTool.Parent then
                bindTool = (Character and Character:FindFirstChild("BindTool")) or LocalPlayer.Backpack:FindFirstChild("BindTool")
                if bindTool and bindTool.Parent ~= Character then bindTool.Parent = Character ; task.wait(0.05) end
                bindRF = bindTool and bindTool:FindFirstChild("RF")
            end
            if bindRF then
                local pushPorts, pullPorts = {}, {}
                for _, pb in ipairs(actBlocks) do
                    local bu = pb:FindFirstChild("BindUp") or pb:FindFirstChild("BindUp", true)
                    local bd = pb:FindFirstChild("BindDown") or pb:FindFirstChild("BindDown", true)
                    if bu then pushPorts[#pushPorts + 1] = bu end
                    if bd then pullPorts[#pullPorts + 1] = bd end
                end
                local bindActs = {}
                if #pushPorts > 0 then bindActs.Push = pushPorts end
                if #pullPorts > 0 then bindActs.Pull = pullPorts end
                if next(bindActs) then
                    updProg(string.format("Pistons: binding service Switch to %d pistons (%d Push / %d Pull ports)...",
                        #actBlocks, #pushPorts, #pullPorts), 94)
                    pcall(function() bindRF:InvokeServer(bindActs, {serviceSwitch}, {}, false, false) end)
                    task.wait(0.25)
                else
                    updProg("Pistons: no BindUp/BindDown ports found, skip bind", 94)
                end
            else
                updProg("Pistons: no BindTool RF — service Switch left unbound", 94)
            end
        end

        if serviceSwitch and propertiesRF then
            updProg("Pistons: Legacy property on service Switch...", 94)
            pcall(function() propertiesRF:InvokeServer("Legacy", {serviceSwitch}) end)
            task.wait(0.25)
        end

        local inputLocalScript = ReplicatedStorage:FindFirstChild("InputLocalScript")
        local queueBlocksRF = inputLocalScript and inputLocalScript:FindFirstChild("QueueBlocksRequest")
        local firedBatch = false
        if queueBlocksRF and #actBlocks > 0 and (LocalPlayer.Character or Character) then
            if serviceSwitch then

                local currentChar = LocalPlayer.Character or Character
                local args = {}
                for _, pb in ipairs(actBlocks) do
                    args[#args + 1] = {
                        pb,
                        true,
                        false,
                        serviceSwitch,
                        currentChar,
                        true,
                        false,
                        true,
                        true,
                        false
                    }
                end
                args[#args + 1] = {
                    serviceSwitch,
                    true,
                    false,
                    false,
                    currentChar,
                    true,
                    false,
                    true,
                    true,
                    false
                }
                updProg("Activating " .. #actBlocks .. " pistons (ONE QueueBlocksRequest via legacy Switch)...", 95)
                logBuild(string.format("Pistons: activating %d pistons via QueueBlocksRequest (service Switch)", #actBlocks), "PISTON", "ACTIVATE")
                pcall(function() queueBlocksRF:FireServer(args) end)
                local cd = serviceSwitch:FindFirstChildWhichIsA("ClickDetector") or serviceSwitch:FindFirstChild("ClickDetector", true)
                if cd and typeof(fireclickdetector) == "function" then
                    pcall(function() fireclickdetector(cd) end)
                end
                firedBatch = true
            else

                updProg("Activating " .. #actBlocks .. " pistons (direct clicks fallback)...", 95)
                local fallbackItems = {}
                for _, pb in ipairs(actBlocks) do fallbackItems[#fallbackItems + 1] = {piston = pb, button = false} end
                batchActivatePistons(fallbackItems)
                firedBatch = true
            end
        end

        local topParts, baseParts, targetDist = {}, {}, {}
        for _, pb in ipairs(actBlocks) do
            local tp, bp = nil, nil
            pcall(function()
                tp = pb:FindFirstChild("TopPart")
                bp = pb:FindFirstChild("Base")
            end)
            if not tp or not bp then
                pcall(function()
                    for _, d in ipairs(pb:GetDescendants()) do
                        if d:IsA("BasePart") and d.Name == "TopPart" and not tp then
                            tp = d
                        end
                        if d:IsA("BasePart") and d.Name == "Base" and not bp then
                            bp = d
                        end
                    end
                end)
            end
            if tp and bp and tp:IsA("BasePart") and bp:IsA("BasePart") then
                topParts[pb] = tp
                baseParts[pb] = bp
                local extLen
                pcall(function()
                    local nvb = pb:FindFirstChild("ExtendLength") or pb:FindFirstChild("ExtendLength", true)
                    if nvb then extLen = tonumber(nvb.Value) end
                end)
                if extLen and extLen > 0 then
                    targetDist[pb] = extLen + 0.4
                end
            end
        end
        local verifiable = 0
        for _, pb in ipairs(actBlocks) do
            if targetDist[pb] then verifiable = verifiable + 1 end
        end
        if firedBatch and verifiable > 0 and not stopBuild then
            updProg("Waiting for FULL piston extension (distance check)...", 96)
            local EXT_TOL = 0.1
            local startT = os.clock()
            local pendingLast = nil
            while os.clock() - startT < 60 do
                if stopBuild then break end
                task.wait(0.25)
                local done = 0
                local pending = {}
                for _, pb in ipairs(actBlocks) do
                    local td = targetDist[pb]
                    if td then
                        local ok, cur = pcall(function()
                            return (topParts[pb].Position - baseParts[pb].Position).Magnitude
                        end)
                        if ok and cur and math.abs(cur - td) < EXT_TOL then
                            done = done + 1
                        else
                            pending[#pending + 1] = pb
                        end
                    end
                end
                updProg(string.format("Pistons fully extended: %d/%d (%.1fs)...", done, verifiable, os.clock() - startT), 96)
                if #pending == 0 then
                    pendingLast = nil
                    break
                end
                pendingLast = pending
            end
            if stopBuild then
                updProg("Piston extension wait interrupted (stop)", 96)
            elseif pendingLast then
                updProg("Pistons: " .. #pendingLast .. "/" .. verifiable .. " did not reach full extension", 96)
            else
                updProg("All pistons fully extended!", 97)
            end
        end

        if serviceSwitch and serviceSwitch.Parent then
            deleteBlock(serviceSwitch)
            serviceSwitch = nil
        end
    end

    if not needPistonElevator and hasActivePistons and not stopBuild then
        local normalPistonsToActivate = {}
        for _, entry in ipairs(allStyled) do
            if entry.block and entry.block.Parent and entry.block.Name:find("Piston") and getPistonLD(entry.v) == 1 then
                normalPistonsToActivate[#normalPistonsToActivate + 1] = entry.block
            end
        end
        if #normalPistonsToActivate > 0 then
            updProg("Activating " .. #normalPistonsToActivate .. " extended pistons...", 94)
            pressBlocksViaQueue(normalPistonsToActivate)
            for _, pb in ipairs(normalPistonsToActivate) do
                local cd = pb:FindFirstChildWhichIsA("ClickDetector") or pb:FindFirstChild("ClickDetector", true)
                if cd and fireclickdetector then
                    pcall(function() fireclickdetector(cd) end)
                end
            end
            local waitStart = os.clock()
            while os.clock() - waitStart < 6 and not stopBuild do
                local allDone = true
                for _, pb in ipairs(normalPistonsToActivate) do
                    local tp = pb:FindFirstChild("TopPart") or pb:FindFirstChild("TopPart", true)
                    local bp = pb:FindFirstChild("Base") or pb:FindFirstChild("Base", true) or pb:FindFirstChild("PPart")
                    if tp and bp then
                        local extLen = 10
                        local nvb = pb:FindFirstChild("ExtendLength") or pb:FindFirstChild("ExtendLength", true)
                        if nvb and tonumber(nvb.Value) then extLen = tonumber(nvb.Value) end
                        local td = extLen + 0.4
                        local cur = (tp.Position - bp.Position).Magnitude
                        if cur < math.max(2.0, td * 0.6) then
                            allDone = false
                            break
                        end
                    end
                end
                if allDone then break end
                task.wait(0.2)
            end
        end
    end

    if #pistonUpList > 0 and not stopBuild then
        updProg("Moving pistons DOWN to final positions...", 97)
        local downTool = (Character and Character:FindFirstChild("TrowelTool")) or LocalPlayer.Backpack:FindFirstChild("TrowelTool")
        if downTool then
            if downTool.Parent ~= Character then downTool.Parent = Character ; task.wait(0.05) end
            local downOpRF = downTool:FindFirstChild("OperationRF")
            if downOpRF then
                local function moveDownPass(items, chunk)
                    local deltaGroups, deltaOrder = {}, {}
                    for _, it in ipairs(items) do
                        local b = it.block
                        if b and b.Parent and b:FindFirstChild("PPart") and it.worldCF then
                            local okD, d = pcall(function() return it.worldCF.Position - b:GetPivot().Position end)
                            if okD and d then
                                local key = string.format("%.3f_%.3f_%.3f", d.X, d.Y, d.Z)
                                local grp = deltaGroups[key]
                                if not grp then
                                    grp = {items = {}, delta = d}
                                    deltaGroups[key] = grp
                                    deltaOrder[#deltaOrder + 1] = key
                                end
                                grp.items[#grp.items + 1] = it
                            end
                        end
                    end
                    local moved = 0
                    for _, key in ipairs(deltaOrder) do
                        local grp = deltaGroups[key]
                        for i = 1, #grp.items, chunk do
                            if stopBuild then break end
                            local parts = {}
                            for j = i, math.min(i + chunk - 1, #grp.items) do
                                parts[#parts + 1] = grp.items[j].block
                            end
                            local anchor
                            pcall(function() anchor = parts[1]:GetPivot().Position end)

                            if anchor then
                                pcall(function()
                                    downOpRF:InvokeServer(parts, CFrame.new(anchor), CFrame.new(anchor + grp.delta), "Move")
                                end)
                                moved = moved + #parts
                            end
                            task.wait(0.08)
                        end
                    end
                    return moved
                end

                moveDownPass(pistonUpList, 10)
                local restored = 0
                for _ = 1, 6 do
                    local needRetry = {}
                    restored = 0
                    for _, it in ipairs(pistonUpList) do
                        local b = it.block
                        if b and b.Parent and b:FindFirstChild("PPart") then
                            local okP, cur = pcall(function() return b:GetPivot().Position end)
                            if okP and cur and (cur - it.worldCF.Position).Magnitude > 1.0 then
                                needRetry[#needRetry + 1] = it
                            else
                                restored = restored + 1
                            end
                        else
                            restored = restored + 1
                        end
                    end
                    if #needRetry == 0 then break end
                    updProg("Pistons DOWN: retrying " .. #needRetry .. " stuck...", 97)
                    task.wait(0.5)
                    moveDownPass(needRetry, 5)
                end
                updProg("Pistons moved DOWN: " .. restored .. "/" .. #pistonUpList .. " OK", 98)
                logBuild(string.format("Pistons moved DOWN: %d/%d to final world positions", restored, #pistonUpList), "PISTON", "ELEVATOR_DOWN")
            else
                updProg("No OperationRF for piston Move DOWN", 98)
            end
        else
            updProg("No TrowelTool for piston Move DOWN", 98)
        end

        updProg("Piston collision ON...", 98)
        if propertiesRF then
            local pistonCCList = {}
            for _, item in ipairs(pistonUpList) do
                local ld = getPistonLD(item.v)
                if ld == 1 and item.block and item.block.Parent and item.block:FindFirstChild("PPart") then
                    if not item.block.PPart.CanCollide then
                        pistonCCList[#pistonCCList + 1] = item.block
                    end
                end
            end
            if #pistonCCList > 0 then
                pcall(function() propertiesRF:InvokeServer("Collision", pistonCCList) end)
                task.wait(0.15)
            end
        end
    end

    if not stopBuild and #allStyled > 0 then
        updProg("Waiting for blocks to settle...", 97)
        local totalCount = #allStyled
        local maxWait = (Settings.buildSpeed == 0) and 1.5 or 12
        local startT = os.clock()
        local function countSettled()
            local settledCount = 0
            for _, entry in ipairs(allStyled) do
                local b = entry.block
                if b and b.Parent and b:FindFirstChild("PPart") then
                    local pp = b.PPart
                    local target = entry.worldCF
                    if target and (pp.Position - target.Position).Magnitude < 1.5 then
                        settledCount = settledCount + 1
                    end
                else
                    settledCount = settledCount + 1
                end
            end
            return settledCount
        end
        while countSettled() < totalCount * 0.9 and os.clock() - startT < maxWait do
            if stopBuild then break end
            task.wait(0.05)
        end
        updProg("Weld fix: ensuring collision ON on everything...", 97)
        local propToolWeld = Character and Character:FindFirstChild("PropertiesTool") or LocalPlayer.Backpack:FindFirstChild("PropertiesTool")
        if propToolWeld and propToolWeld.Parent ~= Character then propToolWeld.Parent = Character ; task.wait(0.05) end
        propertiesRF = propToolWeld and (propToolWeld:FindFirstChild("SetPropertieRF") or propToolWeld:FindFirstChild("RF")) or propertiesRF

        if propertiesRF then
            local needCCOn = {}
            for _, entry in ipairs(allStyled) do
                if entry.block and entry.block.Parent and entry.block:FindFirstChild("PPart") and not isSpecialPropBlock(entry.block.Name) then

                    if not entry.block.PPart.CanCollide then
                        needCCOn[#needCCOn+1] = entry.block
                    end
                end
            end
            if #needCCOn > 0 then
                for i = 1, #needCCOn, 50 do
                    local chunk = {}
                    for j = i, math.min(i + 49, #needCCOn) do
                        chunk[#chunk+1] = needCCOn[j]
                    end
                    asyncCall(function() pcall(function() propertiesRF:InvokeServer("Collision", chunk) end) end)
                end
                asyncDrain()
                task.wait(0.1)
            end
        end

        for _, entry in ipairs(allStyled) do
            if entry.block and entry.block.Parent and entry.block:FindFirstChild("PPart") and not isSpecialPropBlock(entry.block.Name) then
                pcall(function()
                    entry.block.PPart.CanCollide = true
                    for _, desc in ipairs(entry.block:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            desc.CanCollide = true
                        end
                    end
                end)
            end
        end

        updProg("Weld fix (non-blocks, 0 Rotate)...", 98)
        local weldList = {}
        local nonBlockList = weldList
        local trowelTool = (Character and Character:FindFirstChild("TrowelTool")) or LocalPlayer.Backpack:FindFirstChild("TrowelTool")
        if trowelTool and trowelTool.Parent ~= Character then trowelTool.Parent = Character end
        local weldOpRF = trowelTool and (trowelTool:FindFirstChild("OperationRF") or trowelTool:FindFirstChild("RF"))

        for _, entry in ipairs(allStyled) do
            if stopBuild then break end
            if entry.block and entry.block.Parent and entry.block:FindFirstChild("PPart") then
                local isRegular = isRegularBlock(entry.block.Name)
                if not isRegular then
                    weldList[#weldList + 1] = entry
                end
            end
        end
        if folder then
            for _, b in ipairs(folder:GetChildren()) do
                if b:FindFirstChild("PPart") and not preExistingBlocks[b] then
                    local isRegular = isRegularBlock(b.Name)
                    if not isRegular then
                        local found = false
                        for _, e in ipairs(weldList) do if e.block == b then found = true break end end
                        if not found then weldList[#weldList + 1] = {block = b, worldCF = b.PPart.CFrame} end
                    end
                end
            end
        end

        if #weldList > 0 and weldOpRF then
            updProg("Weld fix (" .. #weldList .. " non-blocks, 0 Rotate)...", 98)
            local batchSize = 50
            for i = 1, #weldList, batchSize do
                if stopBuild then break end
                local batch = {}
                for j = i, math.min(i + batchSize - 1, #weldList) do
                    local e = weldList[j]
                    local blk = e.block
                    if blk and blk.Parent then
                        batch[#batch + 1] = blk
                    end
                end
                if #batch > 0 then
                    local ppart = batch[1]:FindFirstChild("PPart") or batch[1].PrimaryPart or batch[1]:FindFirstChildWhichIsA("BasePart")
                    local pivotCF = ppart and ppart.CFrame or (batch[1].GetPivot and batch[1]:GetPivot())
                    if pivotCF then
                        task.spawn(function()
                            pcall(function()
                                weldOpRF:InvokeServer(batch, pivotCF, pivotCF, "Rotate")
                            end)
                        end)
                    end
                end
            end
            task.wait(0.04)
            updProg("Weld fix done", 98)
        end

        if #nonBlockList > 0 and not stopBuild then
            local propTool = Character and Character:FindFirstChild("PropertiesTool") or LocalPlayer.Backpack:FindFirstChild("PropertiesTool")
            if propTool and propTool.Parent ~= Character then propTool.Parent = Character end
            propertiesRF = propTool and propTool:FindFirstChild("SetPropertieRF") or propertiesRF

            if propertiesRF then
                local ccToggleOn = {}
                for _, entry in ipairs(nonBlockList) do
                    local b = entry.block
                    local pp = b:FindFirstChild("PPart") or b.PrimaryPart or b:FindFirstChildWhichIsA("BasePart")
                    local isConstraint = not isRegularBlock(b.Name)
                    if not isConstraint and pp and not pp.CanCollide then
                        ccToggleOn[#ccToggleOn+1] = b
                    end
                end

                if #ccToggleOn > 0 then
                    task.spawn(function()
                        pcall(function() propertiesRF:InvokeServer("Collision", ccToggleOn) end)
                    end)
                end

                local twoPartCCToggle = {}
                for _, entry in ipairs(nonBlockList) do
                    if entry.v and entry.v.IsTwoPart and entry.block and entry.block.Parent then
                        local targetCC = (entry.v.CanCollide ~= false)
                        pcall(function()
                            if entry.block:FindFirstChild("PPart") then entry.block.PPart.CanCollide = targetCC end
                            for _, desc in ipairs(entry.block:GetDescendants()) do
                                if desc:IsA("BasePart") then
                                    desc.CanCollide = targetCC
                                end
                            end
                        end)
                        if targetCC and entry.block:FindFirstChild("PPart") and not entry.block.PPart.CanCollide then
                            twoPartCCToggle[#twoPartCCToggle+1] = entry.block
                        end
                    end
                end
                if #twoPartCCToggle > 0 then
                    task.spawn(function()
                        pcall(function() propertiesRF:InvokeServer("Collision", twoPartCCToggle) end)
                    end)
                end

                local nbTGroups, nbTOrder = {}, {}
                for _, entry in ipairs(nonBlockList) do
                    local v = entry.v
                    if v and v.Transparency ~= nil and entry.block and entry.block.Parent then
                        local t = tonumber(v.Transparency)
                        if t then
                            t = math.clamp(t, 0, 1)
                            local tStr = tostring(math.floor(t * 100 + 0.5))
                            local g = nbTGroups[tStr]
                            if not g then
                                g = {}
                                nbTGroups[tStr] = g
                                nbTOrder[#nbTOrder + 1] = tStr
                            end
                            g[#g + 1] = entry.block
                        end
                    end
                end
                for _, tStr in ipairs(nbTOrder) do
                    local g = nbTGroups[tStr]
                    for i = 1, #g, 100 do
                        local chunk = {}
                        for j = i, math.min(i + 99, #g) do chunk[#chunk + 1] = g[j] end
                        task.spawn(function()
                            pcall(function() propertiesRF:InvokeServer("Transparency", chunk, tStr) end)
                        end)
                    end
                end
                for _, entry in ipairs(nonBlockList) do
                    local v = entry.v
                    if v and v.Transparency ~= nil then
                        local t = tonumber(v.Transparency)
                        if t then
                            t = math.clamp(t, 0, 1)
                            pcall(function()
                                for _, desc in ipairs(entry.block:GetDescendants()) do
                                    if desc:IsA("BasePart") and desc.Name ~= "PPart" then
                                        desc.Transparency = t
                                    end
                                end
                            end)
                        end
                    end
                end
            end
            updProg("Weld fix done (" .. #nonBlockList .. " non-Block rotated)", 99)
        else
            updProg("Weld fix done", 99)
        end
    end

    if not stopBuild then
        local propToolPost = Character and Character:FindFirstChild("PropertiesTool") or LocalPlayer.Backpack:FindFirstChild("PropertiesTool")
        if propToolPost and propToolPost.Parent ~= Character then propToolPost.Parent = Character ; task.wait(0.05) end
        propertiesRF = propToolPost and (propToolPost:FindFirstChild("SetPropertieRF") or propToolPost:FindFirstChild("RF")) or propertiesRF
    end

    if not stopBuild and propertiesRF then
        updProg("Applying all properties post-weld-fix...", 99)
        local postAnchorOn, postAnchorOff = {}, {}
        local postCcOn, postCcOff = {}, {}

        local function getModelCollisionState(model)
            if not model then return false end
            local pp = model:FindFirstChild("PPart") or model.PrimaryPart
            if isRegularBlock(model.Name) and pp then
                return pp.CanCollide
            end
            for _, desc in ipairs(model:GetDescendants()) do
                if desc:IsA("BasePart") and desc.CanCollide then
                    return true
                end
            end
            if pp then return pp.CanCollide end
            local anyPart = model:FindFirstChildWhichIsA("BasePart")
            return anyPart and anyPart.CanCollide or false
        end

        for _, entry in ipairs(allStyled) do
            if not entry.block or not entry.block.Parent or not entry.v then continue end
            local v = entry.v
            local b = entry.block
            local pp = b:FindFirstChild("PPart") or b.PrimaryPart or b:FindFirstChildWhichIsA("BasePart")
            local isBlock = isRegularBlock(b.Name)

            local wantAnchor
            if v.Anchored ~= nil then
                wantAnchor = v.Anchored == true
            elseif not isBlock then
                wantAnchor = true
            end
            if wantAnchor ~= nil and pp and pp.Anchored ~= wantAnchor and not toggledToAnchor[b] then
                if wantAnchor then
                    postAnchorOn[#postAnchorOn+1] = b
                    toggledToAnchor[b] = true
                else
                    postAnchorOff[#postAnchorOff+1] = b
                end
            end

            if v.CanCollide == false then
                postCcOff[#postCcOff+1] = b
            elseif v.CanCollide == true and not getModelCollisionState(b) then
                postCcOn[#postCcOn+1] = b
            end
        end

        for i = 1, #postAnchorOn, 40 do
            local chunk = {}
            for j = i, math.min(i + 39, #postAnchorOn) do chunk[#chunk+1] = postAnchorOn[j] end
            asyncCall(function() pcall(function() propertiesRF:InvokeServer("Anchored", chunk) end) end)
            task.wait(0.015)
        end
        for i = 1, #postAnchorOff, 40 do
            local chunk = {}
            for j = i, math.min(i + 39, #postAnchorOff) do chunk[#chunk+1] = postAnchorOff[j] end
            asyncCall(function() pcall(function() propertiesRF:InvokeServer("Anchored", chunk) end) end)
            task.wait(0.015)
        end
        for i = 1, #postCcOn, 40 do
            local chunk = {}
            for j = i, math.min(i + 39, #postCcOn) do chunk[#chunk+1] = postCcOn[j] end
            asyncCall(function() pcall(function() propertiesRF:InvokeServer("Collision", chunk) end) end)
            task.wait(0.015)
        end
        asyncDrain()

        for _, b in ipairs(postCcOn) do
            pcall(function()
                local pp = b:FindFirstChild("PPart") or b.PrimaryPart
                if pp then pp.CanCollide = true end
                for _, desc in ipairs(b:GetDescendants()) do
                    if desc:IsA("BasePart") and desc.Name ~= "PPart" then
                        desc.CanCollide = true
                    end
                end
            end)
        end

        local postTranspGroups = {}
        local postShadowGroups = {}
        for _, entry in ipairs(allStyled) do
            if not entry.block or not entry.block.Parent or not entry.v or not entry.block:FindFirstChild("PPart") then continue end
            local v = entry.v
            local b = entry.block
            if v.Transparency ~= nil then
                local t = tonumber(v.Transparency)
                if t then
                    t = math.clamp(t, 0, 1)
                    local tStr = tostring(math.floor(t * 100 + 0.5))
                    postTranspGroups[tStr] = postTranspGroups[tStr] or {}
                    table.insert(postTranspGroups[tStr], b)
                end
            end
            if v.ShowShadow ~= nil then
                local val = v.ShowShadow == true
                local key = val and "1" or "0"
                postShadowGroups[key] = postShadowGroups[key] or {}
                table.insert(postShadowGroups[key], b)
            end
        end

        for valKey, blocks in pairs(postTranspGroups) do
            if #blocks > 0 then
                local tNum = tonumber(valKey) and (tonumber(valKey) / 100) or 0
                for _, b in ipairs(blocks) do
                    pcall(function()
                        if isRegularBlock(b.Name) then
                            if b:FindFirstChild("PPart") then b.PPart.Transparency = tNum end
                        else

                            if b:FindFirstChild("PPart") then b.PPart.Transparency = 1 end
                            for _, desc in ipairs(b:GetDescendants()) do
                                if desc:IsA("BasePart") and desc.Name ~= "PPart" then
                                    desc.Transparency = tNum
                                end
                            end
                        end
                    end)
                end
                for i = 1, #blocks, 40 do
                    local chunk = {}
                    for j = i, math.min(i + 39, #blocks) do chunk[#chunk + 1] = blocks[j] end
                    asyncCall(function() pcall(function() propertiesRF:InvokeServer("Transparency", chunk, valKey) end) end)
                    task.wait(0.015)
                end
            end
        end

        for _, entry in ipairs(allStyled) do
            local b = entry.block
            if b and b.Parent and not isRegularBlock(b.Name) and b:FindFirstChild("PPart") then
                pcall(function() b.PPart.Transparency = 1 end)
            end
        end
        for valKey, blocks in pairs(postShadowGroups) do
            for i = 1, #blocks, 40 do
                local chunk = {}
                for j = i, math.min(i + 39, #blocks) do chunk[#chunk + 1] = blocks[j] end
                asyncCall(function() pcall(function() propertiesRF:InvokeServer("Cast shadow", chunk, valKey) end) end)
                task.wait(0.015)
            end
        end
        asyncDrain()
        if #postCcOff > 0 then
            for i = 1, #postCcOff, 40 do
                local chunk = {}
                for j = i, math.min(i + 39, #postCcOff) do chunk[#chunk+1] = postCcOff[j] end
                asyncCall(function() pcall(function() propertiesRF:InvokeServer("Collision", chunk) end) end)
                task.wait(0.015)
            end
            asyncDrain()

            for _, b in ipairs(postCcOff) do
                pcall(function()
                    for _, desc in ipairs(b:GetDescendants()) do
                        if desc:IsA("BasePart") then
                            desc.CanCollide = false
                        end
                    end
                end)
            end
        end
        updProg("Properties applied", 99)
    end

    if #styledPistons > 0 and propertiesRF and not stopBuild then

        local speedGroups = {}
        for _, entry in ipairs(styledPistons) do
            if entry.block and entry.block.Parent and entry.v then
                local sp = 10
                if entry.v.NumberValues and entry.v.NumberValues.Speed then
                    sp = tonumber(entry.v.NumberValues.Speed) or 10
                end
                if not speedGroups[sp] then speedGroups[sp] = {} end
                speedGroups[sp][#speedGroups[sp] + 1] = entry.block
            end
        end
        for sp, blist in pairs(speedGroups) do
            for i = 1, #blist, 40 do
                local chunk = {}
                for j = i, math.min(i + 39, #blist) do chunk[#chunk + 1] = blist[j] end
                pcall(function() propertiesRF:InvokeServer("Piston speed", chunk, sp) end)
                task.wait(0.015)
            end
        end
    end

    if not stopBuild and propertiesRF then
        local noteBlocksToTune = {}
        for _, entry in ipairs(allStyled) do
            if entry.block and entry.block.Parent and entry.block.Name == "Note" and entry.v then
                local targetPitch = nil
                if entry.v.NotePitch ~= nil then
                    targetPitch = tonumber(entry.v.NotePitch)
                elseif entry.v.NumberValues and entry.v.NumberValues.NotePitch ~= nil then
                    targetPitch = tonumber(entry.v.NumberValues.NotePitch)
                elseif entry.v.NumberValues and entry.v.NumberValues.Key ~= nil then
                    targetPitch = tonumber(entry.v.NumberValues.Key)
                end
                if targetPitch and targetPitch > 0 and targetPitch <= 24 then
                    table.insert(noteBlocksToTune, {
                        block = entry.block,
                        remaining = targetPitch,
                    })
                end
            end
        end

        if #noteBlocksToTune > 0 then
            updProg(string.format("Tuning %d Note blocks...", #noteBlocksToTune), 99)
            for step = 1, 24 do
                if stopBuild then break end
                local batch = {}
                for _, item in ipairs(noteBlocksToTune) do
                    if item.remaining >= step and item.block and item.block.Parent then
                        table.insert(batch, item.block)
                    end
                end
                if #batch == 0 then break end

                for i = 1, #batch, 40 do
                    local chunk = {}
                    for j = i, math.min(i + 39, #batch) do chunk[#chunk + 1] = batch[j] end
                    pcall(function()
                        propertiesRF:InvokeServer("Key", chunk)
                    end)
                    task.wait(0.02)
                end
                task.wait(0.04)
            end
            updProg("Note blocks tuned!", 99)
        end
    end

    if not stopBuild and propertiesRF then
        local ccOffConstraint = {}
        for _, entry in ipairs(allStyled) do
            if entry.block and entry.block.Parent then
                local b = entry.block
                local v = entry.v
                if isSpecialPropBlock(b.Name) and v and v.CanCollide == false then
                    local pp = b:FindFirstChild("PPart") or b.PrimaryPart or b:FindFirstChildWhichIsA("BasePart")
                    local anyCc = false
                    for _, desc in ipairs(b:GetDescendants()) do
                        if desc:IsA("BasePart") and desc.CanCollide then anyCc = true break end
                    end
                    if anyCc or (pp and pp.CanCollide) then
                        ccOffConstraint[#ccOffConstraint+1] = b
                    end
                end
            end
        end
        if #ccOffConstraint > 0 then
            updProg("Disabling collision on " .. #ccOffConstraint .. " constraint blocks...", 99)

            for i = 1, #ccOffConstraint, 50 do
                local chunk = {}
                for j = i, math.min(i + 49, #ccOffConstraint) do
                    chunk[#chunk+1] = ccOffConstraint[j]
                end
                asyncCall(function() pcall(function() propertiesRF:InvokeServer("Collision", chunk) end) end)
            end
            asyncDrain()
        end
    end

    if not stopBuild and #allStyled > 0 then
        updProg("Applying binds...", 99)
        local waitBindsDone = applyBindTables(allStyled, 99, 100)
        if waitBindsDone then
            waitBindsDone(25, function(w, pend, tot)
                updProg(string.format("Binds: %.1fs, %d/%d done...", w, tot - pend, tot), 99)
            end)
        end
    end

    updProg(stopBuild and "Stopped" or "Done! " .. total .. " blocks", 100)
    logBuild(string.format("Build finished successfully in %.2fs (Placed: %d)", os.clock() - buildStartTime, total), "FINISH", "SUCCESS")
    isBuilding = false
    if GlobalBuildOverlayRef then GlobalBuildOverlayRef.Visible = false end
    pcall(function()
        local settingsFolder = LocalPlayer:FindFirstChild("Settings")
        if settingsFolder then
            local sbVal = settingsFolder:FindFirstChild("ShareBlocks")
            if sbVal then
                sbVal.Value = shareBlocksOriginal
            end
        end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        local bg = pg and pg:FindFirstChild("BuildGui")
        local mf = bg and bg:FindFirstChild("InventoryFrame") and bg.InventoryFrame:FindFirstChild("MoreFrame")
        local mb = mf and mf:FindFirstChild("MakeBinds") and mf.MakeBinds:FindFirstChild("MakeBinds")
        if mb and mb:IsA("BoolValue") then
            mb.Value = makeBindsOriginal
        end
    end)
    pcall(function()
        local cam = workspace.CurrentCamera
        if cam then
            local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            cam.CameraType = Enum.CameraType.Custom
            if hum then cam.CameraSubject = hum end
        end
    end)
    return true, placedById
end

recentlyPlacedBlocks = {}

local _previewGen = 0
local previewHandles = nil
local previewBox = nil
local baseModelBounds = {min = Vector3.new(0,0,0), max = Vector3.new(0,0,0), size = Vector3.new(0,0,0), center = Vector3.new(0,0,0)}
local previewPartData = {}
local updateAxisCardDisplaysGlobal = nil
updateDimensionsDisplayGlobal = nil
updatePreviewTransform = nil
updateGizmoModeGlobal = nil

local gizmoSyncCallbacks = {}
function notifyAllGizmoSync()
    if updateGizmoModeGlobal then updateGizmoModeGlobal() end
    for _, cb in ipairs(gizmoSyncCallbacks) do
        pcall(cb)
    end
end

function clearPreview()
    _previewGen = _previewGen + 1
    pcall(function()
        if previewHandles then previewHandles:Destroy(); previewHandles = nil end
        if previewBox then previewBox:Destroy(); previewBox = nil end
        if PreviewFolder then PreviewFolder:ClearAllChildren() end
    end)
    for _, b in pairs(selectionBoxes) do if b then pcall(function() b:Destroy() end) end end
    selectionBoxes = {}
    previewParts = {}
    previewPartData = {}
    previewActive = false
    selectedObjectName = nil
    if updatePreviewButtonGlobal then updatePreviewButtonGlobal() end
    if updateDimensionsDisplayGlobal then updateDimensionsDisplayGlobal() end
end

function updatePreviewTransform(newScVec, newOffVec, fullUpdate)
    if not previewBox or not previewBox.Parent then return end
    local myZone = getPlayerZone(LocalPlayer)
    if not myZone then return end

    if newScVec then
        newScVec = Vector3.new(
            math.clamp(newScVec.X, 0.05, 50),
            math.clamp(newScVec.Y, 0.05, 50),
            math.clamp(newScVec.Z, 0.05, 50)
        )
        Settings.scaleX = newScVec.X
        Settings.scaleY = newScVec.Y
        Settings.scaleZ = newScVec.Z
        Settings.buildScale = (newScVec.X + newScVec.Y + newScVec.Z) / 3
    end
    if newOffVec then
        Settings.buildOffsetX = newOffVec.X
        Settings.buildOffsetY = newOffVec.Y
        Settings.buildOffsetZ = newOffVec.Z
    end
    local scVec = Vector3.new(tonumber(Settings.scaleX) or 1, tonumber(Settings.scaleY) or 1, tonumber(Settings.scaleZ) or 1)
    local off = Vector3.new(tonumber(Settings.buildOffsetX) or 0, tonumber(Settings.buildOffsetY) or 0, tonumber(Settings.buildOffsetZ) or 0)

    local bSize = baseModelBounds.size or Vector3.new(4, 4, 4)
    local bCenter = baseModelBounds.center or Vector3.new(0, 0, 0)

    local curBoxW = math.max(0.1, bSize.X * scVec.X)
    local curBoxH = math.max(0.1, bSize.Y * scVec.Y)
    local curBoxD = math.max(0.1, bSize.Z * scVec.Z)
    previewBox.Size = Vector3.new(curBoxW, curBoxH, curBoxD)
    local boxRelPos = bCenter + off
    previewBox.CFrame = myZone.CFrame:ToWorldSpace(CFrame.new(boxRelPos))

    for _, pp in ipairs(previewParts) do
        local data = previewPartData[pp]
        if pp and pp.Parent and data then
            pp.Size = Vector3.new(
                math.max(0.05, data.baseSize.X * scVec.X),
                math.max(0.05, data.baseSize.Y * scVec.Y),
                math.max(0.05, data.baseSize.Z * scVec.Z)
            )
            local delta = data.baseRelPos - bCenter
            local pPos = bCenter + Vector3.new(delta.X * scVec.X, delta.Y * scVec.Y, delta.Z * scVec.Z) + off
            pp.CFrame = myZone.CFrame:ToWorldSpace(CFrame.new(pPos) * data.baseRot)
        end
    end

    if updateDimensionsDisplayGlobal then updateDimensionsDisplayGlobal() end
    if updateAxisCardDisplaysGlobal then updateAxisCardDisplaysGlobal() end
end

function createPreview(buildData, selBlock, onlyMove)
    clearPreview()
    local thisGen = _previewGen
    local myZone = getPlayerZone(LocalPlayer)
    if not myZone or not buildData then return false end

    local normalizedData = {}
    if type(buildData) == "table" then
        if buildData[1] ~= nil and (buildData[1].CFrame or buildData[1].Position or buildData[1].Size or buildData[1].cf or buildData[1].p or buildData[1].Name) then
            for _, bi in ipairs(buildData) do
                local nm = bi.Name or "Block"
                normalizedData[nm] = normalizedData[nm] or {}
                table.insert(normalizedData[nm], bi)
            end
        else
            for k, v in pairs(buildData) do
                if type(v) == "table" then
                    if v[1] ~= nil then
                        normalizedData[k] = v
                    elseif v.CFrame or v.Position or v.Size or v.cf or v.p then
                        normalizedData[k] = { v }
                    else
                        normalizedData[k] = v
                    end
                end
            end
        end
    end
    buildData = normalizedData

    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    local hasAny = false

    for blockName, blocks in pairs(buildData) do
        if type(blocks) == "table" then
            for _, bi in pairs(blocks) do
                local relCF = getBlockCF(bi) or CFrame.new()
                local rawSz = (bi.Size and bi.Size ~= "") and strV3(bi.Size) or (bi.sz and strV3(bi.sz)) or (bi.s and strV3(bi.s)) or Vector3.new(4, 4, 4)
                local p = relCF.Position
                local half = rawSz * 0.5
                minX = math.min(minX, p.X - half.X)
                minY = math.min(minY, p.Y - half.Y)
                minZ = math.min(minZ, p.Z - half.Z)
                maxX = math.max(maxX, p.X + half.X)
                maxY = math.max(maxY, p.Y + half.Y)
                maxZ = math.max(maxZ, p.Z + half.Z)
                hasAny = true
            end
        end
    end

    if not hasAny then
        minX, minY, minZ = -2, -2, -2
        maxX, maxY, maxZ = 2, 2, 2
    end

    local bSize = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
    local bCenter = (Vector3.new(minX, minY, minZ) + Vector3.new(maxX, maxY, maxZ)) * 0.5
    baseModelBounds = {
        min = Vector3.new(minX, minY, minZ),
        max = Vector3.new(maxX, maxY, maxZ),
        size = bSize,
        center = bCenter
    }

    local scVec = Vector3.new(
        tonumber(Settings.scaleX) or tonumber(Settings.buildScale) or 1,
        tonumber(Settings.scaleY) or tonumber(Settings.buildScale) or 1,
        tonumber(Settings.scaleZ) or tonumber(Settings.buildScale) or 1
    )
    local off = Vector3.new(tonumber(Settings.buildOffsetX) or 0, tonumber(Settings.buildOffsetY) or 0, tonumber(Settings.buildOffsetZ) or 0)

    local rawT = tonumber(Settings.previewTransparency)
    if rawT == nil or rawT >= 0.9 then rawT = 0 end
    local targetT = math.clamp(rawT, 0, 0.7)

    previewBox = Instance.new("Part")
    previewBox.Name = "SPRB_PreviewBox"
    previewBox.Anchored = true
    previewBox.CanCollide = false
    previewBox.CanTouch = false
    previewBox.CanQuery = true
    previewBox.CastShadow = false
    previewBox.Transparency = 1
    previewBox.Size = Vector3.new(
        math.max(0.1, bSize.X * scVec.X),
        math.max(0.1, bSize.Y * scVec.Y),
        math.max(0.1, bSize.Z * scVec.Z)
    )
    local boxRelPos = bCenter + off
    previewBox.CFrame = myZone.CFrame:ToWorldSpace(CFrame.new(boxRelPos))
    previewBox.Parent = PreviewFolder

    local pBoxStroke = Instance.new("SelectionBox")
    pBoxStroke.Name = "SPRB_BoxStroke"
    pBoxStroke.Adornee = previewBox
    pBoxStroke.Color3 = Colors.Secondary or Color3.fromRGB(0, 220, 255)
    pBoxStroke.LineThickness = 0.04
    pBoxStroke.Transparency = 0.35
    pBoxStroke.Parent = previewBox

    if not PreviewFolder or not PreviewFolder.Parent then
        PreviewFolder = Workspace:FindFirstChild("SPRB_Preview") or Instance.new("Folder")
        PreviewFolder.Name = "SPRB_Preview"
        PreviewFolder.Parent = Workspace
    end

    previewHandles = Instance.new("Handles")
    previewHandles.Name = "SPRB_PreviewHandles"
    previewHandles.Adornee = previewBox
    previewHandles.Color3 = Color3.fromRGB(0, 220, 255)
    previewHandles.Style = (onlyMove or Settings.gizmoMode == "move") and Enum.HandlesStyle.Movement or Enum.HandlesStyle.Resize
    previewHandles.Faces = Faces.new(
        Enum.NormalId.Top, Enum.NormalId.Bottom,
        Enum.NormalId.Right, Enum.NormalId.Left,
        Enum.NormalId.Front, Enum.NormalId.Back
    )

    local handleParent = LocalPlayer:FindFirstChildOfClass("PlayerGui") or (workspace.CurrentCamera or workspace:FindFirstChildOfClass("Camera"))
    previewHandles.Parent = handleParent
    previewHandles.Visible = true

    updateGizmoModeGlobal = function()
        if previewHandles and previewHandles.Parent then
            if onlyMove or Settings.gizmoMode == "move" then
                previewHandles.Style = Enum.HandlesStyle.Movement
                previewHandles.Color3 = Color3.fromRGB(0, 220, 255)
            else
                previewHandles.Style = Enum.HandlesStyle.Resize
                previewHandles.Color3 = Color3.fromRGB(255, 200, 50)
            end
        end
    end
    updateGizmoModeGlobal()

    local dragStartScale = scVec
    local dragStartOffset = off

    local function recordDragStart()
        dragStartScale = Vector3.new(
            tonumber(Settings.scaleX) or tonumber(Settings.buildScale) or 1,
            tonumber(Settings.scaleY) or tonumber(Settings.buildScale) or 1,
            tonumber(Settings.scaleZ) or tonumber(Settings.buildScale) or 1
        )
        dragStartOffset = Vector3.new(
            tonumber(Settings.buildOffsetX) or 0,
            tonumber(Settings.buildOffsetY) or 0,
            tonumber(Settings.buildOffsetZ) or 0
        )
    end

    previewHandles.MouseButton1Down:Connect(recordDragStart)

    previewHandles.MouseDrag:Connect(function(face, distance)
        local snap = tonumber(Settings.gizmoSnap) or 1.0
        if snap > 0 then
            distance = math.round(distance / snap) * snap
        end

        if onlyMove or Settings.gizmoMode == "move" then
            local moveVec = Vector3.zero
            if face == Enum.NormalId.Right then moveVec = Vector3.new(distance, 0, 0)
            elseif face == Enum.NormalId.Left then moveVec = Vector3.new(-distance, 0, 0)
            elseif face == Enum.NormalId.Top then moveVec = Vector3.new(0, distance, 0)
            elseif face == Enum.NormalId.Bottom then moveVec = Vector3.new(0, -distance, 0)
            elseif face == Enum.NormalId.Front then moveVec = Vector3.new(0, 0, -distance)
            elseif face == Enum.NormalId.Back then moveVec = Vector3.new(0, 0, distance) end
            local newOff = dragStartOffset + moveVec
            updatePreviewTransform(dragStartScale, newOff, false)
        else
            local mSize = baseModelBounds.size or Vector3.new(4, 4, 4)
            local deltaScale = 0
            if face == Enum.NormalId.Right or face == Enum.NormalId.Left then
                deltaScale = (distance * 2) / math.max(0.1, mSize.X)
            elseif face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
                deltaScale = (distance * 2) / math.max(0.1, mSize.Y)
            elseif face == Enum.NormalId.Front or face == Enum.NormalId.Back then
                deltaScale = (distance * 2) / math.max(0.1, mSize.Z)
            end

            local newScale = dragStartScale
            if Settings.gizmoUniform then
                local factor = 1 + deltaScale / math.max(0.1, dragStartScale.X)
                factor = math.clamp(factor, 0.05, 50)
                newScale = dragStartScale * factor
            else
                if face == Enum.NormalId.Right or face == Enum.NormalId.Left then
                    newScale = Vector3.new(math.max(0.05, dragStartScale.X + deltaScale), dragStartScale.Y, dragStartScale.Z)
                elseif face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
                    newScale = Vector3.new(dragStartScale.X, math.max(0.05, dragStartScale.Y + deltaScale), dragStartScale.Z)
                elseif face == Enum.NormalId.Front or face == Enum.NormalId.Back then
                    newScale = Vector3.new(dragStartScale.X, dragStartScale.Y, math.max(0.05, dragStartScale.Z + deltaScale))
                end
            end

            updatePreviewTransform(newScale, dragStartOffset, false)
        end
    end)

    previewHandles.MouseButton1Up:Connect(function()
        saveSettings()
    end)

    previewActive = true
    if updatePreviewButtonGlobal then updatePreviewButtonGlobal() end
    if updateDimensionsDisplayGlobal then updateDimensionsDisplayGlobal() end

    local created = 0
    for blockName, blocks in pairs(buildData) do
        if thisGen ~= _previewGen then return false end
        if type(blocks) == "table" then
            for _, bi in pairs(blocks) do
                if thisGen ~= _previewGen then return false end
                local pcallOk, pcallErr = pcall(function()
                    local relCF = getBlockCF(bi) or CFrame.new()
                    local delta = relCF.Position - bCenter
                    local pPos = bCenter + Vector3.new(delta.X * scVec.X, delta.Y * scVec.Y, delta.Z * scVec.Z) + off
                    local rotCF = relCF.Rotation or (relCF - relCF.Position)
                    local scaledCF = CFrame.new(pPos) * rotCF
                    local worldCF = myZone.CFrame:ToWorldSpace(scaledCF)

                    local pp = Instance.new("Part")
                    pp.Name = blockName
                    pp.Anchored = true
                    pp.CanCollide = false
                    pp.CanTouch = false
                    pp.CanQuery = false
                    pp.CastShadow = false
                    pp.Material = Enum.Material.SmoothPlastic
                    local rawSize = (bi.Size and bi.Size ~= "") and strV3(bi.Size) or (bi.sz and strV3(bi.sz)) or (bi.s and strV3(bi.s)) or Vector3.new(4, 4, 4)
                    pp.Size = Vector3.new(
                        math.max(0.05, rawSize.X * scVec.X),
                        math.max(0.05, rawSize.Y * scVec.Y),
                        math.max(0.05, rawSize.Z * scVec.Z)
                    )
                    pp.CFrame = worldCF
                    local rawCol = bi.Col or bi.Color or bi.color or bi.col or bi.cl
                    pp.Color = (rawCol and rawCol ~= "") and strCol(rawCol) or Color3.fromRGB(200, 200, 200)
                    pp.Transparency = targetT

                    previewPartData[pp] = {
                        baseRelPos = relCF.Position,
                        baseSize = rawSize,
                        baseRot = rotCF
                    }
                    pp.Parent = PreviewFolder

                    if selBlock and blockName == selBlock and not selectionBoxes[blockName] then
                        local hl = Instance.new("Highlight")
                        hl.Adornee = pp
                        hl.FillColor = Color3.fromRGB(255, 255, 255)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.7
                        hl.OutlineTransparency = 0.3
                        hl.Parent = pp
                        selectionBoxes[blockName] = hl
                    end
                    previewParts[#previewParts + 1] = pp
                    created = created + 1
                end)
                if not pcallOk then
                end

                if created > 0 and created % 400 == 0 then task.wait() end
            end
        end
    end
    if thisGen ~= _previewGen then return false end
    if updateBlocksDisplayGlobal then task.spawn(updateBlocksDisplayGlobal) end
    if updateDimensionsDisplayGlobal then updateDimensionsDisplayGlobal() end
    return true
end

