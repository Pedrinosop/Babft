function convertMcLaren(rawData)

    local converted = {}
    local invertedBinds = {}
    local idToKey = {}

    for blockName, blocks in pairs(rawData) do
        if type(blocks) == "table" and #blocks > 0 then
            local arr = {}
            for idx, bi in ipairs(blocks) do
                local entry = {}
                entry.ID = bi.ID
                entry.Transparency = bi.Transparency
                entry.Anchored = bi.Anchored
                entry.CanCollide = bi.CanCollide
                entry.CFrame = bi.CFrame
                entry.Size = bi.Size

                if bi.Color then
                    local hex = tostring(bi.Color):gsub("^#","")
                    local r = tonumber(hex:sub(1,2), 16) or 255
                    local g = tonumber(hex:sub(3,4), 16) or 255
                    local b = tonumber(hex:sub(5,6), 16) or 255
                    entry.Col = string.format("%.6f,%.6f,%.6f", r/255, g/255, b/255)
                end

                if bi.CastShadow ~= nil then
                    entry.ShowShadow = bi.CastShadow
                end

                if bi.MValues and type(bi.MValues) == "table" then
                    local numV, boolV = {}, {}
                    for k, v in pairs(bi.MValues) do
                        if type(v) == "number" then
                            numV[k] = v
                        elseif type(v) == "boolean" then
                            boolV[k] = v
                        else
                            numV[k] = v
                        end
                    end
                    if next(numV) then entry.NumberValues = numV end
                    if next(boolV) then entry.BoolValues = boolV end
                end

                if bi.SecCFrame then
                    entry.SecCFrame = bi.SecCFrame
                end

                local knownKeys = {ID=true, Transparency=true, Anchored=true, CanCollide=true,
                    CFrame=true, Size=true, Color=true, CastShadow=true, Binds=true, MValues=true, SecCFrame=true}
                local extra = {}
                for k, v in pairs(bi) do
                    if not knownKeys[k] then extra[k] = v end
                end
                if next(extra) then entry.ASUExtra = extra end
                arr[#arr+1] = entry

                if bi.ID then
                    idToKey[bi.ID] = {blockName = blockName, idx = idx}
                end

                if bi.Binds and type(bi.Binds) == "table" then
                    for _, bindRow in ipairs(bi.Binds) do
                        if type(bindRow) == "table" and bindRow[1] then
                            local sourceID = bindRow[1]
                            local bindName = bindRow[2]
                            local bindValue = bindRow[3]
                            if not invertedBinds[sourceID] then
                                invertedBinds[sourceID] = {}
                            end

                            local bindEntry = {bi.ID, bindName, bindValue}
                            table.insert(invertedBinds[sourceID], bindEntry)
                        end
                    end
                end
            end
            converted[blockName] = arr
        end
    end

    for sourceID, bindList in pairs(invertedBinds) do
        local key = idToKey[sourceID]
        if key then
            local arr = converted[key.blockName]
            if arr and arr[key.idx] then
                arr[key.idx].BindTable = bindList
            end
        end
    end

    return converted
end

function convertAutoBuildToPRS(data)

    if type(data) ~= "table" then return nil end
    local result = {}
    for blockName, blocks in pairs(data) do
        if type(blocks) == "table" and #blocks > 0 then
            local arr = {}
            for _, b in ipairs(blocks) do
                if type(b) == "table" then
                    local bi = {}
                    bi.ID = b.ID
                    if b.CFrame then
                        local cfVals = nil
                        if type(b.CFrame) == "table" then
                            cfVals = b.CFrame
                            bi.CFrame = table.concat(b.CFrame, ", ")
                        else
                            bi.CFrame = tostring(b.CFrame)
                            cfVals = parseNums(bi.CFrame)
                        end
                        if cfVals and #cfVals >= 3 then
                            local cx = tonumber(cfVals[1]) or 0
                            local cy = tonumber(cfVals[2]) or 0
                            local cz = tonumber(cfVals[3]) or 0
                            if math.abs(cx) > 50000 or math.abs(cy) > 50000 or math.abs(cz) > 50000 then
                                continue
                            end
                        end
                    end
                    if b.Size then
                        if type(b.Size) == "table" then
                            bi.Size = table.concat(b.Size, ", ")
                        else
                            bi.Size = tostring(b.Size)
                        end
                    end
                    if b.Color then
                        local hex = tostring(b.Color):gsub("^#", "")
                        if #hex == 6 then
                            local r = tonumber(hex:sub(1,2), 16) or 255
                            local g = tonumber(hex:sub(3,4), 16) or 255
                            local bl = tonumber(hex:sub(5,6), 16) or 255
                            bi.Col = string.format("%.6f,%.6f,%.6f", r/255, g/255, bl/255)
                        end
                    end
                    bi.Anchored = (b.Anchored ~= false)
                    bi.CanCollide = (b.CanCollide ~= false)
                    if b.CastShadow ~= nil then bi.ShowShadow = b.CastShadow end
                    if b.Transparency ~= nil then bi.Transparency = b.Transparency end
                    if b.MValues and type(b.MValues) == "table" then
                        local numV, boolV = {}, {}
                        for k, v in pairs(b.MValues) do
                            if type(v) == "boolean" then boolV[k] = v
                            else numV[k] = v end
                        end
                        if next(numV) then bi.NumberValues = numV end
                        if next(boolV) then bi.BoolValues = boolV end
                    end

                    if b.SecCFrame ~= nil then
                        if type(b.SecCFrame) == "table" then
                            bi.SecCFrame = table.concat(b.SecCFrame, ", ")
                        else
                            bi.SecCFrame = tostring(b.SecCFrame)
                        end
                    end
                    if b.SecondaryPartPosition ~= nil then bi.SecondaryPartPosition = b.SecondaryPartPosition end
                    if b.Binds and type(b.Binds) == "table" then
                        bi.BindTable = {}
                        for _, bindRow in ipairs(b.Binds) do
                            if type(bindRow) == "table" and bindRow[1] then
                                bi.BindTable[#bi.BindTable+1] = {bindRow[1], bindRow[2] or "", bindRow[3] or ""}
                            end
                        end
                    end
                    arr[#arr+1] = bi
                end
            end
            if #arr > 0 then result[blockName] = arr end
        end
    end
    if next(result) then return result end
    return nil
end

function convertBABtoPRS(raw)
    if not raw or #raw < 10 then return nil end
    if not raw:match("^[%d%-]") then return nil end
    local blockCount = 0
    for _ in raw:gmatch("[Bb]lock/") do blockCount = blockCount + 1 end
    if blockCount < 1 then
        for _ in raw:gmatch("[%a%d]+/") do blockCount = blockCount + 1 end
    end
    if blockCount < 1 then return nil end

    local blocks = {}
    local total = 0
    local globalId = 1

    for segment in raw:gmatch("([^/]+)") do
        if #segment > 5 then
            local parts = string.split(segment, ":")
            if #parts >= 5 then
                local posStr = parts[1]
                local rotStr = parts[2]
                local colorStr = parts[3]
                local sizeStr = parts[4]
                local matName = parts[5]:match("^%s*(.-)%s*$")

                if matName and #matName > 0 then
                    local px, py, pz = posStr:match("^([^,]+),([^,]+),([^,]+)$")
                    local rx, ry, rz = rotStr:match("^([^,]+),([^,]+),([^,]+)$")
                    if px and rx then
                        px = tonumber(px) or 0
                        py = tonumber(py) or 0
                        pz = tonumber(pz) or 0
                        rx = tonumber(rx) or 0
                        ry = tonumber(ry) or 0
                        rz = tonumber(rz) or 0

                        local cf = CFrame.new(px, py, pz) * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))

                        local sizeStrVal = nil
                        if sizeStr and sizeStr ~= "-" then
                            local sv = {}
                            for v in sizeStr:gmatch("[^,]+") do sv[#sv+1] = tonumber(v) end
                            if #sv >= 3 then
                                sizeStrVal = string.format("%.6f,%.6f,%.6f", sv[1] or 2, sv[2] or 2, sv[3] or 2)
                            end
                        end

                        local colStrVal = nil
                        if colorStr and colorStr ~= "-" then
                            local cr, cg, cb = colorStr:match("^([^,]+),([^,]+),([^,]+)$")
                            if cr then
                                local rN, gN, bN = tonumber(cr) or 1, tonumber(cg) or 1, tonumber(cb) or 1
                                if rN > 1 or gN > 1 or bN > 1 then
                                    rN, gN, bN = rN / 255, gN / 255, bN / 255
                                end
                                colStrVal = string.format("%.4f,%.4f,%.4f", math.clamp(rN, 0, 1), math.clamp(gN, 0, 1), math.clamp(bN, 0, 1))
                            end
                        end

                        local entry = {
                            CFrame = cfStr(cf),
                            ID = globalId,
                            Position = string.format("%.6f,%.6f,%.6f", px, py, pz),
                            Rotation = string.format("%.6f,%.6f,%.6f", rx, ry, rz),
                            Size = sizeStrVal,
                            Col = colStrVal,
                            Anchored = true,
                            CanCollide = true,
                        }

                        blocks[matName] = blocks[matName] or {}
                        blocks[matName][#blocks[matName] + 1] = entry
                        total = total + 1
                        globalId = globalId + 1
                    end
                end
            end
        end
    end

    if total == 0 then return nil end
    return blocks
end

function convertArrayBuildToPRS(dec)
    if type(dec) ~= "table" or #dec == 0 then return nil end
    local blocks = {}
    local total = 0
    local globalId = 1

    for _, item in ipairs(dec) do
        if type(item) == "table" and #item >= 4 and type(item[1]) == "string" and type(item[2]) == "table" then
            local matName = item[1]:match("^%s*(.-)%s*$")
            local pos = item[2]
            local look = type(item[3]) == "table" and item[3] or {0, 0, -1}
            local up = type(item[4]) == "table" and item[4] or {0, 1, 0}
            local sz = type(item[5]) == "table" and item[5] or nil
            local anchored = (item[6] ~= false)
            local col = type(item[7]) == "table" and item[7] or nil
            local props = type(item[8]) == "table" and item[8] or nil
            local binds = type(item[9]) == "table" and item[9] or nil

            local px = tonumber(pos[1] or pos.X) or 0
            local py = tonumber(pos[2] or pos.Y) or 0
            local pz = tonumber(pos[3] or pos.Z) or 0

            local lx = tonumber(look[1] or look.X) or 0
            local ly = tonumber(look[2] or look.Y) or 0
            local lz = tonumber(look[3] or look.Z) or -1

            local ux = tonumber(up[1] or up.X) or 0
            local uy = tonumber(up[2] or up.Y) or 1
            local uz = tonumber(up[3] or up.Z) or 0

            local posVec = Vector3.new(px, py, pz)
            local lookVec = Vector3.new(lx, ly, lz)
            local upVec = Vector3.new(ux, uy, uz)

            if lookVec.Magnitude < 0.0001 then lookVec = Vector3.new(0, 0, -1) else lookVec = lookVec.Unit end
            if upVec.Magnitude < 0.0001 then upVec = Vector3.new(0, 1, 0) else upVec = upVec.Unit end

            local rightVec = upVec:Cross(-lookVec)
            if rightVec.Magnitude < 0.0001 then
                rightVec = Vector3.new(1, 0, 0)
                upVec = (-lookVec):Cross(rightVec).Unit
            else
                rightVec = rightVec.Unit
                upVec = (-lookVec):Cross(rightVec).Unit
            end

            local cf = CFrame.fromMatrix(posVec, rightVec, upVec, -lookVec)

            local sizeStr = nil
            if sz and #sz >= 3 then
                sizeStr = string.format("%.6f,%.6f,%.6f", tonumber(sz[1]) or 2, tonumber(sz[2]) or 2, tonumber(sz[3]) or 2)
            end

            local colStr = nil
            if col and #col >= 3 then
                local r, g, b = tonumber(col[1]) or 255, tonumber(col[2]) or 255, tonumber(col[3]) or 255
                if r > 1 or g > 1 or b > 1 then r, g, b = r / 255, g / 255, b / 255 end
                colStr = string.format("%.4f,%.4f,%.4f", math.clamp(r, 0, 1), math.clamp(g, 0, 1), math.clamp(b, 0, 1))
            end

            local canCollide = true
            local transparency = nil
            local numVals = {}
            local boolVals = {}

            if props then
                for _, elem in ipairs(props) do
                    if type(elem) == "table" then
                        for pk, pv in pairs(elem) do
                            if pk == "Transparency" then
                                local tn = tonumber(pv) or 0
                                if tn > 1 then transparency = math.clamp(tn / 4, 0, 1) else transparency = math.clamp(tn, 0, 1) end
                            elseif pk == "Collision" then
                                canCollide = (tonumber(pv) ~= 1 and pv ~= false)
                            elseif pk == "Reverse rotation" or pk == "ReverseRotation" then
                                boolVals.ReverseRotation = (tonumber(pv) == 1 or pv == true)
                            else
                                local mappedNum = tonumber(pv)
                                if mappedNum ~= nil then
                                    numVals[pk] = mappedNum
                                end
                            end
                        end
                    end
                end
            end

            local entry = {
                CFrame = cfStr(cf),
                ID = globalId,
                Size = sizeStr,
                Col = colStr,
                Transparency = transparency,
                Anchored = anchored,
                CanCollide = canCollide,
            }
            if next(numVals) then entry.NumberValues = numVals end
            if next(boolVals) then entry.BoolValues = boolVals end

            if binds and #binds > 0 then
                entry.BindTable = binds
            end

            blocks[matName] = blocks[matName] or {}
            blocks[matName][#blocks[matName] + 1] = entry
            total = total + 1
            globalId = globalId + 1
        end
    end

    if total == 0 then return nil end
    return blocks
end

function spExtractJsonDataKeys(json, targetDepth)
    if type(json) ~= "string" or #json < 2 then return nil end
    local n = #json
    local firstChar
    local i = 1
    while i <= n do
        local c = json:byte(i)
        if c == 32 or c == 9 or c == 10 or c == 13 then
            i = i + 1
        else
            firstChar = string.char(c)
            break
        end
    end
    if not firstChar then return nil end
    if targetDepth == nil then
        targetDepth = (firstChar == "[") and 2 or 1
    end
    local keys = {}
    local depth = 0
    local stack = {}
    while i <= n do
        local c = json:byte(i)
        if c == 34 then
            local j = i + 1
            while j <= n do
                local c2 = json:byte(j)
                if c2 == 92 then
                    j = j + 2
                elseif c2 == 34 then
                    break
                end
                j = j + 1
            end
            if j > n then return nil end
            if depth == targetDepth and stack[#stack] == "o" then
                local k = j + 1
                while k <= n do
                    local c3 = json:byte(k)
                    if c3 == 32 or c3 == 9 or c3 == 10 or c3 == 13 then
                        k = k + 1
                    else
                        break
                    end
                end
                if json:byte(k) == 58 then
                    keys[#keys + 1] = json:sub(i + 1, j - 1)
                end
            end
            i = j + 1
        elseif c == 123 or c == 91 then
            depth = depth + 1
            stack[#stack + 1] = (c == 123) and "o" or "a"
            i = i + 1
        elseif c == 125 or c == 93 then
            stack[#stack] = nil
            depth = depth - 1
            i = i + 1
        else
            i = i + 1
        end
    end
    if #keys == 0 then return nil end
    return keys
end

function loadBuildFromFile(fileName)
    ensureFolder()
    lastLoadedBuildName = fileName
    local json
    local searchPaths = {FOLDER_PREFIX, FOLDER_PATH .. "/", ""}
    for _, root in ipairs(searchPaths) do
        local paths = {
            root .. fileName .. ".au2",
            root .. fileName .. ".AU2",
            root .. fileName .. ".Build",
            root .. fileName .. ".build",
            root .. fileName .. ".json",
            root .. fileName .. ".txt",
            root .. fileName,
        }
        for _, p in ipairs(paths) do
            if isfile(p) then json = readfile(p) ; break end
        end
        if json then break end
    end
    if not json then
        local targetName = fileName:match("([^/\\]+)$") or fileName
        local function scanSubDir(dir, depth)
            if depth > 3 or json then return end
            local ok, items = pcall(listfiles, dir)
            if not ok or type(items) ~= "table" then return end
            for _, fp in ipairs(items) do
                if isfolder(fp) then
                    scanSubDir(fp, depth + 1)
                    if json then return end
                else
                    local base = fp:match("([^/\\]+)%.[^.]+$") or fp:match("([^/\\]+)$")
                    local baseFull = fp:match("([^/\\]+)$")
                    if (base and (base == targetName or base:lower() == targetName:lower()))
                        or (baseFull and (baseFull == targetName or baseFull:lower() == targetName:lower())) then
                        local okR, txt = pcall(readfile, fp)
                        if okR and txt and #txt > 0 then
                            json = txt
                            return
                        end
                    end
                end
            end
        end
        pcall(scanSubDir, FOLDER_PATH, 0)
    end
    if not json then return nil, nil end

    json = json:match("^%s*(.-)%s*$") or json
    if json:byte(1) == 0xEF and json:byte(2) == 0xBB and json:byte(3) == 0xBF then
        json = json:sub(4)
    end
    local lpBuildPos = json:find("LP_BUILD")
    if lpBuildPos then
        local buildPart = json:sub(lpBuildPos + 8):match("^%s*(.-)%s*$")
        if buildPart and #buildPart > 0 then
            json = buildPart
        end
    end

    _SPRB_AsuKeyOrder = nil

    local okBAB, babData = pcall(convertBABtoPRS, json)
    if okBAB and babData then
        return babData, "BAB"
    end

    local okAB, decAB = pcall(function() return HttpService:JSONDecode(json) end)
    if okAB and type(decAB) == "table" and (decAB.AutoBuild_Version or decAB.Data) and type(decAB.Data) == "table" then
        local prsData = convertAutoBuildToPRS(decAB.Data)
        if prsData then return prsData, "AutoBuild" end
    end

    if okAB and type(decAB) == "table" and decAB.Codec and decAB.Build and type(decAB.Build) == "table" then
        return decAB.Build, "Asu"
    end

    if json:find("BuilderHub") or json:find("%[Build%]") then
        local buildLine = json:match("Build%s*=%s*(%b{})")
        if buildLine then
            local okB, decB = pcall(function() return HttpService:JSONDecode(buildLine) end)
            if okB and decB and decB.b and type(decB.b) == "table" then
                local dataObj = decB.b
                for bn, blist in pairs(dataObj) do
                    if type(blist) == "table" then
                        for _, b in ipairs(blist) do
                            if type(b) == "table" then
                                if b.p then b.Position = b.p end
                                if b.r then b.Rotation = b.r end
                                if b.cl then b.Color = b.cl end
                                if b.sz then b.Size = b.sz end
                                if b.a ~= nil then b.Anchored = b.a end
                                if b.cc ~= nil then b.CanCollide = b.cc end
                                if b.ss ~= nil then b.ShowShadow = b.ss end
                                if b.i then b.ID = b.i end
                                if b.nv then b.NumberValues = b.nv end
                                if b.d ~= nil then
                                    b.NumberValues = b.NumberValues or {}
                                    local dVal = tonumber(b.d) or 0.2
                                    b.NumberValues.Delay = dVal
                                    b.NumberValues["Delay time"] = dVal
                                    b.NumberValues.WaitDuration = dVal
                                end
                                if b.bd and type(b.bd) == "table" and #b.bd > 0 then
                                    local binds = {}
                                    for _, item in ipairs(b.bd) do
                                        if type(item) == "table" and item[1] ~= nil then
                                            binds[#binds + 1] = {tonumber(item[1]) or item[1], item[2] or "BindFire", tonumber(item[3]) or item[3] or -1}
                                        elseif type(item) == "number" or type(item) == "string" then
                                            binds[#binds + 1] = {tonumber(item) or item, "BindFire", -1}
                                        end
                                    end
                                    if #binds > 0 then b.BindTable = binds end
                                end
                            end
                        end
                    end
                end
                return dataObj, "Asu"
            end
        end
    end

    local ok, dec = pcall(function() return HttpService:JSONDecode(json) end)
    if not ok or not dec then
        local compacted = json:gsub("\r\n", " "):gsub("\n", " "):gsub("\r", " "):gsub("%s+", " ")
        ok, dec = pcall(function() return HttpService:JSONDecode(compacted) end)
    end
    if not ok or not dec then return nil, nil end

    if type(dec) == "table" then
        if #dec == 0 and json:match("^%s*%[%s*%]%s*$") then
            return {}, "Empty"
        end
        if #dec > 0 and type(dec[1]) == "table" and type(dec[1][1]) == "string" then
            local arrData = convertArrayBuildToPRS(dec)
            if arrData then return arrData, "ArrayBuild" end
        end
    end

    if type(dec) == "table" then
        local isToon = false
        for _, blocks in pairs(dec) do
            if type(blocks) == "table" and #blocks > 0 then
                local fb = blocks[1]
                if type(fb) == "table" and (fb.cf or fb.s or fb.cl) then
                    isToon = true
                end
                break
            end
        end
        if isToon then
            local prsData = convertTOONtoPRS(dec)
            if prsData then return prsData, "TOON" end
        end
    end

    if type(dec) == "table" and dec.f == "au2" and dec.b and type(dec.b) == "table" then
        local prsData = convertAU2toPRS(dec)
        if prsData then return prsData, "AU2" end
    end
    if type(dec) == "table" and #dec >= 2 then
        local cats, dataObj = dec[1], dec[2]
        if type(cats) == "table" and type(dataObj) == "table" then
            for _, blocks in pairs(dataObj) do
                if type(blocks) == "table" and #blocks > 0 then
                    local fb = blocks[1]
                    if type(fb) == "table" and (fb.Position or fb.position or fb.p or fb.Pos or fb.pos or fb.CFrame or fb.cframe) then
                        local extracted = spExtractJsonDataKeys(json, 2)
                        _SPRB_AsuKeyOrder = (type(extracted) == "table" and #extracted > 0) and extracted or ((type(cats) == "table" and #cats > 0) and cats)
                        dataObj._SPRB_KeyOrder = _SPRB_AsuKeyOrder
                        return dataObj, "Asu"
                    end
                end
            end
        end
    end
    if dec.format and dec.data then
        if dec.format == "Asu" then
            local extracted = spExtractJsonDataKeys(json, 2)
            _SPRB_AsuKeyOrder = (type(extracted) == "table" and #extracted > 0) and extracted or ((type(dec.cats) == "table" and #dec.cats > 0) and dec.cats)
            return dec.data, "Asu"
        end
        return dec.data, dec.format
    end

    if type(dec) == "table" and dec.b and type(dec.b) == "table" and dec.t then
        local dataObj = dec.b
        for _, blocks in pairs(dataObj) do
            if type(blocks) == "table" and #blocks > 0 then
                local fb = blocks[1]
                if type(fb) == "table" and (fb.p or fb.cl or fb.i) then
                    for bn, blist in pairs(dataObj) do
                        if type(blist) == "table" then
                            for _, b in ipairs(blist) do
                                if type(b) == "table" then
                                    if b.p then b.Position = b.p end
                                    if b.r then b.Rotation = b.r end
                                    if b.cl then b.Color = b.cl end
                                    if b.sz then b.Size = b.sz end
                                    if b.a ~= nil then b.Anchored = b.a end
                                    if b.cc ~= nil then b.CanCollide = b.cc end
                                    if b.ss ~= nil then b.ShowShadow = b.ss end
                                    if b.i then b.ID = b.i end
                                    if b.nv then b.NumberValues = b.nv end
                                    if b.sv then
                                        b.StringValues = b.sv
                                        if b.sv.ActionName then
                                            b.NumberValues = b.NumberValues or {}
                                        end
                                    end
                                    if b.bd then b.BindTable = b.bd end
                                end
                            end
                        end
                    end
                    return dataObj, "Asu"
                end
            end
        end
    end
    if type(dec) == "table" and not dec.format and #dec == 0 then
        local hasBlockData = false
        for _, v in pairs(dec) do
            if type(v) == "table" and #v > 0 and type(v[1]) == "table" then
                hasBlockData = true
                local fb = v[1]

                if fb.CFrame and type(fb.CFrame) == "string" then
                    return dec, "PRS"
                end

                if fb.CFrame and type(fb.CFrame) == "table" then
                    for _, blocks in pairs(dec) do
                        if type(blocks) == "table" then
                            for _, b in ipairs(blocks) do
                                if type(b) == "table" then
                                    if type(b.Size) == "table" then
                                        b.Size = table.concat({b.Size[1], b.Size[2], b.Size[3]}, ", ")
                                    end
                                    if b.MValues and type(b.MValues) == "table" then
                                        local mv_num, mv_bool = {}, {}
                                        for mk, mv in pairs(b.MValues) do
                                            if type(mv) == "boolean" then
                                                mv_bool[mk] = mv
                                            else
                                                mv_num[mk] = mv
                                            end
                                        end
                                        if next(mv_num) then b.NumberValues = mv_num end
                                        if next(mv_bool) then b.BoolValues = mv_bool end
                                    end
                                    if b.Binds then b.BindTable = b.Binds end
                                    if b.CastShadow ~= nil then b.ShowShadow = b.CastShadow end
                                end
                            end
                        end
                    end
                    return dec, "PRS"
                end

                if fb.Position or fb.position or fb.Pos or fb.pos then

                    _SPRB_AsuKeyOrder = spExtractJsonDataKeys(json, 1)
                    return dec, "Asu"
                end
            end
        end
        if hasBlockData then
            _SPRB_AsuKeyOrder = spExtractJsonDataKeys(json, 1)
            return dec, "Asu"
        end
    end
    return dec, "PRS"
end

_buildFilesCache = nil
_buildFilesCacheTime = 0
function getSavedBuilds()
    if _buildFilesCache and (os.clock() - _buildFilesCacheTime) < 300 then
        return _buildFilesCache
    end
    ensureFolder()
    local builds, seen = {}, {}
    local function scanDir(dir, depth)
        if depth > 3 then return end
        local ok, items = pcall(listfiles, dir)
        if not ok or type(items) ~= "table" then return end
        for _, fp in ipairs(items) do
            if isfolder(fp) then
                scanDir(fp, depth + 1)
            else
                local n = fp:match("([^/\\]+)%.au2$") or fp:match("([^/\\]+)%.AU2$") or fp:match("([^/\\]+)%.Build$") or fp:match("([^/\\]+)%.build$") or fp:match("([^/\\]+)%.json$")
                if n and not seen[n:lower()] then
                    table.insert(builds, n)
                    seen[n:lower()] = true
                end
            end
        end
        task.wait()
    end
    scanDir(FOLDER_PATH, 0)
    table.sort(builds, function(a, b) return a:lower() < b:lower() end)
    _buildFilesCache = builds
    _buildFilesCacheTime = os.clock()
    return builds
end

