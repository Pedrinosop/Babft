        b.Font = SPRB_FONT
        b.LayoutOrder = getNextLayoutOrder(parent)
        b.Parent = parent

        local _, bs = stylizeCard(b, Colors.PanelElevated, Colors.Border, 10)
        if bs then
            bs.Name = "SPRB_ThemedStroke"
            bs.Transparency = 0.6
            bs.Thickness = 1.0
        end

        local autoIcon = iconName
        if not autoIcon then
            local ln = name:lower()
            local lt = (txt or ""):lower()
            if ln:find("build") or lt:find("build") or lt:find("построить") then autoIcon = "build"
            elseif ln:find("save") or lt:find("save") or lt:find("сохранить") then autoIcon = "save"
            elseif ln:find("load") or lt:find("load") or lt:find("загрузить") then autoIcon = "load"
            elseif ln:find("farm") or lt:find("farm") or lt:find("фарм") then autoIcon = "farm"
            elseif ln:find("chest") or lt:find("chest") or lt:find("сундук") then autoIcon = "chest"
            elseif ln:find("replace") or lt:find("replace") or lt:find("заменить") then autoIcon = "replace"
            elseif ln:find("brush") or ln:find("paint") or lt:find("paint") then autoIcon = "brush"
            elseif ln:find("refresh") or lt:find("refresh") or lt:find("обновить") then autoIcon = "refresh"
            elseif ln:find("stop") or lt:find("stop") or lt:find("стоп") or ln:find("clear") then autoIcon = "close"
            elseif ln:find("teleport") or lt:find("teleport") or lt:find("тп") then autoIcon = "teleport"
            end
        end

        local iconImg = nil
        if autoIcon then
            local asset = resolveIconAsset(autoIcon)
            if asset then
                iconImg = Instance.new("ImageLabel")
                iconImg.Name = "BtnIcon"
                iconImg.Size = UDim2.new(0, 14, 0, 14)
                iconImg.Position = UDim2.new(0, 10, 0.5, -7)
                iconImg.BackgroundTransparency = 1
                iconImg.Image = asset
                iconImg.ImageColor3 = Colors.Muted
                iconImg.ScaleType = Enum.ScaleType.Fit
                iconImg.ZIndex = b.ZIndex + 1
                iconImg.Parent = b
            end
        end

        b:SetAttribute("SkipDefaultHover", true)
        local bScale = Instance.new("UIScale"); bScale.Scale = 1; bScale.Parent = b
        local activeTweens = {}
        local function cancelActiveTweens()
            for _, tw in ipairs(activeTweens) do
                pcall(function() tw:Cancel() end)
            end
            table.clear(activeTweens)
        end

        local function refreshBtnStateVisual(animated)
            local sc = Colors.Secondary or Color3.fromRGB(234, 138, 46)
            local border = Colors.Border or Color3.fromRGB(44, 50, 64)
            local panelElev = Colors.PanelElevated or Color3.fromRGB(30, 34, 44)
            local panelSoft = Colors.PanelSoft or Color3.fromRGB(20, 22, 28)
            local txt = tostring(b.Text or "")
            local txtUpper = txt:upper()
            local isActive = (b:GetAttribute("Active") == true)
                or (txt:find("●", 1, true) ~= nil)
                or (txtUpper:find(": ON", 1, true) ~= nil)
                or (txtUpper:find("[ON]", 1, true) ~= nil)
                or (txtUpper:find(" ON", 1, true) ~= nil and not txtUpper:find("OFF", 1, true))
                or (txtUpper:find("STOP", 1, true) ~= nil)
                or (txt:find("Вкл", 1, true) ~= nil or txt:find("вкл", 1, true) ~= nil or txt:find("ВКЛ", 1, true) ~= nil)
                or (txt:find("Стоп", 1, true) ~= nil or txt:find("стоп", 1, true) ~= nil or txt:find("СТОП", 1, true) ~= nil)

            local targetBg = isActive and sc:Lerp(panelSoft, 0.45) or panelElev
            local targetText = isActive and sc or Colors.Text
            local targetStroke = isActive and sc or border
            local targetTrans = isActive and 0.2 or 0.6
            local targetThick = isActive and 1.2 or 1.0
            local targetIcon = isActive and sc or Colors.Muted

            cancelActiveTweens()

            if animated then
                local tInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                local twB = TweenService:Create(b, tInfo, {BackgroundColor3 = targetBg, TextColor3 = targetText})
                table.insert(activeTweens, twB)
                twB:Play()
                if bs then
                    bs.Thickness = targetThick
                    local twS = TweenService:Create(bs, tInfo, {Color = targetStroke, Transparency = targetTrans})
                    table.insert(activeTweens, twS)
                    twS:Play()
                end
                if iconImg then
                    local twI = TweenService:Create(iconImg, tInfo, {ImageColor3 = targetIcon})
                    table.insert(activeTweens, twI)
                    twI:Play()
                end
            else
                b.BackgroundColor3 = targetBg
                b.TextColor3 = targetText
                if bs then
                    bs.Color = targetStroke
                    bs.Transparency = targetTrans
                    bs.Thickness = targetThick
                end
                if iconImg then iconImg.ImageColor3 = targetIcon end
            end
        end

        b:GetAttributeChangedSignal("Active"):Connect(function() refreshBtnStateVisual(false) end)
        b:GetPropertyChangedSignal("Text"):Connect(function() refreshBtnStateVisual(false) end)
        refreshBtnStateVisual(false)
        task.defer(function() refreshBtnStateVisual(false) end)

        b.MouseEnter:Connect(function()
            playUISound(UISoundConfig.hover)
            local sc = Colors.Secondary or Color3.fromRGB(234, 138, 46)
            local panelElev = Colors.PanelElevated or Color3.fromRGB(30, 34, 44)
            local panelSoft = Colors.PanelSoft or Color3.fromRGB(20, 22, 28)
            local btText = tostring(b.Text or "")
            local btUpper = btText:upper()
            local isAct = (b:GetAttribute("Active") == true)
                or (btText:find("●", 1, true) ~= nil)
                or (btUpper:find(": ON", 1, true) ~= nil)
                or (btUpper:find("[ON]", 1, true) ~= nil)
                or (btUpper:find(" ON", 1, true) ~= nil and not btUpper:find("OFF", 1, true))
                or (btUpper:find("STOP", 1, true) ~= nil)
                or (btText:find("Вкл", 1, true) ~= nil or btText:find("вкл", 1, true) ~= nil or btText:find("ВКЛ", 1, true) ~= nil)
                or (btText:find("Стоп", 1, true) ~= nil or btText:find("стоп", 1, true) ~= nil or btText:find("СТОП", 1, true) ~= nil)
            local hBg = isAct and sc:Lerp(panelSoft, 0.3) or panelElev:Lerp(sc, 0.18)
            cancelActiveTweens()
            local tInfo = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            local twB = TweenService:Create(b, tInfo, {BackgroundColor3 = hBg, TextColor3 = sc})
            table.insert(activeTweens, twB)
            twB:Play()
            if bs then
                local twS = TweenService:Create(bs, tInfo, {Color = sc, Transparency = 0.15})
                table.insert(activeTweens, twS)
                twS:Play()
            end
            if iconImg then
                local twI = TweenService:Create(iconImg, tInfo, {ImageColor3 = sc})
                table.insert(activeTweens, twI)
                twI:Play()
            end
            tween(bScale, TweenInfo.new(0.08, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1.02}):Play()
        end)
        b.MouseLeave:Connect(function()
            refreshBtnStateVisual(true)
            tween(bScale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end)
        b.MouseButton1Click:Connect(function()
            playUISound(UISoundConfig.click)
            tween(bScale, TweenInfo.new(0.05, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 0.96}):Play()
            task.wait(0.05)
            tween(bScale, TweenInfo.new(0.08, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
            if cb then task.spawn(cb) end
            task.defer(function()
                task.wait(0.02)
                refreshBtnStateVisual(true)
            end)
        end)
        return b
    end

