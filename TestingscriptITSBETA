function waitForPistonSettle(pistonBlocks, maxWaitSec, progressCb)

    if not pistonBlocks or #pistonBlocks == 0 then return end
    maxWaitSec = maxWaitSec or 30
    local MOVEMENT_THRESHOLD = 0.05
    local CHECK_INTERVAL = 0.25
    local SETTLE_CONFIRM_TIME = 1.0

    local snapPos = {}
    local topParts = {}
    for _, pb in ipairs(pistonBlocks) do
        local tp = nil
        pcall(function()
            tp = pb:FindFirstChild("TopPart")
            if not tp then
                for _, d in ipairs(pb:GetDescendants()) do
                    if d:IsA("BasePart") and d.Name == "TopPart" then
                        tp = d; break
                    end
                end
            end
        end)
        if tp and tp:IsA("BasePart") then
            topParts[pb] = tp
            pcall(function() snapPos[pb] = tp.Position end)
        end
    end

    local startT = os.clock()
    local allSettled = false
    local settledAt = nil

    while os.clock() - startT < maxWaitSec do
        task.wait(CHECK_INTERVAL)

        local movingCount = 0
        local totalWithTopPart = 0
        for pb, tp in pairs(topParts) do
            local ok, newPos = pcall(function() return tp.Position end)
            if ok then
                totalWithTopPart = totalWithTopPart + 1
                local oldPos = snapPos[pb]
                if oldPos and (newPos - oldPos).Magnitude > MOVEMENT_THRESHOLD then
                    movingCount = movingCount + 1
                end
                snapPos[pb] = newPos
            end
        end

        local waited = os.clock() - startT
        if progressCb then
            progressCb(waited, movingCount, totalWithTopPart)
        end

        if movingCount == 0 then
            if not settledAt then
                settledAt = os.clock()
            end

            if os.clock() - settledAt >= SETTLE_CONFIRM_TIME then
                allSettled = true
                break
            end
        else

            settledAt = nil
        end
    end

    return allSettled
end

