function isRegularBlock(blockName)
    if not blockName or type(blockName) ~= "string" then return false end
    local lower = string.lower(blockName)
    return string.find(lower, "block") ~= nil
end

function buildDataToFlat(buildData, myZone)
    local regularFlat = {}
    local funcFlat = {}
    local scVec = Vector3.new(
        tonumber(Settings.scaleX) or tonumber(Settings.buildScale) or 1,
        tonumber(Settings.scaleY) or tonumber(Settings.buildScale) or 1,
        tonumber(Settings.scaleZ) or tonumber(Settings.buildScale) or 1
    )
    local off = Vector3.new(Settings.buildOffsetX or 0, Settings.buildOffsetY or 0, Settings.buildOffsetZ or 0)
    local fallbackIdCounter = 1

    local bCenter = (baseModelBounds and baseModelBounds.center) or Vector3.zero
    if (bCenter == Vector3.zero or not baseModelBounds or baseModelBounds.size == Vector3.zero) and buildData then
        local calcMin = Vector3.new(math.huge, math.huge, math.huge)
        local calcMax = Vector3.new(-math.huge, -math.huge, -math.huge)
        for _, blist in pairs(buildData) do
            if type(blist) == "table" then
                for _, bitem in pairs(blist) do
                    local bcf = getBlockCF(bitem)
                    if bcf then
                        local bp = bcf.Position
                        calcMin = Vector3.new(math.min(calcMin.X, bp.X), math.min(calcMin.Y, bp.Y), math.min(calcMin.Z, bp.Z))
                        calcMax = Vector3.new(math.max(calcMax.X, bp.X), math.max(calcMax.Y, bp.Y), math.max(calcMax.Z, bp.Z))
                    end
                end
            end
        end
        if calcMin.X < math.huge then
            bCenter = (calcMin + calcMax) * 0.5
        end
    end

    local orderedNames, seenName = {}, {}
    local keyOrder = buildData._SPRB_KeyOrder or _SPRB_AsuKeyOrder
    if type(keyOrder) == "table" then
        for _, nm in ipairs(keyOrder) do
            if buildData[nm] ~= nil and not seenName[nm] then
                seenName[nm] = true
                orderedNames[#orderedNames + 1] = nm
            end
        end
    end
    for nm in pairs(buildData) do
        if not seenName[nm] and nm:sub(1,1) ~= "_" then
            orderedNames[#orderedNames + 1] = nm
        end
    end

    for _, blockName in ipairs(orderedNames) do
        local blocks = buildData[blockName]
        if type(blocks) ~= "table" then continue end

        if Settings.excludedBlocks[blockName] then continue end

        local effectiveName = blockName
        if Settings.blockReplacements and Settings.blockReplacements[blockName] then
            effectiveName = Settings.blockReplacements[blockName]
        end
        local regular = isRegularBlock(effectiveName)
        for _, bi in pairs(blocks) do
            local relCF = getBlockCF(bi) or CFrame.new()
            local delta = relCF.Position - bCenter
            local pos = bCenter + Vector3.new(delta.X * scVec.X, delta.Y * scVec.Y, delta.Z * scVec.Z) + off
            local scaledCF = CFrame.new(pos) * relCF.Rotation
            local worldCF = myZone.CFrame:ToWorldSpace(scaledCF)
            local hasSz = bi.Size ~= nil and bi.Size ~= ""
            local rawSz = hasSz and strV3(bi.Size) or (regular and Vector3.new(2, 2, 2) or nil)
            local sz = rawSz and Vector3.new(rawSz.X * scVec.X, rawSz.Y * scVec.Y, rawSz.Z * scVec.Z) or nil
            hasSz = (sz ~= nil)
            local rawCol = (bi.Col ~= nil and bi.Col ~= "" and bi.Col)
                or (bi.Color ~= nil and bi.Color ~= "" and bi.Color)
                or (bi.color ~= nil and bi.color ~= "" and bi.color)
                or (bi.cl ~= nil and bi.cl ~= "" and bi.cl)
            local col = rawCol and strCol(rawCol) or nil
            local hasCo = (col ~= nil)
            local mergedBoolValues, mergedNumberValues = mergePropertyMaps(bi.BoolValues, bi.NumberValues, bi.ASUExtra, bi.MValues)

            do
                local flatNums = {
                    ServoTorque = true, ServoSpeed = true, WheelTorque = true, MaxSpeed = true,
                    ExtendLength = true, Speed = true, WaitDuration = true, FuseTime = true,
                    FlightDistance = true, SemitoneOffset = true, HeadScale = true, HeightScale = true,
                    WidthScale = true, DepthScale = true, MaxForce = true, Stiffness = true,
                    Damping = true, TargetLength = true, MaxLength = true, MinLength = true,
                    Length = true, AngleLimit = true, LastDirection = true, LastDirrection = true,
                    Density = true, Weight = true,
                }
                for fk in pairs(flatNums) do
                    local fv = bi[fk]
                    if fv ~= nil and mergedNumberValues[fk] == nil and type(fv) ~= "table" then
                        local fnv = tonumber(fv)
                        if fnv ~= nil then mergedNumberValues[fk] = fnv end
                    end
                end
                if bi.Density ~= nil and mergedNumberValues.Density == nil then
                    local dn = tonumber(bi.Density)
                    if dn ~= nil then mergedNumberValues.Density = dn end
                end
                local flatBools = {
                    ReverseRotation = true, ReverseSpin = true, MatchRotation = true,
                    ShowConstraint = true, Invertible = true, ShowCrosshairs = true, Legacy = true,
                    Forward = true, Backward = true,
                }
                for fk in pairs(flatBools) do
                    local fv = bi[fk]
                    if fv ~= nil and mergedBoolValues[fk] == nil then
                        if type(fv) == "boolean" then mergedBoolValues[fk] = fv
                        elseif fv == 1 then mergedBoolValues[fk] = true
                        elseif fv == 0 then mergedBoolValues[fk] = false end
                    end
                end
            end
            local assignedId = bi.ID or fallbackIdCounter
            fallbackIdCounter = fallbackIdCounter + 1
            local entry = {
                Name = effectiveName,
                ID = assignedId,
                worldCF = worldCF,
                skyWorldCF = nil,
                Relative = myZone,
                Size = sz,
                Col = col,
                hasSz = hasSz,
                hasCo = hasCo,
                isRegular = regular,
                slotCount = regular and calcSlots(sz) or 1,
                Transparency = bi.Transparency,
                Anchored = bi.Anchored,
                CanCollide = bi.CanCollide,
                ShowShadow = bi.ShowShadow,
                BoolValues = mergedBoolValues,
                NumberValues = mergedNumberValues,
                LastDirection = mergedNumberValues.LastDirection or bi.LastDirection,
                Forward = mergedBoolValues.Forward or bi.Forward,
                Backward = mergedBoolValues.Backward or bi.Backward,
                BindTable = bi.BindTable,
                ASUExtra = bi.ASUExtra,
                IsTwoPart = (bi.SecondaryPartPosition ~= nil
                    or (bi.ASUExtra and bi.ASUExtra.SecondaryPartPosition ~= nil)
                    or (bi.SecCFrame ~= nil)
                    or (bi.ASUExtra and bi.ASUExtra.SecCFrame ~= nil)),
                SecondaryWorldCF = nil,
            }
            if entry.IsTwoPart then

                local rawSecCF = bi.SecCFrame or (bi.ASUExtra and bi.ASUExtra.SecCFrame)
                local secNums = nil
                if type(rawSecCF) == "table" then
                    secNums = {}
                    for _, snv in ipairs(rawSecCF) do secNums[#secNums + 1] = tonumber(snv) end
                elseif type(rawSecCF) == "string" then
                    secNums = parseNumList(rawSecCF)
                end
                if not (secNums and #secNums >= 3) then
                    secNums = parseNums(bi.SecondaryPartPosition or (bi.ASUExtra and bi.ASUExtra.SecondaryPartPosition))
                end
                local ppRotCF = relCF.Rotation
                if secNums and #secNums >= 12 then
                    local secRelCF = CFrame.new(table.unpack(secNums))
                    local secPos = secRelCF.Position
                    local scaledSecPos = Vector3.new(secPos.X * scVec.X, secPos.Y * scVec.Y, secPos.Z * scVec.Z) + off
                    entry.SecondaryWorldCF = myZone.CFrame:ToWorldSpace(CFrame.new(scaledSecPos) * secRelCF.Rotation)
                elseif secNums and #secNums >= 3 then
                    local secPosV = Vector3.new(secNums[1] * scVec.X, secNums[2] * scVec.Y, secNums[3] * scVec.Z) + off
                    entry.SecondaryWorldCF = myZone.CFrame:ToWorldSpace(CFrame.new(secPosV) * ppRotCF)
                else
                    entry.SecondaryWorldCF = myZone.CFrame:ToWorldSpace(CFrame.new(Vector3.zero) * ppRotCF)
                end
                entry.SpringProps = {}

                local extra = bi.ASUExtra or {}
                local numV = bi.NumberValues or {}
                local function getProp(k)
                    if bi[k] ~= nil then return bi[k] end
                    if numV[k] ~= nil then return numV[k] end
                    if extra[k] ~= nil then return extra[k] end
                    return nil
                end
                local stiff = getProp("Stiffness")
                if stiff then entry.SpringProps.Stiffness = tostring(stiff) end
                local damp = getProp("Damping")
                if damp then entry.SpringProps.Damping = tostring(damp) end
                local tl = getProp("TargetLength")
                if tl then entry.SpringProps.TargetLength = tostring(tl) end
                local mxl = getProp("MaxLength")
                if mxl then entry.SpringProps.MaxLength = tostring(mxl) end
                local mnl = getProp("MinLength")
                if mnl then entry.SpringProps.MinLength = tostring(mnl) end
                local ln = getProp("Length")
                if ln then entry.SpringProps.Length = tostring(ln) end
                local al = getProp("AngleLimit")
                if al then entry.SpringProps.AngleLimit = tostring(al) end
                local mr = getProp("MatchRotation")
                if mr ~= nil then entry.SpringProps.MatchRotation = mr end
                local sc2 = getProp("ShowConstraint")
                if sc2 ~= nil then entry.SpringProps.ShowConstraint = sc2 end
            end
            if regular then
                regularFlat[#regularFlat+1] = entry
            else
                funcFlat[#funcFlat+1] = entry
            end
        end
    end

    local flat = {}
    for _, v in ipairs(regularFlat) do flat[#flat+1] = v end
    for _, v in ipairs(funcFlat) do flat[#flat+1] = v end

    local skyBaseY = 10000
    local spacingY = 25
    local myZonePos = myZone and myZone.Position or Vector3.new(0, 0, 0)

    for i, v in ipairs(flat) do
        if v.isRegular then
            local skyY = skyBaseY + (i - 1) * spacingY
            local skyPos = Vector3.new(myZonePos.X, skyY, myZonePos.Z)
            local rotOnly = (v.worldCF and (v.worldCF - v.worldCF.Position)) or CFrame.new()
            v.skyWorldCF = CFrame.new(skyPos) * rotOnly
        else

            v.skyWorldCF = v.worldCF
        end
    end

    return flat
end

