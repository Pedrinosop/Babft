            Settings.buildOffsetY = 0
            Settings.buildOffsetZ = 0

            Settings.buildRotX = 0
            Settings.buildRotY = 0
            Settings.buildRotZ = 0

            Settings.excludedBlocks = {}
            Settings.blockReplacements = {}

            local buildOk, placedIds
            local okExec, _ = pcall(function()
                buildOk, placedIds = pasteBuild(buildData, function(msg, pct)
