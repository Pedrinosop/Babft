function showNotification(text, notifType, duration)
    if not Settings or not NotificationContainer then return end
    text = tostring(text or "")
    notifType = notifType or "info"
    duration = math.clamp(tonumber(duration) or 3, 1.5, 12)
    local now = os.clock()

    if text == _lastNotifText and (now - _lastNotifTime) < NOTIF_DUPE_WINDOW then
        _lastNotifTime = now
        return
    end
    _lastNotifText = text
    _lastNotifTime = now

    while #_notifications >= NOTIF_MAX_VISIBLE do
        local oldest = table.remove(_notifications, 1)
        if oldest then pcall(function() oldest:Destroy() end) end
    end

    local sc = Settings.secondaryColor or Color3.fromRGB(59, 130, 246)
    local pc = Settings.primaryColor or Color3.fromRGB(15, 17, 21)
    local gt = tonumber(Settings.guiTransparency) or 0.2
    local cardTrans = math.clamp(gt + 0.35, 0.45, 0.85)

    local accents = {
        info    = sc,
        success = Color3.fromRGB(90, 220, 110),
        warn    = Color3.fromRGB(255, 190, 70),
        error   = Color3.fromRGB(255, 105, 105),
        stage   = pc:Lerp(Color3.fromRGB(255, 255, 255), 0.3),
