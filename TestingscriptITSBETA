        local b = entry.block
        if b and b.Parent and CONTROLLER_LEGACY_NAMES[b.Name] then
            local bv = entry.v and entry.v.BoolValues

            local wantLegacy = false
            if bv and bv.Legacy == true then
                wantLegacy = true
            end
            if wantLegacy then
                local alreadyLegacy = false
                pcall(function()
                    if b.HasTag and b:HasTag("Legacy") then alreadyLegacy = true end
                    local tag = b:FindFirstChild("Legacy") or (b.PPart and b.PPart:FindFirstChild("Legacy"))
                    if tag and tag:IsA("BoolValue") and tag.Value == true then
                        alreadyLegacy = true
                    end
                end)
                if not alreadyLegacy then
                    targets[#targets + 1] = b
                end
            end
        end
    end
    if #targets == 0 then return 0 end
    for i = 1, #targets, 40 do
        local chunk = {}
        for j = i, math.min(i + 39, #targets) do chunk[#chunk + 1] = targets[j] end
