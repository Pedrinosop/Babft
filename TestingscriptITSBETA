                if (_SG.shapeType or "") == "polygon" then
                    setStatus("  Polygon: use its own Preview / FILL buttons")
                else
                    setStatus("  Empty shape")
                end
                return
            end
            currentBuild = bData
            clearPreview()
            createPreview(currentBuild)
            updateShapePreviewBtnText()
            local count = 0
            for _, arr in pairs(currentBuild) do if type(arr) == "table" then count = count + #arr end end
            setStatus(string.format("  Preview: %d blocks", count))
        end)

