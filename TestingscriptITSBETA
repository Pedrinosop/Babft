function parseNums(s)
    if type(s) ~= "string" then return {} end
    local r = {}
    for p in s:gmatch("[^,%s]+") do
        local n = tonumber(p)
        if n then table.insert(r, n) end
    end
    return r
end

function strV3(s)
    if typeof and typeof(s) == "Vector3" then return s end
    if type(s) == "string" then
        local c = {}
        for v in s:gmatch("[^,]+") do table.insert(c, tonumber(v:match("^%s*(.-)%s*$")) or 0) end
        return #c >= 3 and Vector3.new(c[1],c[2],c[3]) or Vector3.new(0,0,0)
    elseif type(s) == "table" then
        local x = tonumber(s[1] or s.X or s.x) or 0
        local y = tonumber(s[2] or s.Y or s.y) or 0
        local z = tonumber(s[3] or s.Z or s.z) or 0
        return Vector3.new(x, y, z)
    end
    return Vector3.new(0,0,0)
end

function v3Str(v) return string.format("%.4f,%.4f,%.4f", v.X, v.Y, v.Z) end

function strCF(s)
    if typeof and typeof(s) == "CFrame" then return s end
    if type(s) ~= "string" then return nil end
    local c = {}
    for v in s:gmatch("[^,]+") do
        local n = tonumber(v:match("^%s*(.-)%s*$"))
        if n then table.insert(c, n) end
    end
    if #c >= 12 then
        return CFrame.new(table.unpack(c))
    elseif #c >= 3 then
        return CFrame.new(c[1], c[2], c[3])
    end
    return nil
end

function colStr(c) return string.format("%.4f,%.4f,%.4f", c.R, c.G, c.B) end
function strCol(s)
    if typeof and typeof(s) == "Color3" then return s end
    if type(s) ~= "string" then return Color3.new(1,1,1) end
    local c = {}
    for v in s:gmatch("[^,]+") do table.insert(c, tonumber(v) or 1) end
    if #c >= 3 then
        local r,g,b = c[1],c[2],c[3]
        if r > 1 or g > 1 or b > 1 then
            r = r/255; g = g/255; b = b/255
        end
        return Color3.new(math.clamp(r,0,1), math.clamp(g,0,1), math.clamp(b,0,1))
    end
    return Color3.new(1,1,1)
end

function getBlockCF(bi)
    if not bi then return nil end
    if typeof and typeof(bi.CFrame) == "CFrame" then return bi.CFrame end
    if bi.CFrame then
        if type(bi.CFrame) == "string" then
            local cf = strCF(bi.CFrame)
            if cf then return cf end
        elseif type(bi.CFrame) == "table" and #bi.CFrame >= 12 then
            return CFrame.new(table.unpack(bi.CFrame))
        elseif type(bi.CFrame) == "table" and #bi.CFrame >= 3 then
            return CFrame.new(tonumber(bi.CFrame[1]) or 0, tonumber(bi.CFrame[2]) or 0, tonumber(bi.CFrame[3]) or 0)
        end
    end
    if bi.cf then
        if typeof and typeof(bi.cf) == "CFrame" then return bi.cf end
        if type(bi.cf) == "string" then
            local cf = strCF(bi.cf)
            if cf then return cf end
        elseif type(bi.cf) == "table" and #bi.cf >= 12 then
            return CFrame.new(table.unpack(bi.cf))
        elseif type(bi.cf) == "table" and #bi.cf >= 3 then
            return CFrame.new(tonumber(bi.cf[1]) or 0, tonumber(bi.cf[2]) or 0, tonumber(bi.cf[3]) or 0)
        end
    end
    if bi.CF then
        if typeof and typeof(bi.CF) == "CFrame" then return bi.CF end
        if type(bi.CF) == "string" then
            local cf = strCF(bi.CF)
            if cf then return cf end
        elseif type(bi.CF) == "table" and #bi.CF >= 12 then
            return CFrame.new(table.unpack(bi.CF))
        elseif type(bi.CF) == "table" and #bi.CF >= 3 then
            return CFrame.new(tonumber(bi.CF[1]) or 0, tonumber(bi.CF[2]) or 0, tonumber(bi.CF[3]) or 0)
        end
    end

    local posRaw = bi.Position or bi.position or bi.Pos or bi.pos or bi.p
    local rotRaw = bi.Rotation or bi.rotation or bi.Rot or bi.rot or bi.r
    if posRaw then
        local pos = strV3(posRaw)
        if rotRaw then
            local r = {}
            if type(rotRaw) == "string" then
                for v in rotRaw:gmatch("[^,]+") do
                    local n = tonumber(v:match("^%s*(.-)%s*$"))
                    if n then table.insert(r, math.rad(n)) end
                end
            elseif type(rotRaw) == "table" then
                for i = 1, 3 do
                    local v = rotRaw[i] or rotRaw[("XYZ"):sub(i,i)] or rotRaw[("xyz"):sub(i,i)]
                    table.insert(r, math.rad(tonumber(v) or 0))
                end
            elseif typeof and typeof(rotRaw) == "Vector3" then
                r = {math.rad(rotRaw.X), math.rad(rotRaw.Y), math.rad(rotRaw.Z)}
            end
            if #r >= 3 then
                return CFrame.new(pos) * CFrame.Angles(r[1], r[2], r[3])
            end
        end
        return CFrame.new(pos)
    end
    return CFrame.new(0, 0, 0)
end

