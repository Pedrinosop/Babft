            end
        end
        if not currentBuild or not next(currentBuild) then return end

        local totalNeeded = 0
        local totalHave = 0
        local blockStats = {}
        local scVec = Vector3.new(
            tonumber(Settings.scaleX) or tonumber(Settings.buildScale) or 1,
            tonumber(Settings.scaleY) or tonumber(Settings.buildScale) or 1,
            tonumber(Settings.scaleZ) or tonumber(Settings.buildScale) or 1
        )
        for blockName, blocks in pairs(currentBuild) do
            if type(blocks) == "table" then
                local regular = isRegularBlock(blockName)
                local needed = 0
                for _, bi in pairs(blocks) do
                    local sz = nil
                    if regular then
                        local raw = (bi and bi.Size and bi.Size ~= "") and strV3(bi.Size) or Vector3.new(2, 2, 2)
                        sz = Vector3.new(raw.X * scVec.X, raw.Y * scVec.Y, raw.Z * scVec.Z)
                    end
                    needed = needed + (regular and calcSlots(sz) or 1)
                end
                local have = getRealBlockCount(blockName)
                totalNeeded = totalNeeded + needed
                totalHave = totalHave + math.min(have, needed)
                blockStats[blockName] = {needed=needed, have=have, count=#blocks, regular=regular}
            end
