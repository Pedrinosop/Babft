            R.isRunning = false
            return
        end

        task.spawn(function()
            updateStatus((L("Deleting") or "Deleting") .. " " .. totalBlocks .. "...")
            for _, b in ipairs(toReplace) do
                task.spawn(function()
                    if b and b.Parent then
                        pcall(function() deleteRF:InvokeServer(b) end)
                    end
                end)
            end
            task.wait(0.1)
            for _, b in ipairs(toReplace) do
                if b and b.Parent then
