    sfSelBtn.MouseButton1Click:Connect(function()
        if sfActive then
            sfActive = false
            if sfConn then pcall(function() sfConn:Disconnect() end) sfConn = nil end
        else
            sfActive = true
            local mouse = LocalPlayer:GetMouse()
            if mouse then
                if sfConn then pcall(function() sfConn:Disconnect() end) end

                sfConn = mouse.Button1Down:Connect(function()
                    if not sfActive then if sfConn then sfConn:Disconnect() sfConn = nil end return end
                    if #sfVerts >= sfGetVertCount() then return end
                    local camera = Workspace.CurrentCamera
                    if not camera then return end
                    local ray = camera:ScreenPointToRay(mouse.X, mouse.Y)
                    local rayParams = RaycastParams.new()
                    rayParams.FilterType = Enum.RaycastFilterType.Include
                    local folder = BlocksFolder:FindFirstChild(LocalPlayer.Name)
                    if not folder then return end
                    local desc = {}
                    pcall(function()
                        for _, b in ipairs(folder:GetChildren()) do
                            if b:FindFirstChild("PPart") then desc[#desc + 1] = b.PPart end
                        end
                    end)
                    rayParams.FilterDescendantsInstances = desc
                    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
                    if result and result.Instance and result.Position then
                        local pp = result.Instance.Parent and result.Instance.Parent:FindFirstChild("PPart")
                        if not pp then pp = result.Instance end
                        if pp then
                            local bCF = pp.CFrame
                            local bSize = pp.Size
                            local bestCorner, bestDist = nil, math.huge
                            for sx = -1, 1, 2 do for sy = -1, 1, 2 do for sz2 = -1, 1, 2 do
                                local corner = bCF * Vector3.new(bSize.X / 2 * sx, bSize.Y / 2 * sy, bSize.Z / 2 * sz2)
                                local d = (corner - result.Position).Magnitude
                                if d < bestDist then bestDist = d; bestCorner = corner end
                            end end end
                            if bestCorner then
                                sfVerts[#sfVerts + 1] = bestCorner
                                sfRefreshView()
                                showNotification("Corner " .. #sfVerts .. "/" .. sfGetVertCount() .. " selected", "info", 1.2)
                                if #sfVerts >= sfGetVertCount() then
                                    showNotification("Selection ready! Press FILL!", "success", 3)
