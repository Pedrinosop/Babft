    local function finalizeCleanup()
        pcall(function() if targetGui then targetGui:Destroy() end end)
        pcall(function()
            local cg = game:GetService("CoreGui")
            for _, o in pairs(cg:GetChildren()) do
                if o.Name:find("SPRB") or o.Name:find("CScript_") then pcall(function() o:Destroy() end) end
            end
        end)
        pcall(function()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
