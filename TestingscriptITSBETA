        local PLACE_BATCH = 60
    local STYLE_BATCH = 90
    local MOVE_BATCH = 90

    local function runPlacePhase(subset, label, p0, p1)
        local delayTime = Settings.buildSpeed > 0 and Settings.buildSpeed * 0.01 or 0
        if delayTime == 0 then

            local BATCH = 80
            for i = 1, #subset do
                if stopBuild then break end
                local v = subset[i]
                if not v._preplacedBlock then
                    task.spawn(fastPlace, v)
                end
                if i % BATCH == 0 then
                    RunService.Heartbeat:Wait()
                    updProg(label .. i .. "/" .. #subset, p0 + math.floor((i / math.max(1, #subset)) * (p1 - p0)))
                end
                if #subset > 3000 and i % 300 == 0 then
                    task.wait(0.01)
                end
            end
            task.wait(0.2)
        else
            local BATCH = 20
            for i = 1, #subset do
                if stopBuild then break end
                local v = subset[i]
                if not v._preplacedBlock then
                    fastPlace(v)
                end
                if i % BATCH == 0 then
                    task.wait(delayTime)
                    updProg(label .. i .. "/" .. #subset, p0 + math.floor((i / math.max(1, #subset)) * (p1 - p0)))
                end
            end
        end
        updProg(label .. #subset .. " placed", p1)
    end

    local function runStylePhase(subset, baseList, used, p0, p1)
        local regularStyled = {}
        local funcStyled = {}
        local paintQueue = {}
        local unmatched = {}

        local newBase = {}
        for _, blk in ipairs(baseList) do
            if blk and blk.Parent and blk.Name and not preExistingBlocks[blk] then
                newBase[#newBase + 1] = blk
            end
        end

        local nameGroups = {}
        for _, blk in ipairs(newBase) do
            if blk and blk.Parent and blk.Name then
                nameGroups[blk.Name] = nameGroups[blk.Name] or {}
                table.insert(nameGroups[blk.Name], blk)
            end
        end
        local nameIdx = {}

        for i = 1, #subset do
            if stopBuild then break end
            local v = subset[i]
            local b = v._preplacedBlock
            if not b then
                if not v.isRegular then

                    local targetPos = v.worldCF and v.worldCF.Position or Vector3.zero
                    b = findNearest(v.Name, targetPos, (nameGroups and nameGroups[v.Name]) or newBase, used)
                else
                    nameIdx[v.Name] = (nameIdx[v.Name] or 0) + 1
                    local group = nameGroups[v.Name]
                    if group then
                        for j = nameIdx[v.Name], #group do
                            local candidate = group[j]
                            if candidate and candidate.Parent and not used[candidate] and candidate:FindFirstChild("PPart") then
                                b = candidate
                                used[b] = true
                                nameIdx[v.Name] = j
                                break
                            end
                        end
                    end

                    if not b and group and #group > 0 then
                        b = findNearest(v.Name, v.skyWorldCF and v.skyWorldCF.Position or Vector3.zero, group, used)
                    end
                end
            end
                        if b and b:FindFirstChild("PPart") then
                                if v.ID ~= nil then
                                        placedById[v.ID] = b
                                        placedById[tostring(v.ID)] = b
                                end
                                if v.isRegular then
                                        if v.hasCo and v.Col then
                                                paintQueue[#paintQueue+1] = {b, v.Col}
                                        end
                                        if v.hasSz and v.Size then
                                                fastRescale(b, v.skyWorldCF, v.Size)
                                                regularStyled[#regularStyled+1] = {block=b, worldCF=v.worldCF, v=v}
                                        else
                                                pcall(function() b.PPart.CFrame = v.skyWorldCF end)
                                                regularStyled[#regularStyled+1] = {block=b, worldCF=v.worldCF, v=v}
                                        end
                                else
                                        funcStyled[#funcStyled+1] = {block=b, worldCF=v.worldCF, v=v}
                                end
                        else
                                unmatched[#unmatched+1] = v
                        end
                end

                if #unmatched > 0 then
                        logBuild(string.format("Initial style phase had %d unmatched blocks, retrying replication...", #unmatched), "STYLE", "RETRY")
                        for retryAttempt = 1, 6 do
                            if #unmatched == 0 or stopBuild then break end
                            updProg(string.format("Waiting for %d replicated blocks (pass %d/6)...", #unmatched, retryAttempt), p0 + 60)
                            task.wait(0.35)
                            local refreshedBase = {}
                            for _, blk in ipairs(folder:GetChildren()) do
                                    if blk and blk.Parent and blk.Name and not used[blk] and not preExistingBlocks[blk] then
                                            refreshedBase[#refreshedBase + 1] = blk
                                    end
                            end
                            local refreshedGroups = {}
                            for _, blk in ipairs(refreshedBase) do
                                    if blk and blk.Parent and blk.Name then
                                            refreshedGroups[blk.Name] = refreshedGroups[blk.Name] or {}
                                            table.insert(refreshedGroups[blk.Name], blk)
                                    end
                            end
                            local stillUnmatched = {}
                            for _, v in ipairs(unmatched) do
                                    if stopBuild then break end
                                    local b = nil
                                    if not v.isRegular then
                                        local targetPos = v.worldCF and v.worldCF.Position or Vector3.zero
                                        b = findNearest(v.Name, targetPos, (refreshedGroups and refreshedGroups[v.Name]) or refreshedBase, used)
                                    else
                                        local grp = refreshedGroups[v.Name]
                                        if grp then
                                                for j = 1, #grp do
                                                        local candidate = grp[j]
                                                        if candidate and candidate.Parent and not used[candidate] and candidate:FindFirstChild("PPart") then
                                                                b = candidate
                                                                used[b] = true
                                                                break
                                                        end
                                                end
                                        end
                                        if not b then
                                                b = findNearest(v.Name, v.skyWorldCF and v.skyWorldCF.Position or v.worldCF.Position, refreshedBase, used)
                                        end
                                    end
                                    if b and b:FindFirstChild("PPart") then
                                            used[b] = true
                                            if v.ID ~= nil then
                                                    placedById[v.ID] = b
                                                    placedById[tostring(v.ID)] = b
                                            end
                                            if v.isRegular then
                                                    if v.hasCo and v.Col then
                                                            paintQueue[#paintQueue+1] = {b, v.Col}
                                                    end
                                                    if v.hasSz and v.Size then
                                                            fastRescale(b, v.skyWorldCF, v.Size)
                                                            regularStyled[#regularStyled+1] = {block=b, worldCF=v.worldCF, v=v}
                                                    else
                                                            pcall(function() b.PPart.CFrame = v.skyWorldCF end)
                                                            regularStyled[#regularStyled+1] = {block=b, worldCF=v.worldCF, v=v}
                                                    end
                                            else
                                                    funcStyled[#funcStyled+1] = {block=b, worldCF=v.worldCF, v=v}
                                            end
                                    else
                                            stillUnmatched[#stillUnmatched + 1] = v
                                    end
                            end
                            unmatched = stillUnmatched
                        end
                        if #unmatched > 0 then
                            logBuild(string.format("WARNING: %d blocks remained unmatched after replication retries", #unmatched), "STYLE", "WARN")
                        end
                end

                updProg("Painting " .. #paintQueue .. " blocks...", p0 + 70)
                if #paintQueue > 0 then
                        batchPaintSync(paintQueue)
                end

                local allStyled = {}
                for _, e in ipairs(regularStyled) do allStyled[#allStyled+1] = e end
                for _, e in ipairs(funcStyled) do allStyled[#allStyled+1] = e end

                return allStyled
        end

