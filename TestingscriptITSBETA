                for i = 1, 65 do
                    local p = Instance.new("Frame")
                    local isSmoke = (i > 50)
                    local sz = isSmoke and math.random(24, 48) or math.random(6, 18)
                    p.Size = UDim2.new(0, sz, 0, sz)
                    p.Position = UDim2.new(0, centerPx.X - sz / 2, 0, centerPx.Y - sz / 2)
                    p.BackgroundColor3 = isSmoke and Color3.fromRGB(50, 45, 50) or emberColors[math.random(1, #emberColors)]
                    p.BackgroundTransparency = isSmoke and 0.4 or 0
                    p.BorderSizePixel = 0
                    p.ZIndex = 9999
                    local sc = Instance.new("UICorner"); sc.CornerRadius = UDim.new(isSmoke and 1 or 0, isSmoke and 0 or math.random(2, 6)); sc.Parent = p
                    p.Parent = targetGui

                    local angle = math.random() * math.pi * 2
                    local dist = isSmoke and math.random(80, 280) or math.random(200, 950)
                    local dx = math.cos(angle) * dist
                    local dy = math.sin(angle) * dist - (isSmoke and math.random(50, 150) or 0)
                    local rot = math.random(-900, 900)
                    local dur = isSmoke and 0.7 or (0.35 + math.random() * 0.25)

                    TweenService:Create(p, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                        Position = UDim2.new(0, centerPx.X + dx, 0, centerPx.Y + dy),
                        Rotation = rot,
                        BackgroundTransparency = 1,
                        Size = isSmoke and UDim2.new(0, sz * 1.8, 0, sz * 1.8) or UDim2.new(0, 0, 0, 0)
                    }):Play()
                    task.delay(dur + 0.1, function() pcall(function() p:Destroy() end) end)
                end
            end

            for _, desc in ipairs(mf:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                    TweenService:Create(desc, TweenInfo.new(0.15), {TextTransparency = 1}):Play()
                elseif desc:IsA("ImageLabel") or desc:IsA("ImageButton") then
                    TweenService:Create(desc, TweenInfo.new(0.15), {ImageTransparency = 1}):Play()
                end
            end

            TweenService:Create(mf, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                Size = UDim2.new(0, 0, 0, 0),
                Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + absSize.X / 2, origPos.Y.Scale, origPos.Y.Offset + absSize.Y / 2),
                BackgroundTransparency = 1,
            }):Play()

            task.wait(0.35)
            finalizeCleanup()
        end)
    else
        finalizeCleanup()
    end
end

