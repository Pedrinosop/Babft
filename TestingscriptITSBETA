            searchBox.Text = ""
            for _, ob in ipairs(optionBtns) do pcall(function() ob:Destroy() end) end
            optionBtns = {}
            local opts = getOpts()
            if type(opts) ~= "table" then opts = {} end
            currentOpts = opts
            populateList("")

            if isOpen and container.Visible then
                local cw2, ch2 = layoutPopup()
                TweenService:Create(container, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, cw2, 0, ch2)}):Play()
            end
        end

