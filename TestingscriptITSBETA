            local isBlock = block.Name:sub(-5) == "Block"
            local realTransp = ppart.Transparency
            if not isBlock and block.Name ~= "Sign" then
                for _, desc in pairs(block:GetChildren()) do
                    if (desc:IsA("BasePart") or desc:IsA("UnionOperation")) and desc ~= ppart and desc.Transparency < 1 then
                        realTransp = desc.Transparency
                        break
                    end
                end
            end
            buildData[block.Name] = buildData[block.Name] or {}
            local blockCol = ppart.Color
            local colVal = colStr(blockCol)
            if block.Name == "Sign" and isDefaultSignColor(blockCol) then
                colVal = nil
            end
            local entry = {
                CFrame = cfStr(relCF),
                Size = v3Str(ppart.Size),
                Col = colVal,
                Transparency = realTransp,
                Anchored = ppart.Anchored,
                CanCollide = ppart.CanCollide,
                ShowShadow = ppart.CastShadow ~= false,
                ID = idCounter,
            }
            idCounter = idCounter + 1
            local boolVals = {}
            local numVals = {}
            for _, child in pairs(block:GetChildren()) do
                if child:IsA("BoolValue") then
                    boolVals[child.Name] = child.Value
                elseif (child:IsA("NumberValue") or child:IsA("IntValue")) and not child.Name:find("^Bind") then
                    numVals[child.Name] = child.Value
                end
            end
            for _, child in pairs(ppart:GetChildren()) do
                if child:IsA("BoolValue") then
                    boolVals[child.Name] = child.Value
                elseif (child:IsA("NumberValue") or child:IsA("IntValue")) and not child.Name:find("^Bind") then
                    numVals[child.Name] = child.Value
                end
            end

            pcall(function()
                local cpp = ppart.CustomPhysicalProperties
                if cpp then
                    numVals.Density = cpp.Density
                end
            end)

            pcall(function()
                local bn = block.Name
                if bn == "Note" then
                    local noteText = nil
                    pcall(function()
                        local base = block:FindFirstChild("Base")
                        local sg = base and base:FindFirstChild("SurfaceGui1")
                        if sg and sg:FindFirstChildOfClass("TextLabel") then
                            noteText = sg:FindFirstChildOfClass("TextLabel").Text
                        end
                    end)
                    if not noteText then
                        pcall(function()
                            for _, desc in ipairs(block:GetDescendants()) do
                                if desc:IsA("TextLabel") and desc.Parent:IsA("SurfaceGui") then
                                    noteText = desc.Text
                                    break
                                end
                            end
                        end)
                    end

                    local notePitch = nil
                    pcall(function()
                        notePitch = block:GetAttribute("Key") or block:GetAttribute("Pitch") or block:GetAttribute("NotePitch")
                        if not notePitch and block:FindFirstChild("Base") then
                            notePitch = block.Base:GetAttribute("Key") or block.Base:GetAttribute("Pitch")
                        end
                    end)

                    if not notePitch and noteText then
                        local NOTE_MAP = {
                            ["F#"] = 0, ["G"] = 1, ["G#"] = 2, ["A"] = 3, ["A#"] = 4, ["B"] = 5,
                            ["C"] = 6, ["C#"] = 7, ["D"] = 8, ["D#"] = 9, ["E"] = 10, ["F"] = 11,
                        }
                        local basePitch = NOTE_MAP[noteText:upper()]
                        if basePitch then
                            local sound = block:FindFirstChildOfClass("Sound", true)
                            if sound and sound.PlaybackSpeed and sound.PlaybackSpeed > 0 then
                                local octRatio = sound.PlaybackSpeed
                                if octRatio > 1.9 then
                                    notePitch = basePitch + 12
                                    if noteText:upper() == "F#" and octRatio > 3.8 then notePitch = 24 end
                                else
                                    notePitch = basePitch
                                end
                            else
                                notePitch = basePitch
                            end
                        end
                    end

                    if notePitch then
                        numVals.NotePitch = notePitch
                        numVals.Key = notePitch
                        entry.NotePitch = notePitch
                    end
                    if noteText then
                        entry.Note = noteText
                    end
                elseif bn == "Sign" then
                    local signText = nil
                    pcall(function()
                        local pp = block:FindFirstChild("PPart")
                        if pp then
                            local sg = pp:FindFirstChildOfClass("SurfaceGui") or pp:FindFirstChild("SurfaceGui")
                            if sg then
                                local tl = sg:FindFirstChildOfClass("TextLabel") or sg:FindFirstChild("TextLabel")
                                if tl and tl.Text and tl.Text ~= "" then
                                    signText = tl.Text
                                end
                            end
                        end
                    end)
                    if not signText then
                        pcall(function()
                            for _, desc in ipairs(block:GetDescendants()) do
                                if desc:IsA("TextLabel") and desc.Text and desc.Text ~= "" then
                                    signText = desc.Text
                                    break
                                end
                            end
                        end)
                    end
                    if not signText then
                        pcall(function()
                            for _, desc in ipairs(block:GetDescendants()) do
                                if desc:IsA("StringValue") and desc.Value and desc.Value ~= "" then
                                    signText = desc.Value
                                    break
                                end
                            end
                        end)
                    end
                    if not signText then
                        pcall(function()
                            signText = block:GetAttribute("Text") or block:GetAttribute("SignText")
                            if not signText and block:FindFirstChild("PPart") then
                                signText = block.PPart:GetAttribute("Text") or block.PPart:GetAttribute("SignText")
                            end
                        end)
                    end
                    if signText and tostring(signText) ~= "" then
                        entry.Text = tostring(signText)
                        entry.SignText = tostring(signText)
                        entry.txt = tostring(signText)
                        entry.StringValues = entry.StringValues or {}
                        entry.StringValues.Text = tostring(signText)
                        entry.StringValues.SignText = tostring(signText)
                    end
                elseif bn == "Servo" then
                    local hc = ppart:FindFirstChildOfClass("HingeConstraint")
                    if hc then
                        numVals.ServoTorque = hc.ServoMaxTorque
                        numVals.ServoSpeed = hc.AngularSpeed
                    end
                elseif bn == "Motor" or bn == "HugeMotor" or bn == "FrontWheel" or bn == "BackWheel"
                    or bn == "HugeFrontWheel" or bn == "HugeBackWheel"
                    or bn == "FrontWheelCookie" or bn == "BackWheelCookie"
                    or bn == "FrontWheelMint" or bn == "BackWheelMint" then
                    local hc = ppart:FindFirstChildOfClass("HingeConstraint")
                    if hc then numVals.WheelTorque = hc.MotorMaxTorque end
                elseif bn == "Spring" then
                    local spc = ppart:FindFirstChildOfClass("SpringConstraint")
                    if spc then
                        numVals.Stiffness = spc.Stiffness
                        numVals.Damping = spc.Damping
                        numVals.TargetLength = spc.FreeLength
                        boolVals.Invertible = spc.LimitsEnabled
                        boolVals.ShowConstraint = spc.Visible
                    end
                    local pcc = ppart:FindFirstChildOfClass("PrismaticConstraint")
                    if pcc then
                        numVals.MaxLength = pcc.UpperLimit
                        numVals.MinLength = pcc.LowerLimit
                    end
                elseif bn == "Bar" or bn == "Rope" then
                    local rc = ppart:FindFirstChildOfClass("RodConstraint") or ppart:FindFirstChildOfClass("RopeConstraint")
                    if rc then
                        numVals.Length = rc.Length
                        if bn == "Bar" and rc:IsA("RodConstraint") then numVals.AngleLimit = rc.LimitAngle0 end
                        boolVals.ShowConstraint = rc.Visible
                    end
                    local ao = ppart:FindFirstChildOfClass("AlignOrientation")
                    if ao then boolVals.MatchRotation = ao.Enabled end
                end
            end)

            pcall(function()
                if block.HasTag and block:HasTag("Legacy") then boolVals.Legacy = true end
            end)
            if block.Name:find("Piston") then
                local function isTruthy(val)
                    if val == true or val == 1 or val == "1" then return true end
                    if type(val) == "string" then
                        local s = val:lower()
                        if s == "true" or s == "forward" or s == "yes" or s == "1" then return true end
                    end
                    return false
                end

                local hasFwdAttr = false
                local hasBwdAttr = false

                local function scanAttrs(inst)
                    if not inst then return end
                    local attrs = inst:GetAttributes()
                    for k, v in pairs(attrs) do
                        local kl = tostring(k):lower()
                        if kl == "forward" and isTruthy(v) then
                            hasFwdAttr = true
                        elseif kl == "backward" and isTruthy(v) then
                            hasBwdAttr = true
                        end
                    end
                end

                scanAttrs(block)
                if not hasFwdAttr and not hasBwdAttr then
                    for _, d in ipairs(block:GetChildren()) do
                        scanAttrs(d)
                    end
                end

                local tp, bp = nil, nil
                pcall(function()
                    tp = block:FindFirstChild("TopPart")
                    bp = block:FindFirstChild("Base")
                end)
                if not tp or not bp then
                    pcall(function()
                        for _, d in ipairs(block:GetDescendants()) do
                            if d:IsA("BasePart") and d.Name == "TopPart" and not tp then tp = d end
                            if d:IsA("BasePart") and d.Name == "Base" and not bp then bp = d end
                        end
                    end)
                end
                if not bp and ppart then bp = ppart end

                local extLen = 10
                pcall(function()
                    local nvb = block:FindFirstChild("ExtendLength") or block:FindFirstChild("ExtendLength", true)
                    if nvb and tonumber(nvb.Value) then extLen = tonumber(nvb.Value) end
                end)

                local targetDist = extLen + 0.4
                local curDist = nil
                if tp and bp and tp:IsA("BasePart") and bp:IsA("BasePart") then
                    pcall(function()
                        curDist = (tp.Position - bp.Position).Magnitude
                    end)
                end

                local isFullyExtended = false
                if curDist ~= nil and targetDist > 0 then
                    if math.abs(curDist - targetDist) <= 0.8 or curDist >= math.max(2.0, targetDist * 0.6) then
                        isFullyExtended = true
                    end
                end

                local isExtended = false
                if isFullyExtended then
                    isExtended = true
                elseif hasFwdAttr then
                    isExtended = true
                elseif hasBwdAttr then
                    isExtended = false
                else
                    isExtended = isFullyExtended
                end

                numVals.LastDirection = isExtended and 1 or 0
                boolVals.Forward = isExtended
                boolVals.Backward = not isExtended
                entry.LastDirection = isExtended and 1 or 0
                entry.Forward = isExtended
                entry.Backward = not isExtended

                local attrs = block:GetAttributes()
                local attrList = {}
                for k, v in pairs(attrs) do
                    table.insert(attrList, tostring(k) .. "=" .. tostring(v))
                end
                local attrStr = #attrList > 0 and table.concat(attrList, ", ") or "none"

                local curDistStr = curDist and string.format("%.2f", curDist) or "nil"
                local targetDistStr = string.format("%.2f", targetDist)

            end
            if next(boolVals) then entry.BoolValues = boolVals end
            if next(numVals) then entry.NumberValues = numVals end
            table.insert(buildData[block.Name], entry)
            idToBlock[idCounter - 1] = block
        end
    end
    do
        local BKEYS = {
            BindFire = true, BindActivate = true,
            BindUp = true, BindDown = true,
            BindLeft = true, BindRight = true,
        }
        local CONTROLLER_NAMES = {
            SwitchBig = true, Button = true, CarSeat = true, Switch = true,
            SensorBlock = true, RemoteController = true, PilotSeat = true,
            Lever = true, Gate = true, Delay = true,
        }

        local blockToId = {}
        for bid, bInst in pairs(idToBlock) do
            blockToId[bInst] = bid
        end

        local function idOfBlock(inst)
            if not inst then return nil, nil end
            local cur = inst
            while cur and cur ~= workspace and cur ~= playerBlocks do
                if blockToId[cur] then return blockToId[cur], cur end
                cur = cur.Parent
            end
            return nil, nil
        end

        local function isSeatController(blk)
            if not blk then return false end
            if blk.Name == "CarSeat" or blk.Name == "PilotSeat" then return true end
            if blk:FindFirstChildOfClass("VehicleSeat") or blk:FindFirstChildOfClass("Seat") then return true end
            if blk.HasTag and blk:HasTag("SeatInput") then return true end
            return false
        end

        local function getTargetPorts(targetBlock)
            local ports = {}
            if not targetBlock then return ports end
            local seen = {}
            local function checkObj(obj)
                if not obj or seen[obj] then return end
                if (obj:IsA("IntValue") or obj:IsA("NumberValue") or obj:IsA("ObjectValue")) and not obj.Name:find("Health") then
                    local actChild = obj:FindFirstChild("ActionName")
                    local isBindName = BKEYS[obj.Name] == true or obj.Name:sub(1, 4) == "Bind"
                    if actChild or isBindName then
                        seen[obj] = true
                        local action = actChild and tostring(actChild.Value) or obj.Name
                        local keyVal = (obj:IsA("IntValue") or obj:IsA("NumberValue")) and obj.Value or -1
                        if (keyVal == -1 or keyVal == nil or keyVal <= 0) and obj:FindFirstChild("DefaultInputKeyCode") then
                            keyVal = obj.DefaultInputKeyCode.Value
                        end
                        table.insert(ports, {
                            PortName = obj.Name,
                            ActionName = action,
                            KeyVal = keyVal or -1
                        })
                    end
                end
            end

            for _, ch in ipairs(targetBlock:GetChildren()) do checkObj(ch) end
            for _, ch in ipairs(targetBlock:GetDescendants()) do checkObj(ch) end

            if #ports == 0 then
                if targetBlock.Name == "Piston" then
                    table.insert(ports, {PortName = "BindUp", ActionName = "Push", KeyVal = -1})
                    table.insert(ports, {PortName = "BindDown", ActionName = "Pull", KeyVal = -1})
                elseif targetBlock.Name == "Servo" then
                    table.insert(ports, {PortName = "BindLeft", ActionName = "Left", KeyVal = 97})
                    table.insert(ports, {PortName = "BindRight", ActionName = "Right", KeyVal = 100})
                elseif targetBlock.Name == "Motor" or targetBlock.Name == "HugeMotor" then
                    table.insert(ports, {PortName = "BindUp", ActionName = "Forward", KeyVal = 119})
                    table.insert(ports, {PortName = "BindDown", ActionName = "Backward", KeyVal = 115})
                elseif targetBlock:FindFirstChild("BindFire") then
                    table.insert(ports, {PortName = "BindFire", ActionName = "Activate", KeyVal = -1})
                elseif targetBlock:FindFirstChild("BindActivate") then
                    table.insert(ports, {PortName = "BindActivate", ActionName = "Activate", KeyVal = -1})
                elseif targetBlock:FindFirstChild("BindUp") then
                    table.insert(ports, {PortName = "BindUp", ActionName = "Push", KeyVal = -1})
                    if targetBlock:FindFirstChild("BindDown") then
                        table.insert(ports, {PortName = "BindDown", ActionName = "Pull", KeyVal = -1})
                    end
                end
            end
            return ports
        end

        for _, ctrl in pairs(playerBlocks:GetChildren()) do
            if not ctrl:FindFirstChild("PPart") then continue end
            local isSeat = isSeatController(ctrl)
            if not (CONTROLLER_NAMES[ctrl.Name] or isSeat) then continue end

            local cid = blockToId[ctrl]
            if not cid then continue end

            local bEntry = nil
            for _, ent in ipairs(buildData[ctrl.Name] or {}) do
                if ent.ID == cid then bEntry = ent break end
            end
            if not bEntry then continue end

            local connectedTargets = {}

            for _, item in ipairs(ctrl:GetDescendants()) do
                if item:IsA("Beam") then
                    if item.Attachment1 then
                        local tid, tBlock = idOfBlock(item.Attachment1)
                        if tid and tBlock and tBlock ~= ctrl then
                            connectedTargets[tBlock] = tid
                        end
                    end
                    if item.Attachment0 then
                        local tid, tBlock = idOfBlock(item.Attachment0)
                        if tid and tBlock and tBlock ~= ctrl then
                            connectedTargets[tBlock] = tid
                        end
                    end
                end
            end

            for _, blk in pairs(playerBlocks:GetChildren()) do
                if blk ~= ctrl then
                    for _, item in ipairs(blk:GetDescendants()) do
                        if item:IsA("Beam") then
                            local b0Id, b0 = idOfBlock(item.Attachment0)
                            local b1Id, b1 = idOfBlock(item.Attachment1)
                            if b0 == ctrl and b1 and b1 ~= ctrl then
                                connectedTargets[b1] = b1Id
                            elseif b1 == ctrl and b0 and b0 ~= ctrl then
                                connectedTargets[b0] = b0Id
                            end
                        end
                    end
                end
            end

            for _, blk in pairs(playerBlocks:GetChildren()) do
                if blk ~= ctrl then
                    local tid = blockToId[blk]
                    if tid then
                        for _, ov in ipairs(blk:GetDescendants()) do
                            if ov:IsA("ObjectValue") and ov.Value then
                                local _, cBlock = idOfBlock(ov.Value)
                                if cBlock == ctrl or ov.Value == ctrl or (typeof(ov.Value) == "Instance" and ov.Value:IsDescendantOf(ctrl)) then
                                    connectedTargets[blk] = tid
                                    break
                                end
                            end
                        end
                    end
                end
            end

            for _, ov in ipairs(ctrl:GetDescendants()) do
                if ov:IsA("ObjectValue") and ov.Value then
                    local tid, tBlock = idOfBlock(ov.Value)
                    if tid and tBlock and tBlock ~= ctrl then
                        connectedTargets[tBlock] = tid
                    end
                end
            end

            local bt = {}
            local seenRow = {}

            local function addRow(tid, port, key)
                local rk = tostring(tid) .. "|" .. tostring(port) .. "|" .. tostring(key)
                if not seenRow[rk] then
                    seenRow[rk] = true
                    table.insert(bt, {tid, port, key})
                end
            end

            for tBlock, tid in pairs(connectedTargets) do
                local ports = getTargetPorts(tBlock)
                if isSeat then
                    for _, p in ipairs(ports) do
                        addRow(tid, p.PortName, p.KeyVal)
                    end
                else
                    for _, p in ipairs(ports) do
                        addRow(tid, p.PortName, -1)
                    end
                end
            end

            if #bt > 0 then
                bEntry.BindTable = bt
            end
        end
    end
    return buildData
end

function getBlock(expected, list, used)
    local best, bestDist = nil, math.huge
    local tpos = expected.skyWorldCF.Position
    for _, b in ipairs(list) do
        if b and b.Parent and b:FindFirstChild("PPart") and b.Name == expected.Name and not used[b] then
            local d = (b.PPart.Position - tpos).Magnitude
            if d < bestDist then bestDist = d ; best = b end
        end
    end
    if best then used[best] = true end
    return best
end

function calcSlots(sz)
    if not sz then return 1 end
    local vx = tonumber(sz.X) or 2
    local vy = tonumber(sz.Y) or 2
    local vz = tonumber(sz.Z) or 2
    local vol = vx * vy * vz
    return math.max(1, math.ceil(vol / 8))
end

