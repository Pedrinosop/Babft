    local farmRestartRequested = false
    local function getLiveFarmChar()
        local c = LocalPlayer.Character
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        if c and hum and hrp and hum.Health > 0 and c.Parent == workspace then
            return c, hum, hrp
        end
        return nil, nil, nil
    end

    local function waitForLiveFarmChar(maxWait)
        local t0 = os.clock()
        while (os.clock() - t0 < (maxWait or 10)) do
            local c, hum, hrp = getLiveFarmChar()
            if c and hum and hrp then
                return c, hum, hrp
            end
            task.wait(0.1)
        end
        local newC = LocalPlayer.CharacterAdded:Wait()
        local newHrp = newC:WaitForChild("HumanoidRootPart", 10)
        local newHum = newC:WaitForChild("Humanoid", 10)
        return newC, newHum, newHrp
    end

    local function cleanupFarmArtifacts()
        pcall(function()
            local c = LocalPlayer.Character
            local hrp = c and c:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.Anchored = false end
        end)
        for _, p in ipairs(workspace:GetChildren()) do
            if p.Name == "SPRB_FarmPlatform" then
                pcall(function() p:Destroy() end)
            end
        end
    end

    local function doRun()
        farmRestartRequested = false
        cleanupFarmArtifacts()

        local char, hum, r = getLiveFarmChar()
        if not (char and hum and r) then
            char, hum, r = waitForLiveFarmChar(10)
        end
        if not r then return end

        local stages = workspace:FindFirstChild("BoatStages")
            and workspace.BoatStages:FindFirstChild("NormalStages")

        if not stages then
            updateStatus("[ERR]", L("BuildError") or "Error!", "NormalStages not found", Theme.Danger)
            showFarmNotification("Error", "NormalStages not found in workspace!", 4, Theme.Danger)
            cfg.farmActive = false
            farmToggle.SetValue(false)
            return
        end

        currentStage = 1
        for i = 1, 10 do
            if not cfg.farmActive or cfg.farmCancelled or farmRestartRequested then
                cleanupFarmArtifacts()
                return
            end

            local curC, curHum, curHrp = getLiveFarmChar()
            if not (curC and curHum and curHrp) then
                cleanupFarmArtifacts()
                waitForLiveFarmChar(10)
                return 
            end
            r = curHrp

            local stage = stages:FindFirstChild("CaveStage" .. i)
            if stage then
                local dp = stage:FindFirstChild("DarknessPart")
                if dp then

                    pcall(function()
                        r.AssemblyLinearVelocity = Vector3.zero
                        r.AssemblyAngularVelocity = Vector3.zero
                        r.Velocity = Vector3.zero
                        r.RotVelocity = Vector3.zero
                    end)

                    r.CFrame = dp.CFrame * CFrame.new(0, 1.5, 0)

                    r.Anchored = true

                    local floor = Instance.new("Part")
                    floor.Name = "SPRB_FarmPlatform"
                    floor.Anchored = true
                    floor.CanCollide = true
                    floor.Size = Vector3.new(16, 1, 16)
                    floor.Transparency = 1
                    floor.CFrame = r.CFrame * CFrame.new(0, -3.2, 0)
                    floor.Parent = workspace

                    currentStage = i
                    updateStatus("[RUN]", L("Teleporting") or "Teleporting...", (L("Stage") or "Stage ") .. " " .. i .. "/10", Theme.Accent)

                    if i < 9 then
                        pcall(function()
                            local ev = workspace:FindFirstChild("ClaimRiverResultsGold")
                            if ev and typeof(ev.FireServer) == "function" then
                                ev:FireServer()
                            end
                        end)
                    end

                    task.wait(cfg.tpDelay)
                    pcall(function() floor:Destroy() end)
                    r.Anchored = false
                end
            end
        end

        if not cfg.farmActive or cfg.farmCancelled or farmRestartRequested then
            cleanupFarmArtifacts()
            return
        end

        local theEnd = stages:FindFirstChild("TheEnd")
        if theEnd then
            local chest = theEnd:FindFirstChild("GoldenChest")
            if chest then
                local trigger = chest:FindFirstChild("Trigger")
                if trigger then
                    local curC, curHum, curHrp = getLiveFarmChar()
                    if curHrp then r = curHrp end

                    pcall(function()
                        r.AssemblyLinearVelocity = Vector3.zero
                        r.AssemblyAngularVelocity = Vector3.zero
                    end)
                    r.CFrame = trigger.CFrame
                    r.Anchored = true

                    pcall(function()
                        if typeof(firetouchinterest) == "function" then
                            firetouchinterest(r, trigger, 0)
                            firetouchinterest(r, trigger, 1)
                        end
                    end)
                    updateStatus("[RUN]", L("Collecting") or "Collecting...", L("OpeningChest") or "Opening chest", Theme.Accent)

                    task.wait(0.1)

                    pcall(function()
                        local ev = workspace:FindFirstChild("ClaimRiverResultsGold")
                        if ev and typeof(ev.FireServer) == "function" then
                            ev:FireServer()
                        end
                    end)

                    runsCompleted = runsCompleted + 1

                    updateStatus("[DONE]", L("RunComplete") or "Run Complete!", (L("TotalRuns") or "Total runs: ") .. runsCompleted, Theme.Success)
                    showFarmNotification(L("RunComplete") or "Run Complete!", (L("TotalRuns") or "Total runs: ") .. runsCompleted, 2, Theme.Success)

                    tween(ResultFrame, {BackgroundColor3 = Theme.Success}, 0.1)
                    task.delay(0.1, function()
                        tween(ResultFrame, {BackgroundColor3 = Theme.Bg}, 0.3)
                    end)

                    tgSend("BABFT Farm: Run #" .. runsCompleted .. " completed! Total runs: " .. runsCompleted)

                    r.Anchored = false

                    task.wait(0.1)
                    cleanupFarmArtifacts()
                    return
                end
            end
        end

        cleanupFarmArtifacts()
        task.wait(0.1)
    end

    farmLoop = function()
