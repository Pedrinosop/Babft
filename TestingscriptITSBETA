                local globalCol = math.floor((i - 1) / STEPS_PER_COL)
                local rowInCol = (i - 1) % STEPS_PER_COL
                local floorIdx = math.floor(globalCol / COLS_PER_FLOOR)
                local colOnFloor = globalCol % COLS_PER_FLOOR

                local colXIdx = colOnFloor % COLS_X
                local colZIdx = math.floor(colOnFloor / COLS_X)

                local cx = -26 + colXIdx * 4
                local cz = -18 + colZIdx * 4
                local cy = 1.5 + floorIdx * 54 + rowInCol * 2

                local dId = idCounter
                idCounter = idCounter + 1
                delayIds[i] = dId

                local nextT = steps[i + 1].time
                local dt = math.clamp(nextT - st.time, 0.05, 10.0)
                local roundedDt = math.floor(dt * 100 + 0.5) / 100

                prs.Delay[#prs.Delay + 1] = {
                    CFrame = string.format("%d, %.1f, %d, 1, 0, 0, 0, 1, 0, 0, 0, 1", cx, cy, cz),
                    Size = "2, 2, 2",
                    Anchored = true,
                    ID = dId,
                    NumberValues = {
                        Delay = roundedDt,
                        WaitDuration = roundedDt,
                        ["Delay time"] = roundedDt
                    },
                    BoolValues = {
                        Legacy = true
                    },
                    BindTable = {}
                }
            end

            for _, p in ipairs(steps[1] and steps[1].pitches or {}) do
                local nid = pitchToId[p]
                if nid then
                    prs.Button[1].BindTable[#prs.Button[1].BindTable + 1] = {nid, "BindFire", -1}
                end
            end
            if delayIds[1] then
                prs.Button[1].BindTable[#prs.Button[1].BindTable + 1] = {delayIds[1], "BindFire", -1}
            end

            for i = 1, #steps - 1 do
                local curDelay = prs.Delay[i]
                if curDelay then
                    local nextPitches = steps[i + 1] and steps[i + 1].pitches or {}
                    for _, p in ipairs(nextPitches) do
                        local nid = pitchToId[p]
                        if nid then
                            curDelay.BindTable[#curDelay.BindTable + 1] = {nid, "BindFire", -1}
                        end
                    end
                    if delayIds[i + 1] then
                        curDelay.BindTable[#curDelay.BindTable + 1] = {delayIds[i + 1], "BindFire", -1}
                    end
                end
            end
        end
        return prs, nil
    end

    convertMidiToBuild = function(filePath, buildName, mode, tempoScale, startSec, endSec, compressionLevel)
        buildName = buildName or "midi_build"
        local prs, err = convertMidiToBlocks(filePath, mode, tempoScale, startSec, endSec, compressionLevel)
        if not prs then
            return nil, err
        end
        if saveBuildToFile then
            local ok, fmt = saveBuildToFile(buildName, prs)
            if ok then
                return prs, "Saved to " .. buildName .. " (" .. (fmt or "toon") .. ")"
            else
                return nil, "Failed to save build"
            end
        end
        return prs, nil
    end
end

local function parseObjData(text, filePath)
    local materialColors = {}
    local vertices = {}
    local faces = {}
    for line in text:gmatch("[^\r\n]+") do
        local tag, rest = line:match("^%s*(%S+)%s*(.-)%s*$")
        if tag == "v" then
            local nums = parseNums(rest)
            if #nums >= 3 then
                local entry = {pos = Vector3.new(nums[1], nums[2], nums[3])}
                if #nums >= 6 then
                    entry.color = {nums[4], nums[5], nums[6]}
                end
                vertices[#vertices + 1] = entry
            end
        elseif tag == "f" then
            local face = {}
            for token in rest:gmatch("%S+") do
                local idxToken = token:match("([^/]+)")
                local idx = tonumber(idxToken)
                if idx then
                    if idx < 0 then
                        idx = #vertices + idx + 1
                    end
                    if vertices[idx] then
                        face[#face + 1] = idx
                    end
                end
            end
            if #face >= 3 then
                faces[#faces + 1] = {indices = face}
            end
        end
    end
    return {vertices = vertices, faces = faces, materialColors = materialColors}
end

local function chooseFaceColor(face, vertices, faceMaterial, materialColors)
    if faceMaterial and materialColors[faceMaterial] then
        return materialColors[faceMaterial]
    end
    local rs, gs, bs, count = 0, 0, 0, 0
    for _, idx in ipairs(face) do
        local v = vertices[idx]
        if v and v.color then
            rs = rs + v.color[1]
            gs = gs + v.color[2]
            bs = bs + v.color[3]
            count = count + 1
        end
    end
    if count > 0 then
        return rgbStr(rs / count, gs / count, bs / count)
    end
    return rgbStr(220, 220, 220)
end

local function centerPoints(points)
    local minV = Vector3.new(math.huge, math.huge, math.huge)
    local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)
    for _, p in ipairs(points) do
        minV = Vector3.new(math.min(minV.X, p.X), math.min(minV.Y, p.Y), math.min(minV.Z, p.Z))
        maxV = Vector3.new(math.max(maxV.X, p.X), math.max(maxV.Y, p.Y), math.max(maxV.Z, p.Z))
    end
    local center = (minV + maxV) * 0.5
    local shifted = {}
    for i, p in ipairs(points) do
        shifted[i] = p - center
    end
    return shifted, center
end

local function makeFacePanel(points, scale, thickness, colorStr, blockId)
    if #points < 3 then
        return nil
    end
    local centered, baseCenter = centerPoints(points)
    local scaled = {}
    for i, p in ipairs(centered) do
        scaled[i] = Vector3.new(p.X * scale, p.Y * scale, p.Z * scale)
    end

    local normal = nil
    for i = 2, #scaled - 1 do
        local cross = (scaled[i] - scaled[1]):Cross(scaled[i + 1] - scaled[1])
        if cross.Magnitude > 1e-9 then
            normal = cross.Unit
            break
        end
    end
    if not normal then
        return nil
    end

    local longest = nil
    local bestDist = 0
    for i = 1, #scaled do
        for j = i + 1, #scaled do
            local d = (scaled[j] - scaled[i]).Magnitude
            if d > bestDist then
                bestDist = d
                longest = scaled[j] - scaled[i]
            end
        end
    end
    if not longest or longest.Magnitude < 1e-5 then
        return nil
    end

    local axisX = longest - normal * longest:Dot(normal)
    if axisX.Magnitude < 1e-5 then
        axisX = normal:Cross(Vector3.new(0, 1, 0))
        if axisX.Magnitude < 1e-5 then
            axisX = normal:Cross(Vector3.new(1, 0, 0))
        end
    end
    axisX = axisX.Unit
    local axisY = normal:Cross(axisX)
    if axisY.Magnitude < 1e-5 then
        return nil
    end
    axisY = axisY.Unit

    local minU, minV = math.huge, math.huge
    local maxU, maxV = -math.huge, -math.huge
    local center = Vector3.zero
    for _, p in ipairs(scaled) do
        center = center + p
    end
    center = center / #scaled
    for _, p in ipairs(scaled) do
        local rel = p - center
        local u = rel:Dot(axisX)
        local v = rel:Dot(axisY)
        minU = math.min(minU, u)
        maxU = math.max(maxU, u)
        minV = math.min(minV, v)
        maxV = math.max(maxV, v)
    end

    local width = math.max(0.02, maxU - minU)
    local height = math.max(0.02, maxV - minV)
    local faceCenter = (baseCenter * scale) + center + axisX * ((minU + maxU) * 0.5) + axisY * ((minV + maxV) * 0.5)
    local cf = CFrame.fromMatrix(faceCenter, axisX, axisY, normal)
    return cfToAsuBlock(cf, Vector3.new(width, height, thickness), colorStr, blockId, 0)
end

local function makeFacePanelCentered(points, thickness, colorStr, blockId)

    if #points < 3 then
        return nil
    end

    local normal = nil
    for i = 2, #points - 1 do
        local cross = (points[i] - points[1]):Cross(points[i + 1] - points[1])
        if cross.Magnitude > 1e-9 then
            normal = cross.Unit
            break
        end
    end
    if not normal then
        return nil
    end

    local longest = nil
    local bestDist = 0
    for i = 1, #points do
        for j = i + 1, #points do
            local d = (points[j] - points[i]).Magnitude
            if d > bestDist then
                bestDist = d
                longest = points[j] - points[i]
            end
        end
    end
    if not longest or longest.Magnitude < 1e-5 then
        return nil
    end

    local axisX = longest - normal * longest:Dot(normal)
    if axisX.Magnitude < 1e-5 then
        axisX = normal:Cross(Vector3.new(0, 1, 0))
        if axisX.Magnitude < 1e-5 then
            axisX = normal:Cross(Vector3.new(1, 0, 0))
        end
    end
    axisX = axisX.Unit
    local axisY = normal:Cross(axisX)
    if axisY.Magnitude < 1e-5 then
        return nil
    end
    axisY = axisY.Unit

    local minU, minV = math.huge, math.huge
    local maxU, maxV = -math.huge, -math.huge
    local centroid = Vector3.zero
    for _, p in ipairs(points) do
        centroid = centroid + p
    end
    centroid = centroid / #points
    for _, p in ipairs(points) do
        local rel = p - centroid
        local u = rel:Dot(axisX)
        local v = rel:Dot(axisY)
        minU = math.min(minU, u)
        maxU = math.max(maxU, u)
        minV = math.min(minV, v)
        maxV = math.max(maxV, v)
    end

    local width = math.max(0.02, maxU - minU)
    local height = math.max(0.02, maxV - minV)
    local faceCenter = centroid + axisX * ((minU + maxU) * 0.5) + axisY * ((minV + maxV) * 0.5)
    local cf = CFrame.fromMatrix(faceCenter, axisX, axisY, normal)
    return cfToAsuBlock(cf, Vector3.new(width, height, thickness), colorStr, blockId, 0)
end

local function makeEdgeBlock(p0, p1, scale, thickness, colorStr, blockId)
    local center = (p0 + p1) * 0.5 * scale
    local delta = (p1 - p0) * scale
    if delta.Magnitude < 1e-5 then
        return nil
    end
    local axisX = delta.Unit
    local up = math.abs(axisX:Dot(Vector3.new(0, 1, 0))) > 0.98 and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
    local axisZ = axisX:Cross(up)
    if axisZ.Magnitude < 1e-5 then
        axisZ = axisX:Cross(Vector3.new(0, 0, 1))
    end
    axisZ = axisZ.Unit
    local axisY = axisZ:Cross(axisX).Unit
    local cf = CFrame.fromMatrix(center, axisX, axisY, axisZ)
    return cfToAsuBlock(cf, Vector3.new(delta.Magnitude, thickness, thickness), colorStr, blockId, 0)
end

local function snapAngle90(deg)
    return math.floor(deg / 90 + 0.5) * 90
end

local function makeEdgeBlockFromRef(pA, pB, thickness, color, blockId, faceNormal)
    local delta = pB - pA
    local dist = delta.Magnitude
    if dist < 0.01 then return nil end
    local dir = delta.Unit

    local maxEdgeLen = 50
    if dist > maxEdgeLen then dist = maxEdgeLen end

    local shrink = math.min(dist * 0.06, thickness * 0.5)
    local effectiveDist = dist - shrink
    if effectiveDist < 0.01 then effectiveDist = dist end
    local shrinkHalf = (dist - effectiveDist) / 2
    local eA = pA + dir * shrinkHalf
    local eB = pB - dir * shrinkHalf
    local mid = (eA + eB) / 2

    local maxPos = 300
    mid = Vector3.new(
        math.clamp(mid.X, -maxPos, maxPos),
        math.clamp(mid.Y, -maxPos, maxPos),
        math.clamp(mid.Z, -maxPos, maxPos)
    )

    local absDir = Vector3.new(math.abs(dir.X), math.abs(dir.Y), math.abs(dir.Z))
    local isDiagonal = not (absDir.X > 0.95 or absDir.Y > 0.95 or absDir.Z > 0.95)

    local upHint
    if faceNormal and faceNormal.Magnitude > 0.0001 then
        local projN = faceNormal - dir * faceNormal:Dot(dir)
        if projN.Magnitude > 0.0001 then
            upHint = projN.Unit
        else
            upHint = Vector3.new(0, 1, 0)
        end
    else
        local absX, absY, absZ = math.abs(dir.X), math.abs(dir.Y), math.abs(dir.Z)
        if absY <= absX and absY <= absZ then
            upHint = Vector3.new(0, 1, 0)
        elseif absX <= absY and absX <= absZ then
            upHint = Vector3.new(1, 0, 0)
        else
            upHint = Vector3.new(0, 0, 1)
        end
    end
    local right = dir:Cross(upHint)
    if right.Magnitude < 0.0001 then
        local alternatives = {Vector3.new(0, 1, 0), Vector3.new(1, 0, 0), Vector3.new(0, 0, 1)}
        for _, alt in ipairs(alternatives) do
            right = dir:Cross(alt)
            if right.Magnitude > 0.0001 then
                upHint = alt
                break
            end
        end
        if right.Magnitude < 0.0001 then return nil end
    end
    right = right.Unit
    local upFixed = right:Cross(dir).Unit

    local cf = CFrame.fromMatrix(mid, right, upFixed, dir)

    if not isDiagonal then
        local rx, ry, rz = cf:ToEulerAnglesXYZ()
        rx = math.rad(snapAngle90(math.deg(rx)))
        ry = math.rad(snapAngle90(math.deg(ry)))
        rz = math.rad(snapAngle90(math.deg(rz)))
        cf = CFrame.new(mid) * CFrame.fromEulerAnglesXYZ(rx, ry, rz)
    end

    local effThick = math.clamp(thickness, 0.05, 4)
    local effLen = math.clamp(effectiveDist, 0.01, maxEdgeLen)

    local colorStr = nil
    if type(color) == "string" and color ~= "" then
        colorStr = color
    elseif typeof(color) == "Color3" then
        colorStr = string.format("%.3f,%.3f,%.3f", color.R, color.G, color.B)
    end
    return cfToAsuBlock(cf, Vector3.new(effThick, effThick, effLen), colorStr, blockId, 0)
end

local function createTriangleStrips(p1, p2, p3, stripSize, color, detailMul, blockIdStart)
    local parts = {}
    local v1 = p2 - p1
    local normal = v1:Cross(p3 - p1)
    if normal.Magnitude < 0.0001 then return parts end
    normal = normal.Unit

    local e1Len = (p2 - p1).Magnitude
    local e2Len = (p3 - p2).Magnitude
    local e3Len = (p3 - p1).Magnitude
    local longestDir
    if e1Len >= e2Len and e1Len >= e3Len then
        longestDir = (p2 - p1).Unit
    elseif e2Len >= e1Len and e2Len >= e3Len then
        longestDir = (p3 - p2).Unit
    else
        longestDir = (p3 - p1).Unit
    end

    local projDir = longestDir - normal * (normal.X * longestDir.X + normal.Y * longestDir.Y + normal.Z * longestDir.Z)
    if projDir.Magnitude < 0.0001 then return {} end
    projDir = projDir.Unit

    local localY = projDir:Cross(normal)
    if localY.Magnitude < 0.0001 then return {} end
    localY = localY.Unit

    local localX = localY:Cross(normal)
    if localX.Magnitude < 0.0001 then return {} end
    localX = localX.Unit

    local h1 = p1:Dot(localY)
    local h2 = p2:Dot(localY)
    local h3 = p3:Dot(localY)
    local minH = math.min(h1, h2, h3)
    local maxH = math.max(h1, h2, h3)
    local span = maxH - minH
    if span < 0.0001 then return {} end

    local numStrips = math.max(1, math.ceil(span / stripSize * detailMul))

    local edgeData = {
        {p1, p2, h1, h2},
        {p2, p3, h2, h3},
        {p3, p1, h3, h1}
    }

    for stripIdx = 0, numStrips - 1 do
        local stripH = minH + (stripIdx + 0.5) * span / numStrips
        local intersections = {}

        for _, edge in ipairs(edgeData) do
            local eA, eB, eHA, eHB = edge[1], edge[2], edge[3], edge[4]
            if stripH >= math.min(eHA, eHB) - 1e-5 and stripH <= math.max(eHA, eHB) + 1e-5 then
                local spanH = eHB - eHA
                local t = 0.5
                if math.abs(spanH) > 1e-5 then
                    t = math.clamp((stripH - eHA) / spanH, 0, 1)
                end
                local pt = eA + (eB - eA) * t
                intersections[#intersections + 1] = pt
            end
        end

        if #intersections >= 2 then

            local bestDist = 0
            local iP1 = intersections[1]
            local iP2 = intersections[2]
            for i = 1, #intersections do
                for j = i + 1, #intersections do
                    local d = (intersections[j] - intersections[i]).Magnitude
                    if d > bestDist then
                        bestDist = d
                        iP1 = intersections[i]
                        iP2 = intersections[j]
                    end
                end
            end

            if bestDist > 0.0001 then
                local stripCenter = (iP1 + iP2) / 2
                local stripDir = (iP2 - iP1).Unit

                local orientNormal = normal - stripDir * (stripDir.X * normal.X + stripDir.Y * normal.Y + stripDir.Z * normal.Z)
                if orientNormal.Magnitude < 0.0001 then
                    orientNormal = Vector3.new(0, 1, 0)
                end
                orientNormal = -orientNormal

                local cf = CFrame.fromMatrix(stripCenter, stripDir:Cross(orientNormal).Unit, orientNormal, stripDir)
                local colorStr = nil
                if type(color) == "string" and color ~= "" then
                    colorStr = color
                elseif typeof(color) == "Color3" then
                    colorStr = string.format("%.3f,%.3f,%.3f", color.R, color.G, color.B)
                end
                parts[#parts + 1] = cfToAsuBlock(cf, Vector3.new(stripSize, stripSize, bestDist), colorStr, blockIdStart + #parts, 0)
            end
        end
    end

    return parts
end

local function triangulateFace(faceIndices)
    local tris = {}
    if #faceIndices < 3 then
        return tris
    end
    for i = 2, #faceIndices - 1 do
        tris[#tris + 1] = {faceIndices[1], faceIndices[i], faceIndices[i + 1]}
    end
    return tris
end

local function mergeCoplanarFacesForVoxel(faces, centeredVerts, coplanarTolerance, vertices, materialColors, resolveColor)

    coplanarTolerance = coplanarTolerance or 0.02
    local skipFaceSet = {}
    local mergedQuads = {}

    if #faces < 2 then return mergedQuads, skipFaceSet end

    local facePlaneKey = {}
    for fi, f in ipairs(faces) do
        local indices = f.indices
        if not indices or #indices < 3 then continue end
        local p1 = centeredVerts[indices[1]]
        local p2 = centeredVerts[indices[2]]
        local p3 = centeredVerts[indices[3]]
        if not p1 or not p2 or not p3 then continue end
        local v1 = p2 - p1
        local v2 = p3 - p1
        local normal = v1:Cross(v2)
        if normal.Magnitude < 0.0001 then continue end
        normal = normal.Unit
        local d = normal:Dot(p1)

        local nQx = math.floor(normal.X / coplanarTolerance + 0.5)
        local nQy = math.floor(normal.Y / coplanarTolerance + 0.5)
        local nQz = math.floor(normal.Z / coplanarTolerance + 0.5)
        local dQ = math.floor(d / coplanarTolerance + 0.5)

        local adx, ady, adz = math.abs(nQx), math.abs(nQy), math.abs(nQz)
        local sign = 1
        if adx >= ady and adx >= adz then sign = nQx >= 0 and 1 or -1
        elseif ady >= adz then sign = nQy >= 0 and 1 or -1
        else sign = nQz >= 0 and 1 or -1 end
        local key = (nQx*sign) .. "|" .. (nQy*sign) .. "|" .. (nQz*sign) .. "|" .. (dQ*sign)
        facePlaneKey[fi] = key
    end

    local groups = {}
    for fi, key in pairs(facePlaneKey) do
        if not groups[key] then groups[key] = {} end
        groups[key][#groups[key] + 1] = fi
    end

    local function findConnectedComponents(faceIndices, faces)

        local vertToFaces = {}
        for _, fi in ipairs(faceIndices) do
            local f = faces[fi]
            if not f or not f.indices then continue end
            for _, vi in ipairs(f.indices) do
                if not vertToFaces[vi] then vertToFaces[vi] = {} end
                vertToFaces[vi][#vertToFaces[vi] + 1] = fi
            end
        end

        local visited = {}
        local components = {}
        for _, fi in ipairs(faceIndices) do
            if visited[fi] then continue end

            local comp = {}
            local queue = {fi}
            local qHead = 1
            visited[fi] = true
            while qHead <= #queue do
                local cur = queue[qHead]
                qHead = qHead + 1
                comp[#comp + 1] = cur

                local curF = faces[cur]
                if curF and curF.indices then
                    for _, vi in ipairs(curF.indices) do
                        local neighbors = vertToFaces[vi]
                        if neighbors then
                            for _, nfi in ipairs(neighbors) do
                                if not visited[nfi] then
                                    visited[nfi] = true
                                    queue[#queue + 1] = nfi
                                end
                            end
                        end
                    end
                end
            end
            components[#components + 1] = comp
        end
        return components
    end

    for key, group in pairs(groups) do
        if #group < 2 then continue end

        local components = findConnectedComponents(group, faces)

        for _, comp in ipairs(components) do
            if #comp < 2 then continue end

            local refFi = comp[1]
            local refIndices = faces[refFi].indices
            local rp1 = centeredVerts[refIndices[1]]
            local rp2 = centeredVerts[refIndices[2]]
            local rp3 = centeredVerts[refIndices[3]]
            if not rp1 or not rp2 or not rp3 then continue end
            local normal = (rp2 - rp1):Cross(rp3 - rp1)
            if normal.Magnitude < 0.0001 then continue end
            normal = normal.Unit
            local d = normal:Dot(rp1)

            local up = Vector3.new(0, 1, 0)
            if math.abs(normal:Dot(up)) > 0.99 then
                up = Vector3.new(1, 0, 0)
            end
            local localX = up - normal * (normal:Dot(up))
            if localX.Magnitude < 0.0001 then
                up = Vector3.new(0, 0, 1)
                localX = up - normal * (normal:Dot(up))
            end
            if localX.Magnitude < 0.0001 then continue end
            localX = localX.Unit
            local localY = normal:Cross(localX).Unit

            local minU, maxU = math.huge, -math.huge
            local minV, maxV = math.huge, -math.huge
            local basePoint = normal * d

            for _, fi in ipairs(comp) do
                local f = faces[fi]
                for _, idx in ipairs(f.indices) do
                    local p = centeredVerts[idx]
                    if not p then continue end
                    local u = localX:Dot(p - basePoint)
                    local v = localY:Dot(p - basePoint)
                    minU = math.min(minU, u)
                    maxU = math.max(maxU, u)
                    minV = math.min(minV, v)
                    maxV = math.max(maxV, v)
                end
                skipFaceSet[fi] = true
            end

            local corner1 = basePoint + localX * minU + localY * minV
            local corner2 = basePoint + localX * maxU + localY * minV
            local corner3 = basePoint + localX * maxU + localY * maxV
            local corner4 = basePoint + localX * minU + localY * maxV

            local colorCounts = {}
            local bestColor = nil
            local bestCount = 0
            for _, fi in ipairs(comp) do
                local f = faces[fi]
                local meshColor = chooseFaceColor(f.indices, vertices, f.material, materialColors)
                local cKey = tostring(meshColor)
                colorCounts[cKey] = (colorCounts[cKey] or 0) + 1
                if colorCounts[cKey] > bestCount then
                    bestCount = colorCounts[cKey]
                    bestColor = meshColor
                end
            end

            local centroid = (corner1 + corner2 + corner3 + corner4) / 4
            local color = resolveColor(bestColor, centroid)

            mergedQuads[#mergedQuads + 1] = {
                p1 = corner1, p2 = corner2, p3 = corner3, p4 = corner4,
                color = color
            }
        end
    end

    return mergedQuads, skipFaceSet
end

local function addVoxelCell(cellMap, x, y, z, color)
    local key = x .. "," .. y .. "," .. z
    if not cellMap[key] then
        local qCol = color
        if type(color) == "string" and color:find(",") then
            local nums = parseNums(color)
            if #nums >= 3 then
                local rQ = math.floor(nums[1] * 20 + 0.5) / 20
                local gQ = math.floor(nums[2] * 20 + 0.5) / 20
                local bQ = math.floor(nums[3] * 20 + 0.5) / 20
                qCol = string.format("%.2f,%.2f,%.2f", rQ, gQ, bQ)
            end
        end
        cellMap[key] = {x = x, y = y, z = z, color = qCol}
    end
end

local function rasterizeTriangleToVoxels(cellMap, p1, p2, p3, voxelSize, color)
    local e1 = p2 - p1
    local e2 = p3 - p1
    local e3 = p3 - p2
    local longest = math.max(e1.Magnitude, e2.Magnitude, e3.Magnitude)
    local steps = math.max(1, math.ceil(longest / math.max(voxelSize * 0.7, 0.05)))
    for i = 0, steps do
        for j = 0, steps - i do
            local a = i / steps
            local b = j / steps
            local c = 1 - a - b
            local p = p1 * c + p2 * a + p3 * b
            addVoxelCell(
                cellMap,
                math.floor(p.X / voxelSize + 0.5),
                math.floor(p.Y / voxelSize + 0.5),
                math.floor(p.Z / voxelSize + 0.5),
                color
            )
        end
    end
end

local function voxelCellsToBlocks(cellMap, voxelSize, blockIdStart)
    local voxels = {}
    local minX, minY, minZ = math.huge, math.huge, math.huge
    local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
    for _, v in pairs(cellMap) do
        voxels[#voxels + 1] = v
        minX = math.min(minX, v.x)
        minY = math.min(minY, v.y)
        minZ = math.min(minZ, v.z)
        maxX = math.max(maxX, v.x)
        maxY = math.max(maxY, v.y)
        maxZ = math.max(maxZ, v.z)
    end
    local boxes = greedyMergeVoxels(voxels)
    local blocks = {}
    local cx = (minX + maxX + 1) * 0.5
    local cy = (minY + maxY + 1) * 0.5
    local cz = (minZ + maxZ + 1) * 0.5
    for i, box in ipairs(boxes) do
        local sizeVec = Vector3.new(
            (box.x2 - box.x1 + 1) * voxelSize,
            (box.y2 - box.y1 + 1) * voxelSize,
            (box.z2 - box.z1 + 1) * voxelSize
        )
        local center = Vector3.new(
            ((box.x1 + box.x2 + 1) * 0.5 - cx) * voxelSize,
            ((box.y1 + box.y2 + 1) * 0.5 - cy) * voxelSize,
            ((box.z1 + box.z2 + 1) * 0.5 - cz) * voxelSize
        )
        blocks[#blocks + 1] = cfToAsuBlock(CFrame.new(center), sizeVec, box.color, (blockIdStart or 1) + i - 1, 0)
    end
    return blocks
end

local function makeWireLine(p1, p2, thickness, color, blockId)

    local distance = (p1 - p2).Magnitude
    if distance < 0.01 then return nil end
    local center = (p1 + p2) / 2
    local dir = (p2 - p1).Unit

    local up = Vector3.new(0, 1, 0)
    if math.abs(dir:Dot(up)) > 0.99 then
        up = Vector3.new(1, 0, 0)
    end
    local right = dir:Cross(up).Unit
    local realUp = right:Cross(dir).Unit
    local cf = CFrame.fromMatrix(center, right, realUp, dir)
    local colorStr = nil
    if type(color) == "string" and color ~= "" then colorStr = color
    elseif typeof(color) == "Color3" then colorStr = string.format("%.3f,%.3f,%.3f", color.R, color.G, color.B) end
    return cfToAsuBlock(cf, Vector3.new(thickness, thickness, distance), colorStr, blockId, 0)
end

local function makeWireEdge(pA, pB, thickness, colorStr, blockId)
    local diff = pB - pA
    local len = diff.Magnitude
    if len < 0.001 then return nil end
    local mid = (pA + pB) * 0.5
    local cf = CFrame.lookAt(mid, pB)
    local effLen = len + thickness * 0.05
    return cfToAsuBlock(cf, Vector3.new(thickness, thickness, effLen), colorStr, blockId, 0)
end

local function buildTriangleAltitudeStrips(pA, pB, pC, stripWidth, depth, colorStr, bIdStart)
    local outBlocks = {}
    local dAB = (pB - pA).Magnitude
    local dBC = (pC - pB).Magnitude
    local dCA = (pA - pC).Magnitude
    if dAB < 1e-4 or dBC < 1e-4 or dCA < 1e-4 then return outBlocks end

    local baseStart, baseEnd, apex
    if dAB >= dBC and dAB >= dCA then
        baseStart, baseEnd, apex = pA, pB, pC
    elseif dBC >= dCA then
        baseStart, baseEnd, apex = pB, pC, pA
    else
        baseStart, baseEnd, apex = pC, pA, pB
    end

    local baseAxis = baseEnd - baseStart
    local baseLen = baseAxis.Magnitude
    if baseLen <= 1e-4 then return outBlocks end
    baseAxis = baseAxis.Unit

    local apexOffset = apex - baseStart
    local altitudeVec = apexOffset - baseAxis * apexOffset:Dot(baseAxis)
    local altitude = altitudeVec.Magnitude
    if altitude <= 1e-4 then return outBlocks end
    local altitudeAxis = altitudeVec.Unit

    local step = math.max(0.05, tonumber(stripWidth) or 0.5)
    local stripCount = math.clamp(math.ceil(altitude / step), 1, 96)
    local blockDepth = math.max(0.05, tonumber(depth) or 0.2)

    for s = 0, stripCount - 1 do
        local t0 = s / stripCount
        local t1 = (s + 1) / stripCount

        local left0 = apex:Lerp(baseStart, t0)
        local right0 = apex:Lerp(baseEnd, t0)
        local left1 = apex:Lerp(baseStart, t1)
        local right1 = apex:Lerp(baseEnd, t1)

        local chord = (right0 - left0) + (right1 - left1)
        local chordLen = chord.Magnitude
        local rowH = ((left1 + right1) * 0.5 - (left0 + right0) * 0.5).Magnitude

        if chordLen > 1e-4 and rowH > 1e-4 then
            local chordAxis = chord.Unit
            local normal = altitudeAxis:Cross(chordAxis).Unit
            local width = math.max((right0 - left0).Magnitude, (right1 - left1).Magnitude) + 0.02
            local effRowH = rowH + 0.02
            local center = (left0 + right0 + left1 + right1) * 0.25

            local cf = CFrame.fromMatrix(center, chordAxis, normal, altitudeAxis)
            local blk = cfToAsuBlock(cf, Vector3.new(width, blockDepth, effRowH), colorStr, bIdStart + #outBlocks, 0)
            if blk then
                outBlocks[#outBlocks + 1] = blk
            end
        end
    end

    return outBlocks
end

local function buildObjBlocks(parsedObj, scale, thickness, mode, colorOpts)
    mode = tostring(mode or "solid"):lower()
    local vertices = parsedObj.vertices or {}
    local faces = parsedObj.faces or {}
    local materialColors = parsedObj.materialColors or {}
    local blocks = {}
    local blockId = 1
    local stripSize = tonumber(thickness) or 0.5
    local opts = colorOpts or {}
    local colorMode = opts.colorMode or "mesh"
    local solidDetail = tonumber(opts.detail) or 1
    local totalFaces = #faces
    local faceIndex = 0
    local gradDir = opts.gradDir or "y_asc"

    local gradMin, gradMax

    local function resolveColor(meshColor, pos)
        if colorMode == "custom" then
            return string.format("%.3f,%.3f,%.3f", opts.customR or 0.4, opts.customG or 0.6, opts.customB or 1.0)
        elseif colorMode == "random" then
            return string.format("%.3f,%.3f,%.3f", math.random(), math.random(), math.random())
        elseif colorMode == "gradient" then
            local t = 0
            if gradDir == "index" then
                t = totalFaces > 1 and (faceIndex / (totalFaces - 1)) or 0
            elseif pos and gradMin and gradMax then
                if gradDir == "y_asc" then
                    t = (pos.Y - gradMin.Y) / math.max(0.0001, gradMax.Y - gradMin.Y)
                elseif gradDir == "y_desc" then
                    t = 1 - (pos.Y - gradMin.Y) / math.max(0.0001, gradMax.Y - gradMin.Y)
                elseif gradDir == "x_asc" then
                    t = (pos.X - gradMin.X) / math.max(0.0001, gradMax.X - gradMin.X)
                elseif gradDir == "x_desc" then
                    t = 1 - (pos.X - gradMin.X) / math.max(0.0001, gradMax.X - gradMin.X)
                elseif gradDir == "z_asc" then
                    t = (pos.Z - gradMin.Z) / math.max(0.0001, gradMax.Z - gradMin.Z)
                elseif gradDir == "z_desc" then
                    t = 1 - (pos.Z - gradMin.Z) / math.max(0.0001, gradMax.Z - gradMin.Z)
                elseif gradDir == "radial_out" then
                    local gc = (gradMin + gradMax) / 2
                    t = (pos - gc).Magnitude / math.max(0.0001, (gradMax - gradMin).Magnitude / 2)
                elseif gradDir == "radial_in" then
                    local gc = (gradMin + gradMax) / 2
                    t = 1 - (pos - gc).Magnitude / math.max(0.0001, (gradMax - gradMin).Magnitude / 2)
                else
                    t = totalFaces > 1 and (faceIndex / (totalFaces - 1)) or 0
                end
            else
                t = totalFaces > 1 and (faceIndex / (totalFaces - 1)) or 0
            end
            t = math.clamp(t, 0, 1)
            local g1R, g1G, g1B = opts.grad1R or 1, opts.grad1G or 0.3, opts.grad1B or 0.1
            local g2R, g2G, g2B = opts.grad2R or 0.1, opts.grad2G or 0.3, opts.grad2B or 1
            local cr = g1R + (g2R - g1R) * t
            local cg = g1G + (g2G - g1G) * t
            local cb = g1B + (g2B - g1B) * t
            return string.format("%.3f,%.3f,%.3f", cr, cg, cb)
        else
            return meshColor
        end
    end

    local verts = {}
    for _, v in ipairs(vertices) do
        verts[#verts + 1] = v.pos * scale
    end

    local faceIndices = {}
    for _, f in ipairs(faces) do
        faceIndices[#faceIndices + 1] = f.indices
    end

    if #faceIndices > 0 then
    end

    if #verts == 0 then return blocks end

    local bMin = verts[1]
    local bMax = verts[1]
    for _, v in ipairs(verts) do
        bMin = Vector3.new(math.min(bMin.X, v.X), math.min(bMin.Y, v.Y), math.min(bMin.Z, v.Z))
        bMax = Vector3.new(math.max(bMax.X, v.X), math.max(bMax.Y, v.Y), math.max(bMax.Z, v.Z))
    end
    local center = Vector3.new((bMin.X + bMax.X) / 2, bMin.Y - 4.0, (bMin.Z + bMax.Z) / 2)
    local localMin = bMin - center
    local localMax = bMax - center
    gradMin = localMin
    gradMax = localMax

    local centeredVerts = {}
    for _, v in ipairs(verts) do
        centeredVerts[#centeredVerts + 1] = v - center
    end

    local weldMap = {}
    local spatialLookup = {}
    for vi = 1, #centeredVerts do
        local p = centeredVerts[vi]
        local qx = math.floor(p.X * 500 + 0.5)
        local qy = math.floor(p.Y * 500 + 0.5)
        local qz = math.floor(p.Z * 500 + 0.5)
        local skey = qx .. "_" .. qy .. "_" .. qz
        if not spatialLookup[skey] then
            spatialLookup[skey] = vi
        end
        weldMap[vi] = spatialLookup[skey]
    end

    local edgeCount = {}
    local edgeOrder = {}
    local edgeMap = {}
    local edgeFaces = {}
    local allEdges = {}
    for _, face in ipairs(faceIndices) do
        local seenInFace = {}
        for i = 1, #face do
            local a = face[i]
            local b = face[(i % #face) + 1]
            if a >= 1 and a <= #centeredVerts and b >= 1 and b <= #centeredVerts and a ~= b then
                local wa = weldMap[a] or a
                local wb = weldMap[b] or b
                if wa ~= wb then
                    local k1, k2 = math.min(wa, wb), math.max(wa, wb)
                    local key = k1 .. "_" .. k2
                    if not seenInFace[key] then
                        seenInFace[key] = true
                        edgeCount[key] = (edgeCount[key] or 0) + 1
                        if not edgeMap[key] then
                            edgeMap[key] = {centeredVerts[wa], centeredVerts[wb], wa, wb}
                            edgeOrder[#edgeOrder + 1] = key
                            edgeFaces[key] = {}
                        end
                        edgeFaces[key][#edgeFaces[key] + 1] = face
                    end
                end
            end
        end
    end
    local edges = {}
    for _, key in ipairs(edgeOrder) do
        local count = edgeCount[key]
        local keep = true
        if count >= 2 then
            local fs = edgeFaces[key]
            if fs and #fs >= 2 then
                local normals = {}
                for fi = 1, #fs do
                    local face = fs[fi]
                    local fn = #face
                    if fn >= 3 then
                        local nx, ny, nz = 0, 0, 0
                        for i = 1, fn do
                            local p1 = centeredVerts[face[i]]
                            local p2 = centeredVerts[face[(i % fn) + 1]]
                            if p1 and p2 then
                                nx = nx + (p1.Y - p2.Y) * (p1.Z + p2.Z)
                                ny = ny + (p1.Z - p2.Z) * (p1.X + p2.X)
                                nz = nz + (p1.X - p2.X) * (p1.Y + p2.Y)
                            end
                        end
                        local nVec = Vector3.new(nx, ny, nz)
                        if nVec.Magnitude > 0.0001 then
                            normals[#normals + 1] = nVec.Unit
                        end
                    end
                end
                if #normals >= 2 then
                    local allCoplanar = true
                    for i = 2, #normals do
                        if math.abs(normals[1]:Dot(normals[i])) < 0.92 then
                            allCoplanar = false
                            break
                        end
                    end
                    if allCoplanar then
                        keep = false
                    end
                end
            end
        end
        if keep then
            local eNormal = nil
            local efs = edgeFaces[key]
            if efs and #efs >= 1 then
                local sumN = Vector3.zero
                local nCount = 0
                for _, face in ipairs(efs) do
                    if #face >= 3 then
                        local fp1 = centeredVerts[face[1]]
                        local fp2 = centeredVerts[face[2]]
                        local fp3 = centeredVerts[face[3]]
                        if fp1 and fp2 and fp3 then
                            local fn = (fp2 - fp1):Cross(fp3 - fp1)
                            if fn.Magnitude > 0.0001 then
                                sumN = sumN + fn.Unit
                                nCount = nCount + 1
                            end
                        end
                    end
                end
                if nCount > 0 and sumN.Magnitude > 0.0001 then
                    eNormal = sumN.Unit
                end
            end
            edges[#edges + 1] = {edgeMap[key][1], edgeMap[key][2], eNormal}
        end

        do
            local eNormal2 = nil
            local efs2 = edgeFaces[key]
            if efs2 and #efs2 >= 1 then
                local sumN2 = Vector3.zero
                local nC2 = 0
                for _, face in ipairs(efs2) do
                    if #face >= 3 then
                        local fp1 = centeredVerts[face[1]]
                        local fp2 = centeredVerts[face[2]]
                        local fp3 = centeredVerts[face[3]]
                        if fp1 and fp2 and fp3 then
                            local fn = (fp2 - fp1):Cross(fp3 - fp1)
                            if fn.Magnitude > 0.0001 then
                                sumN2 = sumN2 + fn.Unit
                                nC2 = nC2 + 1
                            end
                        end
                    end
                end
                if nC2 > 0 and sumN2.Magnitude > 0.0001 then
                    eNormal2 = sumN2.Unit
                end
            end
            allEdges[#allEdges + 1] = {edgeMap[key][1], edgeMap[key][2], eNormal2, key}
        end
    end

    local function getColor(pos)
        for _, f in ipairs(faces) do
            local color = chooseFaceColor(f, vertices, f.material, materialColors)
            if color then return color end
        end
        return nil
    end

    local function getColorForPos(pos)

        local bestDist = math.huge
        local bestColor = nil
        for _, f in ipairs(faces) do
            local indices = f.indices
            if #indices >= 3 then
                for i = 2, #indices - 1 do
                    local p1 = centeredVerts[indices[1]]
                    local p2 = centeredVerts[indices[i]]
                    local p3 = centeredVerts[indices[i+1]]
                    if p1 and p2 and p3 then
                        local centroid = (p1 + p2 + p3) / 3
                        local dist = (pos - centroid).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestColor = chooseFaceColor(indices, vertices, f.material, materialColors)
                        end
                    end
                end
            end
        end
        return bestColor
    end

    if mode == "face" then
        for fi, f in ipairs(faces) do
            faceIndex = fi
            local points = {}
            for _, idx in ipairs(f.indices) do
                points[#points + 1] = centeredVerts[idx] or vertices[idx].pos
            end
            local meshColor = chooseFaceColor(f.indices, vertices, f.material, materialColors)
            local cx, cy, cz = 0, 0, 0
            for _, p in ipairs(points) do cx = cx + p.X; cy = cy + p.Y; cz = cz + p.Z end
            local n = #points
            local faceCentroid = Vector3.new(cx/n, cy/n, cz/n)
            local color = resolveColor(meshColor, faceCentroid)
            local block = makeFacePanelCentered(points, thickness, color, blockId)
            if block then
                blocks[#blocks + 1] = block
                blockId = blockId + 1
            end
        end
    elseif mode == "wireframe" or mode == "wireframe_ext" then
        local wfThick = math.max(0.05, tonumber(thickness) or 0.2)
        local isExtended = (mode == "wireframe_ext")
        local edgeDict = {}
        local uniqueEdgeList = {}
        for fi, f in ipairs(faces) do
            local idxs = f.indices
            local fn = #idxs
            if fn >= 2 then
                for i = 1, fn do
                    local iA = idxs[i]
                    local iB = idxs[(i % fn) + 1]
                    if iA and iB and iA ~= iB and centeredVerts[iA] and centeredVerts[iB] then
                        local k1, k2 = math.min(iA, iB), math.max(iA, iB)
                        local key = k1 .. "_" .. k2
                        if not edgeDict[key] then
                            edgeDict[key] = true
                            uniqueEdgeList[#uniqueEdgeList + 1] = {centeredVerts[iA], centeredVerts[iB], fi, iA, iB}
                        end
                    end
                end
            end
        end

        local nodeSeen = {}
        for ei, edge in ipairs(uniqueEdgeList) do
            if ei % 150 == 0 then task.wait() end
            local pA, pB, fi, vA, vB = edge[1], edge[2], edge[3], edge[4], edge[5]
            faceIndex = fi
            local mid = (pA + pB) * 0.5
            local meshColor = chooseFaceColor(faces[fi] and faces[fi].indices, vertices, faces[fi] and faces[fi].material, materialColors)
            if not meshColor then meshColor = getColor(mid) end
            local color = resolveColor(meshColor, mid)
            if not color or color == "" then color = resolveColor(nil, mid) end
            if not color or color == "" then
                color = string.format("%.3f,%.3f,%.3f", opts.customR or 0.4, opts.customG or 0.6, opts.customB or 1.0)
            end

            local block = makeWireEdge(pA, pB, wfThick, color, blockId)
            if block then
                blocks[#blocks + 1] = block
                blockId = blockId + 1
            end

            if isExtended then
                local nodeSz = wfThick * 1.5
                for _, vi in ipairs({vA, vB}) do
                    if not nodeSeen[vi] then
                        nodeSeen[vi] = true
                        local vPos = centeredVerts[vi]
                        if vPos then
                            local nodeCol = resolveColor(meshColor, vPos)
                            local nodeBlk = cfToAsuBlock(CFrame.new(vPos), Vector3.new(nodeSz, nodeSz, nodeSz), nodeCol, blockId, 0)
                            if nodeBlk then
                                blocks[#blocks + 1] = nodeBlk
                                blockId = blockId + 1
                            end
                        end
                    end
                end
            end
        end
    elseif mode == "solid" then
        local baseStripWidth = math.max(0.08, (tonumber(stripSize) or 0.5) / math.max(0.2, solidDetail))
        local depth = math.max(0.05, tonumber(thickness) or 0.2)

        for fi, f in ipairs(faces) do
            if fi % 150 == 0 then task.wait() end
            faceIndex = fi
            local idxs = f.indices
            local fn = #idxs
            if fn >= 3 then
                local meshColor = chooseFaceColor(idxs, vertices, f.material, materialColors)

                for i = 2, fn - 1 do
                    local iA, iB, iC = idxs[1], idxs[i], idxs[i + 1]
                    local pA = centeredVerts[iA]
                    local pB = centeredVerts[iB]
                    local pC = centeredVerts[iC]

                    if pA and pB and pC then
                        local triCentroid = (pA + pB + pC) / 3
                        local colStr = resolveColor(meshColor, triCentroid)

                        local slices = buildTriangleAltitudeStrips(pA, pB, pC, baseStripWidth, depth, colStr, blockId)
                        for _, sl in ipairs(slices) do
                            blocks[#blocks + 1] = sl
                            blockId = blockId + 1
                        end
                    end
                end
            end
        end

    elseif mode == "voxel" then
        local cellMap = {}
        local voxelSize = math.max(0.05, stripSize)
        local effectiveVoxelSize = voxelSize / math.max(scale, 0.001)

        local mergedQuads, skipFaceSet = mergeCoplanarFacesForVoxel(faces, centeredVerts, 0.02, vertices, materialColors, resolveColor)
        local mergedCount = 0
        for _ in pairs(skipFaceSet) do mergedCount = mergedCount + 1 end

        for fi, f in ipairs(faces) do
            if skipFaceSet[fi] then continue end
            faceIndex = fi
            local meshColor = chooseFaceColor(f.indices, vertices, f.material, materialColors)
            local fcx, fcy, fcz = 0, 0, 0
            for _, idx in ipairs(f.indices) do local p = centeredVerts[idx] or vertices[idx].pos; fcx = fcx + p.X; fcy = fcy + p.Y; fcz = fcz + p.Z end
            local fn = #f.indices
            local voxCentroid = Vector3.new(fcx/fn, fcy/fn, fcz/fn)
            local color = resolveColor(meshColor, voxCentroid)
            for _, tri in ipairs(triangulateFace(f.indices)) do
                local vp1 = centeredVerts[tri[1]] or vertices[tri[1]].pos
                local vp2 = centeredVerts[tri[2]] or vertices[tri[2]].pos
                local vp3 = centeredVerts[tri[3]] or vertices[tri[3]].pos
                rasterizeTriangleToVoxels(cellMap, vp1, vp2, vp3, effectiveVoxelSize, color)
            end
        end

        for qi, quad in ipairs(mergedQuads) do

            rasterizeTriangleToVoxels(cellMap, quad.p1, quad.p2, quad.p3, effectiveVoxelSize, quad.color)
            rasterizeTriangleToVoxels(cellMap, quad.p1, quad.p3, quad.p4, effectiveVoxelSize, quad.color)
        end

        blocks = voxelCellsToBlocks(cellMap, voxelSize, blockId)
    end
    return blocks
end

convertObjToBlocks = function(filePath, scale, thickness, mode, material, colorOpts)
    scale = tonumber(scale) or 1
    thickness = tonumber(thickness) or 0.2
    material = tostring(material or "PlasticBlock")
    if scale <= 0 or thickness <= 0 then
        return nil, nil, "Scale/thickness must be > 0"
    end
    local readFileOk, text = pcall(readfile, filePath)
    if not readFileOk then
        return nil, nil, "Failed to read file: " .. tostring(text)
    end
    local parsed = parseObjData(text, filePath)
    if #(parsed.vertices or {}) == 0 then
        return nil, nil, "No vertices found in OBJ file"
    end
    local blocks = buildObjBlocks(parsed, scale, thickness, mode, colorOpts)
    if #blocks == 0 then
        return nil, nil, "No blocks produced"
    end
    local minBottomY = math.huge
    for _, blk in ipairs(blocks) do
        local cy = 0
        local sy = 0
        local hx, hy, hz = 0.5, 0.5, 0.5
        if blk.CFrame then
            local cf = strCF(blk.CFrame)
            cy = cf.Position.Y
            if blk.Size then
                local sz = strV3(blk.Size)
                hx, hy, hz = sz.X * 0.5, sz.Y * 0.5, sz.Z * 0.5
            end
            local extY = hx * math.abs(cf.RightVector.Y) + hy * math.abs(cf.UpVector.Y) + hz * math.abs(cf.LookVector.Y)
            local bottom = cy - extY
            if bottom < minBottomY then
                minBottomY = bottom
            end
        else
            if blk.Position then
                local nums = parseNums(blk.Position)
                if #nums >= 2 then cy = nums[2] end
            end
            if blk.Size then
                local sz = strV3(blk.Size)
                sy = sz.Y
            end
            local bottom = cy - sy * 0.5
            if bottom < minBottomY then
                minBottomY = bottom
            end
        end
    end
    local targetBottomY = 6.0
    if minBottomY < targetBottomY or minBottomY == math.huge then
        local yShift = (minBottomY == math.huge) and 6.0 or (targetBottomY - minBottomY)
        local shiftVec = Vector3.new(0, yShift, 0)
        for _, blk in ipairs(blocks) do
            if blk.CFrame then
                local cf = strCF(blk.CFrame)
                blk.CFrame = cfStr(CFrame.new(shiftVec) * cf)
            end
            if blk.Position then
                local nums = parseNums(blk.Position)
                if #nums >= 3 then
                    nums[2] = nums[2] + yShift
                    blk.Position = string.format("%.6f, %.6f, %.6f", nums[1], nums[2], nums[3])
                end
            end
        end
    end
    return material, blocks, nil
end

convertObjToBuild = function(filePath, buildName, scale, thickness, material, mode, colorOpts)
    local outMaterial, blocks, err = convertObjToBlocks(filePath, scale, thickness, mode, material, colorOpts)
    if not outMaterial then
        return nil, err
    end

    local off = Vector3.new(tonumber(Settings.buildOffsetX) or 0, tonumber(Settings.buildOffsetY) or 0, tonumber(Settings.buildOffsetZ) or 0)
    local scVec = Vector3.new(tonumber(Settings.scaleX) or 1, tonumber(Settings.scaleY) or 1, tonumber(Settings.scaleZ) or 1)
    if off.Magnitude > 0.001 or (scVec - Vector3.new(1,1,1)).Magnitude > 0.001 then
        for _, blk in ipairs(blocks) do
            if blk.CFrame then
                local cf = strCF(blk.CFrame)
                local p = cf.Position
                local newP = Vector3.new(p.X * scVec.X, p.Y * scVec.Y, p.Z * scVec.Z) + off
                blk.CFrame = cfStr(CFrame.new(newP) * (cf - p))
            end
            if blk.Position then
                local nums = parseNums(blk.Position)
                if #nums >= 3 then
                    blk.Position = string.format("%.6f, %.6f, %.6f", nums[1] * scVec.X + off.X, nums[2] * scVec.Y + off.Y, nums[3] * scVec.Z + off.Z)
                end
            end
            if blk.Size then
                local sz = strV3(blk.Size)
                blk.Size = string.format("%.6f, %.6f, %.6f", sz.X * scVec.X, sz.Y * scVec.Y, sz.Z * scVec.Z)
            end
        end
    end
    return writeConvertedBuild(buildName, outMaterial, blocks)
end
end

function bytesToFloatLE(b1, b2, b3, b4)
    local v = (((b4 * 256) + b3) * 256 + b2) * 256 + b1
    if v == 0 then return 0 end
    local sign = bit.band(v, 0x80000000) ~= 0 and -1 or 1
    local exp = bit.band(bit.rshift(v, 23), 0xFF)
    local mant = bit.band(v, 0x7FFFFF)
    if exp == 0 then
        return sign * (mant / 8388608) * 2^-126
    end
    if exp == 255 then
        return sign * math.huge
    end
    return sign * (1 + mant / 8388608) * 2^(exp - 127)
end

function asuToCF(pos, rot)
    local p = {0,0,0}
    if type(pos) == "string" then
        local v = parseNums(pos)
        if #v >= 3 then p = {v[1],v[2],v[3]} end
    elseif type(pos) == "table" then p = pos end
    local r = {0,0,0}
    if type(rot) == "string" then
        local v = parseNums(rot)
        if #v >= 3 then r = {math.rad(v[1]),math.rad(v[2]),math.rad(v[3])} end
    elseif type(rot) == "table" then
        for i,v in ipairs(rot) do r[i] = math.rad(tonumber(v) or 0) end
    end
    return CFrame.new(p[1] or 0, p[2] or 0, p[3] or 0) * CFrame.fromEulerAnglesXYZ(r[1] or 0, r[2] or 0, r[3] or 0)
end

function convertAsuToPRS(asuData)
    if type(asuData) ~= "table" then return nil end
    local prs = {}
    local entriesById = {}
    local pendingBindTables = {}

    local keyOrder = asuData._SPRB_KeyOrder or _SPRB_AsuKeyOrder
    _SPRB_AsuKeyOrder = nil
    local orderedNames, seenName = {}, {}
    if type(keyOrder) == "table" then
        for _, nm in ipairs(keyOrder) do
            if asuData[nm] ~= nil and not seenName[nm] then
                seenName[nm] = true
                orderedNames[#orderedNames + 1] = nm
            end
        end
    end
    do
        local restNames = {}
        for nm in pairs(asuData) do
            if not seenName[nm] then restNames[#restNames + 1] = nm end
        end
        table.sort(restNames)
        for _, nm in ipairs(restNames) do orderedNames[#orderedNames + 1] = nm end
    end
    local globalIdCounter = 1
    for _, blockName in ipairs(orderedNames) do
        local blocks = asuData[blockName]
        if type(blocks) == "table" then
            prs[blockName] = prs[blockName] or {}
            for _, block in ipairs(blocks) do
                if type(block) == "table" then
                    local rawCF = block.CFrame or block.cframe
                    local cf = nil
                    if rawCF then
                        cf = strCF(rawCF)
                    end
                    if cf then
                        local cp = cf.Position
                        if math.abs(cp.X) > 50000 or math.abs(cp.Y) > 50000 or math.abs(cp.Z) > 50000 then
                            continue
                        end
                    end
                    if not cf then
                        local pos = block.Position or block.position or block.Pos or block.pos or block.p
                        local rot = block.Rotation or block.rotation or block.Rot or block.rot or block.r
                        if not pos then continue end
                        if type(pos) == "string" or type(rot) == "string" then
                            cf = asuToCF(tostring(pos), rot and tostring(rot) or "0,0,0")
                        else
                            cf = CFrame.new(
                                (type(pos)=="table") and (pos[1] or pos.X or 0) or 0,
                                (type(pos)=="table") and (pos[2] or pos.Y or 0) or 0,
                                (type(pos)=="table") and (pos[3] or pos.Z or 0) or 0
                            ) * CFrame.Angles(
                                math.rad((type(rot)=="table") and (rot[1] or rot.X or 0) or 0),
                                math.rad((type(rot)=="table") and (rot[2] or rot.Y or 0) or 0),
                                math.rad((type(rot)=="table") and (rot[3] or rot.Z or 0) or 0)
                            )
                        end
                    end
                    local sz = block.Size or block.size or block.sz or block.s
                    local col = block.Color or block.color or block.Col or block.col or block.cl
                    local sizeStr = nil
                    if sz then
                        local sizeVec = Vector3.new(1,1,1)
                        if type(sz) == "string" then
                            local v = parseNums(sz)
                            if #v >= 3 then sizeVec = Vector3.new(v[1],v[2],v[3]) end
                        elseif type(sz) == "table" then
                            sizeVec = Vector3.new(sz[1] or sz.X or 1, sz[2] or sz.Y or 1, sz[3] or sz.Z or 1)
                        elseif type(sz) == "number" then
                            sizeVec = Vector3.new(sz,sz,sz)
                        end
                        sizeStr = v3Str(sizeVec)
                    end
                    local colStr2 = nil
                    if col and type(col) == "string" then
                        local cv = parseNums(col)
                        if #cv >= 3 then
                            local r2,g2,b2 = cv[1],cv[2],cv[3]
                            if r2>1 or g2>1 or b2>1 then r2=r2/255; g2=g2/255; b2=b2/255 end
                            colStr2 = string.format("%.4f,%.4f,%.4f", math.clamp(r2,0,1), math.clamp(g2,0,1), math.clamp(b2,0,1))
                        end
                    elseif type(col) == "table" then
                        local r2 = tonumber(col[1] or col.r or col.R) or 0
                        local g2 = tonumber(col[2] or col.g or col.G) or 0
                        local b2 = tonumber(col[3] or col.b or col.B) or 0
                        if r2>1 or g2>1 or b2>1 then r2=r2/255; g2=g2/255; b2=b2/255 end
                        colStr2 = string.format("%.4f,%.4f,%.4f", math.clamp(r2,0,1), math.clamp(g2,0,1), math.clamp(b2,0,1))
                    end
                    local extras = collectAsuExtras(block)
                    local mergedBoolValues, mergedNumberValues = mergePropertyMaps(block.BoolValues, block.NumberValues, extras, block.MValues)
                    if block.Density ~= nil and mergedNumberValues and mergedNumberValues.Density == nil then
                        local dn = tonumber(block.Density)
                        if dn ~= nil then mergedNumberValues.Density = dn end
                    end
                    if mergedNumberValues then
                        if mergedNumberValues.LastDirrection ~= nil and mergedNumberValues.LastDirection == nil then
                            mergedNumberValues.LastDirection = mergedNumberValues.LastDirrection
                            mergedNumberValues.LastDirrection = nil
                        end
                    end

                    if block.d ~= nil then
                        local dVal = tonumber(block.d) or 0.2
                        mergedNumberValues = mergedNumberValues or {}
                        mergedNumberValues.Delay = dVal
                        mergedNumberValues["Delay time"] = dVal
                        mergedNumberValues.WaitDuration = dVal
                    end

                    local assignedId = block.ID or block.i or block.Id or block.id
                    if assignedId == nil then
                        assignedId = globalIdCounter
                        globalIdCounter = globalIdCounter + 1
                    else
                        assignedId = tonumber(assignedId) or assignedId
                        if type(assignedId) == "number" then
                            globalIdCounter = math.max(globalIdCounter, assignedId + 1)
                        end
                    end

                    local rawCC = block.CanCollide
                    if rawCC == nil and block.cc ~= nil then rawCC = block.cc end
                    if rawCC == nil and block.Collision ~= nil then rawCC = block.Collision end
                    if rawCC == nil and mergedBoolValues then
                        if mergedBoolValues.CanCollide ~= nil then
                            rawCC = mergedBoolValues.CanCollide
                        elseif mergedBoolValues.Collision ~= nil then
                            rawCC = mergedBoolValues.Collision
                        end
                    end
                    local effCanCollide = nil
                    if rawCC ~= nil then
                        if type(rawCC) == "boolean" then
                            effCanCollide = rawCC
                        elseif tostring(rawCC):lower() == "false" or rawCC == 0 then
                            effCanCollide = false
                        elseif tostring(rawCC):lower() == "true" or rawCC == 1 then
                            effCanCollide = true
                        end
                    end

                    local rawShadow = block.ShowShadow
                    if rawShadow == nil and block.CastShadow ~= nil then rawShadow = block.CastShadow end
                    if rawShadow == nil and block.ss ~= nil then rawShadow = block.ss end
                    if rawShadow == nil and mergedBoolValues then
                        if mergedBoolValues.ShowShadow ~= nil then
                            rawShadow = mergedBoolValues.ShowShadow
                        elseif mergedBoolValues.CastShadow ~= nil then
                            rawShadow = mergedBoolValues.CastShadow
                        end
                    end
                    local effShadow = nil
                    if rawShadow ~= nil then
                        if type(rawShadow) == "boolean" then
                            effShadow = rawShadow
                        elseif tostring(rawShadow):lower() == "false" or rawShadow == 0 then
                            effShadow = false
                        elseif tostring(rawShadow):lower() == "true" or rawShadow == 1 then
                            effShadow = true
                        end
                    end

                    local rawAnchored = block.Anchored
                    if rawAnchored == nil and block.a ~= nil then rawAnchored = block.a end
                    if rawAnchored == nil and mergedBoolValues and mergedBoolValues.Anchored ~= nil then
                        rawAnchored = mergedBoolValues.Anchored
                    end
                    local effAnchored = nil
                    if rawAnchored ~= nil then
                        if type(rawAnchored) == "boolean" then
                            effAnchored = rawAnchored
                        elseif tostring(rawAnchored):lower() == "false" or rawAnchored == 0 then
                            effAnchored = false
                        elseif tostring(rawAnchored):lower() == "true" or rawAnchored == 1 then
                            effAnchored = true
                        end
                    end

                    local rawTransp = block.Transparency
                    if rawTransp == nil and block.t ~= nil then rawTransp = block.t end
                    if rawTransp == nil and mergedNumberValues and mergedNumberValues.Transparency ~= nil then
                        rawTransp = mergedNumberValues.Transparency
                    end
                    local effTransp = nil
                    if rawTransp ~= nil then
                        local tn = tonumber(rawTransp)
                        if tn ~= nil then
                            if tn > 1 then effTransp = math.clamp(tn / 100, 0, 1) else effTransp = math.clamp(tn, 0, 1) end
                        end
                    end

                    local flatNums = {
                        ServoTorque = true, ServoSpeed = true, WheelTorque = true, MaxSpeed = true,
                        ExtendLength = true, Speed = true, WaitDuration = true, FuseTime = true,
                        FlightDistance = true, SemitoneOffset = true, HeadScale = true, HeightScale = true,
                        WidthScale = true, DepthScale = true, MaxForce = true, Stiffness = true,
                        Damping = true, TargetLength = true, MaxLength = true, MinLength = true,
                        Length = true, AngleLimit = true, LastDirection = true, LastDirrection = true,
                        Density = true, Weight = true,
                    }
                    mergedNumberValues = mergedNumberValues or {}
                    for fk in pairs(flatNums) do
                        local fv = block[fk]
                        if fv ~= nil and mergedNumberValues[fk] == nil and type(fv) ~= "table" then
                            local fnv = tonumber(fv)
                            if fnv ~= nil then mergedNumberValues[fk] = fnv end
                        end
                    end
                    local flatBools = {
                        ReverseRotation = true, ReverseSpin = true, MatchRotation = true,
                        ShowConstraint = true, Invertible = true, ShowCrosshairs = true, Legacy = true,
                        Forward = true, Backward = true,
                    }
                    mergedBoolValues = mergedBoolValues or {}
                    for fk in pairs(flatBools) do
                        local fv = block[fk]
                        if fv ~= nil and mergedBoolValues[fk] == nil then
                            if type(fv) == "boolean" then mergedBoolValues[fk] = fv
                            elseif fv == 1 or fv == "1" or fv == "true" then mergedBoolValues[fk] = true
                            elseif fv == 0 or fv == "0" or fv == "false" then mergedBoolValues[fk] = false end
                        end
                    end

                    local entry = {
                        CFrame = cfStr(cf),
                        ID = assignedId,
                        Size = sizeStr,
                        Col = colStr2,
                        Transparency = effTransp,
                        Anchored = effAnchored,
                        CanCollide = effCanCollide,
                        ShowShadow = effShadow,
                        ASUExtra = extras,
                        BoolValues = mergedBoolValues,
                        NumberValues = mergedNumberValues,
                    }

                    if block.np ~= nil then
                        local npVal = tonumber(block.np) or 0
                        entry.NotePitch = npVal
                        entry.NumberValues = entry.NumberValues or {}
                        entry.NumberValues.NotePitch = npVal
                        entry.NumberValues.Key = npVal
                    end

                    if block.SecondaryPartPosition then entry.SecondaryPartPosition = tostring(block.SecondaryPartPosition) end
                    if block.SecondaryPartRotation then entry.SecondaryPartRotation = tostring(block.SecondaryPartRotation) end
                    if block.Stiffness ~= nil then entry.Stiffness = block.Stiffness end
                    if block.Damping ~= nil then entry.Damping = block.Damping end
                    if block.TargetLength ~= nil then entry.TargetLength = block.TargetLength end
                    if block.MaxLength ~= nil then entry.MaxLength = block.MaxLength end
                    if block.MinLength ~= nil then entry.MinLength = block.MinLength end
                    if block.Length ~= nil then entry.Length = block.Length end
                    if block.AngleLimit ~= nil then entry.AngleLimit = block.AngleLimit end
                    if block.MatchRotation ~= nil then entry.MatchRotation = block.MatchRotation end
                    if block.ShowConstraint ~= nil then entry.ShowConstraint = block.ShowConstraint end
                    if block.ServoTorque ~= nil then entry.ServoTorque = block.ServoTorque end
                    if block.ServoSpeed ~= nil then entry.ServoSpeed = block.ServoSpeed end
                    if block.BarLength ~= nil then entry.BarLength = block.BarLength end
                    if block.WheelTorque ~= nil then entry.WheelTorque = block.WheelTorque end
                    if block.Text then entry.Text = block.Text end
                    local rawBindTable = block.BindTable or block.bd or block.Binds or block.binds
                    if type(rawBindTable) == "table" and #rawBindTable > 0 then
                        local normBinds = {}
                        for _, br in ipairs(rawBindTable) do
                            if type(br) == "table" and br[1] ~= nil then
                                normBinds[#normBinds + 1] = {tonumber(br[1]) or br[1], br[2] or "BindFire", tonumber(br[3]) or br[3] or -1}
                            elseif type(br) == "number" or type(br) == "string" then
                                normBinds[#normBinds + 1] = {tonumber(br) or br, "BindFire", -1}
                            end
                        end
                        if #normBinds > 0 then
                            entry.BindTable = normBinds
                            pendingBindTables[#pendingBindTables + 1] = entry.BindTable
                        end
                    end
                    if entry.ID ~= nil then
                        entriesById[entry.ID] = entry
                        entriesById[tostring(entry.ID)] = entry
                    end
                    table.insert(prs[blockName], entry)
                    if globalIdCounter % 400 == 0 and coroutine.running() then
                        task.wait()
                    end
                end
            end
        end
    end

    prs._SPRB_KeyOrder = orderedNames
    return prs
end

function convertedBlocksToPRS(material, blocks)
    if type(blocks) ~= "table" or #blocks == 0 then
        return nil
    end
    local materialName = tostring(material or "PlasticBlock")
    if materialName ~= "Auto" then
        return convertAsuToPRS({[materialName] = blocks})
    end
    local groups = {}
    for _, block in ipairs(blocks) do
        local blockMaterial = tostring(block.Material or "PlasticBlock")
        groups[blockMaterial] = groups[blockMaterial] or {}
        groups[blockMaterial][#groups[blockMaterial] + 1] = block
    end
    return convertAsuToPRS(groups)
end

function convertRobloxAssetToBlocks(assetId, scale)
    local id = tostring(assetId or ""):match("%d+")
    if not id then return nil, "Enter a valid Roblox asset ID" end
    scale = math.clamp(tonumber(scale) or 1, 0.05, 10)
    local ok, loaded = pcall(function()
        return game:GetObjects("rbxassetid://" .. id)
    end)
    if not ok or type(loaded) ~= "table" or not loaded[1] then
        return nil, "Roblox could not load this asset ID"
    end
    local root = loaded[1]
    local parts = {}
    for _, obj in ipairs(root:GetDescendants()) do
        if obj:IsA("BasePart") then parts[#parts + 1] = obj end
    end
    if root:IsA("BasePart") then parts[#parts + 1] = root end
    if #parts == 0 then return nil, "The asset has no BasePart or MeshPart" end
    local function mapRobloxMaterial(mat)
        local n = tostring(mat and mat.Name or ""):lower()
        if n:find("wood") then return "WoodBlock" end
        if n:find("metal") or n:find("diamond") or n:find("foil") then return "MetalBlock" end
        if n:find("glass") then return "GlassBlock" end
        if n:find("neon") then return "NeonBlock" end
        if n:find("fabric") then return "FabricBlock" end
        if n:find("granite") then return "GraniteBlock" end
        if n:find("marble") then return "MarbleBlock" end
        if n:find("slate") then return "SlateBlock" end
        if n:find("brick") then return "BrickBlock" end
        if n:find("cobble") then return "CobblestoneBlock" end
        if n:find("grass") then return "GrassBlock" end
        if n:find("ice") then return "IceBlock" end
        if n:find("sand") then return "SandBlock" end
        if n:find("concrete") then return "ConcreteBlock" end
        if n:find("corroded") then return "CorrodedMetalBlock" end
        if n:find("pebble") then return "PebbleBlock" end
        return "PlasticBlock"
    end
    local center = Vector3.zero
    for _, part in ipairs(parts) do center = center + part.Position end
    center = center / #parts
    local blocks = {}
    for index, part in ipairs(parts) do
        local rx, ry, rz = part.CFrame:ToOrientation()
        blocks[#blocks + 1] = {
            Position = {(part.Position.X - center.X) * scale, (part.Position.Y - center.Y) * scale, (part.Position.Z - center.Z) * scale},
            Rotation = {math.deg(rx), math.deg(ry), math.deg(rz)},
            Size = {math.max(0.05, part.Size.X * scale), math.max(0.05, part.Size.Y * scale), math.max(0.05, part.Size.Z * scale)},
            Color = colStr(part.Color),
            Transparency = part.Transparency,
            Anchored = true,
            CanCollide = part.CanCollide,
            Material = mapRobloxMaterial(part.Material),
            ID = index,
        }
    end
    pcall(function() root:Destroy() end)
    return blocks, nil
end

function convertPRStoAU2(prsData)

    if type(prsData) ~= "table" then return nil end
    local data = {}
    for blockName, blocks in pairs(prsData) do
        if type(blocks) == "table" and #blocks > 0 then
            local arr = {}
            for idx, bi in ipairs(blocks) do
                local entry = {}
                entry.i = bi.ID or idx
                if bi.Anchored == false then entry.a = 0 end
                if bi.CanCollide == false then entry.cc = 0 end
                if bi.Transparency and bi.Transparency ~= 0 then entry.t = bi.Transparency end
                if bi.ShowShadow == false then entry.sh = 0 end
                if bi.CFrame then
                    if type(bi.CFrame) == "string" then
                        local nums = {}
                        for v in bi.CFrame:gmatch("[^,]+") do
                            local n = tonumber(v:match("^%s*(.-)%s*$"))
                            if n then table.insert(nums, n) end
                        end
                        entry.c = nums
                    elseif type(bi.CFrame) == "table" then
                        entry.c = bi.CFrame
                    end
                end
                if bi.Size then
                    if type(bi.Size) == "string" then
                        local nums = {}
                        for v in bi.Size:gmatch("[^,]+") do
                            local n = tonumber(v:match("^%s*(.-)%s*$"))
                            if n then table.insert(nums, n) end
                        end
                        entry.s = nums
                    elseif type(bi.Size) == "table" then
                        entry.s = bi.Size
                    end
                end
                if bi.Col then
                    local cv = {}
                    for v in bi.Col:gmatch("[^,]+") do
                        local n = tonumber(v:match("^%s*(.-)%s*$"))
                        if n then table.insert(cv, n) end
                    end
                    if #cv >= 3 then
                        local r = math.floor((cv[1] or 1) * 255 + 0.5)
                        local g = math.floor((cv[2] or 1) * 255 + 0.5)
                        local b = math.floor((cv[3] or 1) * 255 + 0.5)
                        entry.cl = string.format("%02x%02x%02x", r, g, b)
                    end
                end
                local nv = {}
                if bi.NumberValues and type(bi.NumberValues) == "table" then
                    for k, v in pairs(bi.NumberValues) do nv[k] = v end
                end
                if bi.BoolValues and type(bi.BoolValues) == "table" then
                    for k, v in pairs(bi.BoolValues) do nv[k] = v end
                end
                if next(nv) then entry.nv = nv end
                if bi.SecCFrame then
                    if type(bi.SecCFrame) == "string" then
                        local nums = {}
                        for v in bi.SecCFrame:gmatch("[^,]+") do
                            local n = tonumber(v:match("^%s*(.-)%s*$"))
                            if n then table.insert(nums, n) end
                        end
                        entry.sc = nums
                    elseif type(bi.SecCFrame) == "table" then
                        entry.sc = bi.SecCFrame
                    end
                end
                if bi.BindTable and type(bi.BindTable) == "table" then
                    local idToBlock = {}
                    for bName, bList in pairs(prsData) do
                        if type(bList) == "table" then
                            for _, bEntry in ipairs(bList) do
                                if bEntry.ID then idToBlock[bEntry.ID] = bName end
                            end
                        end
                    end
                    local binds = {}
                    for _, bindRow in ipairs(bi.BindTable) do
                        if type(bindRow) == "table" and bindRow[1] then
                            local targetID = bindRow[1]
                            local bindName = bindRow[2]
                            local bindValue = bindRow[3]
                            table.insert(binds, {targetID, bindName, bindValue})
                        end
                    end
                    if #binds > 0 then entry.bd = binds; entry.BindTable = binds end
                end
                if bi.SpringProps and type(bi.SpringProps) == "table" and next(bi.SpringProps) then
                    entry.sp = bi.SpringProps
                end
                table.insert(arr, entry)
            end
            data[blockName] = arr
        end
    end
    return {f = "au2", v = 1, b = data}
end

function convertAU2toPRS(au2Data)

    if type(au2Data) ~= "table" or not au2Data.b then return nil end
    local data = au2Data.b
    local result = {}
    for blockName, blocks in pairs(data) do
        if type(blocks) == "table" and #blocks > 0 then
            local arr = {}
            for _, bi in ipairs(blocks) do
                local entry = {}
                entry.ID = bi.i
                entry.Anchored = (bi.a == nil) or (bi.a ~= 0)
                entry.CanCollide = (bi.cc == nil) or (bi.cc ~= 0)
                entry.Transparency = bi.t or 0
                entry.ShowShadow = (bi.sh == nil) or (bi.sh ~= 0)
                if bi.c then
                    if type(bi.c) == "table" then
                        entry.CFrame = table.concat(bi.c, ", ")
                    else
                        entry.CFrame = bi.c
                    end
                end

                if type(bi.s) == "table" and #bi.s >= 3 then
                    entry.Size = table.concat({bi.s[1], bi.s[2], bi.s[3]}, ", ")
                end
                if type(bi.cl) == "string" and #bi.cl >= 6 then
                    local rN = tonumber(string.sub(bi.cl, 1, 2), 16)
                    local gN = tonumber(string.sub(bi.cl, 3, 4), 16)
                    local bN = tonumber(string.sub(bi.cl, 5, 6), 16)
                    if rN and gN and bN then
                        entry.Col = string.format("%.4f,%.4f,%.4f", rN / 255, gN / 255, bN / 255)
                    end
                end
                if type(bi.nv) == "table" and next(bi.nv) then entry.NumberValues = bi.nv end
                if type(bi.sc) == "table" and #bi.sc >= 3 then entry.SecCFrame = bi.sc end
                if type(bi.bd) == "table" and #bi.bd > 0 then entry.BindTable = bi.bd end
                table.insert(arr, entry)
            end
            data[blockName] = arr
        end
    end
    return data
end

function rn(n)

    if n == nil then return nil end
    local r = math.floor(n * 10000 + 0.5) / 10000

    if r == math.floor(r) then return math.floor(r) end
    return r
end

function parseNumList(str)
    local t = {}
    if type(str) == "string" then
        for v in str:gmatch("[^,]+") do
            local n = tonumber(v:match("^%s*(.-)%s*$"))
            if n then t[#t+1] = n end
        end
    elseif type(str) == "table" then
        t = str
    end
    return t
end

TOON_SHORT = {
    Transparency = "t", Anchored = "a", CanCollide = "c",
    Color = "cl", CFrame = "cf", CastShadow = "cs", Size = "s",
    SecCFrame = "sp", NumberValues = "nv", BoolValues = "bv",
    BindTable = "bd", ID = "i", ShowShadow = "cs",
}

TOON_LONG = {}
for k, v in pairs(TOON_SHORT) do TOON_LONG[v] = k end

function toonRound(n)
    if n == nil then return nil end
    local intPart = math.floor(n + 0.5)
    if math.abs(n - intPart) < 0.001 then
        return intPart
    end
    local r2 = math.floor(n * 100 + 0.5) / 100
    if math.abs(n - r2) < 0.0005 then
        return r2
    end
    local r3 = math.floor(n * 1000 + 0.5) / 1000
    if r3 == math.floor(r3) then return math.floor(r3) end
    return r3
end

function toHexColor(r01, g01, b01)

    local ri = math.clamp(math.floor((r01 or 1) * 255 + 0.5), 0, 255)
    local gi = math.clamp(math.floor((g01 or 1) * 255 + 0.5), 0, 255)
    local bi = math.clamp(math.floor((b01 or 1) * 255 + 0.5), 0, 255)
    return string.format("#%02X%02X%02X", ri, gi, bi)
end

function fromHexColor(hex)

    hex = tostring(hex):gsub("^#", "")
    if #hex ~= 6 then return nil end
    local r = tonumber(hex:sub(1,2), 16)
    local g = tonumber(hex:sub(3,4), 16)
    local b = tonumber(hex:sub(5,6), 16)
    if not r or not g or not b then return nil end
    return r / 255, g / 255, b / 255
end

function isDefaultSignColor(col)
    if not col then return false end
    local r, g, b
    if typeof and typeof(col) == "Color3" then
        r = math.floor(col.R * 255 + 0.5)
        g = math.floor(col.G * 255 + 0.5)
        b = math.floor(col.B * 255 + 0.5)
    elseif type(col) == "table" and #col >= 3 then
        local c1, c2, c3 = tonumber(col[1]) or 0, tonumber(col[2]) or 0, tonumber(col[3]) or 0
        if c1 <= 1 and c2 <= 1 and c3 <= 1 and (c1 > 0 or c2 > 0 or c3 > 0) then
            r = math.floor(c1 * 255 + 0.5)
            g = math.floor(c2 * 255 + 0.5)
            b = math.floor(c3 * 255 + 0.5)
        else
            r, g, b = math.floor(c1 + 0.5), math.floor(c2 + 0.5), math.floor(c3 + 0.5)
        end
    elseif type(col) == "string" then
        if col:sub(1, 1) == "#" then
            local hex = col:gsub("^#", "")
            if #hex == 6 then
                r = tonumber(hex:sub(1, 2), 16)
                g = tonumber(hex:sub(3, 4), 16)
                b = tonumber(hex:sub(5, 6), 16)
            end
        else
            local c = strCol(col)
            if c then
                r = math.floor(c.R * 255 + 0.5)
                g = math.floor(c.G * 255 + 0.5)
                b = math.floor(c.B * 255 + 0.5)
            end
        end
    end
    if r and g and b then
        return math.abs(r - 137) <= 2 and math.abs(g - 119) <= 2 and math.abs(b - 84) <= 2
    end
    return false
end

function convertPRStoTOON(prsData)

    if type(prsData) ~= "table" then return nil end

    local result = {}
    for blockName, blocks in pairs(prsData) do
        if type(blocks) == "table" and #blocks > 0 then
            local arr = {}
            for _, bi in ipairs(blocks) do
                local entry = {}

                local cfNums = parseNumList(bi.CFrame)
                if #cfNums >= 12 then
                    local r00 = cfNums[4];  local r01 = cfNums[5];  local r02 = cfNums[6]
                    local r10 = cfNums[7];  local r11 = cfNums[8];  local r12 = cfNums[9]
                    local r20 = cfNums[10]; local r21 = cfNums[11]; local r22 = cfNums[12]

                    local isIdent = math.abs(r00 - 1) < 0.001 and math.abs(r01) < 0.001 and math.abs(r02) < 0.001
                        and math.abs(r10) < 0.001 and math.abs(r11 - 1) < 0.001 and math.abs(r12) < 0.001
                        and math.abs(r20) < 0.001 and math.abs(r21) < 0.001 and math.abs(r22 - 1) < 0.001

                    if isIdent then
                        entry.cf = {toonRound(cfNums[1]), toonRound(cfNums[2]), toonRound(cfNums[3])}
                    else
                        entry.cf = {
                            toonRound(cfNums[1]), toonRound(cfNums[2]), toonRound(cfNums[3]),
                            toonRound(r00), toonRound(r01), toonRound(r02),
                            toonRound(r10), toonRound(r11), toonRound(r12),
                            toonRound(r20), toonRound(r21), toonRound(r22),
                        }
                    end
                    entry.Position = {toonRound(cfNums[1]), toonRound(cfNums[2]), toonRound(cfNums[3])}
                    entry.Rotation = {0, 0, 0}
                elseif #cfNums >= 3 then
                    entry.cf = {toonRound(cfNums[1]), toonRound(cfNums[2]), toonRound(cfNums[3])}
                    entry.Position = {toonRound(cfNums[1]), toonRound(cfNums[2]), toonRound(cfNums[3])}
                    entry.Rotation = {0, 0, 0}
                end

                local szNums = parseNumList(bi.Size)
                if #szNums >= 3 then
                    local sx, sy, sz = toonRound(szNums[1]), toonRound(szNums[2]), toonRound(szNums[3])
                    if not (sx == 2 and sy == 2 and sz == 2) then
                        entry.s = {sx, sy, sz}
                    end
                end

                if bi.Col and not (blockName == "Sign" and isDefaultSignColor(bi.Col)) then
                    local cv = parseNumList(bi.Col)
                    if #cv >= 3 then
                        entry.cl = toHexColor(cv[1], cv[2], cv[3])
                    end
                end

                if bi.Anchored == false then entry.a = false end
                if bi.CanCollide == false then entry.c = false end
                if bi.ShowShadow == false then entry.cs = false end

                local t = toonRound(bi.Transparency)
                if t and t ~= 0 then entry.t = t end

                if bi.ID then entry.i = bi.ID end

                if bi.NumberValues and type(bi.NumberValues) == "table" then
                    local clean = {}
                    for k, v in pairs(bi.NumberValues) do
                        if k ~= "Health" and k ~= "MaxHealth" then
                            clean[k] = type(v) == "number" and toonRound(v) or v
                        end
                    end
                    if next(clean) then entry.nv = clean end
                end

                if bi.BoolValues and type(bi.BoolValues) == "table" then
                    local clean = {}
                    for k, v in pairs(bi.BoolValues) do clean[k] = v end
                    if next(clean) then entry.bv = clean end
                end

                if bi.SecCFrame then
                    local scNums = parseNumList(bi.SecCFrame)
                    if #scNums >= 3 then
                        entry.sp = {toonRound(scNums[1]), toonRound(scNums[2]), toonRound(scNums[3])}
                    end
                end

                if bi.BindTable and type(bi.BindTable) == "table" and #bi.BindTable > 0 then
                    local binds = {}
                    for _, br in ipairs(bi.BindTable) do
                        if type(br) == "table" and br[1] then
                            binds[#binds+1] = {tonumber(br[1]) or br[1], br[2] or "", br[3] or ""}
                        end
                    end
                    if #binds > 0 then entry.bd = binds end
                end

                if bi.NotePitch ~= nil then
                    entry.np = bi.NotePitch
                elseif bi.NumberValues and bi.NumberValues.NotePitch ~= nil then
                    entry.np = bi.NumberValues.NotePitch
                elseif bi.NumberValues and bi.NumberValues.Key ~= nil and blockName == "Note" then
                    entry.np = bi.NumberValues.Key
                end
                if bi.Note ~= nil then entry.nt = bi.Note end
                if bi.txt ~= nil and tostring(bi.txt) ~= "" then
                    entry.txt = tostring(bi.txt)
                elseif bi.Text ~= nil and tostring(bi.Text) ~= "" then
                    entry.txt = tostring(bi.Text)
                elseif bi.SignText ~= nil and tostring(bi.SignText) ~= "" then
                    entry.txt = tostring(bi.SignText)
                elseif bi.StringValues and (bi.StringValues.Text or bi.StringValues.SignText) then
                    local stVal = bi.StringValues.Text or bi.StringValues.SignText
                    if stVal and tostring(stVal) ~= "" then
                        entry.txt = tostring(stVal)
                    end
                end

                arr[#arr+1] = entry
            end
            result[blockName] = arr
        end
    end

    return result
end

function convertTOONtoPRS(data)

    if type(data) ~= "table" then return nil end

    local result = {}
    for blockName, blocks in pairs(data) do
        if type(blocks) == "table" and #blocks > 0 then
            local arr = {}
            for _, b in ipairs(blocks) do
                if type(b) == "table" then
                    local bi = {}

                    if b.cf then
                        if type(b.cf) == "table" then
                            if #b.cf >= 12 then
                                bi.CFrame = table.concat(b.cf, ", ")
                            elseif #b.cf >= 3 then
                                bi.CFrame = string.format("%s, %s, %s, 1, 0, 0, 0, 1, 0, 0, 0, 1", b.cf[1], b.cf[2], b.cf[3])
                            end
                        else
                            bi.CFrame = tostring(b.cf)
                        end
                    end

                    if b.s then
                        if type(b.s) == "table" then
                            bi.Size = table.concat(b.s, ", ")
                        else
                            bi.Size = tostring(b.s)
                        end
                    else
                        bi.Size = "2, 2, 2"
                    end

                    if b.cl then
                        local r, g, bl = fromHexColor(b.cl)
                        if r then
                            bi.Col = string.format("%.6f,%.6f,%.6f", r, g, bl)
                        end
                    end

                    if b.a ~= nil then bi.Anchored = b.a else bi.Anchored = true end
                    if b.c ~= nil then bi.CanCollide = b.c else bi.CanCollide = true end
                    if b.cs ~= nil then bi.ShowShadow = b.cs else bi.ShowShadow = true end

                    if b.t ~= nil then bi.Transparency = b.t else bi.Transparency = 0 end

                    if b.i then bi.ID = b.i end

                    if b.nv and type(b.nv) == "table" then
                        bi.NumberValues = b.nv
                    end

                    if b.bv and type(b.bv) == "table" then
                        bi.BoolValues = b.bv
                    end

                    if b.sp then
                        if type(b.sp) == "table" then
                            bi.SecCFrame = table.concat(b.sp, ", ")
                        else
                            bi.SecCFrame = tostring(b.sp)
                        end
                    end

                    if b.d ~= nil then
                        local dVal = tonumber(b.d) or 0.2
                        bi.NumberValues = bi.NumberValues or {}
                        bi.NumberValues.Delay = dVal
                        bi.NumberValues["Delay time"] = dVal
                        bi.NumberValues.WaitDuration = dVal
                    end

                    if b.bd and type(b.bd) == "table" and #b.bd > 0 then
                        local binds = {}
                        for _, item in ipairs(b.bd) do
                            if type(item) == "table" and item[1] ~= nil then
                                binds[#binds + 1] = {tonumber(item[1]) or item[1], item[2] or "BindFire", tonumber(item[3]) or item[3] or -1}
                            elseif type(item) == "number" or type(item) == "string" then
                                binds[#binds + 1] = {tonumber(item) or item, "BindFire", -1}
                            end
                        end
                        if #binds > 0 then
                            bi.BindTable = binds
                        end
                    end

                    if b.np ~= nil then
                        bi.NotePitch = b.np
                        bi.NumberValues = bi.NumberValues or {}
                        bi.NumberValues.NotePitch = b.np
                        bi.NumberValues.Key = b.np
                    end
                    if b.nt ~= nil then
                        bi.Note = b.nt
                    end
                    if b.txt ~= nil then
                        bi.Text = tostring(b.txt)
                        bi.SignText = tostring(b.txt)
                        bi.txt = tostring(b.txt)
                        bi.StringValues = bi.StringValues or {}
                        bi.StringValues.Text = tostring(b.txt)
                        bi.StringValues.SignText = tostring(b.txt)
                    elseif b.Text ~= nil then
                        bi.Text = tostring(b.Text)
                        bi.SignText = tostring(b.Text)
                        bi.txt = tostring(b.Text)
                        bi.StringValues = bi.StringValues or {}
                        bi.StringValues.Text = tostring(b.Text)
                        bi.StringValues.SignText = tostring(b.Text)
                    elseif b.SignText ~= nil then
                        bi.Text = tostring(b.SignText)
                        bi.SignText = tostring(b.SignText)
                        bi.txt = tostring(b.SignText)
                        bi.StringValues = bi.StringValues or {}
                        bi.StringValues.Text = tostring(b.SignText)
                        bi.StringValues.SignText = tostring(b.SignText)
                    end

                    arr[#arr+1] = bi
                end
            end
            if #arr > 0 then result[blockName] = arr end
        end
    end

    if next(result) then return result end
    return nil
end

