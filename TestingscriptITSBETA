function writeBuildLog(action, remoteName, target, details)
    if Settings and Settings.detailedBuildLogs == false then return end
    pcall(function()
        ensureFolder()
        local logPath = FOLDER_PATH .. "/BUILD.log"
        local tStr = os.date("%H:%M:%S")
        local line = string.format("[%s] [%-6s] %-14s | %-16s | %s\n",
            tStr, tostring(action or "LOG"), tostring(remoteName or "-"), tostring(target or "-"), tostring(details or "-"))
        if appendfile then
            appendfile(logPath, line)
        elseif writefile then
            local prev = isfile(logPath) and readfile(logPath) or ""
            writefile(logPath, prev .. line)
        end
    end)
end

function resetBuildLog(targetName, totalBlocks)
    if Settings and Settings.detailedBuildLogs == false then return end
    pcall(function()
        ensureFolder()
        local logPath = FOLDER_PATH .. "/BUILD.log"
        local header = string.format("======================================================================\n=== BUILD LOG STARTED %s ===\n=== Target: %s | Total: %s blocks ===\n======================================================================\n",
            os.date("%Y-%m-%d %H:%M:%S"), tostring(targetName or "Build"), tostring(totalBlocks or "?"))
        if writefile then
            writefile(logPath, header)
        end
    end)
end

