        local function getShapeBuildData()
            local curBlockName = _SG.shapeBlockName or shapeBlockName or "WoodBlock"
            local entries = genEntries and genEntries()
            if not entries or #entries == 0 then return nil end
            local hOff = (getHOff and getHOff()) or 15
            local blockList = {}
            for _, ent in ipairs(entries) do
                local baseCF = strCF(ent.CFrame)
                local p = baseCF.Position
                local newPos = p + Vector3.new(0, hOff, 0)
                local newCF = CFrame.new(newPos) * (baseCF - p)
                local e2 = {
                    CFrame = cfStr(newCF),
                    Anchored = true,
                    Size = ent.Size,
                    CanCollide = (ent.CanCollide ~= nil and ent.CanCollide or false),
                    Transparency = ent.Transparency,
                    ShowShadow = ent.ShowShadow
                }
                table.insert(blockList, e2)
            end
            return { [curBlockName] = blockList }
        end

