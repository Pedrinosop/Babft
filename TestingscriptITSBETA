    local function getClosestSnapZone(dockCenter)
        if not MainFrame.Visible then return nil end
        local mfPos = MainFrame.AbsolutePosition
        local mfSize = MainFrame.AbsoluteSize

        local dockOffsetY = 62
        local leftCenter = Vector2.new(mfPos.X - 25 - 8, mfPos.Y + dockOffsetY + mfSize.Y * 0.5)
        local rightCenter = Vector2.new(mfPos.X + mfSize.X + 25 + 8, mfPos.Y + dockOffsetY + mfSize.Y * 0.5)
        local topCenter = Vector2.new(mfPos.X + mfSize.X * 0.5, mfPos.Y - 23 - 8 + dockOffsetY)
        local botCenter = Vector2.new(mfPos.X + mfSize.X * 0.5, mfPos.Y + mfSize.Y + 23 + 8 + dockOffsetY)

        local dLeft = (dockCenter - leftCenter).Magnitude
        local dRight = (dockCenter - rightCenter).Magnitude
        local dTop = (dockCenter - topCenter).Magnitude
        local dBot = (dockCenter - botCenter).Magnitude

        local minDist = math.min(dLeft, dRight, dTop, dBot)
        local SNAP_THRESHOLD = 140

        if minDist <= SNAP_THRESHOLD then
            if minDist == dLeft then return "left"
            elseif minDist == dRight then return "right"
            elseif minDist == dTop then return "top"
            elseif minDist == dBot then return "bottom"
            end
        end
        return nil
    end

