                local sf = shopGui:FindFirstChild("SideFrame")
                local mb = sf and sf:FindFirstChild("MenuButton")
                if mb then
                    if not origShopPos then origShopPos = mb.Position end
                    local targetPos = calcDodgePosition(mb, origShopPos, mfRect, vp)
