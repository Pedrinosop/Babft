            Button = true, Switch = true, SwitchBig = true, SensorBlock = true,
            RemoteController = true, PilotSeat = true, CarSeat = true, Lever = true, Delay = true,
            Gate = true,
        }
        local TARGET_PORT_ACTION = {
            Piston = { BindUp = "Push", BindDown = "Pull", Push = "Push", Pull = "Pull" },
            Servo = { BindLeft = "Left", BindRight = "Right", RotateLeft = "Left", RotateRight = "Right", Left = "Left", Right = "Right" },
            Motor = { BindUp = "Forward", BindDown = "Backward", Forward = "Forward", Backward = "Backward" },
            BoatMotor = { BindUp = "Forward", BindDown = "Backward", BindLeft = "Left", BindRight = "Right", Forward = "Forward", Backward = "Backward", Left = "Left", Right = "Right" },
            CarSeat = { BindUp = "Forward", BindDown = "Backward", BindLeft = "Left", BindRight = "Right" },
            PilotSeat = { BindUp = "Forward", BindDown = "Backward", BindLeft = "Left", BindRight = "Right" },
            LightBulb = { BindFire = "Activate", BindActivate = "Activate", Toggle = "Activate", Fire = "Activate", Activate = "Activate" },
            Switch = { BindFire = "Activate", BindActivate = "Activate", Toggle = "Activate", Activate = "Activate" },
            Button = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            SwitchBig = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Lever = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Delay = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Note = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Gate = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            CannonTurret = { BindFire = "Activate", BindActivate = "Activate", Fire = "Activate", Activate = "Activate" },
            Cannon = { BindFire = "Activate", BindActivate = "Activate", Fire = "Activate", Activate = "Activate" },
            Harpoon = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Magnet = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Shield = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            ShieldGenerator = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Portal = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Firework = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            TNT = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
            Explosive = { BindFire = "Activate", BindActivate = "Activate", Activate = "Activate" },
        }
        local ACTION_PORT_ALIAS = {
            Push = "BindUp", Pull = "BindDown",
            Forward = "BindUp", Backward = "BindDown",
            Left = "BindLeft", Right = "BindRight",
            Activate = "BindFire",
        }

        local function isUnkeyedVal(val)
            if val == nil or val == "" then return true end
            if type(val) == "boolean" then return true end
            local n = tonumber(val)
            if n == nil then return true end
            return n == -1
        end

        local function findPortOwner(blockA, blockB, bindName)
            if bindName == "ControllerRef" then
                for _, cand in ipairs({blockA, blockB}) do
                    if cand and cand.Parent then
                        local other = (cand == blockA) and blockB or blockA
                        for _, ov in ipairs(cand:GetDescendants()) do
                            if ov:IsA("ObjectValue") and ov.Name == "ControllerRef" and ov.Value == other then
                                return cand, other
                            end
                        end
                    end
                end
            end
            local function checkBlockPort(blk, pName)
                if not (blk and blk.Parent) then return false end
                if blk:FindFirstChild(pName) or blk:FindFirstChild(pName, true) then return true end
                local aliases = {
                    BindFire = {"BindActivate", "Activate", "Fire"},
                    BindActivate = {"BindFire", "Activate", "Fire"},
                    BindUp = {"Push", "Forward"},
                    BindDown = {"Pull", "Backward"},
                    BindLeft = {"Left"},
                    BindRight = {"Right"},
                }
                local candList = aliases[pName]
                if candList then
                    for _, al in ipairs(candList) do
                        if blk:FindFirstChild(al) or blk:FindFirstChild(al, true) then return true end
                    end
                end
                return false
            end
            local aHas = checkBlockPort(blockA, bindName)
            local bHas = checkBlockPort(blockB, bindName)
            if aHas and not bHas then return blockA, blockB end
            if bHas and not aHas then return blockB, blockA end
            local aCtrl = blockA and BIND_CONTROLLER_NAMES[blockA.Name] == true
            local bCtrl = blockB and BIND_CONTROLLER_NAMES[blockB.Name] == true
            if aCtrl and not bCtrl then return blockB, blockA end
            if bCtrl and not aCtrl then return blockA, blockB end
            return blockB, blockA
        end

        local function resolvePortAndAction(bindName, targetBlock)
            if bindName == "ControllerRef" then return "ControllerRef", "ControllerRef" end
            if type(bindName) ~= "string" or bindName == "" then return nil, nil end
            local tbName = targetBlock and targetBlock.Name or ""
            local m = TARGET_PORT_ACTION[tbName]
            local portObj = nil

            pcall(function()
                portObj = targetBlock and (targetBlock:FindFirstChild(bindName) or targetBlock:FindFirstChild(bindName, true))
            end)

            if not portObj and targetBlock then
                local searchAliases = {
                    BindFire = {"BindActivate", "Activate", "Fire"},
                    BindActivate = {"BindFire", "Activate", "Fire"},
                    BindUp = {"Push", "Forward"},
                    BindDown = {"Pull", "Backward"},
                    BindLeft = {"Left"},
                    BindRight = {"Right"},
                }
                local candList = searchAliases[bindName]
                if candList then
                    for _, cand in ipairs(candList) do
                        portObj = targetBlock:FindFirstChild(cand) or targetBlock:FindFirstChild(cand, true)
                        if portObj then
                            bindName = portObj.Name
                            break
                        end
                    end
                end
            end

            if portObj then
                local an = portObj:FindFirstChild("ActionName")
                if an and an.Value ~= nil and tostring(an.Value) ~= "" then
                    return portObj.Name, tostring(an.Value)
                end
            end

            if m and m[bindName] then
                return bindName, m[bindName]
            end

            if bindName:sub(1, 4) == "Bind" then
                if bindName == "BindFire" or bindName == "BindActivate" then
                    return bindName, "Activate"
                elseif bindName == "BindUp" then
                    return bindName, (tbName == "Piston" and "Push") or "Forward"
                elseif bindName == "BindDown" then
                    return bindName, (tbName == "Piston" and "Pull") or "Backward"
                elseif bindName == "BindLeft" then
                    return bindName, "Left"
                elseif bindName == "BindRight" then
                    return bindName, "Right"
                end
                return bindName, bindName:sub(5)
            end
            local alias = ACTION_PORT_ALIAS[bindName]
            if alias then return alias, bindName end
            return bindName, bindName
        end

        local claimedRefOvs = {}
        local function findBindObject(targetBlock, portName, ctrlBlock)
            if not targetBlock then return nil end
            if portName == "ControllerRef" then
                for _, ov in ipairs(targetBlock:GetDescendants()) do
                    if ov:IsA("ObjectValue") and ov.Name == "ControllerRef" and ov.Value == ctrlBlock
                        and not claimedRefOvs[ov] then
                        claimedRefOvs[ov] = true
                        return ov
                    end
                end
                for _, ov in ipairs(targetBlock:GetChildren()) do
                    if ov:IsA("ObjectValue") and ov.Name == "ControllerRef" and ov.Value == nil
                        and not claimedRefOvs[ov] then
                        claimedRefOvs[ov] = true
                        return ov
                    end
                end
                return nil
            end
            local o = targetBlock:FindFirstChild(portName) or targetBlock:FindFirstChild(portName, true)
            if not o then
                local candidates = {
                    BindFire = {"BindActivate", "Activate", "Fire"},
                    BindActivate = {"BindFire", "Activate", "Fire"},
                    BindUp = {"Push", "Forward"},
                    BindDown = {"Pull", "Backward"},
                    BindLeft = {"Left"},
                    BindRight = {"Right"},
                    Push = {"BindUp"},
                    Pull = {"BindDown"},
                    Forward = {"BindUp"},
                    Backward = {"BindDown"},
                    Left = {"BindLeft"},
                    Right = {"BindRight"},
                    Activate = {"BindFire", "BindActivate"},
                }
                local list = candidates[portName]
                if list then
                    for _, candName in ipairs(list) do
                        o = targetBlock:FindFirstChild(candName) or targetBlock:FindFirstChild(candName, true)
                        if o then break end
                    end
                end
            end
            if not o then
                for _, ch in ipairs(targetBlock:GetDescendants()) do
                    if ch:IsA("ObjectValue") or ch:IsA("IntValue") or ch:IsA("NumberValue") then
                        if ch.Name ~= "ControllerRef" and (ch.Name:find("Bind") or ch:FindFirstChild("ActionName")) then
                            o = ch
                            break
                        end
                    end
                end
            end
            return o
        end

        local hasAnyBinds = false
        for _, e in ipairs(styledList) do
            if e.v and type(e.v.BindTable) == "table" then
                local cnt = 0
                for _ in pairs(e.v.BindTable) do cnt = cnt + 1 end
                if cnt > 0 then hasAnyBinds = true break end
            end
        end

        if not hasAnyBinds then
            logBind("No bind tables found in build list")
            return
        end

        local recsByCtrl, ctrlOrder = {}, {}
        local totalBinds, skippedBinds = 0, 0

        local function getRec(ctrl)
            local r = recsByCtrl[ctrl]
            if not r then
                r = {seat = ctrl, calls = {}, missing = 0}
                recsByCtrl[ctrl] = r
                ctrlOrder[#ctrlOrder + 1] = r
            end
            return r
        end

        local function getCall(rec, key)
            for _, c in ipairs(rec.calls) do
                if c.key == key then return c end
            end
            local c = {key = key, acts = {}, actOrder = {}}
            rec.calls[#rec.calls + 1] = c
            return c
        end

        for _, entry in ipairs(styledList) do
            if stopBuild then break end
            local bindTable = entry.v and entry.v.BindTable
            if type(bindTable) == "table" and entry.block then
                for _, bindRow in pairs(bindTable) do
                    if type(bindRow) ~= "table" or bindRow[1] == nil or bindRow[2] == nil then continue end
                    local rawName = tostring(bindRow[2])
                    local blockB = placedById[bindRow[1]] or placedById[tostring(bindRow[1])] or (tonumber(bindRow[1]) and placedById[tonumber(bindRow[1])]) or (tonumber(bindRow[1]) and styledList[tonumber(bindRow[1])] and styledList[tonumber(bindRow[1])].block)
                    if not blockB then
                        skippedBinds = skippedBinds + 1
                        continue
                    end
                    local targetBlock, ctrlBlock = findPortOwner(entry.block, blockB, rawName)
                    if not targetBlock or not ctrlBlock or targetBlock == ctrlBlock then
                        skippedBinds = skippedBinds + 1
                        continue
                    end

                    if rawName == "ControllerRef" then
                        local candidatePort = targetBlock:FindFirstChild("BindFire")
                            or targetBlock:FindFirstChild("BindUp")
                            or targetBlock:FindFirstChild("BindLeft")
                            or targetBlock:FindFirstChild("BindActivate")
                        if candidatePort then
                            rawName = candidatePort.Name
                        else
                            local sOv = findBindObject(targetBlock, "ControllerRef", ctrlBlock)
                            if sOv then
                                pcall(function() sOv.Value = ctrlBlock end)
                            end
                            continue
                        end
                    end
                    if ctrlBlock.Name == "PilotSeat" or ctrlBlock.Name == "CarSeat" then
                        local sOv = findBindObject(targetBlock, "ControllerRef", ctrlBlock)
                        if sOv then
                            pcall(function() sOv.Value = ctrlBlock end)
                        end
                    end
                    local portName, actionName = resolvePortAndAction(rawName, targetBlock)
                    if not portName then
                        skippedBinds = skippedBinds + 1
                        continue
                    end
                    local bindValue = tonumber(bindRow[3]) or bindRow[3]
                    local unkeyed = isUnkeyedVal(bindValue)
                    local rec = getRec(ctrlBlock)

                    local callKey = nil
                    if not unkeyed then callKey = bindValue end
                    local call = getCall(rec, callKey)
                    local grp = call.acts[actionName]
                    if not grp then
                        grp = {objs = {}, keys = {}, missing = {}, uobjs = {}, umissing = {}}
                        call.acts[actionName] = grp
                        call.actOrder[#call.actOrder + 1] = actionName
                    end
                    totalBinds = totalBinds + 1
                    local bindObject = findBindObject(targetBlock, portName, ctrlBlock)
                    if bindObject then
                        if unkeyed then
                            grp.uobjs[#grp.uobjs + 1] = bindObject
                        else
                            grp.objs[#grp.objs + 1] = bindObject
                        end
                    else
                        if unkeyed then
                            grp.umissing[#grp.umissing + 1] = {target = targetBlock, name = portName}
                        else
                            grp.missing[#grp.missing + 1] = {target = targetBlock, name = portName}
                        end
                        rec.missing = rec.missing + 1
                    end
                    if not unkeyed then
                        grp.keys[#grp.keys + 1] = bindValue
                    end
                end
            end
        end

        logBind(string.format("Parsed binds: %d rows, %d controllers, %d skipped",
            totalBinds, #ctrlOrder, skippedBinds))

        if #ctrlOrder == 0 then
            updProg("Binds: " .. skippedBinds .. " skipped, 0 controllers", p1)
            return
        end

        local completedCalls = 0
        local totalSuccess = 0
        local doneBinds = 0

        local rf = ensureBindTool()
        if not rf then
            logBind("ERROR: BindTool RF not available, skipping binds phase")
            updProg("No BindTool RF, skipping binds", p0)
            return function() return true end
        end

        updProg("Applying binds (" .. #ctrlOrder .. " controllers)...", p1)

        for ctrlIdx, rec in ipairs(ctrlOrder) do
            if stopBuild then break end
            local ctrlBlock = rec.seat
            if not ctrlBlock or not ctrlBlock.Parent then
                completedCalls = completedCalls + 1
                continue
            end

            local isSeat = (ctrlBlock:HasTag("SeatInput") or ctrlBlock.Name == "CarSeat" or ctrlBlock.Name == "PilotSeat" or ctrlBlock:IsA("VehicleSeat") or ctrlBlock:IsA("Seat")) == true

            local keyedActs, keyedKeys = {}, {}
            local keyedCount = 0
            for _, call in ipairs(rec.calls) do
                if call.key ~= nil then
                    for _, actName in ipairs(call.actOrder) do
                        local grp = call.acts[actName]
                        if grp and #grp.objs > 0 then
                            local validObjs = {}
                            for _, obj in ipairs(grp.objs) do
                                if obj and typeof(obj) == "Instance" and obj.Parent and obj:IsDescendantOf(workspace) then
                                    validObjs[#validObjs + 1] = obj
                                    keyedCount = keyedCount + 1
                                end
                            end
                            if #validObjs > 0 then
                                if not keyedActs[actName] then keyedActs[actName] = {} end
                                for _, vo in ipairs(validObjs) do
                                    keyedActs[actName][#keyedActs[actName] + 1] = vo
                                end
                                keyedKeys[actName] = call.key
                            end
                        end
                    end
                end
            end
            if keyedCount > 0 then
                if logBuild then
                    local keyInfo = {}
                    for a, k in pairs(keyedKeys) do keyInfo[#keyInfo + 1] = tostring(a) .. "=" .. tostring(k) end
                    logBuild(string.format("[REMOTE RF] BindTool.RF:InvokeServer -> Controller: %s (Keyed: %s, %d ports)", ctrlBlock.Name, table.concat(keyInfo, ", "), keyedCount))
                end
                local ok = pcall(function()
                    rf:InvokeServer(keyedActs, {ctrlBlock}, keyedKeys, false, isSeat)
                end)
                if ok then
                    totalSuccess = totalSuccess + 1
                    doneBinds = doneBinds + keyedCount
                end
                task.wait(0.08)
            end

            local uActs = {}
            local uCount = 0
            for _, call in ipairs(rec.calls) do
                if call.key == nil then
                    for _, actName in ipairs(call.actOrder) do
                        local grp = call.acts[actName]
                        if grp and #grp.uobjs > 0 then
                            local validObjs = {}
                            for _, obj in ipairs(grp.uobjs) do
                                if obj and typeof(obj) == "Instance" and obj.Parent and obj:IsDescendantOf(workspace) then
                                    validObjs[#validObjs + 1] = obj
                                    uCount = uCount + 1
                                end
                            end
                            if #validObjs > 0 then
                                if not uActs[actName] then uActs[actName] = {} end
                                for _, vo in ipairs(validObjs) do
                                    uActs[actName][#uActs[actName] + 1] = vo
                                end
                            end
                        end
                    end
                end
            end

            if uCount > 0 then
                if logBuild then
                    local actInfo = {}
                    for a, o in pairs(uActs) do actInfo[#actInfo + 1] = tostring(a) .. "(" .. tostring(#o) .. ")" end
                    logBuild(string.format("[REMOTE RF] BindTool.RF:InvokeServer -> Controller: %s (Unkeyed: %s)", ctrlBlock.Name, table.concat(actInfo, ", ")))
                end
                local ok = pcall(function()
                    rf:InvokeServer(uActs, {ctrlBlock}, {}, false, false)
                end)
                if ok then
                    totalSuccess = totalSuccess + 1
                    doneBinds = doneBinds + uCount
                end
                task.wait(0.08)
            end

            task.wait(0.05)

            completedCalls = completedCalls + 1
            if ctrlIdx % 10 == 0 then
                updProg("Binds: " .. ctrlIdx .. "/" .. #ctrlOrder .. " controllers", p1)
            end
        end

        logBind(string.format("Completed binds phase: %d/%d controllers successful (%d ports bound)",
            totalSuccess, #ctrlOrder, doneBinds))

        local function waitBindsDone(maxWaitSec, progressCb)
            return true
        end
        return waitBindsDone
    end

    local function applyPropertiesPhase(styledList, p0, p1, skipTransp, skipCollision)
        if not propertiesRF then updProg("No PropertiesTool RF, skipping props", p0) return end

        local numGroups, numOrder = {}, {}
        local boolGroups, boolOrder = {}, {}
        local pbCount = 0

        local function pushNum(propName, valStr, blk)
            local key = propName .. "=" .. valStr
            local lst = numGroups[key]
            if not lst then
                lst = {}
                numGroups[key] = lst
                numOrder[#numOrder + 1] = key
            end
            lst[#lst + 1] = blk
        end
        local function pushBool(propName, blk)
            local lst = boolGroups[propName]
            if not lst then
                lst = {}
                boolGroups[propName] = lst
                boolOrder[#boolOrder + 1] = propName
            end
            lst[#lst + 1] = blk
        end

        for _, entry in ipairs(styledList) do
            if stopBuild then break end
            if entry.block and entry.v then
                local v = entry.v
                local b = entry.block

                if CONTROLLER_LEGACY_NAMES[b.Name] then
                    if v.BoolValues and v.BoolValues.Legacy == true then
                        v.BoolValues.Legacy = true
                    elseif v.BoolValues then
                        v.BoolValues.Legacy = nil
                    end
                end

                if (v.NumberValues and next(v.NumberValues)) or (v.BoolValues and next(v.BoolValues)) or (v.SpringProps and next(v.SpringProps)) then
                    pbCount = pbCount + 1

                    local bvToApply = v.BoolValues
                    if skipCollision and bvToApply then
                        bvToApply = {}
                        for bk, bv in pairs(v.BoolValues) do
                            if bk ~= "CanCollide" and bk ~= "Collision" then
                                bvToApply[bk] = bv
                            end
                        end
                    end
                    if bvToApply then
                        for propName, propVal in pairs(bvToApply) do
                            if not BLOCKED_PROPS[propName] then
                                local desired = propVal == true
                                local currentValue = nil
                                pcall(function()
                                    for _, target in ipairs({b, b.PPart}) do
                                        if target then
                                            local pv = target:FindFirstChild(propName) or target:FindFirstChild(propName, true)
                                            if pv and pv:IsA("BoolValue") then
                                                if currentValue == nil then currentValue = pv.Value end
                                            end
                                        end
                                    end
                                end)
                                local needToggle
                                if currentValue == nil then
                                    needToggle = desired
                                else
                                    needToggle = (currentValue ~= desired)
                                end

                                if needToggle then pushBool(mapRemoteBoolProp(propName), b) end
                            end
                        end
                    end

                    if v.NumberValues then
                        for propName, propVal in pairs(v.NumberValues) do
                            if not BLOCKED_PROPS[propName] then
                                local remotePropName = mapRemoteNumberProp(b.Name, propName)
                                local numericVal = tonumber(propVal)
                                if numericVal == nil and type(propVal) == "boolean" then numericVal = propVal and 1 or 0 end
                                pcall(function()
                                    for _, target in ipairs({b, b.PPart}) do
                                        if target then
                                            local pv = target:FindFirstChild(propName) or target:FindFirstChild(propName, true)
                                            if not pv and remotePropName ~= propName then
                                                pv = target:FindFirstChild(remotePropName) or target:FindFirstChild(remotePropName, true)
                                            end
                                            if pv then
                                                if pv:IsA("NumberValue") or pv:IsA("IntValue") then
                                                    pv.Value = numericVal
                                                elseif pv:IsA("BoolValue") then
                                                    pv.Value = numericVal ~= 0
                                                end
                                            end
                                        end
                                    end
                                    if (propName == "Density" or remotePropName == "Density") and numericVal then
                                        local pp = b:FindFirstChild("PPart") or b.PrimaryPart or b:FindFirstChildWhichIsA("BasePart")
                                        if pp then
                                            local d = math.clamp(numericVal, 0.01, 100)
                                            local cur = pp.CustomPhysicalProperties or PhysicalProperties.new(pp.Material)
                                            pp.CustomPhysicalProperties = PhysicalProperties.new(d, cur.Friction, cur.Elasticity, cur.FrictionWeight, cur.ElasticityWeight)
                                        end
                                    end
                                end)

                                if numericVal == nil then
                                    pushNum(remotePropName, tostring(propVal), b)
                                else
                                    pushNum(remotePropName, tostring(propRemoteValue(b.Name, remotePropName, numericVal)), b)
                                end
                            end
                        end
                    end

                    if v.SpringProps and next(v.SpringProps) then
                        local sp = v.SpringProps
                        if sp.Stiffness then pushNum("Stiffness", tostring(tonumber(sp.Stiffness) or 0), b) end
                        if sp.Damping then pushNum("Damping", tostring(tonumber(sp.Damping) or 0), b) end
                        if sp.TargetLength then pushNum("Target length", tostring(tonumber(sp.TargetLength) or 0), b) end
                        if sp.MaxLength then pushNum("Max length", tostring(tonumber(sp.MaxLength) or 0), b) end
                        if sp.MinLength then pushNum("Min length", tostring(tonumber(sp.MinLength) or 0), b) end
                        if sp.Length then pushNum("Length", tostring(tonumber(sp.Length) or 0), b) end
                        if sp.AngleLimit then pushNum("Angle limit", tostring(tonumber(sp.AngleLimit) or 0), b) end
                        if sp.MatchRotation then pushBool("Match rotation", b) end
                        if sp.ShowConstraint then pushBool("Show constraint", b) end
                    end
                end
            end
        end

        local PROP_BATCH = 40
        for _, key in ipairs(numOrder) do
            local lst = numGroups[key]
            local eq = string.find(key, "=", 1, true)
            local propName = string.sub(key, 1, eq - 1)
            local valStr = string.sub(key, eq + 1)
            for i = 1, #lst, PROP_BATCH do
                if stopBuild then break end
                local chunk = {}
                for j = i, math.min(i + PROP_BATCH - 1, #lst) do chunk[#chunk + 1] = lst[j] end
                task.spawn(function()
                    pcall(function() propertiesRF:InvokeServer(propName, chunk, valStr) end)
                end)
                task.wait(0.02)
            end
        end
        for _, propName in ipairs(boolOrder) do
            local lst = boolGroups[propName]
            for i = 1, #lst, PROP_BATCH do
                if stopBuild then break end
                local chunk = {}
                for j = i, math.min(i + PROP_BATCH - 1, #lst) do chunk[#chunk + 1] = lst[j] end
                task.spawn(function()
                    pcall(function() propertiesRF:InvokeServer(propName, chunk) end)
                end)
                task.wait(0.02)
            end
        end
        updProg("Properties done (" .. pbCount .. " blocks, batched)", p1)
    end

    local function runMovePhase(styledList, p0, p1)
        local moveOpRF = nil
        local trowelTool = (Character and Character:FindFirstChild("TrowelTool")) or LocalPlayer.Backpack:FindFirstChild("TrowelTool")
        if trowelTool then
            moveOpRF = trowelTool:FindFirstChild("OperationRF")
            if trowelTool.Parent ~= Character then trowelTool.Parent = Character ; task.wait(0.05) end
        end

        local regularBlocks = {}
        local nonBlocksToMove = {}

        for _, entry in ipairs(styledList) do
            if stopBuild then break end
            local b = entry.block
            if b and b.Parent and b:FindFirstChild("PPart") then
                local cf = entry.worldCF
