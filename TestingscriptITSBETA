                                    if sfConn then pcall(function() sfConn:Disconnect() end) sfConn = nil end
                                    sfUpdateSelBtn()
                                    task.spawn(sfShowPreview)
                                end
                            end
                        end
                    end
                end)
                _G._SPRB_SFMouseConn = sfConn
            end
        end
        sfUpdateSelBtn()
    end)

