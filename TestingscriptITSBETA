        if #toReplace == 0 then updateStatus(L("NoMatchingBlocks") or "No matching blocks!"); return end

        local myZone = getPlayerZone(LocalPlayer)
        if not myZone then updateStatus("No zone!"); return end

        local buildData = {}
        local idCounter = 1
        for _, b in ipairs(toReplace) do
            local pp = b:FindFirstChild("PPart")
            if not pp then continue end
            local relCF = myZone.CFrame:ToObjectSpace(pp.CFrame)
            local realTransp = pp.Transparency
            if b.Name:sub(-5) ~= "Block" and realTransp >= 1 then
                for _, desc in pairs(b:GetChildren()) do
                    if (desc:IsA("BasePart") or desc:IsA("UnionOperation")) and desc ~= pp and desc.Transparency < 1 then
                        realTransp = desc.Transparency
                        break
                    end
                end
            end
            buildData[R.srcName] = buildData[R.srcName] or {}

            local finalTransp = R.keepProps and realTransp or R.srcTransp
            local finalCol = R.keepProps and pp.Color or R.srcColor or pp.Color
            local finalCanCollide = R.keepProps and pp.CanCollide or (R.srcCanCollide ~= nil and R.srcCanCollide or pp.CanCollide)
            local finalShowShadow = R.keepProps and (pp.CastShadow ~= false) or (R.srcShowShadow ~= nil and R.srcShowShadow or (pp.CastShadow ~= false))

            local entry = {
                CFrame = cfStr(relCF),
                Size = v3Str(pp.Size),
                Col = colStr(finalCol),
                Transparency = finalTransp,
                Anchored = true,
                CanCollide = finalCanCollide,
                ShowShadow = finalShowShadow,
                ID = idCounter,
            }
            idCounter = idCounter + 1
            local numVals = {}
            local boolVals = {}
            for _, child in pairs(b:GetChildren()) do
                if child:IsA("BoolValue") then
                    boolVals[child.Name] = child.Value
                elseif (child:IsA("NumberValue") or child:IsA("IntValue")) and not child.Name:find("^Bind") then
                    numVals[child.Name] = child.Value
                end
            end
            for _, child in pairs(pp:GetChildren()) do
                if child:IsA("BoolValue") then
                    boolVals[child.Name] = child.Value
                elseif (child:IsA("NumberValue") or child:IsA("IntValue")) and not child.Name:find("^Bind") then
                    numVals[child.Name] = child.Value
                end
            end
            if pp.CustomPhysicalProperties and numVals.Density == nil then
                numVals.Density = pp.CustomPhysicalProperties.Density
            end
            if next(boolVals) then entry.BoolValues = boolVals end
            if next(numVals) then entry.NumberValues = numVals end
            table.insert(buildData[R.srcName], entry)
        end

        local totalBlocks = idCounter - 1
        if totalBlocks == 0 then updateStatus(L("NoMatching") or "No matching blocks!"); return end

        R.isRunning = true
        clearHLs()

        local ch = Character or LocalPlayer.Character
        local rpTool = ch and ch:FindFirstChild("ReplaceSelect")
