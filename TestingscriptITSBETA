    function sfPushStrip(strips, layers, bsz, cf, sl, nrm, stripThick)
        local th = stripThick or bsz
        for lh = 0, layers - 1 do
            strips[#strips + 1] = {
                cf = cf + nrm * (lh * bsz),
                size = Vector3.new(sl, bsz, th)
            }
        end
        return true
    end

    function sfFillTriangle(strips, layers, bsz, p1, p2, p3, sticksOn)
        local e1, e2, e3 = p2 - p1, p3 - p2, p1 - p3
        local l1, l2, l3 = e1.Magnitude, e2.Magnitude, e3.Magnitude
        if l1 < 0.01 or l2 < 0.01 or l3 < 0.01 then return end
        local nrm = (p2 - p1):Cross(p3 - p1)
        if nrm.Magnitude < 0.0001 then return end
        nrm = nrm.Unit
        if nrm.Y < -0.001 then nrm = -nrm end

        local B, C, A
        if l1 >= l2 and l1 >= l3 then
            B, C, A = p1, p2, p3
        elseif l2 >= l1 and l2 >= l3 then
            B, C, A = p2, p3, p1
        else
            B, C, A = p3, p1, p2
        end

        local baseVec = C - B
        local baseLen = baseVec.Magnitude
        if baseLen < 0.01 then return nrm end
        local dirBase = baseVec.Unit

        local dirH = dirBase:Cross(nrm).Unit
        if dirH:Dot(A - B) < 0 then dirH = -dirH end
        local H = (A - B):Dot(dirH)
        if H < 0.01 then return nrm end

        local localNrm = dirBase:Cross(dirH).Unit
        if localNrm:Dot(nrm) < 0 then localNrm = -localNrm end
        nrm = localNrm

        local xA = (A - B):Dot(dirBase)

        local step = math.clamp(bsz, 0.01, 500)
        local numSteps = math.max(1, math.ceil(H / step))
        if numSteps > 400 then
            numSteps = 400
        end
        step = H / numSteps

        local function xLeft(y)
            return xA * (y / H)
        end
        local function xRight(y)
            return baseLen + (xA - baseLen) * (y / H)
        end

        for i = 0, numSteps - 1 do
            local y1 = i * step
            local y2 = (i + 1) * step
            local yMid = (y1 + y2) * 0.5
            local xL, xR
            if sticksOn ~= false then
                xL = math.max(xLeft(y1), xLeft(y2))
                xR = math.min(xRight(y1), xRight(y2))
            else
                xL = xLeft(yMid)
                xR = xRight(yMid)
            end
            local w = xR - xL
            if w > 0.001 then
                local xMid = (xL + xR) * 0.5
                local center3D = B + dirBase * xMid + dirH * yMid
                local cf = CFrame.fromMatrix(center3D, dirBase, nrm, dirH)
                for lh = 0, layers - 1 do
                    strips[#strips + 1] = {
                        cf = cf + nrm * (lh * bsz),
                        size = Vector3.new(w, bsz, step)
                    }
                end
            end
        end

        return nrm
    end

    function sfFillRails(strips, layers, bsz, preciseMode, v1, v2, v3, v4)
        local edgeA = v2 - v1
        local edgeB = v4 - v3
        local lenA, lenB = edgeA.Magnitude, edgeB.Magnitude
        if lenA < 0.01 or lenB < 0.01 then return nil end
        local railA = edgeA.Unit
        local nrm = railA:Cross(v3 - v1)
        if nrm.Magnitude < 0.001 then return nil end
        nrm = nrm.Unit
        if nrm.Y < 0 then nrm = -nrm end

        if lenB > lenA then
            v1, v2, v3, v4 = v3, v4, v1, v2
            edgeA, edgeB = edgeB, edgeA
            lenA, lenB = lenB, lenA
            railA = edgeA.Unit
        end

        local maxStrips = 400
        if (lenA / bsz) > maxStrips then
            bsz = lenA / maxStrips
        end

        local rawStrips = {}
        local dist = 0
        while dist < lenA do
            local pa = v1 + edgeA * (dist / lenA)
            local pb = v3 + edgeB * (dist / lenA)
            local span = pb - pa
            local sl = span.Magnitude
            if sl >= 0.001 then
                local rv = span.Unit
                local localNrm = railA:Cross(rv)
                if localNrm.Magnitude < 0.001 then
                    localNrm = nrm
                else
                    localNrm = localNrm.Unit
                    if localNrm:Dot(nrm) < 0 then localNrm = -localNrm end
                end
                local backV = rv:Cross(localNrm).Unit
                rawStrips[#rawStrips + 1] = {
                    cf = CFrame.fromMatrix((pa + pb) / 2, rv, localNrm, backV),
                    len = sl,
                    center = (pa + pb) / 2,
                    rv = rv,
                    localNrm = localNrm,
                    backV = backV
                }
            end
            dist = dist + bsz
        end
        if (lenA - (dist - bsz)) > 0.01 and (dist - bsz) < lenA then
            local pa = v1 + edgeA
            local pb = v3 + edgeB
            local span = pb - pa
            local sl = span.Magnitude
            if sl >= 0.001 then
                local rv = span.Unit
                local localNrm = railA:Cross(rv)
                if localNrm.Magnitude < 0.001 then
                    localNrm = nrm
                else
                    localNrm = localNrm.Unit
                    if localNrm:Dot(nrm) < 0 then localNrm = -localNrm end
                end
                local backV = rv:Cross(localNrm).Unit
                rawStrips[#rawStrips + 1] = {
                    cf = CFrame.fromMatrix((pa + pb) / 2, rv, localNrm, backV),
                    len = sl,
                    center = (pa + pb) / 2,
                    rv = rv,
                    localNrm = localNrm,
                    backV = backV
                }
            end
        end

        local nStrips = #rawStrips
        if not preciseMode or nStrips == 0 then
            for idx = 1, nStrips do
                local s = rawStrips[idx]
                for lh = 0, layers - 1 do
                    strips[#strips + 1] = {
                        cf = s.cf + s.localNrm * (lh * bsz),
                        size = Vector3.new(s.len, bsz, bsz)
                    }
                end
            end
            return nrm
        end

        local i = 1
        while i <= nStrips do
            local cur = rawStrips[i]
            local j = i + 1
            while j <= nStrips do
                local nxt = rawStrips[j]
                local diffLen = math.abs(nxt.len - cur.len) / math.max(cur.len, 0.01)
                local dotDir = nxt.rv:Dot(cur.rv)
                local dotRail = math.abs(cur.rv:Dot(railA))
                local dotBackRail = math.abs(cur.backV:Dot(railA))
                if diffLen < 0.02 and dotDir > 0.98 and dotRail < 0.1 and dotBackRail > 0.9 then
                    j = j + 1
                else
                    break
                end
            end

            local count = j - i
            if count > 1 then
                local firstS = rawStrips[i]
                local lastS = rawStrips[j - 1]
                local totalThick = count * bsz
                local mergedCenter = (firstS.center + lastS.center) * 0.5
                local cf = CFrame.fromMatrix(mergedCenter, cur.rv, cur.localNrm, cur.backV)
                for lh = 0, layers - 1 do
                    strips[#strips + 1] = {
                        cf = cf + cur.localNrm * (lh * bsz),
                        size = Vector3.new(cur.len, bsz, totalThick)
                    }
                end
            else
                for lh = 0, layers - 1 do
                    strips[#strips + 1] = {
                        cf = cur.cf + cur.localNrm * (lh * bsz),
                        size = Vector3.new(cur.len, bsz, bsz)
                    }
                end
            end
            i = j
        end

        return nrm
    end

    function sfAddStickSeg(strips, bsz, P, Q, upPref)
        local seg = Q - P
        local len = seg.Magnitude
        if len < 0.001 then return end
        local dir = seg / len
        local up = upPref
        if not up or up.Magnitude < 0.5 or math.abs(dir:Dot(up.Unit)) > 0.95 then
            up = (math.abs(dir.Y) > 0.95) and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
        end
        up = up - dir * dir:Dot(up)
        if up.Magnitude < 0.001 then
            up = (math.abs(dir.Y) > 0.95) and Vector3.new(1, 0, 0) or Vector3.new(0, 1, 0)
            up = up - dir * dir:Dot(up)
        end
        up = up.Unit
        local back = dir:Cross(up)
        strips[#strips + 1] = {
            cf = CFrame.fromMatrix((P + Q) / 2, dir, up, back),
            size = Vector3.new(len + bsz, bsz, bsz),
        }
    end

    function sfAddEdgeSticks(strips, layers, bsz, nrm, verts)
        if not nrm or nrm.Magnitude < 0.5 then return end
        local nU = nrm.Unit
        local nV = #verts
        local function cornerAt(i, t)
            return verts[i] + nU * (t * bsz)
        end
        for t = 0, layers - 1 do
            for i = 1, nV do
                local nxt = (i % nV) + 1
                local a, b = cornerAt(i, t), cornerAt(nxt, t)
                if a and b then sfAddStickSeg(strips, bsz, a, b, nU) end
            end
            if t < layers - 1 then
                for i = 1, nV do
                    sfAddStickSeg(strips, bsz, cornerAt(i, t), cornerAt(i, t + 1), nU)
                end
            end
        end
    end

    local function sfClipCheck(p, q, lo, hi)
        if math.abs(p) < 1e-12 then
            if q < 0 then return false, lo, hi end
            return true, lo, hi
        end
        local t = q / p
        if p < 0 then
            if t > lo then lo = t end
        else
            if t < hi then hi = t end
        end
        if lo > hi then return false, lo, hi end
        return true, lo, hi
    end

    local function sfEdgeInCell(ax, ay, bx, by, x, y, step)
        local e = 1e-5
        local loX, hiX = x + e, x + step - e
        local loY, hiY = y + e, y + step - e
        local lo, hi = 0, 1
        local dx = bx - ax
        local dy = by - ay
        local ok
        ok, lo, hi = sfClipCheck(-dx, ax - loX, lo, hi)
        if not ok then return false end
        ok, lo, hi = sfClipCheck(dx, hiX - ax, lo, hi)
        if not ok then return false end
        ok, lo, hi = sfClipCheck(-dy, ay - loY, lo, hi)
        if not ok then return false end
        ok, lo, hi = sfClipCheck(dy, hiY - ay, lo, hi)
        if not ok then return false end
        return true
    end

    local function sfInPoly2D(px, py, pts, n)
        local inside = false
        for i = 1, n do
            local a = pts[i]
            local b = pts[(i % n) + 1]
            local cross = (b.x - a.x) * (py - a.y) - (b.y - a.y) * (px - a.x)
            if math.abs(cross) < 1e-6 and
               px >= math.min(a.x, b.x) - 1e-6 and px <= math.max(a.x, b.x) + 1e-6 and
               py >= math.min(a.y, b.y) - 1e-6 and py <= math.max(a.y, b.y) + 1e-6 then
                return true
            end
            if ((a.y > py) ~= (b.y > py)) and (px < (b.x - a.x) * (py - a.y) / (b.y - a.y) + a.x) then
                inside = not inside
            end
        end
        return inside
    end

    function sfFillPolygonRects(strips, layers, bsz, verts)
        local N = #verts
        if N < 3 then return nil end
        local nrm = Vector3.new()
        for i = 1, N do
            local c = verts[i]
            local n = verts[(i % N) + 1]
            nrm = nrm + Vector3.new(
                (c.Y - n.Y) * (c.Z + n.Z),
                (c.Z - n.Z) * (c.X + n.X),
                (c.X - n.X) * (c.Y + n.Y)
            )
        end
        if nrm.Magnitude < 0.0001 then return nil end
        nrm = nrm.Unit
        if nrm.Y < -0.001 then nrm = -nrm end

        local origin = verts[1]
        local uAxis = verts[2] - origin
        uAxis = uAxis - nrm * uAxis:Dot(nrm)
        if uAxis.Magnitude < 0.001 and N >= 3 then
            uAxis = verts[3] - origin
            uAxis = uAxis - nrm * uAxis:Dot(nrm)
        end
        if uAxis.Magnitude < 0.001 then return nrm end
        uAxis = uAxis.Unit
        local vAxis = nrm:Cross(uAxis).Unit

        local pts2d = {}
        for i = 1, N do
            local d = verts[i] - origin
            pts2d[i] = { x = d:Dot(uAxis), y = d:Dot(vAxis) }
        end

        local angles = { 0, math.pi / 6, math.pi / 4, math.pi / 3 }
        for i = 1, N do
            local a = pts2d[i]
            local b = pts2d[(i % N) + 1]
            local dx = b.x - a.x
            local dy = b.y - a.y
            if math.abs(dx) > 1e-4 or math.abs(dy) > 1e-4 then
                local ang = math.atan2(dy, dx) % (math.pi / 2)
                local exists = false
                for _, existing in ipairs(angles) do
                    if math.abs(existing - ang) < 0.02 or math.abs(math.abs(existing - ang) - math.pi / 2) < 0.02 then
                        exists = true
                        break
                    end
                end
                if not exists then
                    angles[#angles + 1] = ang
                end
            end
        end

        local grids = {}
        local minStep = math.clamp(bsz, 0.05, 50)
        for _, ang in ipairs(angles) do
            local cosA = math.cos(ang)
            local sinA = math.sin(ang)
            local rotPoly = {}
            local minX, maxX = 1e9, -1e9
            local minY, maxY = 1e9, -1e9
            for i = 1, N do
                local rx = cosA * pts2d[i].x + sinA * pts2d[i].y
                local ry = -sinA * pts2d[i].x + cosA * pts2d[i].y
                rotPoly[i] = { x = rx, y = ry }
                if rx < minX then minX = rx end
                if rx > maxX then maxX = rx end
                if ry < minY then minY = ry end
                if ry > maxY then maxY = ry end
            end
            local spanX = maxX - minX
            local spanY = maxY - minY
            local step = minStep
            local maxGrid = 80
            if (spanX / step) > maxGrid then step = spanX / maxGrid end
            if (spanY / step) > maxGrid then step = math.max(step, spanY / maxGrid) end
            step = math.max(step, minStep)
            local w = math.max(1, math.ceil(spanX / step))
            local h = math.max(1, math.ceil(spanY / step))
            local ox = minX
            local oy = maxY - h * step

            local valid = {}
            local validCount = 0
            for y = 0, h - 1 do
                local yOffset = y * w
                local yy = oy + y * step
                for x = 0, w - 1 do
                    local xx = ox + x * step
                    local c1 = sfInPoly2D(xx, yy, rotPoly, N)
                    local c2 = sfInPoly2D(xx + step, yy, rotPoly, N)
                    local c3 = sfInPoly2D(xx + step, yy + step, rotPoly, N)
                    local c4 = sfInPoly2D(xx, yy + step, rotPoly, N)
                    if c1 and c2 and c3 and c4 then
                        local cuts = false
                        for ei = 1, N do
                            local pa = rotPoly[ei]
                            local pb = rotPoly[(ei % N) + 1]
                            if sfEdgeInCell(pa.x, pa.y, pb.x, pb.y, xx, yy, step) then
                                cuts = true
                                break
                            end
                        end
                        if not cuts then
                            valid[yOffset + x] = true
                            validCount = validCount + 1
                        end
                    end
                end
            end
            if validCount > 0 then
                grids[#grids + 1] = {
                    cos = cosA,
                    sin = sinA,
                    ox = ox,
                    oy = oy,
                    step = step,
                    w = w,
                    h = h,
                    valid = valid,
                    validCount = validCount
                }
            end
        end

        local rectangles = {}
        local maxRectangles = 28
        for it = 1, maxRectangles do
            local bestScore = 0
            local bestRect = nil
            for _, g in ipairs(grids) do
                local stride = g.w + 1
                local sum = {}
                for idx = 1, (g.h + 1) * stride do sum[idx] = 0 end
                for y = 0, g.h - 1 do
                    local rowUncovered = 0
                    local yOffset = y * g.w
                    local sumRowPrev = y * stride
                    local sumRowCurr = (y + 1) * stride
                    for x = 0, g.w - 1 do
                        if g.valid[yOffset + x] then
                            local cxGrid = g.ox + (x + 0.5) * g.step
                            local cyGrid = g.oy + (y + 0.5) * g.step
                            local wx = g.cos * cxGrid - g.sin * cyGrid
                            local wy = g.sin * cxGrid + g.cos * cyGrid
                            local covered = false
                            for _, r in ipairs(rectangles) do
                                local rx = r.cos * wx + r.sin * wy
                                local ry = -r.sin * wx + r.cos * wy
                                if rx >= r.l - 1e-4 and rx <= r.r + 1e-4 and ry >= r.t - 1e-4 and ry <= r.b + 1e-4 then
                                    covered = true
                                    break
                                end
                            end
                            if not covered then
                                rowUncovered = rowUncovered + 1
                            end
                        end
                        sum[sumRowCurr + x + 2] = sum[sumRowPrev + x + 2] + rowUncovered
                    end
                end

                local heights = {}
                for x = 0, g.w - 1 do heights[x] = 0 end
                for y = 0, g.h - 1 do
                    local yOffset = y * g.w
                    for x = 0, g.w - 1 do
                        heights[x] = g.valid[yOffset + x] and (heights[x] + 1) or 0
                    end
                    local stack = {}
                    for x = 0, g.w do
                        local h = (x < g.w) and heights[x] or 0
                        local startX = x
                        while #stack > 0 and stack[#stack].h >= h do
                            local top = table.remove(stack)
                            startX = top.sx
                            local topY = y + 1 - top.h
                            local bottomY = y + 1
                            local bIdxX = bottomY * stride + x + 2
                            local tIdxX = topY * stride + x + 2
                            local bIdxSx = bottomY * stride + startX + 2
                            local tIdxSx = topY * stride + startX + 2
                            local count = sum[bIdxX] - sum[tIdxX] - sum[bIdxSx] + sum[tIdxSx]
                            local score = count * g.step * g.step
                            if score > bestScore then
                                bestScore = score
                                bestRect = {
                                    cos = g.cos,
                                    sin = g.sin,
                                    l = g.ox + startX * g.step,
                                    r = g.ox + x * g.step,
                                    t = g.oy + topY * g.step,
                                    b = g.oy + bottomY * g.step,
                                    step = g.step
                                }
                            end
                        end
                        if h > 0 and (#stack == 0 or stack[#stack].h < h) then
                            stack[#stack + 1] = { sx = startX, h = h }
                        end
                    end
                end
            end

            if not bestRect or bestScore < 1.0 then break end
            rectangles[#rectangles + 1] = bestRect
        end

        if #grids > 0 then
            local g0 = grids[1]
            for y = 0, g0.h - 1 do
                local yOffset = y * g0.w
                local x = 0
                while x < g0.w do
                    if g0.valid[yOffset + x] then
                        local cxGrid = g0.ox + (x + 0.5) * g0.step
                        local cyGrid = g0.oy + (y + 0.5) * g0.step
                        local wx = g0.cos * cxGrid - g0.sin * cyGrid
                        local wy = g0.sin * cxGrid + g0.cos * cyGrid
                        local covered = false
                        for _, r in ipairs(rectangles) do
                            local rx = r.cos * wx + r.sin * wy
                            local ry = -r.sin * wx + r.cos * wy
                            if rx >= r.l - 1e-4 and rx <= r.r + 1e-4 and ry >= r.t - 1e-4 and ry <= r.b + 1e-4 then
                                covered = true
                                break
                            end
                        end
                        if not covered then
                            local startX = x
                            while x < g0.w and g0.valid[yOffset + x] do
                                local cx2 = g0.ox + (x + 0.5) * g0.step
                                local cy2 = g0.oy + (y + 0.5) * g0.step
                                local wx2 = g0.cos * cx2 - g0.sin * cy2
                                local wy2 = g0.sin * cx2 + g0.cos * cy2
                                local cov2 = false
                                for _, r in ipairs(rectangles) do
                                    local rx = r.cos * wx2 + r.sin * wy2
                                    local ry = -r.sin * wx2 + r.cos * wy2
                                    if rx >= r.l - 1e-4 and rx <= r.r + 1e-4 and ry >= r.t - 1e-4 and ry <= r.b + 1e-4 then
                                        cov2 = true
                                        break
                                    end
                                end
                                if cov2 then break end
                                x = x + 1
                            end
                            rectangles[#rectangles + 1] = {
                                cos = g0.cos,
                                sin = g0.sin,
                                l = g0.ox + startX * g0.step,
                                r = g0.ox + x * g0.step,
                                t = g0.oy + y * g0.step,
                                b = g0.oy + (y + 1) * g0.step,
                                step = g0.step
                            }
                        else
                            x = x + 1
                        end
                    else
                        x = x + 1
                    end
                end
            end
        end

        for _, r in ipairs(rectangles) do
            local w = r.r - r.l
            local h = r.b - r.t
            if w > 0.001 and h > 0.001 then
                local cgx = (r.l + r.r) * 0.5
                local cgy = (r.t + r.b) * 0.5
                local wx = r.cos * cgx - r.sin * cgy
                local wy = r.sin * cgx + r.cos * cgy
                local c3D = origin + uAxis * wx + vAxis * wy
                local r3D = (uAxis * r.cos + vAxis * r.sin).Unit
                local cf = CFrame.fromMatrix(c3D, r3D, nrm, r3D:Cross(nrm))
                for lh = 0, layers - 1 do
                    strips[#strips + 1] = {
                        cf = cf + nrm * (lh * bsz),
                        size = Vector3.new(w, bsz, h)
                    }
                end
            end
        end

        return nrm
    end

    function sfComputeStripsGlobal(sfVerts, bsz, layers, sfSticksOn, sfPreciseMode)
        local strips = {}
        local N = #sfVerts
        if N < 3 then return strips end
        bsz = math.clamp(tonumber(bsz) or 0.5, 0.01, 500)
        layers = math.clamp(math.floor(tonumber(layers) or 1), 1, 256)

        local stickNrm = nil
        local perimeterVerts = sfVerts

        if N == 4 then
            perimeterVerts = { sfVerts[1], sfVerts[2], sfVerts[3], sfVerts[4] }
            if sfPreciseMode then
                stickNrm = sfFillPolygonRects(strips, layers, bsz, perimeterVerts)
            end
            if #strips == 0 then
                stickNrm = sfFillRails(strips, layers, bsz, false, sfVerts[1], sfVerts[2], sfVerts[4], sfVerts[3])
            end
        elseif N == 3 then
            perimeterVerts = { sfVerts[1], sfVerts[2], sfVerts[3] }
            if sfPreciseMode then
                stickNrm = sfFillPolygonRects(strips, layers, bsz, perimeterVerts)
            end
            if #strips == 0 then
                stickNrm = sfFillTriangle(strips, layers, bsz, sfVerts[1], sfVerts[2], sfVerts[3], sfSticksOn)
            end
        else
            perimeterVerts = sfVerts
            if sfPreciseMode then
                stickNrm = sfFillPolygonRects(strips, layers, bsz, perimeterVerts)
            end
            if #strips == 0 then
                local nSum = Vector3.new()
                for i = 2, N - 1 do
                    local tn = sfFillTriangle(strips, layers, bsz, sfVerts[1], sfVerts[i], sfVerts[i + 1], sfSticksOn)
                    if tn then nSum = nSum + tn end
                end
                if nSum.Magnitude > 0.0001 then
                    stickNrm = nSum.Unit
                    if stickNrm.Y < 0 then stickNrm = -stickNrm end
                end
            end
        end

        if sfSticksOn and stickNrm then
            sfAddEdgeSticks(strips, layers, bsz, stickNrm, perimeterVerts)
        end
        return strips
    end

