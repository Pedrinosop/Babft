    local function isSameColor(c1, c2)
        if not c1 or not c2 then return false end
        local r1, g1, b1 = math.round(c1.R * 255), math.round(c1.G * 255), math.round(c1.B * 255)
        local r2, g2, b2 = math.round(c2.R * 255), math.round(c2.G * 255), math.round(c2.B * 255)
