        local handleStart = Instance.new("ImageButton")
        handleStart.Name = "HandleStart"
        handleStart.Size = UDim2.new(0, 14, 0, 14)
        handleStart.AnchorPoint = Vector2.new(0.5, 0.5)
        handleStart.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
        handleStart.AutoButtonColor = false
        handleStart.BorderSizePixel = 0
        handleStart.ZIndex = 5
        handleStart.Parent = trackBar
        local hsc = Instance.new("UICorner"); hsc.CornerRadius = UDim.new(1, 0); hsc.Parent = handleStart
        local hss = Instance.new("UIStroke"); hss.Color = Settings.secondaryColor or Color3.fromRGB(59, 130, 246); hss.Thickness = 2; hss.Parent = handleStart

        local handleEnd = Instance.new("ImageButton")
        handleEnd.Name = "HandleEnd"
        handleEnd.Size = UDim2.new(0, 14, 0, 14)
        handleEnd.AnchorPoint = Vector2.new(0.5, 0.5)
        handleEnd.BackgroundColor3 = Color3.fromRGB(240, 240, 245)
        handleEnd.AutoButtonColor = false
        handleEnd.BorderSizePixel = 0
        handleEnd.ZIndex = 5
        handleEnd.Parent = trackBar
        local hec = Instance.new("UICorner"); hec.CornerRadius = UDim.new(1, 0); hec.Parent = handleEnd
        local hes = Instance.new("UIStroke"); hes.Color = Settings.secondaryColor or Color3.fromRGB(59, 130, 246); hes.Thickness = 2; hes.Parent = handleEnd

        local function updateVisuals()
            local span = math.max(1, currentMaxSec - currentMinSec)
            local fracStart = math.clamp((curStartSec - currentMinSec) / span, 0, 1)
            local fracEnd = math.clamp((curEndSec - currentMinSec) / span, 0, 1)
            if fracEnd < fracStart then fracEnd = fracStart end

            handleStart.Position = UDim2.new(fracStart, 0, 0.5, 0)
            handleEnd.Position = UDim2.new(fracEnd, 0, 0.5, 0)
            activeTrack.Position = UDim2.new(fracStart, 0, 0, 0)
            activeTrack.Size = UDim2.new(math.max(0, fracEnd - fracStart), 0, 1, 0)

            minLbl.Text = fmtTime(currentMinSec)
            maxLbl.Text = fmtTime(currentMaxSec)
            rangeLbl.Text = fmtTime(curStartSec) .. " - " .. fmtTime(curEndSec) .. " / " .. fmtTime(currentMaxSec)
        end

        local isDraggingStart = false
        local isDraggingEnd = false

        handleStart.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDraggingStart = true
                tween(handleStart, TweenInfo.new(0.08), {Size = UDim2.new(0, 18, 0, 18)}):Play()
            end
        end)

        handleEnd.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                isDraggingEnd = true
                tween(handleEnd, TweenInfo.new(0.08), {Size = UDim2.new(0, 18, 0, 18)}):Play()
            end
        end)

        trackBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local trackAbsX = trackBar.AbsolutePosition.X
                local trackAbsW = math.max(1, trackBar.AbsoluteSize.X)
                local rel = math.clamp((input.Position.X - trackAbsX) / trackAbsW, 0, 1)
                local span = math.max(1, currentMaxSec - currentMinSec)
                local targetSec = currentMinSec + rel * span
                local distStart = math.abs(targetSec - curStartSec)
                local distEnd = math.abs(targetSec - curEndSec)
                if distStart < distEnd then
                    curStartSec = math.clamp(targetSec, currentMinSec, curEndSec)
                    isDraggingStart = true
                else
                    curEndSec = math.clamp(targetSec, curStartSec, currentMaxSec)
                    isDraggingEnd = true
                end
                updateVisuals()
                if onChange then onChange(curStartSec, curEndSec) end
            end
        end)

        local moveConn = UserInputService.InputChanged:Connect(function(input)
            if not (isDraggingStart or isDraggingEnd) then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                local trackAbsX = trackBar.AbsolutePosition.X
                local trackAbsW = math.max(1, trackBar.AbsoluteSize.X)
                local rel = math.clamp((input.Position.X - trackAbsX) / trackAbsW, 0, 1)
                local span = math.max(1, currentMaxSec - currentMinSec)
                local targetSec = currentMinSec + rel * span

                if isDraggingStart then
                    curStartSec = math.clamp(targetSec, currentMinSec, curEndSec)
                    updateVisuals()
                    if onChange then onChange(curStartSec, curEndSec) end
                elseif isDraggingEnd then
                    curEndSec = math.clamp(targetSec, curStartSec, currentMaxSec)
                    updateVisuals()
                    if onChange then onChange(curStartSec, curEndSec) end
                end
            end
        end)

        local endConn = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                if isDraggingStart or isDraggingEnd then
                    if isDraggingStart then tween(handleStart, TweenInfo.new(0.08), {Size = UDim2.new(0, 14, 0, 14)}):Play() end
                    if isDraggingEnd then tween(handleEnd, TweenInfo.new(0.08), {Size = UDim2.new(0, 14, 0, 14)}):Play() end
                    isDraggingStart = false
                    isDraggingEnd = false
                    playUISound(UISoundConfig.click)
                end
            end
        end)

        card.Destroying:Connect(function()
            if moveConn then moveConn:Disconnect() end
            if endConn then endConn:Disconnect() end
        end)

        updateVisuals()

        return {
            container = card,
            getRange = function() return curStartSec, curEndSec end,
            setLimits = function(minS, maxS)
                currentMinSec = math.max(0, minS or 0)
                currentMaxSec = math.max(currentMinSec + 1, maxS or 60)
                curStartSec = currentMinSec
                curEndSec = currentMaxSec
                updateVisuals()
            end,
            setRange = function(sS, eS)
                curStartSec = math.clamp(sS or currentMinSec, currentMinSec, currentMaxSec)
                curEndSec = math.clamp(eS or currentMaxSec, curStartSec, currentMaxSec)
                updateVisuals()
            end
        }
    end

