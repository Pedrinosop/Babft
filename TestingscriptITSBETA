            end
            if stepDelayIds[1] then
                prs.Button[1].BindTable[#prs.Button[1].BindTable + 1] = {stepDelayIds[1], "BindFire", -1}
            end

            for i = 1, #steps - 1 do
                local curDelay = prs.Delay[i]
