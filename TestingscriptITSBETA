function convBlockToPRS(block, materialName)

    local bi = {}

    if block.CFrame then
        bi.CFrame = cfStr(strCF(block.CFrame))
    else
        local posStr = tostring(block.Position or "0,0,0")
        local rotStr = tostring(block.Rotation or "0,0,0")
        local posNums = {}
        for v in posStr:gmatch("[^,%s]+") do
            local n = tonumber(v)
            if n then posNums[#posNums+1] = n end
        end
        local rotNums = {}
        for v in rotStr:gmatch("[^,%s]+") do
            local n = tonumber(v)
            if n then rotNums[#rotNums+1] = n end
        end

        local px = posNums[1] or 0
        local py = posNums[2] or 0
        local pz = posNums[3] or 0
        local rx = math.rad(rotNums[1] or 0)
        local ry = math.rad(rotNums[2] or 0)
        local rz = math.rad(rotNums[3] or 0)
        local cf = CFrame.new(px, py, pz) * CFrame.fromEulerAnglesXYZ(rx, ry, rz)
        bi.CFrame = cfStr(cf)
    end

    local szStr = tostring(block.Size or "1,1,1")
    local szNums = {}
    for v in szStr:gmatch("[^,%s]+") do
        local n = tonumber(v)
        if n then szNums[#szNums+1] = n end
    end
    bi.Size = string.format("%.4f,%.4f,%.4f", szNums[1] or 1, szNums[2] or 1, szNums[3] or 1)

    local colStr = tostring(block.Color or "1,1,1")
    local r, g, b = 1, 1, 1
    if colStr:match("^%s*[#]?%x%x%x%x%x%x%s*$") then
        local hex = colStr:gsub("^%s*#?", "")
        r = (tonumber(hex:sub(1,2), 16) or 255) / 255
        g = (tonumber(hex:sub(3,4), 16) or 255) / 255
        b = (tonumber(hex:sub(5,6), 16) or 255) / 255
    else
        local cv = {}
        for v in colStr:gmatch("[^,%s]+") do
            local n = tonumber(v)
            if n then cv[#cv+1] = n end
        end
        if #cv >= 3 then
            if cv[1] > 1 or cv[2] > 1 or cv[3] > 1 then
                r, g, b = cv[1]/255, cv[2]/255, cv[3]/255
            else
                r, g, b = cv[1], cv[2], cv[3]
            end
        end
    end
    bi.Col = string.format("%.6f,%.6f,%.6f", r, g, b)

    bi.Anchored = (block.Anchored ~= false)
    bi.CanCollide = (block.CanCollide ~= false)
    bi.Transparency = tonumber(block.Transparency) or 0
    bi.ShowShadow = (block.ShowShadow ~= false)
    if block.ID then bi.ID = block.ID end

    return bi
end

function writeConvertedBuild(buildName, material, blocks)
    local safeName = trimStr(buildName)
    if safeName == "" then
        return nil, "Output name is empty"
    end
    if type(blocks) ~= "table" or #blocks == 0 then
        return nil, "Nothing to convert"
    end
    local cleanBlocks = {}
    local seen = {}
    for _, block in ipairs(blocks) do
        if type(block) == "table" then
            local key = table.concat({
                tostring(block.Position or ""),
                tostring(block.Rotation or ""),
                tostring(block.Size or ""),
                tostring(block.Color or ""),
                tostring(block.Transparency or 0),
                tostring(block.Material or material or ""),
            }, "|")
            if not seen[key] then
                seen[key] = true
                cleanBlocks[#cleanBlocks + 1] = block
            end
        end
    end
    if #cleanBlocks == 0 then
        return nil, "Nothing to convert"
    end
    ensureFolder()

    local groups = {}
    local materials = {}
    local useAuto = (tostring(material) == "Auto")
    for _, block in ipairs(cleanBlocks) do
        local matName = useAuto and tostring(block.Material or "PlasticBlock") or tostring(material or "PlasticBlock")
        if not groups[matName] then
            groups[matName] = {}
            materials[#materials + 1] = matName
        end
        groups[matName][#groups[matName] + 1] = block
    end

    local prsData = {}
    for _, matName in ipairs(materials) do
        local matBlocks = groups[matName]
        local arr = {}
        for _, block in ipairs(matBlocks) do
            arr[#arr + 1] = convBlockToPRS(block, matName)
        end
        prsData[matName] = arr
    end

    local ok, fmt = saveBuildToFile(safeName, prsData)
    if ok then
        local outPath = FOLDER_PREFIX .. safeName .. ".build"
        return outPath, nil
    end
    return nil, "Save failed"
end

