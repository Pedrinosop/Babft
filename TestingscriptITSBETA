                    nIds[#nIds + 1] = nId
                    local noteZ = cz + 2 + (cIdx - 1) * 2
                    prs.Note[#prs.Note + 1] = {
                        CFrame = string.format("%d, %.1f, %d, 1, 0, 0, 0, 1, 0, 0, 0, 1", cx + 2, cy, noteZ),
                        Size = "2, 2, 2",
                        Anchored = true,
                        ID = nId,
                        NotePitch = p,
