                for _, o in pairs(pg:GetChildren()) do
                    if o.Name:find("SPRB") or o.Name:find("CScript_") then pcall(function() o:Destroy() end) end
                end
            end
        end)
        stopBuild = false
        isBuilding = false
        setStatus = function() end
    end

    if mf and mf.Visible then
        task.spawn(function()
            local origPos = mf.Position
            local absPos = mf.AbsolutePosition
            local absSize = mf.AbsoluteSize
            local centerPx = absPos + (absSize / 2)

            local warnOverlay = Instance.new("Frame")
            warnOverlay.Size = UDim2.new(1, 0, 1, 0)
            warnOverlay.BackgroundColor3 = Color3.fromRGB(220, 25, 20)
            warnOverlay.BackgroundTransparency = 0.85
            warnOverlay.ZIndex = 500
            warnOverlay.Parent = mf
            local woCorner = Instance.new("UICorner"); woCorner.CornerRadius = UDim.new(0, 16); woCorner.Parent = warnOverlay

            local tStart = os.clock()
            while os.clock() - tStart < 0.22 do
                local ox = math.random(-8, 8)
                local oy = math.random(-8, 8)
                mf.Position = UDim2.new(origPos.X.Scale, origPos.X.Offset + ox, origPos.Y.Scale, origPos.Y.Offset + oy)
                warnOverlay.BackgroundTransparency = math.random(20, 60) / 100
                task.wait(0.015)
            end
            mf.Position = origPos
            warnOverlay.BackgroundTransparency = 0.05

            if targetGui then
                local flash = Instance.new("Frame")
                flash.Size = UDim2.new(1, 0, 1, 0)
                flash.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                flash.BackgroundTransparency = 0
                flash.BorderSizePixel = 0
                flash.ZIndex = 100000
                flash.Parent = targetGui
                TweenService:Create(flash, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                    BackgroundColor3 = Color3.fromRGB(255, 120, 30),
                    BackgroundTransparency = 1
                }):Play()
                task.delay(0.35, function() pcall(function() flash:Destroy() end) end)

                local function spawnWave(color, targetPx, dur, thick)
                    local ring = Instance.new("Frame")
                    ring.Size = UDim2.new(0, 10, 0, 10)
                    ring.Position = UDim2.new(0, centerPx.X - 5, 0, centerPx.Y - 5)
                    ring.BackgroundTransparency = 1
                    ring.BorderSizePixel = 0
                    ring.ZIndex = 9999
                    local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(1, 0); corner.Parent = ring
                    local stroke = Instance.new("UIStroke"); stroke.Color = color; stroke.Thickness = thick or 6; stroke.Parent = ring
                    ring.Parent = targetGui
                    TweenService:Create(ring, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                        Size = UDim2.new(0, targetPx, 0, targetPx),
                        Position = UDim2.new(0, centerPx.X - targetPx / 2, 0, centerPx.Y - targetPx / 2),
                    }):Play()
                    TweenService:Create(stroke, TweenInfo.new(dur, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                        Transparency = 1,
                        Thickness = 1
                    }):Play()
                    task.delay(dur + 0.1, function() pcall(function() ring:Destroy() end) end)
                end

                spawnWave(Color3.fromRGB(255, 255, 255), 450, 0.28, 10)
                spawnWave(Color3.fromRGB(255, 160, 30), 900, 0.45, 8)
                task.delay(0.04, function() spawnWave(Color3.fromRGB(255, 40, 20), 1350, 0.6, 5) end)

                local emberColors = {
                    Color3.fromRGB(255, 255, 255),
                    Color3.fromRGB(255, 220, 60),
                    Color3.fromRGB(255, 120, 20),
                    Color3.fromRGB(255, 50, 20),
                    Color3.fromRGB(180, 40, 220),
                    Color3.fromRGB(60, 50, 60),
